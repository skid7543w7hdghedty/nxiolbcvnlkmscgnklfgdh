-- ============================================================
-- Show Round Timer (Utilities): reads Workspace.RoundTimerPart Time (seconds)
-- and displays it as "Xm YYs" in white, slightly above the role notify label.
-- ============================================================
showRoundTimerEnabled = false
roundTimerPosXScale = 0.5
roundTimerPosYScale = 0.33
roundTimerSizeXScale = 0.25
roundTimerSizeYScale = 0.06

-- Local extrapolation anchors so the countdown keeps ticking correctly even
-- between the server's updates of RoundTimerPart.Time (the server publishes a
-- fresh value roughly once a second; without this the label would sit "frozen"
-- on the last published second instead of counting down continuously).
local roundTimerLastServerVal = nil
local roundTimerLastServerAt = nil

function getRoundTimerSeconds()
	local part = Workspace:FindFirstChild("RoundTimerPart")
	if not part then roundTimerLastServerVal = nil return nil end
	local t = part:GetAttribute("Time")
	if t == nil then
		local tv = part:FindFirstChild("Time")
		if tv then
			local ok, val = pcall(function() return tv.Value end)
			if ok then t = val end
		end
	end
	if type(t) == "string" then t = tonumber(t) end
	if type(t) ~= "number" then return nil end
	if roundTimerLastServerVal ~= t then
		roundTimerLastServerVal = t
		roundTimerLastServerAt = os.clock()
	end
	-- Smooth, immediate countdown: the published value minus the time elapsed
	-- since we last saw it. The round timer is a "time remaining" countdown, so
	-- it only ever decreases (clamped at 0).
	return math.max(0, roundTimerLastServerVal - (os.clock() - roundTimerLastServerAt))
end

function ensureRoundTimerLabel()

-- Active tab gets a black stroke (white is invisible on the active color),
-- inactive tabs use the customizable stroke color. Transparency applies to both.
function refreshTabStrokeColors()
	for _, catData in pairs(categories) do
		local b = catData.button
		if b then
			local col = catData.isActive and Color3.fromRGB(0, 0, 0) or (tabStrokeColor or Color3.fromRGB(255, 255, 255))
			for _, ch in ipairs(b:GetChildren()) do
				if ch:IsA("UIStroke") then
					ch.Color = col
					ch.Transparency = tabStrokeTransparency or 0
					ch.Thickness = tabStrokeThickness or 1
				end
			end
		end
	end
	pcall(function()
		local function sync(strokeList, activeName)
			if not strokeList then return end
			for _, data in ipairs(strokeList) do
				local st = data.stroke
				if st and st.Parent then
					local active = (data.name == activeName)
					st.Color = active and Color3.fromRGB(0, 0, 0) or (tabStrokeColor or Color3.fromRGB(255, 255, 255))
					st.Transparency = active and 0 or 1
					st.Thickness = tabStrokeThickness or 1
				end
			end
		end
		sync(combatSubTabs, currentCombatSubTab)
		sync(emotesSubTabs, currentEmotesSubTab)
		if sidebarSubTabGroups then
			for _, group in pairs(sidebarSubTabGroups) do
				sync(group.tabs, group.current)
			end
		end
	end)
end
function applyTabStrokesVisible()
	for _, catData in pairs(categories) do
		local b = catData.button
		if b then
			for _, ch in ipairs(b:GetChildren()) do
				if ch:IsA("UIStroke") then ch.Enabled = tabStrokesEnabled end
			end
		end
	end
	pcall(function()
		local function sync(strokeList)
			if not strokeList then return end
			for _, data in ipairs(strokeList) do
				if data.stroke and data.stroke.Parent then data.stroke.Enabled = tabStrokesEnabled end
			end
		end
		sync(combatSubTabs)
		sync(emotesSubTabs)
		if sidebarSubTabGroups then
			for _, group in pairs(sidebarSubTabGroups) do
				sync(group.tabs)
			end
		end
	end)
end

function espHookTrap(trap)
	if not espTrapEnabled then return end
	if espTrackedTraps[trap] then return end
		espCreateTrapHighlight(trap)
		local _, distLabel = espCreateTrapBillboard(trap)
		local lastTrapDistText = nil
	local conn = RunService.Heartbeat:Connect(function()
		if not (espEnabled and espTrapEnabled) then return end
		if _espFrameCounter % 10 ~= 0 then return end
		if not trap or not trap.Parent then return end
			if distLabel then
				local adornee = trap
				if trap:IsA("Model") then adornee = trap.PrimaryPart or trap:FindFirstChildWhichIsA("BasePart") end
				if adornee then
					local myChar = player.Character
					local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
					if myRoot then
						local dist = math.floor((myRoot.Position - adornee.Position).Magnitude)
						local txt = "[" .. tostring(dist) .. "m]"
						if txt ~= lastTrapDistText then
							lastTrapDistText = txt
							distLabel.Text = txt
						end
					end
				end
			end
		end)
		espTrackedTraps[trap] = { conn = conn }
		trap.AncestryChanged:Connect(function(_, parent)
			if not parent then
				if espTrackedTraps[trap] then
					if espTrackedTraps[trap].conn then
						espTrackedTraps[trap].conn:Disconnect()
					end
					espTrackedTraps[trap] = nil
				end
				espCleanTrap(trap)
			end
		end)
	end

	function espScanForTraps()
		-- Watch for new traps immediately; the existing-world scan is chunked.
		local trapConn = Workspace.DescendantAdded:Connect(function(descendant)
			if not (espEnabled and espTrapEnabled) then return end
			if espIsTrap(descendant) then
				task.spawn(espHookTrap, descendant)
			end
		end)
		table.insert(espConnections, trapConn)
		-- [perf] Workspace:GetDescendants() on a full MM2 map allocates a huge
		-- table in ONE frame (the biggest part of the startup hitch). Walk the
		-- tree in small slices across frames instead.
		task.spawn(function()
			local stack = { Workspace }
			local budget = 0
			while #stack > 0 and espEnabled do
				local node = table.remove(stack)
				if espIsTrap(node) then task.spawn(espHookTrap, node) end
				local kids = node:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
				budget = budget + 1
				if budget >= 300 then
					budget = 0
					RunService.Heartbeat:Wait()
				end
			end
		end)
	end

function espScanForMaps()
	for _, mapName in ipairs(ESP_MAP_NAMES) do
		local mapModel = Workspace:FindFirstChild(mapName)
		if mapModel then
			espFindGunDropsInModel(mapModel)
		end
	end
end

function espUpdatePlayer(plr)
	if plr == player then return end
	local character = plr.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	-- Esp Roles gate: hidden roles clean up their own visuals on the next tick
	local class = espGetRoleClass(plr)
	local show = (class == "murderer" and espMurdererEnabled)
		or (class == "sheriff" and espSheriffEnabled)
		or (class == "innocent" and espInnocentEnabled)
		or (class == "dead" and espDeadEnabled)
	if not show then
		espCleanCharacter(character)
		espSkeletonClearPlayer(plr)
		return
	end
	local color = espGetRoleColor(plr)
	local roleSuffix = espGetRoleName(plr)
	local dist = espGetDist(character)
	-- Esp Parts: Outlines (Highlight)
	-- [perf] colors are only written when they actually change.
	if espOutlinesEnabled and espPartRoleEnabled("outlines", class) then
		local hl = espGetOrMakeHighlight(character)
		if hl.OutlineColor ~= color then hl.OutlineColor = color end
		if hl.FillColor ~= color then hl.FillColor = color end
	else
		local old = character:FindFirstChild(ESP_HL_TAG)
		if old then old:Destroy() end
	end
	-- Esp Parts: Skeleton (Drawing lines, updated every frame in espSkeletonTick)
	if not espSkeletonEnabled then
		espSkeletonClearPlayer(plr)
	end
	-- Esp Parts: Names + Distance + Health (billboard)
	-- [perf] label text/colors are only written when they actually change.
	local nameLabel, distLabel = espGetOrMakeBillboard(character)
	if nameLabel then
		if nameLabel.TextColor3 ~= color then nameLabel.TextColor3 = color end
		-- Build extra tags for Exploiter/Teamer/Scammer ESP labels
		local extraTags = ""
		if espLabelExploitersEnabled and markedExploiters and markedExploiters[plr.Name] then
			extraTags = extraTags .. " [EXPLOITER]"
		end
		if espLabelTeamersEnabled and markedTeamers and markedTeamers[plr.Name] then
			extraTags = extraTags .. " [TEAMER]"
		end
		if espLabelScammersEnabled and markedScammers and markedScammers[plr.Name] then
			extraTags = extraTags .. " [SCAMMER]"
		end
		local newNameText = ""
		if espNamesEnabled then
			newNameText = plr.Name .. roleSuffix .. extraTags
		end
		if nameLabel.Text ~= newNameText then nameLabel.Text = newNameText end
	end
	if distLabel then
		if distLabel.TextColor3 ~= color then distLabel.TextColor3 = color end
		local showDist = espDistanceEnabled and dist ~= nil
		local showHp = espHealthEnabled and espPartRoleEnabled("health", class)
		local hpTxt = ""
		if showHp then
			local hum = character:FindFirstChildOfClass("Humanoid")
			hpTxt = tostring(hum and math.max(0, math.floor(hum.Health + 0.5)) or 0) .. "HP"
		end
		local newDistText = ""
		if showDist and showHp then
			newDistText = "[" .. tostring(dist) .. "m, " .. hpTxt .. "]"
		elseif showDist then
			newDistText = "[" .. tostring(dist) .. "m]"
		elseif showHp then
			newDistText = "[" .. hpTxt .. "]"
		end
		if distLabel.Text ~= newDistText then distLabel.Text = newDistText end
	end
end

function espCleanCharacter(character)
	if not character then return end
	local oldHl = character:FindFirstChild(ESP_HL_TAG)
	if oldHl then oldHl:Destroy() end
	local owner = Players:GetPlayerFromCharacter(character)
	if owner then espSkeletonClearPlayer(owner) end
	local head = character:FindFirstChild("Head")
	if head then
		local oldBb = head:FindFirstChild(ESP_BB_TAG)
		if oldBb then oldBb:Destroy() end
	end
end

_espFrameCounter = 0
RunService.Heartbeat:Connect(function()
	_espFrameCounter = _espFrameCounter + 1
end)

function espHookCharacter(plr, character)
	character:WaitForChild("HumanoidRootPart", 10)
	-- [perf] stagger players across 10 frames (~6 updates/sec each at 60fps) instead
	-- of 3 — role colors / name tags don't need 20 updates per second, and with a
	-- full lobby this cuts ESP CPU cost by ~70%
	local myOffset = math.random(0, 9)
	local conn = RunService.Heartbeat:Connect(function()
		if not espEnabled then return end
		if not character.Parent then return end
		if _espFrameCounter % 10 ~= myOffset then return end
		espUpdatePlayer(plr)
	end)
	local prev = espTrackedData[plr]
	if prev then
		if prev.conn then prev.conn:Disconnect() end
		espCleanCharacter(prev.character)
	end
	espTrackedData[plr] = { conn = conn, character = character }
	character.AncestryChanged:Connect(function(_, parent)
		if not parent and espTrackedData[plr] and espTrackedData[plr].character == character then
			conn:Disconnect()
		end
	end)
end

function espHookPlayer(plr)
	if plr == player then return end
	if plr.Character then task.spawn(espHookCharacter, plr, plr.Character) end
	local charAddedConn = plr.CharacterAdded:Connect(function(character)
		task.spawn(espHookCharacter, plr, character)
	end)
	table.insert(espConnections, charAddedConn)
end

function espCleanAll()
	for plr, data in pairs(espTrackedData) do
		if data.conn then data.conn:Disconnect() end
		espCleanCharacter(data.character)
	end
	espTrackedData = {}
	for gunDrop, data in pairs(espTrackedGuns) do
		if data.conn then data.conn:Disconnect() end
		espCleanGun(gunDrop)
	end
	espTrackedGuns = {}
	for trap, data in pairs(espTrackedTraps) do
		if data.conn then data.conn:Disconnect() end
		espCleanTrap(trap)
	end
	espTrackedTraps = {}
	for _, conn in ipairs(espConnections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then
			conn:Disconnect()
		end
	end
	espConnections = {}
	espRoles = nil
end

function espEnableAll()
	-- Hook players
	for _, plr in ipairs(Players:GetPlayers()) do
		task.spawn(espHookPlayer, plr)
	end
	table.insert(espConnections, Players.PlayerAdded:Connect(function(plr)
		espHookPlayer(plr)
	end))
	table.insert(espConnections, Players.PlayerRemoving:Connect(function(plr)
		local data = espTrackedData[plr]
		if not data then return end
		if data.conn then data.conn:Disconnect() end
		espCleanCharacter(data.character)
		espTrackedData[plr] = nil
	end))

	-- Roles loop
	task.spawn(function()
		while espEnabled do
			local ok, result = pcall(function()
				return invokePlayerData()
			end)
			if ok and result then
				espRoles = result
				espCurrentHero = nil
				for name, v in pairs(result) do
					if v.Role == "Hero" and v.HasGun then
						espCurrentHero = name
					end
				end
			end
			task.wait(0.75)
		end
	end)

	-- Gun ESP: scan existing maps
	espScanForMaps()

	-- Trap ESP: scan for traps
	espScanForTraps()

	-- Gun ESP: watch for new maps
	table.insert(espConnections, Workspace.ChildAdded:Connect(function(child)
		if not (espEnabled and espGunEnabled) then return end
		for _, mapName in ipairs(ESP_MAP_NAMES) do
			if child.Name == mapName then
				task.wait(0.5)
				espFindGunDropsInModel(child)
				break
			end
		end
	end))

	-- Gun ESP: watch for GunDrop anywhere inside map hierarchy
	table.insert(espConnections, Workspace.DescendantAdded:Connect(function(descendant)
		if not (espEnabled and espGunEnabled) then return end
		if descendant.Name == "GunDrop" then
			local parent = descendant.Parent
			while parent and parent ~= Workspace do
				for _, mapName in ipairs(ESP_MAP_NAMES) do
					if parent.Name == mapName then
						task.spawn(espHookGunDrop, descendant)
						return
					end
				end
				parent = parent.Parent
			end
		end
	end))
end

function toggleEsp()
	espEnabled = not espEnabled
	if espEnabled then
		espEnableAll()
	else
		espCleanAll()
	end
end


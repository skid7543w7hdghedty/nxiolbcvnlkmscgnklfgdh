	end
	function glitchHasGun()
		local c = player.Character
		local bp = player:FindFirstChild("Backpack")
		return c and (c:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))) and true or false
	end
	function glitchFindMurderer()
		local ok, data = pcall(function() return invokePlayerData() end)
		if ok and type(data) == "table" then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player then
					local info = data[plr.Name]
					if info and info.Role == "Murderer" then return plr end
				end
			end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local bp = plr:FindFirstChild("Backpack")
				if bp and bp:FindFirstChild("Knife") then return plr end
				if plr.Character and plr.Character:FindFirstChild("Knife") then return plr end
			end
		end
		return nil
	end
	function glitchFindSheriff()
		local phys = nil
		pcall(function() phys = findCurrentGunHolderPlayer() end)
		if phys then return phys end
		local ok, data = pcall(function() return invokePlayerData() end)
		if ok and type(data) == "table" then
			local heroAlive, gunAlive, sheriffAlive = nil, nil, nil
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and not isPlayerWhitelisted(plr.Name) then
					local c = plr.Character
					local h = c and c:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then
						local d = data[plr.Name]
						if d then
							if d.Role == "Hero" and d.HasGun then heroAlive = heroAlive or plr end
							if d.HasGun and d.Role ~= "Murderer" then gunAlive = gunAlive or plr end
							if d.Role == "Sheriff" then sheriffAlive = sheriffAlive or plr end
						end
					end
				end
			end
			return heroAlive or gunAlive or sheriffAlive
		end
		return nil
	end
	function glitchMurdererAlive(m)
		if not m then return false end
		local c = m.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		return h ~= nil and h.Health > 0
	end
	function doGlitchServer()
		if glitchRunning then notify("Glitch", "Already running", 2) return end
		glitchRunning = true
		pcall(function()
			-- Remember the last safe spot before any fling and keep watching for
			-- falls (sheriff dying under the map) for the whole run.
			pcall(glitchRememberSafePoint)
			pcall(glitchStartFallGuard)
			-- 1) AutoGrab Gun ON if it was off (leave untouched if already on).
			-- Remember whether WE switched it on so it can be restored before the
			-- kick instead of staying enabled after the rejoin.
			glitchAutoGrabGunTurnedOn = false
			if not autoGrabGunEnabled then
				toggleAutoGrabGun()
				glitchAutoGrabGunTurnedOn = (autoGrabGunEnabled == true)
				setToggleState(btn.autoGrabGun, autoGrabGunEnabled, "AutoGrab Gun: ON", "AutoGrab Gun: OFF")
				setExtractedBtnState("AutoGrab Gun", autoGrabGunEnabled)
			end
			notify("Glitch", "Hunting Sheriff (retries until roles drop)...", 2)
			-- 2-3) Reset Sheriff until the gun lands on us. Roles may not exist yet
			-- when pressed pre-round, so this never stops after one attempt — it
			-- keeps retrying until the timeout (flings supersede each other safely).
			local t0 = os.clock()
			while not glitchHasGun() and os.clock() - t0 < (glitchGunTimeout or 10) do
				local c = player.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if not (h and h.Health > 0) then notify("Glitch", "Died waiting for gun", 2) return end
				if glitchFindSheriff() then
					pcall(executeNanFlingByRole, "Sheriff")
				end
				task.wait(1)
			end
			if not glitchHasGun() then notify("Glitch", "No gun — abort", 2) return end
			-- 4) find the murderer (roles can appear late pre-round: poll briefly)
			local m = glitchFindMurderer()
			local t1 = os.clock()
			while not m and os.clock() - t1 < (glitchFindTimeout or 10) do task.wait(0.5) m = glitchFindMurderer() end
			if not m then notify("Glitch", "No murderer found", 2) return end
			notify("Glitch", "Shooting " .. m.Name .. " until dead...", 2)
			-- 5) shoot until the murderer is dead (at least one confirmed kill of ours)
			local fired = 0
			local t2 = os.clock()
			while glitchMurdererAlive(m) and os.clock() - t2 < (glitchShootTimeout or 10) do
				local c = player.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if not (h and h.Health > 0) then notify("Glitch", "Died while shooting", 2) return end
				if not glitchHasGun() then notify("Glitch", "Lost the gun", 2) return end
				-- Honor the Silent Aim mode selected in Combat (Default /
				-- Intercept / both Accurate flows) instead of always forcing the
				-- predicted original shot.
				local ok, shot = pcall(aimAutoShootDispatch, m)
				if ok and shot then fired += 1 end
				-- Accurate modes shoot asynchronously; wait for the study-and-
				-- fire flow before judging whether the murderer survived.
				local waitStart = os.clock()
				while aimAccurateBusy and os.clock() - waitStart < 2.6 do task.wait() end
				task.wait((AIM_CONFIG and AIM_CONFIG.autoShotCooldown) or 0.1)
			end
			if glitchMurdererAlive(m) or fired == 0 then
				notify("Glitch", "Murderer survived — abort", 2)
				return
			end
			-- 6) kick now; Rejoin on Kick (armed below) catches the kick screen and
			-- rejoins the EXACT same server after Rejoin Delay. Code after :Kick()
			-- here would never run on its own — the hook above is what brings us back.
			-- Before kicking, put AutoGrab Gun back the way the user had it: if the
			-- script switched it ON for this run it goes OFF (and the saved config
			-- already says OFF, so the rejoin does not restore it); if the user had
			-- it ON themselves it is left untouched. Speed is not affected.
			pcall(glitchRestoreAutoGrabGun)
			notify("Glitch", "Murderer down — kicking...", 3)
			glitchRejoinSameServer = true
			glitchRejoinJobId = game.JobId
			if not rejoinOnKickEnabled then
				rejoinOnKickEnabled = true
				if rejoinOnKickBtn then setToggleState(rejoinOnKickBtn, true, "Rejoin on Kick: ON", "Rejoin on Kick: OFF") end
				pcall(saveConfig)
			end
			pcall(function() player:Kick("Glitching...") end)
		end)
		glitchRunning = false
		-- Aborted runs (no gun / murderer survived) also give AutoGrab Gun back.
		pcall(glitchRestoreAutoGrabGun)
	end

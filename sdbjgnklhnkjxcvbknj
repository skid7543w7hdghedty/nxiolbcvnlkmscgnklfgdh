function refreshConfigDropdown()
	for _, child in ipairs(configDropdownFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local files = getConfigFiles()
	configDropdownFrame.Size = UDim2.new(0, 164, 0, #files * 30)
	for i, name in ipairs(files) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 30)
		btn.Position = UDim2.new(0, 0, 0, (i-1)*30)
		btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Text = name
		btn.Font = Enum.Font.SourceSansBold
		btn.TextSize = 14
		btn.AutoButtonColor = false
		btn.ZIndex = 10
		btn.Parent = configDropdownFrame
		styleSeparatorBtn(btn)
		btn.MouseButton1Click:Connect(function()
			-- Selecting only highlights the choice; loading happens
			-- exclusively via the "Load Config" button below.
			configListSelect.Text = name .. " ▼"
			configDropdownFrame.Visible = false
		end)
		btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60) end)
		btn.MouseLeave:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0) end)
	end
end

configListSelect.MouseButton1Click:Connect(function()
	refreshConfigDropdown()
	configDropdownFrame.Visible = not configDropdownFrame.Visible

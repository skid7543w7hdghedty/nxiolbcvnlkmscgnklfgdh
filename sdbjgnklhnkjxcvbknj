-- Touch Fling auto-hold for Reset (so it never fights Shoot Murderer aim):
-- one-shots hold it only for the fling, Auto-* holds it while enabled.
-- Reference-counted: nested/overlapping resets can't leak it ON, and a manually
-- enabled Touch Fling is left untouched afterwards.
resetFlingHolds = 0
resetFlingWasOn = nil
function resetTouchFlingOn()
	resetFlingHolds += 1
	if resetFlingHolds > 1 then return end
	resetFlingWasOn = hiddenfling
	if hiddenfling then return end
	hiddenfling = true
	setToggleState(touchFlingButton, true, "Touch Fling: ON", "Touch Fling: OFF")
	setExtractedBtnState("Touch Fling", true)
	if not flingThread or coroutine.status(flingThread) == "dead" then
		flingThread = coroutine.create(fling)
		coroutine.resume(flingThread)
	end
end
function resetTouchFlingOff()
	if resetFlingHolds <= 0 then return end
	resetFlingHolds -= 1
	if resetFlingHolds > 0 then return end
	local wasOn = resetFlingWasOn
	resetFlingWasOn = nil
	if wasOn or not hiddenfling then return end
	hiddenfling = false
	setToggleState(touchFlingButton, false, "Touch Fling: ON", "Touch Fling: OFF")
	setExtractedBtnState("Touch Fling", false)
end

-- ============================================================
-- Shared "return home" for EVERY Reset action (Reset Player, Reset Selected,
-- Reset Everyone, Reset Sheriff/Hero, Reset Murderer, Auto Reset Player and
-- Auto Reset Everyone).
-- The old restore teleported for 15 plain frames and then gave up. If the
-- physics snapshot was still being written by Touch Fling, if the humanoid was
-- ragdolled, or if the character was standing inside the victim, those 15
-- frames could be overwritten before the client accepted the position and you
-- stayed where the victim was. This is the Glitch-tab fall guard: keep placing
-- the body until it actually sticks (with a hard time cap), always clear
-- velocities and leave the humanoid in a standing state.
-- Returns true when we are back within a few studs of the target.
-- ============================================================
function resetReturnHome(targetCFrame, savedPlatformStand)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and hum and hrp) then return false end
	local dest = targetCFrame or CFrame.new(hrp.Position)
	local safeY = (workspace.FallenPartsDestroyHeight or -500) + 50
	if dest.Position.Y < safeY then
		dest = CFrame.new(dest.Position.X, safeY, dest.Position.Z)
	end
	pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", hrp) end)
	-- Standing physics during the return: PlatformStand keeps the body ragdolled
	-- and lets the victim's contact impulses keep pushing it away.
	pcall(function() hum.PlatformStand = false end)
	local myToken = nanFlingCallCounter
	local returned = false
	for _ = 1, 40 do
		-- A reset started while we were walking home: that reset owns the
		-- character now (and performs its own return), so stop fighting it.
		if nanFlingCallCounter ~= myToken then break end
		char = player.Character
		hum = char and char:FindFirstChildOfClass("Humanoid")
		hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (char and hum and hrp) then break end
		if hum.Health <= 0 then break end -- died: respawn owns the position now
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
		pcall(function()
			hrp.CFrame = dest
			char:SetPrimaryPartCFrame(dest)
		end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		task.wait(0.05)
		if (hrp.Position - dest.Position).Magnitude < 4 then
			returned = true
			break
		end
	end
	char = player.Character
	hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function() hum.PlatformStand = savedPlatformStand and true or false end)
		if hum.Health > 0 then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
	end
	return returned
end

nanFlingTargetName = ""

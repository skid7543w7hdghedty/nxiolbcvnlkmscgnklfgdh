-- Auto Remove Coins
-- TWO MODES (picker below the toggle):
--   Full    - destroys the map's CoinContainer itself (old behaviour). The
--             container is gone, so coins do NOT respawn until the next round.
--   Default - destroys each individual coin INSIDE the container the instant it
--             appears. Removal is instant and cheap (no repeated full-workspace
--             scans), and because the container survives, turning the feature
--             OFF mid-round lets the coins respawn normally.
autoDeleteCoinsEnabled = false
autoDeleteCoinsConnections = {}
autoDeleteCoinsMode = (loadedConfig and loadedConfig.toggles and loadedConfig.toggles.autoDeleteCoinsMode) or "Default"
if autoDeleteCoinsMode ~= "Full" then autoDeleteCoinsMode = "Default" end
autoDeleteCoinContainers = {}

autoDeleteCoinsTargets = mapNameSet()

function isInsideTargetModel(instance)
	-- [allmaps] Coins used to be removed only inside a hardcoded map whitelist,
	-- which broke on every newer MM2 map. CoinContainer only ever spawns as map
	-- content, so: any non-player Model ancestor counts as "inside a map", and
	-- so does a Folder/Workspace chain (some newer maps nest the container in
	-- Folders instead of a Model). Player characters are explicitly excluded so
	-- nothing belonging to a player is ever destroyed.
	local current = instance.Parent
	while current and current ~= Workspace and current ~= game do
		if current:IsA("Model") then
			-- Skip player characters
			local plr = Players:GetPlayerFromCharacter(current)
			if plr then return false, nil end
			return true, current.Name
		end
		current = current.Parent
	end
	return true, "Map"
end

function tryRemoveCoin(instance)
	if instance and instance.Parent and instance.Name == "CoinContainer" then
		local isInside, modelName = isInsideTargetModel(instance)
		if isInside then
			instance:Destroy()
			return true
		end
	end
	return false
end

-- Default mode: remove every coin INSTANCE (never the container).
function autoDeleteCoinsClearContainer(container)
	if not container or not container.Parent then return end
	for _, child in ipairs(container:GetChildren()) do
		pcall(function() child:Destroy() end)
	end
end

function autoDeleteCoinsRefreshContainers()
	local alive = {}
	for _, c in ipairs(autoDeleteCoinContainers) do
		if c and c.Parent then table.insert(alive, c) end
	end
	autoDeleteCoinContainers = alive
	if #autoDeleteCoinContainers == 0 then
		-- [perf] FindFirstChild(..., true) is a RECURSIVE search over the whole
		-- Workspace. The Default sweep runs every 0.15 s and hit this branch
		-- whenever no container existed yet (between rounds), i.e. 6-7 full map
		-- searches per second. New containers are registered by the
		-- DescendantAdded hook anyway, so the fallback only needs to run now and
		-- then (throttled to once every 2 s).
		local now = os.clock()
		if (now - (autoDeleteCoinsFindAt or 0)) < 2 then return end
		autoDeleteCoinsFindAt = now
		local ok, found = pcall(function() return Workspace:FindFirstChild("CoinContainer", true) end)
		if ok and found then table.insert(autoDeleteCoinContainers, found) end
	end
end

function autoDeleteCoinsSweepDefault()
	autoDeleteCoinsRefreshContainers()
	for _, container in ipairs(autoDeleteCoinContainers) do
		autoDeleteCoinsClearContainer(container)
	end
end

function fullCoinScan()
	-- [perf] Chunked walk (300 nodes per frame) instead of one
	-- Workspace:GetDescendants() call. In "Full" mode this runs every 8 s, and
	-- rebuilding the whole map's descendant table in a single frame was a
	-- periodic hitch. Everything except BaseParts is descended into, so the
	-- walk stays short but cannot miss a CoinContainer wherever it lives.
	task.spawn(function()
		local stack = { Workspace }
		local budget = 0
		while autoDeleteCoinsEnabled and #stack > 0 do
			local obj = table.remove(stack)
			if obj.Name == "CoinContainer" then
				if autoDeleteCoinsMode == "Default" then
					autoDeleteCoinsClearContainer(obj)
				else
					tryRemoveCoin(obj)
				end
			end
			if not obj:IsA("BasePart") then
				local kids = obj:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
			end
			budget = budget + 1
			if budget >= 300 then
				budget = 0
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

function enableAutoDeleteCoins()
	autoDeleteCoinsEnabled = true
	autoDeleteCoinContainers = {}

	fullCoinScan()

	local descConn = Workspace.DescendantAdded:Connect(function(instance)
		if not autoDeleteCoinsEnabled then return end
		if autoDeleteCoinsMode == "Default" then
			-- INSTANT per-coin removal: coins are direct children of the
			-- container, so kill them on the spot (no defer -> no visible frame).
			local par = instance.Parent
			if par and par.Name == "CoinContainer" then
				pcall(function() instance:Destroy() end)
				return
			end
			if instance.Name == "CoinContainer" then
				table.insert(autoDeleteCoinContainers, instance)
				-- The container is usually populated in the same frame: clear it
				-- once more after the map script has filled it.
				task.defer(function()
					if autoDeleteCoinsEnabled and autoDeleteCoinsMode == "Default" then
						autoDeleteCoinsClearContainer(instance)
					end
				end)
			end
			return
		end
		task.defer(function()
			if not autoDeleteCoinsEnabled or autoDeleteCoinsMode ~= "Full" then return end
			if instance and instance.Parent then
				if instance.Name == "CoinContainer" then
					tryRemoveCoin(instance)
				end
				if instance:IsA("Model") then
				-- [allmaps] any non-character model can be a map root with coins.
				-- Player characters never hold CoinContainers, so skip them.
				if Players:GetPlayerFromCharacter(instance) == nil then
					task.wait(0.1)
					if instance and instance.Parent and autoDeleteCoinsEnabled then
						for _, child in ipairs(instance:GetDescendants()) do
							if child.Name == "CoinContainer" then
								tryRemoveCoin(child)
							end
						end
					end
				end
			end
			end
		end)
	end)
	table.insert(autoDeleteCoinsConnections, descConn)

	task.spawn(function()
		while autoDeleteCoinsEnabled do
			task.wait(autoDeleteCoinsMode == "Default" and 0.15 or 8)
			if autoDeleteCoinsEnabled then
				if autoDeleteCoinsMode == "Default" then
					autoDeleteCoinsSweepDefault()
				else
					fullCoinScan()
				end
			end
		end
	end)
end

function disableAutoDeleteCoins()
	autoDeleteCoinsEnabled = false
	for _, conn in ipairs(autoDeleteCoinsConnections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	autoDeleteCoinsConnections = {}
end

function toggleAutoDeleteCoins()
	if autoDeleteCoinsEnabled then
		disableAutoDeleteCoins()
	else
		enableAutoDeleteCoins()
	end
end

function autoDeleteCoinsModeLabel()

	-- strip, which is what made dragging feel broken. The panel is kept fully
	-- on screen and the drop point is saved as a fraction of the viewport.
	local dragging, dragStart = false, nil
	local dragCenter = Vector2.new(0, 0)
	local uis = game:GetService("UserInputService")
	local function votePanelViewport()
		local cam = workspace.CurrentCamera
		return (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
	end
	local function votePanelPlace(cx, cy)
		local vs = votePanelViewport()
		local size = frame.AbsoluteSize
		local margin = 4
		local halfW = math.min(size.X / 2, vs.X / 2)
		local halfH = math.min(size.Y / 2, vs.Y / 2)
		cx = math.clamp(cx, halfW + margin, math.max(halfW + margin, vs.X - halfW - margin))
		cy = math.clamp(cy, halfH + margin, math.max(halfH + margin, vs.Y - halfH - margin))
		frame.Position = UDim2.new(cx / math.max(1, vs.X), 0, cy / math.max(1, vs.Y), 0)
	end
	header.InputBegan:Connect(function(input)
		if voteNotifLocked then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		dragStart = input.Position
		dragCenter = Vector2.new(
			frame.AbsolutePosition.X + frame.AbsoluteSize.X / 2,
			frame.AbsolutePosition.Y + frame.AbsoluteSize.Y / 2)
	end)
	uis.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local delta = input.Position - dragStart
		votePanelPlace(dragCenter.X + delta.X, dragCenter.Y + delta.Y)
	end)
	uis.InputEnded:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = false
		voteMapNotifStorePosition()
	end)

	-- The panel can also change size behind our back (UIScale, Roblox's own
	-- interface scale, a viewport change): re-run the layout on the real size.
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if voteMapNotifLayoutQueued then return end
		voteMapNotifLayoutQueued = true
		task.defer(function()
			voteMapNotifLayoutQueued = false
			if voteMapNotifFrame and voteMapNotifFrame.Parent then
				voteMapNotifApplyLayout()
			end
		end)
	end)

	voteMapNotifApplyLayout()
end

-- Paint the three tiles from what the pads show right now.
function voteMapNotifRefresh(snap)
	if not voteMapNotifGui or not voteMapNotifGui.Parent then return end
	snap = snap or voteMapSnapshot()
	local open = (#snap == 3) and voteMapRoundName(snap) == nil
	local byIndex, bySlot = {}, {}
	local bestRank = nil
	for _, m in ipairs(snap) do
		byIndex[m.index] = m
		bySlot[m.slot or m.index] = m
		local rank = voteMapPriorityRank(m.name)
		if rank and (bestRank == nil or rank < bestRank) then bestRank = rank end
	end
	-- Drop optimistic counters whose pad switched to another map.
	for i = 1, 3 do
		local st = voteMapNotifLocal[i]
		if st then
			local m = byIndex[i]
			if not m or (st.name ~= "" and voteMapNorm(st.name) ~= voteMapNorm(m.name)) then
				voteMapNotifLocal[i] = nil
			end
		end
	end
	local activePad = (voteDupeActive and voteDupeCurrentMap) or 0

	-- Tiles are indexed by SLOT: tile 1 is the left pad on screen, whatever
	-- VotePadN that happens to be.
	for slot = 1, 3 do
		local tile = voteMapNotifTiles[slot]
		if tile then
			local m = bySlot[slot]
			local key = m and (voteMapKey(m.name) or voteMapNorm(m.name)) or nil
			local iconId = key and voteMapIconIds[key]
			local hasImage = iconId ~= nil and iconId ~= ""

			if m then
				tile.mapName = voteMapLabel(m.name)
				tile.name.Text = tile.mapName
				if hasImage then
					if tile.img.Image ~= iconId then tile.img.Image = iconId end
					tile.img.Visible = true
					tile.tint.BackgroundTransparency = 1
					tile.mono.Visible = false
				else
					tile.img.Visible = false
					tile.tint.BackgroundTransparency = 0
					tile.tint.BackgroundColor3 = voteMapTileColor(key or m.name)
					tile.mono.Visible = true
					tile.mono.Text = voteMapMonogram(m.name)
				end
			else
				tile.mapName = nil
				tile.name.Text = "-"
				tile.img.Visible = false
				tile.mono.Visible = true
				tile.mono.Text = ""
				tile.tint.BackgroundTransparency = 1
			end

			local voting = (m ~= nil and activePad == m.index) and open
			if m then
				local shown = voteMapNotifVotesFor(m.index, m.votes, m.name)
				tile.votes.Visible = true
				tile.votes.Text = tostring(shown)
				if voting then
					-- White text on a slightly raised dark pill (the old badge was
					-- mint with dark text).
					tile.votes.BackgroundColor3 = Color3.fromRGB(44, 46, 50)
					tile.votes.BackgroundTransparency = 0
					tile.votes.TextColor3 = voteMapPanelText
				elseif open then
					tile.votes.BackgroundColor3 = Color3.fromRGB(10, 11, 13)
					tile.votes.BackgroundTransparency = 0.35
					tile.votes.TextColor3 = voteMapPanelText
				else
					tile.votes.BackgroundColor3 = Color3.fromRGB(10, 11, 13)
					tile.votes.BackgroundTransparency = 0.55
					tile.votes.TextColor3 = voteMapPanelMuted
				end
			else
				tile.votes.Visible = false
			end

			if voting then
				tile.stroke.Color = voteMapPanelAccent
				tile.stroke.Transparency = 0
				tile.stroke.Thickness = 2
			elseif open then
				tile.stroke.Color = Color3.fromRGB(255, 255, 255)
				tile.stroke.Transparency = (tile.hover and 0.45) or 0.88
				tile.stroke.Thickness = 1
			else
				tile.stroke.Color = Color3.fromRGB(255, 255, 255)
				tile.stroke.Transparency = 0.94
				tile.stroke.Thickness = 1
			end

			tile.dot.Visible = open and m ~= nil and voteMapPriorityRank(m.name) == bestRank
			tile.name.TextColor3 = (open and voteMapPanelText) or voteMapPanelMuted
			if tile.img.Visible then
				tile.img.ImageTransparency = open and 0 or 0.5
			end
			tile.mono.TextTransparency = open and 0.25 or 0.55
		end
	end

	if voteMapNotifStatus then
		local roundName = voteMapRoundName(snap)
		if voteMapNotifPreviewing then
			voteMapNotifStatus.Text = "PREVIEW"
			voteMapNotifStatus.TextColor3 = Color3.fromRGB(255, 200, 90)
		elseif open and activePad ~= 0 then
			voteMapNotifStatus.Text = "TAP AGAIN TO CANCEL"
			voteMapNotifStatus.TextColor3 = voteMapPanelAccent
		elseif open then
			voteMapNotifStatus.Text = "TAP A MAP TO VOTE"
			voteMapNotifStatus.TextColor3 = voteMapPanelMuted
		elseif roundName then
			-- The round name changed every round and only added noise.
			voteMapNotifStatus.Text = "WAITING"
			voteMapNotifStatus.TextColor3 = voteMapPanelMuted
		else
			voteMapNotifStatus.Text = "WAITING"
			voteMapNotifStatus.TextColor3 = voteMapPanelMuted
		end
	end
end

function voteMapNotifShow(snap)
	voteMapNotifEnsure()
	voteMapNotifHideToken = voteMapNotifHideToken + 1
	voteMapNotifOpen = true
	-- Fresh window: start every count from the pads again, otherwise a map that
	-- comes up twice in a session would reopen with last round's optimistic count.
	voteMapNotifLocal = {}
	voteMapNotifRefresh(snap)
	if voteMapNotifGui then
		voteMapNotifGui.Enabled = true
	end
	if voteMapNotifScale then
		voteMapNotifScale.Scale = 0.94
		pcall(function()
			TweenService:Create(voteMapNotifScale,
				TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Scale = 1}):Play()
		end)
	end
end

function voteMapNotifHide()
	voteMapNotifHideToken = voteMapNotifHideToken + 1
	voteMapNotifOpen = false
	if voteMapNotifGui then
		voteMapNotifGui.Enabled = false
	end
end

-- Click a tile: vote on that pad's own surface (never a fixed position).
-- Clicking the map that is being voted right now cancels it again.
function voteMapNotifPick(slot)
	if voteMapNotifPreviewing then
		notify("Vote Map", "Preview only - voting opens when the pads switch maps.", 2)
		return
	end
	local padIndex = votePadForSlot(slot)
	local tile = voteMapNotifTiles[slot]
	if voteDupeActive and voteDupeCurrentMap == padIndex then
		voteDupeStop()
		voteMapNotifRefresh()
		notify("Vote Map", "Stopped voting" .. (tile and tile.mapName and (" for " .. tile.mapName) or "") .. ".", 2)
		return
	end
	local snap = voteMapSnapshot()
	local target
	if #snap == 3 and voteMapRoundName(snap) == nil then
		for _, m in ipairs(snap) do
			if m.index == padIndex then
				target = m
				break
			end
		end
	end
	if not target then
		notify("Vote Map", "Voting is closed - a round is running.", 2)
		return
	end
	if voteDupeActive then
		voteDupeStop()
		task.wait(0.15)
	end
	notify("Vote Map", "Voting for " .. voteMapLabel(target.name) .. " (map " .. slot .. ").", 3)
	voteDupeStart(padIndex)
	voteMapNotifRefresh()
end

-- Settings preview: shows the panel with sample data for 10 s so position and
-- size can be tuned without waiting for a vote.
function voteMapNotifPreview()
	voteMapNotifPreviewing = true
	local snap = {}
	for i = 1, math.min(3, #voteMapRegistry) do
		local e = voteMapRegistry[i]
		snap[#snap + 1] = { index = i, slot = i, name = e.key, votes = (4 - i) * 2 }
	end
	voteMapNotifShow(snap)
	notify("Vote Map", "Vote panel preview (10 s). Drag the header to move it.", 3)
	local token = voteMapNotifHideToken
	task.delay(10, function()
		voteMapNotifPreviewing = false
		if token == voteMapNotifHideToken then
			voteMapNotifHide()
		end
	end)
end

-- ============================================
-- Map priority list (reorderable)
-- ============================================
function voteMapPriorityMove(index, dir)
	local list = voteMapPriority
	local j = index + dir
	if not list[index] or j < 1 or j > #list then return end
	list[index], list[j] = list[j], list[index]
	voteMapPriorityRebuild()
	saveConfig()
end

function voteMapPriorityRebuild()
	local holder = voteMapPriorityList
	if not holder then return end
	for _, c in ipairs(holder:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local rowH = 26
	holder.Size = UDim2.new(1, 0, 0, #voteMapPriority * rowH + 4)
	for i, key in ipairs(voteMapPriority) do
		local row = Instance.new("Frame")
		row.Name = "Priority" .. i
		row.Size = UDim2.new(1, 0, 0, rowH - 2)
		row.Position = UDim2.new(0, 0, 0, (i - 1) * rowH)
		row.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		row.BackgroundTransparency = 0.35
		row.BorderSizePixel = 0
		row.Parent = holder
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

		local num = Instance.new("TextLabel")
		num.Size = UDim2.new(0, 24, 1, 0)
		num.BackgroundTransparency = 1
		num.Text = tostring(i)
		num.TextColor3 = Color3.fromRGB(120, 120, 120)
		num.Font = Enum.Font.GothamBold
		num.TextSize = 12
		num.Parent = row

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(1, -84, 1, 0)
		nameLbl.Position = UDim2.new(0, 26, 0, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = voteMapLabel(key)
		nameLbl.TextColor3 = btnTextColor or Color3.fromRGB(255, 255, 255)
		nameLbl.Font = Enum.Font.SourceSansBold
		nameLbl.TextSize = 13
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.Parent = row

		local function arrow(symbol, dx, dir)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0, 26, 1, -4)
			b.Position = UDim2.new(1, dx, 0, 2)
			b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			b.Text = symbol
			b.TextColor3 = Color3.fromRGB(255, 255, 255)
			b.Font = Enum.Font.GothamBold
			b.TextSize = 12
			b.AutoButtonColor = false
			b.Parent = row
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
			b.MouseButton1Click:Connect(function()
				voteMapPriorityMove(i, dir)
			end)
		end
		arrow("^", -56, -1)
		arrow("v", -28, 1)
	end
end


-- When true, image/sound paths are treated as FULL local device paths (e.g.
-- C:\Users\...\Adrenalin.win\file.jpg / file.mp3) instead of workspace-relative
-- paths. Configurable from the Settings tab.
useDevicePaths = false

-- Returns candidate asset path forms to try when resolving an asset. In default
-- (relative) mode only the given path is tried. In device-path mode, an absolute
-- Windows path (C:\...) is used as-is and ALSO tried as a workspace-relative path
-- (the part starting at the CONFIG_FOLDER) — covering executors that require
-- workspace-relative arguments for getcustomasset/syn.asset.
function assetPathCandidates(path)
	if not path or path == "" then return {} end
	local c = { path }
	if useDevicePaths and path:match("^[A-Za-z]:[\\/]") then
		local idx = path:find(CONFIG_FOLDER, 1, true)
		if idx and idx > 1 then
			local rel = path:sub(idx)
			if rel ~= path then table.insert(c, rel) end
		end
	end
	return c
end

_folderReady = false
function ensureFolder()
	-- Same folder set every time: creating them on every save cost 18 pcall
	-- round-trips per write (dozens during startup).
	if _folderReady then return end
	-- Do not latch the flag when the executor has no filesystem API yet: the
	-- folders must still be created by the next call.
	if type(makefolder) ~= "function" then return end
	_folderReady = true
	pcall(function() makefolder(CONFIG_FOLDER) end)
	pcall(function() makefolder(MAIN_DIR) end)
	pcall(function() makefolder(SOUNDS_DIR) end)
	pcall(function() makefolder(CLICK_SOUNDS_DIR) end)
	pcall(function() makefolder(WIN_SOUNDS_DIR) end)
	pcall(function() makefolder(STARTUP_SOUND_DIR) end)
	pcall(function() makefolder(SHERIFF_DIE_SOUND_DIR) end)
	pcall(function() makefolder(MURDERER_DIE_SOUND_DIR) end)
	pcall(function() makefolder(TEAMERS_SOUND_DIR) end)
	pcall(function() makefolder(EXPLOITERS_SOUND_DIR) end)
	pcall(function() makefolder(SCAMMERS_SOUND_DIR) end)
	pcall(function() makefolder(MARK_SOUND_DIR) end)
	pcall(function() makefolder(UNMARK_SOUND_DIR) end)
	pcall(function() makefolder(ROUND_START_SOUND_DIR) end)
	pcall(function() makefolder(VOTE_START_SOUND_DIR) end)
	pcall(function() makefolder(ICONS_DIR) end)
	if TAB_ICON_FOLDERS then
		for _, tabName in ipairs(TAB_ICON_FOLDERS) do
			pcall(function() makefolder(ICONS_DIR .. "/" .. tabIconFolder(tabName)) end)
		end
	end
	if TOP_ICON_FOLDERS then
		for _, topName in ipairs(TOP_ICON_FOLDERS) do
			pcall(function() makefolder(ICONS_DIR .. "/" .. topName) end)
		end
	end
end


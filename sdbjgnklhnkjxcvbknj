bindInputConn = UserInputService.InputBegan:Connect(function(input, gp)
	if listeningForEmotionBind and listeningEmotionTextBox and listeningEmotionId then
		local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1 or
			input.UserInputType == Enum.UserInputType.MouseButton2 or
			input.UserInputType == Enum.UserInputType.MouseButton3
		if isMouse and tick() - lastUIInteract < 0.3 then return end
		local bindKey
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			bindKey = input.KeyCode
		elseif isMouse then
			bindKey = input.UserInputType
		else
			return
		end
		-- Remove old bind for this emotion if exists
		local oldKey = emotionKeyBinds[listeningEmotionId]
		if oldKey and keyBinds[oldKey] then
			keyBinds[oldKey] = nil
		end
		emotionKeyBinds[listeningEmotionId] = bindKey
		local animId = listeningEmotionId
		-- Emote tab: one-time Dance.lua principle, Emotions: toggle walkable.
		-- Emote-ness is checked lazily at press time (see emotionIsEmote) so the
		-- bind keeps working even if the emote lists change later.
		local isEmote = false
		if emoteOrder then for _, e in ipairs(emoteOrder) do if e.id == animId then isEmote = true; break end end end
		keyBinds[bindKey] = {
			callback = function()
				if emotionIsEmote(animId) then
					local char2 = player.Character
					local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
					if hum2 and hum2.RigType == Enum.HumanoidRigType.R15 then
						local desc = hum2:FindFirstChildOfClass("HumanoidDescription")
						local ok = pcall(function() hum2:PlayEmoteAndGetAnimTrackById(animId) end)
						if not ok and desc then
							local nm = (emoteUiById[animId] and emoteUiById[animId].Name) or ("Emote "..tostring(animId))
							pcall(function() desc:AddEmote(nm, animId) end)
							pcall(function() hum2:PlayEmoteAndGetAnimTrackById(animId) end)
						end
					end
				else
					if playingAnimationId == animId then
						stopCurrentAnimation()
					else
						playAnimation(animId, "1")
					end
				end
			end,
			description = (isEmote and "Emote: " or "Emotion: ") .. tostring(animId),
		}
		listeningEmotionTextBox.Text = bindKeyToName(bindKey)
		justBoundKey = bindKey
		listeningForEmotionBind = false
		listeningEmotionTextBox = nil
		listeningEmotionId = nil
		saveConfig()
		return
	end
	if listeningForBind and listeningTextBox and listeningFeatureName then
		local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1 or
			input.UserInputType == Enum.UserInputType.MouseButton2 or
			input.UserInputType == Enum.UserInputType.MouseButton3
		if isMouse and tick() - lastUIInteract < 0.3 then return end
		local bindKey
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			bindKey = input.KeyCode
		elseif isMouse then
			bindKey = input.UserInputType
		else
			return
		end
		local oldKey = featureBinds[listeningFeatureName]
		if oldKey and keyBinds[oldKey] then
			keyBinds[oldKey] = nil
		end
		featureBinds[listeningFeatureName] = bindKey
		for _, feat in ipairs(bindableFeatures) do
			if feat.name == listeningFeatureName then
				keyBinds[bindKey] = {callback = feat.callback, description = feat.name}
				break
			end
		end
		listeningTextBox.Text = bindKeyToName(bindKey)
		justBoundKey = bindKey
		listeningForBind = false
		listeningTextBox = nil
		listeningFeatureName = nil
		saveConfig()
	end
end)


function voteMapNorm(s)
	return (tostring(s or ""):lower():gsub("[^%w]", ""))
end

-- Registry key for any spelling of a map name ("Mil Base" / "milbase" /
-- "MilBase"), or nil when the name is not a map.
function voteMapKey(name)
	if name == nil or name == "" then return nil end
	local n = voteMapNorm(name)
	if n == "" then return nil end
	for _, e in ipairs(voteMapRegistry) do
		if voteMapNorm(e.key) == n or voteMapNorm(e.label) == n then
			return e.key
		end
	end
	-- Loose match: "Hospital" finds "Hospital3", "BioLab" finds "Bio Lab".
	local hit, hits = nil, 0
	for _, e in ipairs(voteMapRegistry) do
		local kn, ln = voteMapNorm(e.key), voteMapNorm(e.label)
		if #n >= 4 and (kn:find(n, 1, true) or n:find(kn, 1, true) or ln:find(n, 1, true) or n:find(ln, 1, true)) then
			hit, hits = e.key, hits + 1
		end
	end
	if hits == 1 then return hit end
	return nil
end

-- "Mil Base" for MilBase, the raw string for anything unknown.
function voteMapLabel(name)
	local key = voteMapKey(name)
	if key then
		for _, e in ipairs(voteMapRegistry) do
			if e.key == key then return e.label end
		end
	end
	return tostring(name or "")
end

-- Two-letter monogram used on the map tiles: "Mil Base" -> "MB", "House 2" -> "H2".
function voteMapMonogram(name)
	local label = voteMapLabel(name)
	local out = ""
	for word in label:gmatch("%a+") do
		out = out .. word:sub(1, 1):upper()
		if #out >= 2 then break end
	end
	local digit = label:match("(%d)%s*$")
	if digit and #out < 3 then out = out .. digit end
	if out == "" then out = label:sub(1, 2):upper() end
	return out
end

-- Stable colour per map so a tile is recognisable at a glance.
function voteMapTileColor(name)
	local n = voteMapNorm(name)
	local h = 0
	for i = 1, #n do
		h = (h * 31 + n:byte(i)) % 360
	end
	return Color3.fromHSV(h / 360, 0.55, 0.85)
end

-- Accepts the old comma/> separated text and returns registry keys.
function voteMapParsePriority(text)
	local list, seen = {}, {}
	for part in string.gmatch(tostring(text or ""), "[^,;>]+") do
		part = part:match("^%s*(.-)%s*$")
		if part ~= "" then
			local key = voteMapKey(part) or part
			if not seen[key] then
				seen[key] = true
				list[#list + 1] = key
			end
		end
	end
	return list
end

-- Fills in maps the saved list did not mention, keeping the saved order.
function voteMapPriorityComplete(list)
	local out, seen = {}, {}
	for _, p in ipairs(list or {}) do
		local key = voteMapKey(p) or p
		if not seen[key] then
			seen[key] = true
			out[#out + 1] = key
		end
	end
	for _, e in ipairs(voteMapRegistry) do
		if not seen[e.key] then
			seen[e.key] = true
			out[#out + 1] = e.key
		end
	end
	return out
end

function voteMapPriorityText()
	local out = {}
	for _, key in ipairs(voteMapPriority or {}) do
		out[#out + 1] = voteMapLabel(key)
	end
	return table.concat(out, " > ")
end

-- ============================================
-- [perf] Shared GetPlayerData remote + role-data cache
-- ============================================
-- The script previously had 13 separate places doing
-- ReplicatedStorage:FindFirstChild("GetPlayerData", true) — a RECURSIVE scan of all
-- of ReplicatedStorage — and 6+ independent loops each calling :InvokeServer()
-- every 0.5-1s. On mobile those recursive scans + parallel remote invocations were
-- a major source of freezes. Now the remote is resolved once and cached, and all
-- periodic pollers share ONE InvokeServer result (refreshed at most every 0.35s).
_playerDataRemote = nil
function getPlayerDataRemote()
	if _playerDataRemote and _playerDataRemote.Parent then
		return _playerDataRemote
	end
	_playerDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
	return _playerDataRemote
end

_roleDataCache = nil
_roleDataCacheAt = 0
_roleDataInFlight = false
function invokePlayerData()
	local now = os.clock()
	if _roleDataCache and (now - _roleDataCacheAt) <= 0.35 then
		return _roleDataCache
	end
	if _roleDataInFlight then
		-- Another loop is already fetching; reuse the last known data instead of
		-- stacking a second server invocation.
		return _roleDataCache
	end
	_roleDataInFlight = true
	local ok, result = pcall(function()
		local remote = getPlayerDataRemote()
		return remote and remote:InvokeServer()
	end)
	_roleDataInFlight = false
	if ok and type(result) == "table" then
		_roleDataCache = result
		_roleDataCacheAt = os.clock()
	end
	return _roleDataCache
end

-- Murderer check with caching
cachedIsMurderer = false
lastMurdererCheck = 0

function isPlayerMurderer()
	if tick() - lastMurdererCheck > 1.0 then
		lastMurdererCheck = tick()
		local ok, result = pcall(function()
			return invokePlayerData()
		end)
		if ok and result then
			for name, data in pairs(result) do
				if name == player.Name then
					cachedIsMurderer = (data.Role == "Murderer")
					return cachedIsMurderer
				end
			end
		end
		cachedIsMurderer = false
	end
	return cachedIsMurderer
end


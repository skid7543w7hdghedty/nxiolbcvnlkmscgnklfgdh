-- [clicksound] Universal click-sound hooking. The old system only connected
-- buttons inside mainGui (via DescendantAdded), so buttons living in other
-- ScreenGuis this script creates (extracted popup buttons, confirm/input
-- dialogs, color pickers, config rows built before the hook ran, R/X picker
-- buttons, etc.) stayed silent. hookClickSound is attribute-guarded so a
-- button can never get the sound connected twice (no double-play on buttons
-- that already had an explicit sound connection).
CLICK_SOUND_HOOK_ATTR = "ClickSoundHooked"

-- Fallback marker for executors where Instance attributes silently fail:
-- weak keys, so destroyed buttons never keep the table alive.
clickSoundHookedFallback = setmetatable({}, {__mode = "k"})

function hookClickSound(btn)
	if not btn or not btn:IsA("GuiButton") then return end
	local hooked = false
	pcall(function() hooked = btn:GetAttribute(CLICK_SOUND_HOOK_ATTR) == true end)
	if hooked then return end
	if clickSoundHookedFallback[btn] then return end
	clickSoundHookedFallback[btn] = true
	pcall(function() btn:SetAttribute(CLICK_SOUND_HOOK_ATTR, true) end)
	pcall(function()
		btn.MouseButton1Click:Connect(function() playClickSoundThrottled() end)
	end)
end

-- ScreenGuis this script owns (checked by name so dynamically created guis
-- like confirm dialogs and popup windows are covered too).
function isAdrenalinSoundGui(root)
	if not root or not root:IsA("ScreenGui") then return false end
	local nm = tostring(root.Name or "")
	if nm:sub(1, 9) == "Adrenalin" then return true end
	return nm == "GameNotifGui" or nm == "InstantRoleGui" or nm == "RoundTimerGui"
		or nm == "ArrowTargetGui" or nm == "ExploiterPopupGui" or nm == "TeamerPopupGui"
end

function refreshAllClickSoundHooks()
	pcall(function()
		for _, d in ipairs(playerGui:GetDescendants()) do
			if d:IsA("GuiButton") then
				local hooked = false
				pcall(function() hooked = d:GetAttribute(CLICK_SOUND_HOOK_ATTR) == true end)
				if not hooked and isAdrenalinSoundGui(d:FindFirstAncestorWhichIsA("ScreenGui")) then
					hookClickSound(d)
				end
			end
		end
	end)
end

-- [perf] Event-driven instead of a 2 s sweep over ALL PlayerGui descendants:
-- the initial pass covers what already exists, DescendantAdded covers anything
-- created later (popups, confirm dialogs, dynamically built lists).
clickSoundHooksConn = nil
pcall(refreshAllClickSoundHooks)
task.defer(function()
	pcall(refreshAllClickSoundHooks)
	if clickSoundHooksConn then return end
	clickSoundHooksConn = playerGui.DescendantAdded:Connect(function(d)
		if not d:IsA("GuiButton") then return end
		pcall(function()
			local hooked = d:GetAttribute(CLICK_SOUND_HOOK_ATTR) == true
			if not hooked and isAdrenalinSoundGui(d:FindFirstAncestorWhichIsA("ScreenGui")) then
				hookClickSound(d)
			end
		end)
	end)
end)

-- [clicksound] Global safety net: whatever button the player actually clicks,
-- inside any ScreenGui this script owns, produces the click sound even if the
-- button never got a hook (built before the system, cloned, or its click
-- handler swallows the event). Hit-testing is used instead of trusting
-- gameProcessedEvent, because that flag is TRUE for GUI clicks.
-- InputEnded (not InputBegan) is used so this fires in the same instant as
-- GuiButton.MouseButton1Click / InputEnded handlers; otherwise a slow press
-- played once on press and once more on release (double sound).
clickSoundGlobalConn = nil
pcall(function()
	if clickSoundGlobalConn then clickSoundGlobalConn:Disconnect() end
	clickSoundGlobalConn = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		pcall(function()
			local pos = input.Position
			local objs = playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
			if not objs then return end
			for _, obj in ipairs(objs) do
				local btn = obj
				-- Climb to the owning button: labels/icons inside a button are
				-- returned first, and they can be nested a few levels deep.
				while btn and not btn:IsA("GuiButton") do
					btn = btn.Parent
				end
				if btn and btn:IsA("GuiButton") and btn.Active ~= false
					and isAdrenalinSoundGui(btn:FindFirstAncestorWhichIsA("ScreenGui")) then
					playClickSoundThrottled()
					return
				end
			end
		end)
	end)
end)


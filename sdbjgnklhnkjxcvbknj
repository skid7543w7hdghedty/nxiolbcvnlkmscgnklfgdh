function updateExploiterStatus()
	if not exploiterStatusLabel then return end
	local count = 0
	for _ in pairs(selectedExploiterTargets) do count += 1 end
	exploiterStatusLabel.Text = count == 0 and "Select players to mark as exploiters" or (count .. " player(s) selected")
	exploiterStatusLabel.TextColor3 = count == 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 80, 80)
end

-- Coalesce rapid successive refresh triggers (join/leave bursts) into one rebuild.
-- Mark/unmark clicks still refresh synchronously; only background events debounce.
exploiterListRefreshPending = false
function requestExploiterListRefresh()
	if exploiterListRefreshPending then return end
	exploiterListRefreshPending = true
	task.delay(0.5, function()
		exploiterListRefreshPending = false
		refreshExploiterList()
	end)
end
function refreshExploiterList()
	if not exploiterScrollFrame then return end
	if refreshSavedExploiters then refreshSavedExploiters() end
	if refreshOnlineExploiters then refreshOnlineExploiters() end
	for _, child in ipairs(exploiterScrollFrame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	exploiterCheckboxes = {}

	local playerList = Players:GetPlayers()
	table.sort(playerList, function(a, b)
		local aMarked = markedExploiters[a.Name] == true
		local bMarked = markedExploiters[b.Name] == true
		if aMarked ~= bMarked then return aMarked end
		return a.Name:lower() < b.Name:lower()
	end)

	local yPosition = 0
	for _, plr in ipairs(playerList) do
		if plr ~= player then
			local isMarked = markedExploiters[plr.Name] == true

			local rowData
			rowData = createAvatarSelectorRow(exploiterScrollFrame, plr, {
				nameSuffix = "ExploiterEntry",
				selected = selectedExploiterTargets[plr.Name] ~= nil,
				prefix = isMarked and "[!] " or "",
				accent = Color3.fromRGB(255, 80, 80),
				baseBg = isMarked and Color3.fromRGB(40, 10, 10) or Color3.fromRGB(0, 0, 0),
				selectedBg = Color3.fromRGB(84, 20, 20),
				baseTextColor = isMarked and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(255, 255, 255),
				onClick = function()
					if selectedExploiterTargets[plr.Name] then
						selectedExploiterTargets[plr.Name] = nil
						rowData.SetSelected(false)
					else
						selectedExploiterTargets[plr.Name] = plr
						rowData.SetSelected(true)
					end
					updateExploiterStatus()
				end,
			})
			rowData.Entry.Position = UDim2.new(0, 0, 0, yPosition)

			exploiterCheckboxes[plr.Name] = {
				Entry = rowData.Entry,
				Checkmark = rowData.Checkmark,
				NameLabel = rowData.NameLabel,
				SetSelected = rowData.SetSelected,
			}

			yPosition += 65
		end
	end

	exploiterScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPosition)
	updateExploiterStatus()
	if exploiterSearchBox then
		local searchText = string.lower(exploiterSearchBox.Text)
		for _, data in pairs(exploiterCheckboxes) do
			if data.Entry and data.NameLabel then
				local playerName = data.NameLabel.Text:gsub("^%[!%] ", "")
				data.Entry.Visible = searchText == "" or string.find(string.lower(playerName), searchText, 1, true) ~= nil
			end
		end
	end
end

function toggleAllExploiterPlayers(selectAll)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local checkboxData = exploiterCheckboxes[plr.Name]
			if checkboxData then
				if selectAll then
					selectedExploiterTargets[plr.Name] = plr
					if checkboxData.SetSelected then checkboxData.SetSelected(true) else checkboxData.Checkmark.Visible = true end
				else
					selectedExploiterTargets[plr.Name] = nil
					if checkboxData.SetSelected then checkboxData.SetSelected(false) else checkboxData.Checkmark.Visible = false end
				end
			end
		end
	end
	updateExploiterStatus()
end

function showPlayerInfoPopup(plr)
	if not plr then return end
	if exploiterPopupCache and exploiterPopupCache[plr.Name] and exploiterPopupCache[plr.Name].Parent then
		-- Second click fully closes (destroy): a merely hidden popup would keep
		-- its 0.15s live-stats loop running forever -> periodic freezes stacking up.
		local oldPopup = exploiterPopupCache[plr.Name]
		exploiterPopupCache[plr.Name] = nil
		oldPopup:Destroy()
		return
	end
	if not exploiterPopupCache then exploiterPopupCache = {} end


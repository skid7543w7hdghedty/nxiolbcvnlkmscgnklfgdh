-- Attaches a keyboard icon to an emotion bind button, shown instead of the
-- default glyph when unbound. Self-maintaining via the Text signal: any later
-- Text set (bind / unbind / restore) re-syncs automatically.
function attachBindKeyIcon(bindBtn)
	if not bindBtn or bindBtn:FindFirstChild("BindKeyIcon") then return end
	local icon = Instance.new("ImageLabel")
	icon.Name = "BindKeyIcon"
	icon.Size = UDim2.new(0, 18, 0, 18)
	icon.Position = UDim2.new(0.5, -9, 0.5, -9)
	icon.BackgroundTransparency = 1
	icon.BorderSizePixel = 0
	icon.Visible = false
	icon.Parent = bindBtn
	pcall(function()
		local asset = nil
		if topIconAsset then asset = topIconAsset("Keyboard") end
		if asset and asset ~= "" then icon.Image = asset end
	end)
	local function syncBindKeyIcon()
		if bindBtn.Text == KB_GLYPH and icon.Image ~= "" then
			bindBtn.Text = ""
			icon.Visible = true
		elseif bindBtn.Text ~= "" then
			icon.Visible = false
		end
	end
	bindBtn:GetPropertyChangedSignal("Text"):Connect(syncBindKeyIcon)
	syncBindKeyIcon()
end


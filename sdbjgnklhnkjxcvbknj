-- Anti-Jump
antiJumpEnabled = false
antiJumpConn = nil

-- ============================================================
-- Predictive pursuit (Trolling ride functions / Reset / Fling).
-- Two facts made the old "snap to the visible position" approach fail:
--   1) remote characters are replicated a bit in the past, and
--   2) a big one-shot CFrame jump is reconciled by the server.
-- So everything below aims at an INTERCEPT point and closes the gap in
-- capped steps:
--   aim = victimPos + victimVel * (base lead + ping/2 + time to close)
-- A standing victim still resolves to their exact spot (velocity is ignored).
-- ============================================================
RSTP_LEAD = RSTP_LEAD or 0.15
RSTP_MIN_SPEED = RSTP_MIN_SPEED or 3
RSTP_MAX_SPEED = RSTP_MAX_SPEED or 140
RSTP_CLOSE_SPEED = RSTP_CLOSE_SPEED or 160
RSTP_MAX_LEAD = RSTP_MAX_LEAD or 0.55
RSTP_MAX_STEP = RSTP_MAX_STEP or 12

-- Victim velocity. AssemblyLinearVelocity is the smoothed value the server
-- simulates; finite differences of a replicated position are jittery and used
-- to under-estimate fast movers. Y is kept: a jumping/falling victim really
-- does move vertically.
function trollTargetVelocity(tr)
	if not tr then return Vector3.zero end
	local v = tr.AssemblyLinearVelocity
	if not v then v = tr.Velocity end
	if not v then return Vector3.zero end
	if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then return Vector3.zero end
	if v.Magnitude > RSTP_MAX_SPEED then v = v.Unit * RSTP_MAX_SPEED end
	return v
end

-- Half the round trip: how far behind the replicated victim position we are.
function trollPingLead()
	local ping = 0
	pcall(function()
		ping = tonumber(player:GetNetworkPing()) or 0
	end)
	return math.clamp(ping * 0.5, 0, 0.25)
end

-- Intercept point for a moving victim.
function trollInterceptPosition(tr, pr, extraLead)
	if not tr then return nil end
	local pos = tr.Position
	if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return nil end
	local v = trollTargetVelocity(tr)
	if v.Magnitude < RSTP_MIN_SPEED then return pos end
	local dist = 0
	if pr then dist = (pos - pr.Position).Magnitude end
	local closeT = math.clamp(dist / RSTP_CLOSE_SPEED, 0, 0.3)
	local lead = RSTP_LEAD + (extraLead or 0) + trollPingLead() + closeT
	if lead > RSTP_MAX_LEAD then lead = RSTP_MAX_LEAD end
	local aim = pos + v * lead
	-- Cap the vertical guess: a victim who just got flung must not drag the
	-- rider into the sky (or through the floor).
	local dy = aim.Y - pos.Y
	if dy > 10 then
		aim = Vector3.new(aim.X, pos.Y + 10, aim.Z)
	elseif dy < -10 then
		aim = Vector3.new(aim.X, pos.Y - 10, aim.Z)
	end
	return aim
end

-- Capped dash. Closing a large gap in small per-frame steps is accepted by the
-- server where a single huge jump gets snapped back; the difference is only a
-- few frames.
function trollStepTowards(pr, destPos, maxStep)
	if not (pr and destPos) then return nil end
	local cur = pr.Position
	local delta = destPos - cur
	if delta.X ~= delta.X or delta.Y ~= delta.Y or delta.Z ~= delta.Z then return nil end
	local dist = delta.Magnitude
	local cap = maxStep or RSTP_MAX_STEP
	if cap and cap > 0 and dist > cap then delta = delta.Unit * cap end
	return cur + delta
end

-- Reset press prediction.
-- AssemblyLinearVelocity alone is not enough for the reset: on a running victim
-- it frequently reads a fraction of the real speed (replication smoothing, a
-- frame right after a footstep, a small hop), so the aim fell BEHIND the victim
-- and the body landed on empty floor. These helpers keep a short position
-- history per victim and aim slightly AHEAD of the real motion, which is what
-- makes contact reliable on people who are walking.
resetVelHist = resetVelHist or setmetatable({}, {__mode = "k"})
function resetVelRecord(tr)
	if not tr then return end
	local pos = tr.Position
	if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return end
	local now = tick()
	local rec = resetVelHist[tr]
	if not rec then
		rec = {samples = {}}
		resetVelHist[tr] = rec
	end
	local s = rec.samples
	s[#s + 1] = {p = pos, t = now}
	while #s > 10 or (#s >= 2 and (now - s[1].t) > 0.24) do
		table.remove(s, 1)
	end
end

-- Velocity from the recorded positions, or nil when there is not enough fresh
-- history to trust it.
function resetHistVelocity(tr)
	local rec = tr and resetVelHist[tr]
	local s = rec and rec.samples
	if not s or #s < 2 then return nil end
	local now = tick()
	local a, b = s[1], s[#s]
	if (now - b.t) > 0.2 then return nil end
	local dt = b.t - a.t
	if dt < 0.03 then return nil end
	local v = (b.p - a.p) / dt
	if v.Magnitude > (RSTP_MAX_SPEED or 140) then
		v = v.Unit * (RSTP_MAX_SPEED or 140)
	end
	return v
end

-- Best guess at the victim's actual velocity: the instance value and the
-- history value averaged when both are usable, the larger one otherwise.
function resetAimVelocity(tr)
	local v = trollTargetVelocity(tr)
	local hv = resetHistVelocity(tr)
	if not hv then return v end
	if v.Magnitude < (RSTP_MIN_SPEED or 3) then return hv end
	if hv.Magnitude < (RSTP_MIN_SPEED or 3) then return v end
	local mixed = (v + hv) * 0.5
	if mixed.Magnitude < RSTP_MIN_SPEED then
		return (v.Magnitude >= hv.Magnitude) and v or hv
	end
	return mixed
end

-- Where to put the body so it meets the victim: a little ahead of their current
-- motion, at their own height, with the same lead components the rest of the
-- pursuit uses (ping, distance, an extra caller lead).
function resetPressAim(tr, pr, extraLead)
	if not tr then return nil end
	local pos = tr.Position
	if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return nil end
	local v = resetAimVelocity(tr)
	local dist = 0
	if pr then dist = (pos - pr.Position).Magnitude end
	local closeT = math.clamp(dist / (RSTP_CLOSE_SPEED or 160), 0, 0.28)
	-- Slightly longer than the generic lead: touching from ahead is what kills,
	-- touching from behind only pushes.
	local lead = 0.18 + (extraLead or 0) + trollPingLead() + closeT
	if lead > (RSTP_MAX_LEAD or 0.55) then lead = RSTP_MAX_LEAD or 0.55 end
	local aim = pos
	if v.Magnitude >= (RSTP_MIN_SPEED or 3) then
		aim = pos + v * lead
	end
	-- Vertical: follow a jump only partly, so a flung victim does not drag us
	-- into the sky (the contact offset is added on top by the caller).
	local dy = math.clamp(v.Y * lead, -4, 4)
	return Vector3.new(aim.X, pos.Y + dy, aim.Z)
end

-- Trolling ride: constant teleport onto the victim every Heartbeat, keeping each
-- function's own offset. This is the behaviour from the older build, which glued
-- the rider to the target far better than the "close the gap in capped steps"
-- pursuit that replaced it: with capped steps the rider trails a few studs behind
-- a moving victim (and floats when the victim is fast), while a direct CFrame
-- write each frame keeps the offset exactly.
-- A short position history is kept per target so the ride leads a walker slightly
-- instead of aiming at a stale replicated position.
trollHist = trollHist or setmetatable({}, {__mode = "k"})
function trollRideTarget(pr, tr, offsetCF)
	if not (pr and tr) then return end
	local tp = tr.Position
	if tp.X ~= tp.X or tp.Y ~= tp.Y or tp.Z ~= tp.Z then return end
	local rec = trollHist[tr]
	local now = tick()
	if not rec then rec = {samples = {}} trollHist[tr] = rec end
	local s = rec.samples
	s[#s + 1] = {p = tp, t = now}
	while #s > 20 or (#s >= 2 and (now - s[1].t) > 0.25) do table.remove(s, 1) end
	local dest = tp
	if #s >= 2 then
		local a = s[1]
		local b = s[#s]
		local dt = b.t - a.t
		if dt > 0.02 then
			local v = (b.p - a.p) / dt
			if v.Magnitude > 60 then v = v.Unit * 60 end
			if v.Magnitude >= (RSTP_MIN_SPEED or 3) then dest = b.p + v * (RSTP_LEAD or 0.15) end
		end
	end
	local rot = tr.CFrame - tr.CFrame.Position
	pr.CFrame = CFrame.new(dest) * rot * (offsetCF or CFrame.new())
end


headlessOriginals = setmetatable({}, {__mode = "k"})

-- Remember the original Head appearance so Headless can be undone on the
-- current character without waiting for a respawn.
function captureHeadlessOriginals(char)
	if not char then return nil end
	local cached = headlessOriginals[char]
	if cached then return cached end
	-- All-Hats may already have snapshotted the real Head appearance; reuse it
	-- instead of capturing an already-hidden Head.
	local shared = headlessAllHatsOriginals and headlessAllHatsOriginals[char]
	if shared then
		local copy = {MeshId = shared.MeshId, TextureID = shared.TextureID, Transparency = shared.Transparency}
		headlessOriginals[char] = copy
		return copy
	end
	local head = char:FindFirstChild("Head")
	if not head then return nil end
	-- R6 heads are plain Parts and have no MeshId/TextureID; read them under
	-- pcall so snapshotting can never break the toggle.
	local mesh, tex
	pcall(function() mesh = head.MeshId end)
	pcall(function() tex = head.TextureID end)
	local originals = {
		MeshId = mesh,
		TextureID = tex,
		Transparency = head.Transparency
	}
	headlessOriginals[char] = originals
	return originals
end

-- Restore the Head ITSELF. The old code wrote the captured Transparency back,
-- and on spawn / while the Changer is applying the avatar the Head is briefly
-- invisible (Transparency = 1). Restoring that value kept the Head permanently
-- headless even though the accessories came back. Geometry is restored only
-- from a REAL mesh (never the headless asset / an empty not-yet-streamed id),
-- and visibility is always forced back on (semi-transparent while the
-- Invisibility feature is active).
function headlessRestoreHeadPart(head, originals)
	if not head then return end
	pcall(function()
		local mesh = originals and originals.MeshId
		local tex = originals and originals.TextureID
		if mesh and mesh ~= "" and not tostring(mesh):find("6686307858", 1, true) then
			head.MeshId = mesh
		end
		if tex and tex ~= "" and not tostring(tex):find("6686307858", 1, true) then
			head.TextureID = tex
		end
		head.Transparency = invis_on and 0.5 or 0
		pcall(function() head.LocalTransparencyModifier = 0 end)
	end)
end

-- Wait briefly for the avatar's real Head mesh to stream in before snapshotting
-- it. An empty MeshId snapshot restores as "nothing", which also leaves the
-- Head invisible after Headless is turned off.
function headlessWaitForHeadMesh(head, timeout)
	if not head then return end
	local t = 0
	local limit = timeout or 1.0
	-- R6 heads are plain Parts (no MeshId property), so a direct read would
	-- error. Guarded helper: a non-MeshPart head counts as "ready".
	local function meshReady()
		local ok, value = pcall(function() return head.MeshId end)
		if not ok then return true end
		return value ~= nil and value ~= ""
	end
	while (not meshReady()) and t < limit do
		task.wait(0.05)
		t = t + 0.05
	end
end

function restoreHeadless(char)
	if not char then return end
	local originals = headlessOriginals[char]
	headlessOriginals[char] = nil
	local function apply()
		local head = char:FindFirstChild("Head")
		if not head then return false end
		headlessRestoreHeadPart(head, originals)
		return true
	end
	if not apply() then
		-- The Head can stream in a moment after the toggle is turned off.
		task.spawn(function()
			for _ = 1, 20 do
				RunService.Heartbeat:Wait()
				if not char.Parent then return end
				if apply() then return end
			end
		end)
	end
	-- Spawn scripts / Changer can re-hide the Head right after we restore it;
	-- re-assert visibility shortly afterwards (unless the other Headless toggle
	-- is still keeping it hidden).
	task.delay(0.4, function()
		if headlessEnabled or headlessAllHatsEnabled then return end
		if player.Character ~= char then return end
		apply()
	end)
end

function applyHeadless(char)
	if not char then return end
	-- [headlessfix] retry: a single WaitForChild could silently miss the Head
	-- on slow spawns and then never apply at all
	for _ = 1, 4 do
		local head = char:FindFirstChild("Head")
		if head then
			headlessWaitForHeadMesh(head, 1.0)
			captureHeadlessOriginals(char)
			-- Transparency first: on an R6 Part the MeshId write errors, and a
			-- combined statement would then leave the head visible.
			pcall(function() head.Transparency = 1 end)
			pcall(function()
				head.MeshId = "http://www.roblox.com/asset/?id=6686307858"
				head.TextureID = "http://www.roblox.com/asset/?id=6686307858"
			end)
			return
		end
		char:WaitForChild("Head", 2)
	end
end

function enableHeadless()
	headlessEnabled = true
	if player.Character then task.spawn(applyHeadless, player.Character) end
	headlessConn = player.CharacterAdded:Connect(applyHeadless)
end

function disableHeadless()
	headlessEnabled = false
	if headlessConn then headlessConn:Disconnect() headlessConn = nil end
	if headlessAllHatsEnabled then
		-- All-Hats shares the same Head override; keep the head hidden until
		-- that separate toggle is turned off too. The plain snapshot is kept so
		-- it can still be used as a fallback if the All-Hats one is missing.
		local char = player.Character
		local head = char and char:FindFirstChild("Head")
		if head then
			pcall(function() head.Transparency = 1 end)
			pcall(function()
				head.MeshId = "http://www.roblox.com/asset/?id=6686307858"
				head.TextureID = "http://www.roblox.com/asset/?id=6686307858"
			end)
		end
	else
		restoreHeadless(player.Character)
	end
end


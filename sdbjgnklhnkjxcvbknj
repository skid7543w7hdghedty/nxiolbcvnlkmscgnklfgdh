-- Monitor player death -> wait (configurable delay) -> Touch Fling ON -> Reset
-- Murderer N times (configurable count, Touch Fling stays ON throughout) ->
-- Touch Fling OFF. The delay starts AT DEATH (the old version waited for a
-- respawn first, and its blocking repeat-loops silently hung — that's why the
-- feature "stopped working"). Death is also detected when the
-- character/humanoid is REMOVED (common in MM2), which the old
-- `hum and hum.Health <= 0` check missed entirely. Resetting the murderer
-- MULTIPLE times + keeping Touch Fling ON between attempts makes the reset
-- reliable instead of firing a single fling that can miss.
autofarmResetDeathBusy = false
task.spawn(function()
	local wasAlive = false
	while task.wait(0.2) do
		if autofarmResetDeathEnabled and autofarmEnabled then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local isAlive = (hum ~= nil) and hum.Health > 0
			if wasAlive and not isAlive and not autofarmResetDeathBusy then
				-- We just died — run the sequence in its own thread so the
				-- detector keeps polling and NEVER misses the next death.
				autofarmResetDeathBusy = true
				task.spawn(function()
					-- 1) Wait the configurable delay after death
					task.wait(autofarmResetDeathDelay)
					-- Make sure we have a live character to fling with (wait up to
					-- 10 extra seconds for the respawn if it hasn't happened yet)
					local t0 = os.clock()
					while os.clock() - t0 < 10 do
						local c = player.Character
						local h = c and c:FindFirstChildOfClass("Humanoid")
						if c and h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") then break end
						task.wait(0.2)
					end
				-- 2) Touch Fling ON — only spawn a fling thread if none is
				-- already running (a live suspended coroutine resumes itself
				-- on every Heartbeat:Wait, so re-creating it would just stack
				-- dead threads and leave the actual fling half-applied).
				hiddenfling = true
				setToggleState(touchFlingButton, true, "Touch Fling: ON", "Touch Fling: OFF")
				setExtractedBtnState("Touch Fling", true)
				if not flingThread or coroutine.status(flingThread) == "dead" then
					flingThread = coroutine.create(fling)
					coroutine.resume(flingThread)
				end
				-- 3) Reset Murderer N times with a gap between attempts;
				-- (Touch Fling stays ON for the whole sequence.)
				local attempts = math.clamp(autofarmResetDeathCount, 1, 5)
				for i = 1, attempts do
					pcall(executeNanFlingByRole, "Murderer")
					if i < attempts then task.wait(autofarmResetDeathGap) end
				end
				-- 4) Touch Fling OFF
				task.wait(1.5)
				hiddenfling = false
				setToggleState(touchFlingButton, false, "Touch Fling: ON", "Touch Fling: OFF")
				setExtractedBtnState("Touch Fling", false)
				autofarmResetDeathBusy = false
				end)
			end
			wasAlive = isAlive
		else
			wasAlive = false
		end
	end
end)


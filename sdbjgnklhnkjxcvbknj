-- ==========================================================================
-- Server block: Location = the SERVER'S COUNTRY (best effort).
-- The two uptime labels are LOCAL clocks:
--   * "Server Uptime"  = os.clock() - serverJoinTime (time on this server),
--   * "Script Uptime"  = os.clock() - scriptStartClock (script runtime).
-- No remote server-age fetch and no "~" estimate marker are used anymore.
-- Country is still resolved best-effort:
--   1) _G.AdrenalinServerCountry / shared.AdrenalinServerCountry override,
--   2) an executor helper (getServerCountry / getServerRegion),
--   3) RoPro getServerInfo.php?serverId=<JobId>,
--   4) client-IP geolocation (ip-api -> ipinfo -> ipapi.co).
-- ==========================================================================

SERVER_COUNTRY_NAMES = {
	AE="United Arab Emirates", AR="Argentina", AT="Austria", AU="Australia",
	BE="Belgium", BG="Bulgaria", BR="Brazil", CA="Canada", CH="Switzerland",
	CL="Chile", CO="Colombia", CZ="Czechia", DE="Germany", DK="Denmark",
	EE="Estonia", ES="Spain", FI="Finland", FR="France", GB="United Kingdom",
	GR="Greece", HK="Hong Kong", HU="Hungary", IE="Ireland", IL="Israel",
	IN="India", IT="Italy", JP="Japan", KR="South Korea", LT="Lithuania",
	LU="Luxembourg", LV="Latvia", MX="Mexico", NL="Netherlands", NO="Norway",
	NZ="New Zealand", PE="Peru", PL="Poland", PT="Portugal", RO="Romania",
	RS="Serbia", RU="Russia", SE="Sweden", SG="Singapore", SK="Slovakia",
	TR="Turkey", TW="Taiwan", UA="Ukraine", US="United States", ZA="South Africa",
}

function serverHttpGet(url)
	local requestFn = (syn and syn.request) or http_request or (_G and _G.request) or request
	if type(requestFn) == "function" then
		local ok, res = pcall(requestFn, {
			Url = url,
			Method = "GET",
			Headers = { ["Accept"] = "application/json" },
		})
		if ok and type(res) == "table" then
			local body = res.Body or res.body
			if type(body) == "string" and body ~= "" then return body end
		end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and type(body) == "string" and body ~= "" then return body end
	return nil
end

function serverHttpPost(url, body, contentType)
	local requestFn = (syn and syn.request) or http_request or (_G and _G.request) or request
	if type(requestFn) ~= "function" then return nil end
	local ok, res = pcall(requestFn, {
		Url = url,
		Method = "POST",
		Headers = {
			["Accept"] = "application/json",
			["Content-Type"] = contentType or "application/json",
		},
		Body = body or "",
	})
	if ok and type(res) == "table" then
		local b = res.Body or res.body
		if type(b) == "string" and b ~= "" then return b end
	end
	return nil
end

function serverJson(text)
	if type(text) ~= "string" or text == "" then return nil end
	local ok, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(text)
	end)
	return ok and type(data) == "table" and data or nil
end

function serverCountryName(value)
	if type(value) ~= "string" then return nil end
	value = value:gsub("^%s+", ""):gsub("%s+$", "")
	if value == "" then return nil end
	local code = value:upper()
	if #code == 2 then
		-- 2-letter tags are country codes only when known; "EU"/"NA"/"AS" style
		-- region tags are not countries and must not be shown as one.
		return SERVER_COUNTRY_NAMES[code]
	end
	return value
end

serverCountryCache = nil
function resolveServerCountry()
	if serverCountryCache then return serverCountryCache end
	local name = nil
	-- 1) Explicit override — the only 100% reliable source.
	local override = nil
	pcall(function() override = _G.AdrenalinServerCountry end)
	if not override then
		pcall(function() override = shared.AdrenalinServerCountry end)
	end
	name = serverCountryName(override)
	if name then serverCountryCache = name return name end
	-- 2) Executor helper, when the executor exposes one.
	for _, fnName in ipairs({"getServerCountry", "getservercountry", "getServerRegion", "getserverregion"}) do
		local fn = nil
		pcall(function() fn = _G[fnName] end)
		if type(fn) ~= "function" then
			pcall(function() fn = getfenv()[fnName] end)
		end
		if type(fn) == "function" then
			local ok, v = pcall(fn)
			name = ok and serverCountryName(v) or nil
			if name then serverCountryCache = name return name end
		end
	end
	-- 3) RoPro per-server record.
	local jobId = game.JobId
	if jobId and jobId ~= "" then
		local data = serverJson(serverHttpGet("https://api.ropro.io/getServerInfo.php?serverId=" .. jobId))
		if data then
			local function pick(t)
				if type(t) ~= "table" then return nil end
				for _, key in ipairs({"country", "Country", "countryName", "country_name", "regionName"}) do
					local v = serverCountryName(t[key])
					if v then return v end
				end
				return nil
			end
			name = pick(data) or pick(data.server) or pick(data.info) or pick(data.data)
			if name then serverCountryCache = name return name end
		end
	end
	-- 4) Client-IP geolocation. This is where the CLIENT exits to the internet
	--   (usually the same region as the Roblox datacenter) — a last resort.
	local ipApi = serverJson(serverHttpGet("http://ip-api.com/json/?fields=status,country,countryCode"))
	if ipApi and ipApi.status == "success" then
		name = serverCountryName(ipApi.country) or serverCountryName(ipApi.countryCode)
		if name then serverCountryCache = name return name end
	end
	local ipInfo = serverJson(serverHttpGet("https://ipinfo.io/json"))
	if ipInfo then
		name = serverCountryName(ipInfo.country)
		if name then serverCountryCache = name return name end
	end
	local ipapiCo = serverJson(serverHttpGet("https://ipapi.co/json/"))
	if ipapiCo then
		name = serverCountryName(ipapiCo.country_name) or serverCountryName(ipapiCo.country)
		if name then serverCountryCache = name return name end
	end
	return nil
end

-- Extract the server age (seconds) from any RoPro-style response. RoPro has
-- changed this endpoint several times: plain {"age":N}, {"server":{"age":N}},
-- {"data":[...]}, a bare number, or an ARRAY of records. All are handled.
function serverAgeFromBody(body)
	if type(body) ~= "string" or body == "" then return nil end
	local data = serverJson(body)
	local keys = {"age", "Age", "serverAge", "server_age", "uptime", "Uptime", "seconds", "Seconds"}

	local function pick(t)
		if type(t) ~= "table" then return nil end
		for _, k in ipairs(keys) do
			local v = tonumber(t[k])
			if v and v >= 0 then return v end
		end
		return nil
	end

	local function deep(t, depth)
		if depth > 3 or type(t) ~= "table" then return nil end
		local direct = pick(t)
		if direct then return direct end
		-- Arrays of records: use the first record that carries an age.
		if #t > 0 then
			for i = 1, math.min(#t, 4) do
				local v = pick(t[i])
				if v then return v end
			end
		end
		for _, key in ipairs({"server", "data", "info", "result", "servers"}) do
			local v = deep(t[key], depth + 1)
			if v then return v end
		end
		return nil
	end

	local age = deep(data, 0)
	if not age then
		age = tonumber(body:match("[\"']?age[\"']?%s*[:=]%s*(%d+)"))
	end
	if not age then
		age = tonumber(body:match("^%s*(%d+)%s*$"))
	end
	if not age or age < 0 then return nil end
	return age
end

-- RoPro returns the real server age in seconds. The endpoint only accepts POST
-- (GET returns 405), so POST is tried first with the shapes the extension has
-- used over time; GET stays as a legacy fallback.
function fetchServerAgeSeconds()
	local jobId = game.JobId
	if not jobId or jobId == "" then return nil end
	local url = "https://api.ropro.io/getServerAge.php"
	local placeId = tostring(game.PlaceId or "")
	local bodies = {
		game:GetService("HttpService"):JSONEncode({ serverId = jobId }),
		game:GetService("HttpService"):JSONEncode({ serverId = jobId, placeId = tonumber(placeId) }),
		"serverId=" .. jobId,
	}
	local age = nil
	for i, payload in ipairs(bodies) do
		local ct = (i == 3) and "application/x-www-form-urlencoded" or "application/json"
		local body = serverHttpPost(url, payload, ct)
		age = serverAgeFromBody(body)
		if age then return age end
	end
	age = serverAgeFromBody(serverHttpGet(url .. "?serverId=" .. jobId))
	if age then return age end
	return nil
end

-- Per-JobId first-seen timestamps. Roblox exposes no server uptime to the
-- client, but remembering WHEN we first saw a JobId turns every rejoin into a
-- real (monotonic) lower bound instead of restarting from 0. Persisted so the
-- estimate survives rejoins/re-executes.
SERVER_AGE_CACHE_PATH = MAIN_DIR .. "/server-age.json"
serverAgeCache = nil

function serverAgeCacheLoad()
	if type(serverAgeCache) == "table" then return serverAgeCache end
	serverAgeCache = {}
	pcall(function()
		if type(isfile) == "function" and isfile(SERVER_AGE_CACHE_PATH) then
			local raw = readfile(SERVER_AGE_CACHE_PATH)
			local data = serverJson(raw)
			if type(data) == "table" then
				for k, v in pairs(data) do
					local n = tonumber(v)
					if type(k) == "string" and n then serverAgeCache[k] = n end
				end
			end
		end
	end)
	return serverAgeCache
end

function serverAgeCacheSave()
	if type(serverAgeCache) ~= "table" then return end
	pcall(function()
		writefile(SERVER_AGE_CACHE_PATH, game:GetService("HttpService"):JSONEncode(serverAgeCache))
	end)
end

-- Returns the lower-bound age (seconds) derived from the first time this
-- JobId was observed. os.time() is wall clock, so it keeps counting even
-- across re-executes inside the same server.
function serverFirstSeenAge()
	local jobId = game.JobId
	if not jobId or jobId == "" then return nil end
	local cache = serverAgeCacheLoad()
	local now = os.time()
	local first = tonumber(cache[jobId])
	if not first then
		first = now
		cache[jobId] = first
		-- Keep only the 40 most recent servers so the file never grows forever.
		local keys = {}
		for k in pairs(cache) do table.insert(keys, k) end
		if #keys > 40 then
			table.sort(keys, function(a, b) return (tonumber(cache[a]) or 0) > (tonumber(cache[b]) or 0) end)
			for i = 41, #keys do cache[keys[i]] = nil end
		end
		serverAgeCacheSave()
	end
	return math.max(0, now - first)
end

-- Server country in its own task too (same reason). Cached by
-- resolveServerCountry, so a successful lookup is never repeated.
task.spawn(function()
	while serverTimeLabel and serverTimeLabel.Parent do
		local ok, country = pcall(resolveServerCountry)
		if ok and country and country ~= "" then
			if serverCountryLabel and serverCountryLabel.Parent then
				serverCountryLabel.Text = "Location: " .. country
			end
			break
		elseif serverCountryLabel and serverCountryLabel.Parent then
			serverCountryLabel.Text = "Location: N/A"
		end
		task.wait(20)
	end
end)

-- Display ticks: both labels are plain local os.clock() deltas, so they keep
-- ticking even when every remote source is unavailable.
--   * "Server Uptime" = how long this client has been on the server.
--   * "Script Uptime" = how long the script itself has been running.
-- No "~" estimate marker is used anymore.
coroutine.wrap(function()
	while serverUptimeLabel and serverUptimeLabel.Parent do
		local totalSeconds = math.max(0, math.floor(os.clock() - serverJoinTime))
		local d = math.floor(totalSeconds / 86400)
		local h = math.floor((totalSeconds % 86400) / 3600)

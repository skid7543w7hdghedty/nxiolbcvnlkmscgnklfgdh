-- ============================================================
-- Sub-tab order helpers (Settings -> Tab Positions).
-- Every owner tab with a sub-tab bar registers its buttons here once; the
-- saved order is validated against the live buttons so renamed/removed
-- sub-tabs can never break the layout.
-- ============================================================
function normalizeSubTabOrderEntry(owner, available)
	if type(subTabOrder) ~= "table" then subTabOrder = {} end
	local saved = subTabOrder[owner]
	local seen, clean = {}, {}
	if type(saved) == "table" then
		for _, name in ipairs(saved) do
			if type(name) == "string" and not seen[name] then
				seen[name] = true
				clean[#clean + 1] = name
			end
		end
	end
	local availableSet = {}
	for _, name in ipairs(available) do availableSet[name] = true end
	local result = {}
	for _, name in ipairs(clean) do
		if availableSet[name] then result[#result + 1] = name end
	end
	for _, name in ipairs(available) do
		if not seen[name] then result[#result + 1] = name end
	end
	-- Vote Dupe is pinned right after Utilities in the built-in layout; a saved
	-- order from before the sub-tab existed would otherwise put it last.
	if owner == "Utilities" then
		local pinned, rest = false, {}
		for _, name in ipairs(result) do
			if name == "Vote Dupe" then pinned = true else rest[#rest + 1] = name end
		end
		if pinned then
			local at = 1
			for i, name in ipairs(rest) do
				if name == "Utilities" then at = i + 1 break end
			end
			table.insert(rest, at, "Vote Dupe")
			result = rest
		end
	end
	subTabOrder[owner] = result
	return result
end

function applySubTabOrder(owner)
	local entry = subTabButtons[owner]
	if not entry then return end
	local order = normalizeSubTabOrderEntry(owner, entry.names)
	for index, name in ipairs(order) do
		local button = entry.buttons[name]
		if button and button.Parent then button.LayoutOrder = index end
	end
end

function registerSubTabButtons(owner, tabs)
	if not owner or type(tabs) ~= "table" or #tabs == 0 then return end
	local entry = subTabButtons[owner]
	if not entry then
		entry = { names = {}, buttons = {} }
		subTabButtons[owner] = entry
		subTabOwnerSequence[#subTabOwnerSequence + 1] = owner
	end
	for _, tab in ipairs(tabs) do
		if type(tab) == "table" and tab.name and tab.button then
			if not entry.buttons[tab.name] then entry.names[#entry.names + 1] = tab.name end
			entry.buttons[tab.name] = tab.button
		end
	end
	applySubTabOrder(owner)
end

function applyAllSubTabOrders()
	if type(subTabButtons) ~= "table" or type(subTabOwnerSequence) ~= "table" then return end
	for _, owner in ipairs(subTabOwnerSequence) do
		pcall(applySubTabOrder, owner)
	end
end

function moveSubTabOrder(owner, idx, delta)
	local entry = subTabButtons[owner]
	if not entry then return end
	local order = normalizeSubTabOrderEntry(owner, entry.names)
	local j = idx + delta
	if not order[idx] or not order[j] then return end
	order[idx], order[j] = order[j], order[idx]
	subTabOrder[owner] = order
	applySubTabOrder(owner)
	pcall(renderSubTabOrderRows)
	pcall(saveConfig)
end


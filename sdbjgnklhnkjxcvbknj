function combatStatsHasGunDrop()
	-- [perf] Recursive name lookup instead of Workspace:GetDescendants(): this
	-- runs every 0.5 s and used to allocate a table with the entire map in it.
	return Workspace:FindFirstChild("GunDrop", true) ~= nil
end

function combatStatsCheckGun()
	if not combatStatsRoundActive then
		if combatStatsGunDropped ~= "No" then
			combatStatsGunDropped = "No"
			combatStatsRefreshText()
		end
		return
	end
	local gunOnGround = combatStatsHasGunDrop()
	local newVal = gunOnGround and "Yes" or "No"
	if newVal ~= combatStatsGunDropped then
		combatStatsGunDropped = newVal
		combatStatsRefreshText()
	end
end


function setExtractedBtnState(name, state, customText)
	local data = extractedButtons[name]
	if not data or not data.popupBtn then return end
	data.state = state
	if state then
		data.popupBtn.BackgroundColor3 = extractedBtnActiveBgColor
		data.popupBtn.TextColor3 = extractedBtnActiveTextColor
		data.popupBtn.Text = customText or (name .. ": ON")
	else
		data.popupBtn.BackgroundColor3 = extractedBtnBgColor
		data.popupBtn.TextColor3 = extractedBtnTextColor
		data.popupBtn.Text = customText or (name .. ": OFF")
	end
end


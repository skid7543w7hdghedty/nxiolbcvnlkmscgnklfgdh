function refreshOnlineTeamers()
	if not onlineTeamersList then return end

	local markedOnline = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and markedTeamers[plr.Name] == true then
			table.insert(markedOnline, plr)
		end
	end
	table.sort(markedOnline, function(a, b) return a.Name:lower() < b.Name:lower() end)
	-- Skip redundant rebuilds: same marked-online membership -> same UI.
	-- (checked BEFORE destroying children so a skip keeps the current list intact)
	local onlineTeamerSigParts = {}
	for _, plr in ipairs(markedOnline) do onlineTeamerSigParts[#onlineTeamerSigParts + 1] = plr.Name end
	local onlineTeamerSig = table.concat(onlineTeamerSigParts, ",")
	if onlineTeamerSig == onlineTeamersLastSig then return end
	onlineTeamersLastSig = onlineTeamerSig

	for _, child in ipairs(onlineTeamersList:GetChildren()) do
		if not child:IsA("UIListLayout") then

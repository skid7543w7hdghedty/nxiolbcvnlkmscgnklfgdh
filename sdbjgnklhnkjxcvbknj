		if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
		local maxX = 0
		pcall(function()
			maxX = math.max(0, barScroll.AbsoluteCanvasSize.X - barScroll.AbsoluteSize.X)
		end)

	local probe = Drawing.new("Line")
	probe:Remove()
	espDrawingOK = true
end)
function espSkeletonClearPlayer(plr)
	local data = espSkelDrawings and espSkelDrawings[plr]
	if data then
		if data.frame then pcall(function() data.frame:Destroy() end) end
		espSkelDrawings[plr] = nil
	end
end
function espSkeletonHidePlayer(plr)
	local data = espSkelDrawings and espSkelDrawings[plr]
	if data and data.frame then
		pcall(function() data.frame.Visible = false end)
	end
end
-- Shared ESP visibility gate: returns character, color when this player's ESP
-- must be drawn, otherwise nil.
function espPlayerVisible(plr)
	if plr == player then return nil end
	local character = plr.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	local class = espGetRoleClass(plr)
	local show = (class == "murderer" and espMurdererEnabled)
		or (class == "sheriff" and espSheriffEnabled)
		or (class == "innocent" and espInnocentEnabled)
		or (class == "dead" and espDeadEnabled)
	if not show then return nil end
	return character, espGetRoleColor(plr)
end
-- One-time migration: remove legacy Beam-based skeleton folders/attachments
-- left in characters by older script versions (they would double the lines).
for _, plr in ipairs(Players:GetPlayers()) do
	local ch = plr.Character
	if ch then
		local f = ch:FindFirstChild("_WSkel")
		if f then pcall(function() f:Destroy() end) end
		for _, d in ipairs(ch:GetDescendants()) do
			if d:IsA("Attachment") and d.Name:sub(1, 6) == "_WSkel" then
				pcall(function() d:Destroy() end)
			end
		end
	end
end
function espSkeletonTick()
	if not (espEnabled and espSkeletonEnabled) then
		for plr, _ in pairs(espSkelDrawings) do
			espSkeletonHidePlayer(plr)
		end
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local gui = espSkeletonEnsureGui()
	if not gui then return end
	-- WorldToViewportPoint is in viewport pixels. The overlay now covers the
	-- full viewport 1:1; only a uniform pixel-space scale (high-DPI executor)
	-- is corrected. A non-uniform ratio means a layout/inset mismatch, applying
	-- it would skew the skeleton, so it is ignored.
	local vs = cam.ViewportSize
	local scale = 1
	local probe = gui:FindFirstChild("SizeProbe")
	if probe then
		local as = probe.AbsoluteSize
		if as.X > 1 and as.Y > 1 and vs.X > 1 and vs.Y > 1 then
			local rx, ry = as.X / vs.X, as.Y / vs.Y
			-- Ignore absurd ratios (probe not laid out yet / one-frame resize).
			if rx > 0.5 and rx < 2 and ry > 0.5 and ry < 2 and math.abs(rx - ry) < 0.02 then
				scale = (rx + ry) * 0.5
			end
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local character, color = espPlayerVisible(plr)
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if not (character and hum and hum.Health > 0) then
			espSkeletonHidePlayer(plr)
		elseif not espPartRoleEnabled("skeleton", espGetRoleClass(plr)) then
			espSkeletonHidePlayer(plr)
		else
			local bonePairs = (hum.RigType == Enum.HumanoidRigType.R15) and ESP_SKEL_R15 or ESP_SKEL_R6
			local data = espSkelDrawings[plr]
			-- [perf] body parts are resolved once per character (not per bone per
			-- frame); rebuild on respawn / rig change / line count mismatch AND
			-- whenever a cached part was replaced or detached inside the same
			-- model (otherwise lines can stick to an old/ragdolled limb and draw
			-- somewhere beside the player).
			local needRebuild = (not data) or data.rig ~= hum.RigType or data.char ~= character
				or #data.lines ~= #bonePairs or #data.parts ~= #bonePairs
			if not needRebuild then
				for _, pr in ipairs(data.parts) do
					local pa, pb = pr[1], pr[2]
					if not pa or not pb or pa.Parent ~= character or pb.Parent ~= character then
						needRebuild = true
						break
					end
				end
			end
			if needRebuild then
				espSkeletonClearPlayer(plr)
				-- Container for this player's bone lines, so visibility/destroy
				-- affects all lines with one call.
				local holder = Instance.new("Frame")
				holder.Name = "Skel_" .. plr.Name
				holder.Size = UDim2.fromScale(1, 1)
				holder.BackgroundTransparency = 1
				holder.BorderSizePixel = 0
				holder.ClipsDescendants = false
				holder.Active = false
				holder.Parent = gui
				data = { frame = holder, lines = {}, parts = {}, rig = hum.RigType, char = character }
				for _ = 1, #bonePairs do
					local l = Instance.new("Frame")
					l.Name = "Bone"
					l.AnchorPoint = Vector2.new(0.5, 0.5)
					l.BackgroundColor3 = Color3.new(1, 1, 1)
					l.BackgroundTransparency = 1 - ESP_SKEL_OPACITY
					l.BorderSizePixel = 0
					l.Size = UDim2.new(0, 0, 0, ESP_SKEL_THICKNESS)
					l.Position = UDim2.new(0, -1000, 0, -1000)
					l.Rotation = 0
					l.Visible = false
					l.ZIndex = 2
					l.Parent = holder
					data.lines[#data.lines + 1] = l
				end
				for _, pair in ipairs(bonePairs) do
					data.parts[#data.parts + 1] = { character:FindFirstChild(pair[1]), character:FindFirstChild(pair[2]) }
				end
				espSkelDrawings[plr] = data
			end
			if data.frame then data.frame.Visible = true end
			-- [perf] No pcall/closure per bone per frame: these are our own Frame
			-- instances, so a property write can never throw. The colour is only
			-- written when it actually changed, and the length test compares the
			-- squared distance (one sqrt less per bone).
			for idx = 1, #bonePairs do
				local line = data.lines[idx]
				local pr = data.parts[idx]
				local shown = false
				if line and pr then
					local partA, partB = pr[1], pr[2]
					if partA and partB and partA.Parent and partB.Parent then
						-- WorldToViewportPoint is the same coordinate space as this
						-- full-viewport (no-inset) ScreenGui, so the frame lines
						-- land exactly on the bones everywhere.
						local posA = cam:WorldToViewportPoint(partA.Position)
						local posB = cam:WorldToViewportPoint(partB.Position)
						-- Z <= 0 means behind the camera: its projection mirrors and
						-- would draw the skeleton somewhere else on screen. Do not rely
						-- on the onScreen flag: on mobile it can be false for points
						-- that are actually visible.
						if posA.Z > 0 and posB.Z > 0 then
							local ax, ay = posA.X * scale, posA.Y * scale
							local bx, by = posB.X * scale, posB.Y * scale
							local dx, dy = bx - ax, by - ay
							local d2 = dx * dx + dy * dy
							if d2 >= 0.25 then
								line.Position = UDim2.new(0, (ax + bx) * 0.5, 0, (ay + by) * 0.5)
								line.Size = UDim2.new(0, math.sqrt(d2), 0, ESP_SKEL_THICKNESS)
								line.Rotation = math.deg(math.atan2(dy, dx))
								if line.BackgroundColor3 ~= color then line.BackgroundColor3 = color end
								line.Visible = true
								shown = true
							end
						end
					end
				end
				if not shown and line then line.Visible = false end
			end
		end
	end
end
-- Bind AFTER the camera update (RenderPriority.Camera + 1): a plain
-- RenderStepped tick can run before the camera CFrame for the frame is final,
-- which projected the skeleton with the previous frame's camera and made the
-- whole figure trail/tilt away from the character whenever the camera moved.
-- Also update EVERY frame so fast/jumping players don't leave the lines behind.
if not pcall(function()
	RunService:BindToRenderStep("WsSkeletonESP", Enum.RenderPriority.Camera.Value + 1, function()
		pcall(espSkeletonTick)
	end)
end) then
	RunService.RenderStepped:Connect(function()
		pcall(espSkeletonTick)
	end)
end
Players.PlayerRemoving:Connect(function(plr)
	espSkeletonClearPlayer(plr)
end)

function espGetDist(character)
	local c = player.Character
	if not c or not c:FindFirstChild("HumanoidRootPart") then return nil end
	if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	return math.floor((c.HumanoidRootPart.Position - character.HumanoidRootPart.Position).Magnitude)
end

function espGetDistFromPos(position)
	local c = player.Character
	if not c or not c:FindFirstChild("HumanoidRootPart") then return nil end
	return math.floor((c.HumanoidRootPart.Position - position).Magnitude)
end

function espGetOrMakeHighlight(character)
	local h = character:FindFirstChild(ESP_HL_TAG)
	if h and h:IsA("Highlight") then return h end
	if h then h:Destroy() end
	local hl = Instance.new("Highlight")
	hl.Name = ESP_HL_TAG
	hl.Adornee = character
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillTransparency = ESP_FILL_ALPHA
	hl.OutlineTransparency = ESP_OUTLINE_ALPHA
	hl.FillColor = ESP_DEFAULT_COLOR
	hl.OutlineColor = ESP_DEFAULT_COLOR
	hl.Parent = character
	return hl
end

function espGetOrMakeBillboard(character)
	local head = character:FindFirstChild("Head")
	if not head then return nil, nil end
	local bb = head:FindFirstChild(ESP_BB_TAG)
	if bb and bb:IsA("BillboardGui") then
		local oldHealth = bb:FindFirstChild("HealthBg")
		if oldHealth then oldHealth:Destroy() end
		return bb:FindFirstChild("NameLabel"), bb:FindFirstChild("DistLabel")
	end
	if bb then bb:Destroy() end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = ESP_BB_TAG
	billboard.Adornee = head
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.new(0, 200, 0, 32)
	billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	billboard.ResetOnSpawn = false
	billboard.Parent = head
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, 0, 0, 18)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = ""
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 13
	nameLabel.TextColor3 = ESP_DEFAULT_COLOR
	nameLabel.TextStrokeTransparency = 1
	nameLabel.TextScaled = false
	nameLabel.Parent = billboard
	local distLabel = Instance.new("TextLabel")
	distLabel.Name = "DistLabel"
	distLabel.Size = UDim2.new(1, 0, 0, 14)
	distLabel.Position = UDim2.new(0, 0, 0, 18)
	distLabel.BackgroundTransparency = 1
	distLabel.Text = ""
	distLabel.Font = Enum.Font.Gotham
	distLabel.TextSize = 11
	distLabel.TextColor3 = ESP_DEFAULT_COLOR
	distLabel.TextStrokeTransparency = 1
	distLabel.TextScaled = false
	distLabel.Parent = billboard
	return nameLabel, distLabel
end

function espGetGunPosition(gunDrop)
	if gunDrop:IsA("BasePart") then return gunDrop.Position end
	if gunDrop.PrimaryPart then return gunDrop.PrimaryPart.Position end
	for _, child in ipairs(gunDrop:GetDescendants()) do
		if child:IsA("BasePart") then return child.Position end
	end
	return nil
end

function espCreateGunHighlight(gunDrop)
	local existing = gunDrop:FindFirstChild(ESP_GUN_HL_TAG)
	if existing then existing:Destroy() end
	local hl = Instance.new("Highlight")
	hl.Name = ESP_GUN_HL_TAG
	hl.Adornee = gunDrop
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillTransparency = 0.5
	hl.OutlineTransparency = 0
	hl.FillColor = ESP_GUN_COLOR
	hl.OutlineColor = ESP_GUN_COLOR
	hl.Parent = gunDrop
	return hl
end

function espCreateGunBillboard(gunDrop)
	local adornee = nil
	if gunDrop:IsA("BasePart") then
		adornee = gunDrop
	elseif gunDrop.PrimaryPart then
		adornee = gunDrop.PrimaryPart
	else
		for _, child in ipairs(gunDrop:GetDescendants()) do
			if child:IsA("BasePart") then adornee = child break end
		end
	end
	if not adornee then return nil, nil end
	local existing = adornee:FindFirstChild(ESP_GUN_BB_TAG)

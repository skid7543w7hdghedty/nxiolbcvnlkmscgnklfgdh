-- Change / Unchange buttons
do
	local changeBtn = createButton("SkyboxChangeBtn", "Change", 430)
	changeBtn.MouseButton1Click:Connect(function()
		local nm = skyboxPickerState and skyboxPickerState.selectedName
		local preset = nm and skyboxGetFacesByName(nm) or nil
		if nm and preset then
			-- Load preset into input fields (works for built-in and saved presets)
			if type(preset) == "table" then
				for _, face in ipairs(skyboxFaces) do
					if skyboxFaceInputs[face] then
						skyboxFaceInputs[face].Text = preset[face] or ""
					end
				end
				-- Build face table and apply
				local ft = {}
				for _, face in ipairs(skyboxFaces) do
					if preset[face] then
						ft[face] = "rbxassetid://" .. preset[face]
					end
				end
				skyboxApplyFaces(ft)
				skyboxLastPresetName = nm
				-- Remember the exact face URLs so Auto Apply works even for
				-- built-in presets (which are not stored in savedSkyboxes).
				skyboxLastFaces = {}
				for _, face in ipairs(skyboxFaces) do
					if ft[face] then skyboxLastFaces[face] = ft[face] end
				end
				pcall(saveConfig)
				notify("Skybox", "Applied preset: " .. nm, 2)
			elseif type(preset) == "string" then
				-- Legacy: single ID for all faces (backward compat)
				for _, face in ipairs(skyboxFaces) do
					if skyboxFaceInputs[face] then
						skyboxFaceInputs[face].Text = preset
					end
				end
				local url = "rbxassetid://" .. preset
				local ft = {}
				for _, face in ipairs(skyboxFaces) do ft[face] = url end
				skyboxApplyFaces(ft)
				skyboxLastPresetName = nm
				skyboxLastFaces = {}
				for _, face in ipairs(skyboxFaces) do skyboxLastFaces[face] = url end
				pcall(saveConfig)
				notify("Skybox", "Applied preset: " .. nm, 2)
			end
		else
			-- No preset selected — apply from input fields
			local faces, count = skyboxCollectInputs()
			if count == 0 then
				notify("Skybox", "Fill in at least one face ID", 2)
				return
			end
			skyboxApplyFaces(faces)
			skyboxLastPresetName = nil
			skyboxLastFaces = {}
			for face, url in pairs(faces) do skyboxLastFaces[face] = url end
			pcall(saveConfig)
			notify("Skybox", "Applied " .. count .. " face(s)", 2)
		end
	end)

	local unchangeBtn = createButton("SkyboxUnchangeBtn", "Unchange", 431)
	unchangeBtn.MouseButton1Click:Connect(function()
		skyboxUnchange()
		notify("Skybox", "Restored default skybox", 2)
	end)

	skyboxAutoApplyBtn = createButton("SkyboxAutoApplyBtn", skyboxAutoApply and "Auto Apply Skybox: ON" or "Auto Apply Skybox: OFF", 432)
	if skyboxAutoApply then
		setToggleState(skyboxAutoApplyBtn, true, "Auto Apply Skybox: ON", "Auto Apply Skybox: OFF")
	end
	skyboxAutoApplyBtn.MouseButton1Click:Connect(function()
		skyboxAutoApply = not skyboxAutoApply
		setToggleState(skyboxAutoApplyBtn, skyboxAutoApply, "Auto Apply Skybox: ON", "Auto Apply Skybox: OFF")
		saveConfig()
		notify("Skybox", skyboxAutoApply and "Auto apply enabled (re-applies after rejoin)" or "Auto apply disabled", 2)
	end)
end

-- Auto-apply the last skybox after (re)join, like Changer's Auto Apply Avatar.
task.defer(function()
	if not skyboxAutoApply then return end
	if not game:IsLoaded() then game.Loaded:Wait() end
	local ft = nil
	local preset = skyboxLastPresetName and skyboxGetFacesByName(skyboxLastPresetName) or nil
	if preset then
		ft = {}
		if type(preset) == "table" then
			for _, face in ipairs(skyboxFaces) do
				if preset[face] and tostring(preset[face]):match("%d+") then
					ft[face] = "rbxassetid://" .. tostring(preset[face]):match("%d+")
				end
			end
		elseif type(preset) == "string" then
			for _, face in ipairs(skyboxFaces) do ft[face] = "rbxassetid://" .. preset end
		end
		if next(ft) == nil then ft = nil end
	elseif skyboxLastFaces and next(skyboxLastFaces) then
		ft = {}
		for face, url in pairs(skyboxLastFaces) do ft[face] = url end
	end
	if ft then pcall(skyboxApplyFaces, ft) end
end)



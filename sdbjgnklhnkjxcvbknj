		teamerListRefreshPending = false
		refreshTeamerList()
	end)
end
function refreshTeamerList()
	if not teamerScrollFrame then return end
	if refreshOnlineTeamers then refreshOnlineTeamers() end
	if refreshSavedTeamers then refreshSavedTeamers() end
	for _, child in ipairs(teamerScrollFrame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	teamerCheckboxes = {}

	local playerList = Players:GetPlayers()
	table.sort(playerList, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	local yPosition = 0
	for _, plr in ipairs(playerList) do
		if plr ~= player then
			local isMarked = markedTeamers[plr.Name] == true

			local rowData
			rowData = createAvatarSelectorRow(teamerScrollFrame, plr, {
				nameSuffix = "Entry",
				selected = selectedTeamerTargets[plr.Name] ~= nil,
				prefix = isMarked and "[!] " or "",
				accent = Color3.fromRGB(255, 150, 0),
				baseBg = Color3.fromRGB(0, 0, 0),
				selectedBg = Color3.fromRGB(84, 50, 8),
				baseTextColor = isMarked and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(255, 255, 255),
				onClick = function()
					if selectedTeamerTargets[plr.Name] then
						selectedTeamerTargets[plr.Name] = nil
						rowData.SetSelected(false)
					else
						selectedTeamerTargets[plr.Name] = plr
						rowData.SetSelected(true)
					end
				end,
			})
			rowData.Entry.Position = UDim2.new(0, 0, 0, yPosition)

			teamerCheckboxes[plr.Name] = {
				Entry = rowData.Entry,
				Checkmark = rowData.Checkmark,
				NameLabel = rowData.NameLabel,
				SetSelected = rowData.SetSelected,
			}

			yPosition += 65
		end
	end

	teamerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPosition)
	updateTeamerStatus()
	if teamerSearchBox then
		local searchText = string.lower(teamerSearchBox.Text)
		for _, data in pairs(teamerCheckboxes) do
			if data.Entry and data.NameLabel then
				local playerName = data.NameLabel.Text:gsub("^%[!%] ", "")
				data.Entry.Visible = searchText == "" or string.find(string.lower(playerName), searchText, 1, true) ~= nil
			end
		end
	end
end

function updateTeamerStatus()
	if not teamerStatusLabel then return end
	local count = 0
	for _ in pairs(selectedTeamerTargets) do
		count += 1
	end
	teamerStatusLabel.Text = count == 0 and "Select players to mark as teamers" or (count .. " player(s) selected")
	teamerStatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

function toggleAllTeamerPlayers(selectAll)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local checkboxData = teamerCheckboxes[plr.Name]
			if checkboxData then
				if selectAll then
					selectedTeamerTargets[plr.Name] = plr
					if checkboxData.SetSelected then checkboxData.SetSelected(true) else checkboxData.Checkmark.Visible = true end
				else
					selectedTeamerTargets[plr.Name] = nil
					if checkboxData.SetSelected then checkboxData.SetSelected(false) else checkboxData.Checkmark.Visible = false end
				end
			end
		end
	end
	updateTeamerStatus()
end


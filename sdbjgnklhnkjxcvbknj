function disableShaders()
	shadersEnabled = false
	for _, obj in ipairs(shadersInstances) do pcall(function() obj:Destroy() end) end
	shadersInstances = {}
	-- Defensive cleanup: destroy any remaining shader effects we may have created
	-- (covers an edge case where an effect didn't end up in shadersInstances). The
	-- "Shaders" name prefix lets us find our own effects without touching any the
	-- game itself created (e.g. a BlurEffect from the "Blur Reveal" menu style).
	pcall(function()
		local Lighting = game:GetService("Lighting")
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("BloomEffect") or child:IsA("ColorCorrectionEffect") or child:IsA("SunRaysEffect") then
				if child.Name:sub(1, 6) == "Shaders" then pcall(function() child:Destroy() end) end
			end
		end
	end)
	-- Restore the ORIGINAL lighting. Destroying the effects does NOT revert the
	-- Lighting properties the shaders changed, which left the scene tinted/dark
	-- after disabling — so every saved value is written back exactly.
	if shadersLightingSaved then
		local Lighting = game:GetService("Lighting")
		Lighting.Brightness = shadersLightingState.Brightness
		Lighting.ColorShift_Bottom = shadersLightingState.ColorShift_Bottom
		Lighting.ColorShift_Top = shadersLightingState.ColorShift_Top
		Lighting.OutdoorAmbient = shadersLightingState.OutdoorAmbient
		Lighting.ClockTime = shadersLightingState.ClockTime
		Lighting.FogColor = shadersLightingState.FogColor
		Lighting.FogEnd = shadersLightingState.FogEnd
		Lighting.FogStart = shadersLightingState.FogStart
		Lighting.ExposureCompensation = shadersLightingState.ExposureCompensation
		Lighting.ShadowSoftness = shadersLightingState.ShadowSoftness
		Lighting.Ambient = shadersLightingState.Ambient
		if shadersLightingState.Sky and not Lighting:FindFirstChildOfClass("Sky") then
			pcall(function() shadersLightingState.Sky.Parent = Lighting end)
		end
		shadersLightingState = {}
		shadersLightingSaved = false
	end
end


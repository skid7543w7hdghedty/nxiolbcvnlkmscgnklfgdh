-- Fuzzy name lookup used by Reset and the Trolling target box. Exact Name /
-- DisplayName wins, then prefix, then "contains" — the old "first player whose
-- name contains the query" hit bystanders (typing "Bob" grabbed
-- "BobTheSecond" before the real Bob) and every follow-up feature then
-- targeted the wrong person.
function findPlayerByQuery(query, needAlive)
	if not query or query == "" then return nil end
	local q = query:lower()
	local contains, prefix, exact = nil, nil, nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local name = plr.Name:lower()
			local disp = string.lower(plr.DisplayName or "")
			local alive = true
			if needAlive then
				local c = plr.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				alive = (h ~= nil and h.Health > 0)
			end
			if alive then
				if not exact and (name == q or disp == q) then
					exact = plr
				elseif not prefix and (name:sub(1, #q) == q or disp:sub(1, #q) == q) then
					prefix = plr
				elseif not contains and (name:find(q, 1, true) or disp:find(q, 1, true)) then
					contains = plr
				end
			end
		end
	end
	return exact or prefix or contains
end

function executeNanFling(durationOverride)
	if nanFlingTargetName == "" then
		notify("Error", "Enter a player name first", 2)
		return
	end

	local targetPlayer = findPlayerByQuery(nanFlingTargetName, true)

	if not targetPlayer or not targetPlayer.Character then
		notify("Error", "Target not found", 2)
		return
	end

	if isPlayerWhitelisted(targetPlayer.Name) then
		return
	end

	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hum then return end

	local targetChar = targetPlayer.Character
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
	if not targetRoot or not targetHum then
		notify("Error", "Target has no character", 2)
		return
	end

	for _, part in pairs(targetChar:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
			part.Anchored = false
		end
	end

	nanFlingCallCounter = nanFlingCallCounter + 1
	local currentFlingId = nanFlingCallCounter
	-- Touch Fling hold for this fling (transferred, not stacked, when superseding
	-- a live fling; the final restore releases exactly once).
	local myFlingHold = true
	if nanFlingConnection then
		nanFlingConnection:Disconnect()
		nanFlingConnection = nil
	else
		resetTouchFlingOn()
	end

	local savedCFrame = hrp.CFrame
	local savedVelocity = hrp.Velocity
	local savedPlatformStand = hum.PlatformStand

	hum.PlatformStand = true
	local startTime = tick()

	-- Constant-teleport technology (experiment): every Heartbeat snap onto the
	-- victim and stay there together with Touch Fling. No velocity writes, no
	-- hidden-property spoof — only plain CFrame teleports, which the server
	-- accepts fine one-shot. Touch Fling (kept ON) owns velocity and kills.
	RSTP_CONTACT = RSTP_CONTACT or 1.4
	RSTP_TIMEOUT = RSTP_TIMEOUT or 3.0
	RSTP_LEAD = RSTP_LEAD or 0.15
	RSTP_MIN_SPEED = RSTP_MIN_SPEED or 3
	local contactH = RSTP_CONTACT
	local tpTimeout = tonumber(durationOverride) or RSTP_TIMEOUT
	local tpLead = RSTP_LEAD

	nanFlingConnection = RunService.Heartbeat:Connect(function()
		if nanFlingCallCounter ~= currentFlingId then return end
		-- Victim dead or gone -> success, restore right away.
		local tCharNow = targetPlayer.Character
		local tHumNow = tCharNow and tCharNow:FindFirstChildOfClass("Humanoid")
		local victimGone = (not tCharNow) or (not tHumNow) or (tHumNow.Health <= 0)
		local myHumNow = char and char:FindFirstChildOfClass("Humanoid")
		if myHumNow and myHumNow.Health <= 0 then
			-- We died mid-reset: stop teleporting the corpse around.
			nanFlingConnection:Disconnect()
			nanFlingConnection = nil
			return
		end
		if victimGone or (tick() - startTime) >= tpTimeout then
			nanFlingConnection:Disconnect()
			nanFlingConnection = nil
			task.defer(function()
				if nanFlingCallCounter ~= currentFlingId then return end
				-- Release our Touch Fling hold first so it stops fighting the restore.
				if myFlingHold then resetTouchFlingOff() end
				resetReturnHome(savedCFrame, savedPlatformStand)
			end)
			return
		end

		-- Constant teleport with movement prediction. The victim keeps moving
		-- between frames and their replicated position is already stale, so we
		-- aim at the intercept point (see resetPressAim): a running victim is met
		-- where they WILL be, a standing one exactly where they are. Contact is
		-- made from slightly above so the press squashes them downward instead of
		-- shooting them sideways.
		do
			-- Custom rigs may have no "HumanoidRootPart": the primary BasePart is
			-- the same contact target there.
			local tR = tCharNow and (tCharNow:FindFirstChild("HumanoidRootPart")
				or tCharNow:FindFirstChildWhichIsA("BasePart"))
			if tR then
				-- Sample the real motion before aiming: on a walker this is what
				-- replaces a near-zero replicated velocity.
				resetVelRecord(tR)
				local aim = resetPressAim(tR, hrp, tpLead)
				if aim then
					-- A tiny vertical wobble makes each frame a slightly different
					-- contact instead of a perfectly repeated ride at one spot,
					-- which the physics solver kept ignoring on a moving victim.
					local wob = math.sin(os.clock() * 13) * 0.12
					hrp.CFrame = CFrame.new(aim.X, aim.Y + contactH + wob, aim.Z)
					-- Keep our own assembly straight while pressing: a spinning
					-- body is what used to send victims up or sideways instead
					-- of down.
					pcall(function()
						hrp.AssemblyAngularVelocity = Vector3.zero
					end)
				end
			end
		end
	end)

	notify("Instant Fling", "Killing " .. targetPlayer.Name, 1.5)
end

-- Find the player who is CURRENTLY holding the gun, using the PHYSICAL "Gun"
-- tool (in hand or Backpack) and only LIVE characters. Server role flags
-- (data.Role == "Hero" / data.HasGun) can lag or stay stale right after a hero
-- dies, so "Reset Sheriff/Hero", "TP to Hero" and "Kill Sheriff" may point at a
-- dead/old player even though a live one visibly holds the gun. Using the real
-- tool fixes that. Returns the Player (or nil). Only considers OTHER players.
function findCurrentGunHolderPlayer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if char and hum and hum.Health > 0 then
				local held = false
				for _, tool in ipairs(char:GetChildren()) do
					if tool:IsA("Tool") and tool.Name:lower():find("gun") then held = true break end
				end
				if not held then
					local bp = p:FindFirstChild("Backpack")
					if bp then
						for _, tool in ipairs(bp:GetChildren()) do
							if tool:IsA("Tool") and tool.Name:lower():find("gun") then held = true break end
						end
					end
				end
				if held then return p end
			end
		end
	end
	return nil
end

function executeNanFlingByRole(roleName, durationOverride)
	local duration = tonumber(durationOverride)
		or (roleName == "Sheriff" and resetSheriffTime)
		or (roleName == "Murderer" and resetMurdererTime)
		or RSTP_TIMEOUT
	local ok, result = pcall(function()
		return invokePlayerData()
	end)
	if not (ok and result) then
		notify("Error", "Could not get roles", 2)
		return
	end
	local function isAlive(name)
		local plr = Players:FindFirstChild(name)
		return plr and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0
	end

	if roleName == "Sheriff" then
		-- Target the CURRENT gun holder only. A player whose Role is still "Hero"
		-- after dropping the gun (died / the gun got re-picked) must NOT be
		-- targeted — that's exactly how the OLD hero used to get reset after a
		-- new hero took the gun. Prefer the CURRENT physical gun holder (the real
		-- "Gun" tool in hand/Backpack of a LIVE player), which beats role flags
		-- that can lag after a death. Fall back to role flags: Hero+gun, then any
		-- gun holder, then the Sheriff role.
		local physHolder = findCurrentGunHolderPlayer()
		if physHolder then
			nanFlingTargetName = physHolder.Name
			executeNanFling(duration)
			return
		end
		local heroAlive, heroAny, gunAlive, gunAny, sheriffAlive, sheriffAny = nil, nil, nil, nil, nil, nil
		for _, plr in ipairs(Players:GetPlayers()) do
			local name = plr.Name
			local data = result[name]
			if data and name ~= player.Name and not isPlayerWhitelisted(name) then
				if data.Role == "Hero" and data.HasGun then
					heroAny = name
					if isAlive(name) then heroAlive = name end
				elseif data.HasGun and data.Role ~= "Murderer" then
					gunAny = name
					if isAlive(name) then gunAlive = name end
				elseif data.Role == "Sheriff" then
					sheriffAny = name
					if isAlive(name) then sheriffAlive = name end
				end
			end
		end
		local chosen = heroAlive or gunAlive or heroAny or gunAny or sheriffAlive or sheriffAny
		if chosen then
			nanFlingTargetName = chosen
			executeNanFling(duration)
			return
		end
	elseif roleName == "Murderer" then
		local aliveTarget = nil
		for name, data in pairs(result) do
			if data.Role == "Murderer" and name ~= player.Name and not isPlayerWhitelisted(name) then
				if isAlive(name) then
					aliveTarget = name
					break
				end
				if not aliveTarget then aliveTarget = name end
			end
		end
		if aliveTarget then
			nanFlingTargetName = aliveTarget
			executeNanFling(duration)
			return
		end
	end
	notify("Error", "No " .. roleName .. " found", 2)
end


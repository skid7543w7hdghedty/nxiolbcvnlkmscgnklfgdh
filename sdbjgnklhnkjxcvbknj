task.spawn(function()
	while true do
		task.wait(0.5)
		local ok, result = pcall(function()
			return invokePlayerData()
		end)
		if ok and result then
			local murderer, perkName = "Not detected", "Not detected"
			local sheriffFromData = nil
			for name, data in pairs(result) do
				if data.Role == "Murderer" then
					murderer = name
					if data.Perk then perkName = data.Perk end
				elseif data.Role == "Sheriff" then
					sheriffFromData = name
				end
			end
			-- Detect murderer dead or left
			local murdererStatus = nil
			if murderer ~= "Not detected" then
				local mPlr = Players:FindFirstChild(murderer)
				if not mPlr then
					murdererStatus = "Left"
				else
					local mChar = mPlr.Character
					local mHum = mChar and mChar:FindFirstChildOfClass("Humanoid")
					if not mChar or not mHum or mHum.Health <= 0 then
						murdererStatus = "Dead"
					end
				end
			end
			-- Validate the data sheriff: stale role data keeps pointing at a sheriff
			-- who already died or left, which also hides the real gun holder below.
			local sheriffStatus = nil
			if sheriffFromData then
				local sPlr = Players:FindFirstChild(sheriffFromData)
				if not sPlr then
					sheriffStatus = "Left"
				else
					local sChar = sPlr.Character
					local sHum = sChar and sChar:FindFirstChildOfClass("Humanoid")
					if not sChar or not sHum or sHum.Health <= 0 then
					sheriffStatus = "Dead"
					end
				end
			end
			-- Always scan the physical gun holder: whoever holds the gun right now
			-- decides Sheriff vs Hero; role data only confirms a living sheriff.
			local scanSheriff, scanHero = combatStatsScanGunHolder(result)
			local holder = scanSheriff or scanHero
			local sheriff, hero = "Not detected", "Not detected"
			if holder then
				sheriffStatus = nil
				if holder == sheriffFromData then
					sheriff = holder
				else
					hero = holder
				end
			elseif sheriffFromData then
				sheriff = sheriffFromData
			else
				sheriffStatus = nil
			end
			combatStatsRoundActive = (murderer ~= "Not detected")
			if combatStatsRoundActive and not combatStatsLastRoundActive then
				combatStatsGunDropped = "No"
			end
			combatStatsCheckGun()
			combatStatsLastRoundActive = combatStatsRoundActive
			if murderer ~= combatStatsMurderer or sheriff ~= combatStatsSheriff or hero ~= combatStatsHero or perkName ~= combatStatsPerk or murdererStatus ~= combatStatsMurdererStatus or sheriffStatus ~= combatStatsSheriffStatus then
				combatStatsMurderer = murderer
				combatStatsSheriff = sheriff
				combatStatsHero = hero
				combatStatsPerk = perkName
				combatStatsMurdererStatus = murdererStatus
				combatStatsSheriffStatus = sheriffStatus
				combatStatsRefreshText()
			end
		end
	end
end)


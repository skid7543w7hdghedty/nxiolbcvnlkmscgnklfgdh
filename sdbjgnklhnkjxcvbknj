	distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	distLabel.TextScaled = false
	distLabel.Parent = billboard
	return nameLabel, distLabel
end

function espCleanGun(gunDrop)
	if not gunDrop then return end
	local hl = gunDrop:FindFirstChild(ESP_GUN_HL_TAG)
	if hl then hl:Destroy() end
	for _, child in ipairs(gunDrop:GetDescendants()) do
		if child:IsA("BasePart") then
			local bb = child:FindFirstChild(ESP_GUN_BB_TAG)
			if bb then bb:Destroy() end
		end
	end
	if gunDrop:IsA("BasePart") then
		local bb = gunDrop:FindFirstChild(ESP_GUN_BB_TAG)
		if bb then bb:Destroy() end
	end
end

function espHookGunDrop(gunDrop)
	if not espGunEnabled then return end
	if espTrackedGuns[gunDrop] then return end
	espCreateGunHighlight(gunDrop)
	local _, distLabel = espCreateGunBillboard(gunDrop)
	-- [perf] distance text only needs a few updates per second, not one per frame;
	-- also skip the (expensive on mobile) TextLabel.Text write when unchanged
	local lastGunDistText = nil
	local conn = RunService.Heartbeat:Connect(function()
		if not (espEnabled and espGunEnabled) then return end
		if _espFrameCounter % 10 ~= 0 then return end
		if not gunDrop or not gunDrop.Parent then return end
		if distLabel then
			local pos = espGetGunPosition(gunDrop)
			if pos then
				local dist = espGetDistFromPos(pos)
				local txt = dist and ("[" .. tostring(dist) .. "m]") or ""
				if txt ~= lastGunDistText then
					lastGunDistText = txt
					distLabel.Text = txt
				end
			end
		end
	end)
	espTrackedGuns[gunDrop] = { conn = conn }
	gunDrop.AncestryChanged:Connect(function(_, parent)
		if not parent then
			if espTrackedGuns[gunDrop] then
				if espTrackedGuns[gunDrop].conn then
					espTrackedGuns[gunDrop].conn:Disconnect()
				end
				espTrackedGuns[gunDrop] = nil
			end
			espCleanGun(gunDrop)
		end
	end)
end

	function espFindGunDropsInModel(mapModel)
		-- Hook NEW drops first, so anything that spawns during the (now chunked)
		-- scan below is never missed.
		local mapConn = mapModel.DescendantAdded:Connect(function(descendant)
			if not (espEnabled and espGunEnabled) then return end
			if descendant.Name == "GunDrop" then
				task.spawn(espHookGunDrop, descendant)
			end
		end)
		table.insert(espConnections, mapConn)
		-- [perf] Incremental walk instead of one mapModel:GetDescendants() call:
		-- a map model can hold tens of thousands of instances, and building that
		-- table in a single frame was a visible hitch during the config restore.
		task.spawn(function()
			local stack = { mapModel }
			local budget = 0
			while #stack > 0 and espEnabled do
				local node = table.remove(stack)
				if node.Name == "GunDrop" then task.spawn(espHookGunDrop, node) end
				local kids = node:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
				budget = budget + 1
				if budget >= 300 then
					budget = 0
					RunService.Heartbeat:Wait()
				end
			end
		end)
	end

	-- Trap ESP: highlight + label for Trap perk traps
	function espIsTrap(inst)
		if not inst then return false end
		if not inst:IsA("BasePart") and not inst:IsA("Model") then return false end
		local n = inst.Name:lower()
		return n:find("trap") or n:find("capkan")
	end

	function espCreateTrapHighlight(trap)
		local adornee = nil
		if trap:IsA("BasePart") then
			adornee = trap
		elseif trap:IsA("Model") then
			adornee = trap.PrimaryPart or trap:FindFirstChildWhichIsA("BasePart")
		end
		if not adornee then return nil end
		local existing = adornee:FindFirstChild(ESP_TRAP_HL_TAG)
		if existing then existing:Destroy() end
		local hl = Instance.new("Highlight")
		hl.Name = ESP_TRAP_HL_TAG
		hl.Adornee = adornee
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.6
		hl.OutlineTransparency = 0
		hl.FillColor = ESP_TRAP_COLOR
		hl.OutlineColor = ESP_TRAP_COLOR
		hl.Parent = adornee
		return hl
	end

	function espCreateTrapBillboard(trap)
		local adornee = nil
		if trap:IsA("BasePart") then
			adornee = trap
		elseif trap:IsA("Model") then

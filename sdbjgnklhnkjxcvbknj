-- Round-start detection based on the Murderer/Sheriff assignment (the same signal
-- used by the round notification). Runs independently of the Notifications toggle.
task.spawn(function()
	task.wait(2)
	local lastRoundKey = nil
	while true do
		task.wait(0.4)
		if not instantRoleNotifyEnabled then continue end
		local ok, roles = pcall(function()
			return invokePlayerData()
		end)
		if ok and roles then
			local murderer, sheriff, murdererPerk = nil, nil, nil
			for name, data in pairs(roles) do
				if data.Role == "Murderer" then
					murderer = name
					if data.Perk then murdererPerk = data.Perk end
				elseif data.Role == "Sheriff" then sheriff = name end
			end
			if murderer and sheriff then
				local roundKey = murderer .. "_" .. sheriff
				if roundKey ~= lastRoundKey then
					lastRoundKey = roundKey
					local myData = roles[player.Name]
					local roleText, roleColor
					if myData and myData.Role == "Murderer" then
						roleText, roleColor = "Murderer", Color3.fromRGB(255, 0, 0)
					elseif myData and myData.Role == "Sheriff" then
						roleText, roleColor = "Sheriff", Color3.fromRGB(0, 0, 255)
					else
						roleText, roleColor = "Innocent", Color3.fromRGB(0, 255, 0)
					end
					if instantRolePerkNotifyEnabled and murdererPerk and murdererPerk ~= "" then
						roleText = roleText .. " | Perk: " .. murdererPerk
					end
					showInstantRoleLabel(roleText, roleColor)
				end
			end
		end
	end
end)


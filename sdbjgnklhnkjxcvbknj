function SkidFling(targetPlayer, noReturn, spinTime)
	if targetPlayer and isPlayerWhitelisted(targetPlayer.Name) then return end
	local characterLocal = player.Character
	local humanoidLocal = characterLocal and characterLocal:FindFirstChildOfClass("Humanoid")
	local rootPartLocal = humanoidLocal and humanoidLocal.RootPart
	local targetCharacter = targetPlayer.Character
	if not targetCharacter then return end

	local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	local targetRootPart = targetHumanoid and targetHumanoid.RootPart
	local targetHead = targetCharacter:FindFirstChild("Head")
	local accessory = targetCharacter:FindFirstChildOfClass("Accessory")
	local handle = accessory and accessory:FindFirstChild("Handle")

	if not (characterLocal and humanoidLocal and rootPartLocal) then
		if not noReturn then
			return notify("Error", "Your character is not ready", 2)
		end
		return
	end

	if not noReturn and rootPartLocal.Velocity.Magnitude < 50 then
		getgenv().OldPos = rootPartLocal.CFrame
	end

	if targetHumanoid and targetHumanoid.Sit then
		if not noReturn then
			return notify("Error", targetPlayer.Name .. " is sitting", 2)
		end
		return
	end

	if targetHead then
		Workspace.CurrentCamera.CameraSubject = targetHead
	elseif handle then
		Workspace.CurrentCamera.CameraSubject = handle
	elseif targetHumanoid then
		Workspace.CurrentCamera.CameraSubject = targetHumanoid
	end

	if not targetCharacter:FindFirstChildWhichIsA("BasePart") then
		return
	end

	-- Spin helper: absolute position (predictive aim), not the victim's stale
	-- position. Velocity/rotation writes stay the same as before.
	local function spinAt(pos, angleCFrame)
		if not (rootPartLocal and characterLocal) then return end
		if not pos then return end
		if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return end
		local cf = CFrame.new(pos) * angleCFrame
		rootPartLocal.CFrame = cf
		characterLocal:SetPrimaryPartCFrame(cf)
		rootPartLocal.Velocity = Vector3.new(9e9, 9e9, 9e9)
		rootPartLocal.RotVelocity = Vector3.new(9e9, 9e9, 9e9)
	end

	local function flingBasePart(basePart)
		local startTime = tick()
		local angle = 0
		local doneFrames = 0
		repeat
			if not rootPartLocal or not targetHumanoid or not basePart or not basePart.Parent then break end
			-- Aim where the victim WILL be. This is the whole fix for runners:
			-- the old code spun around the replicated position, so anyone who
			-- kept moving was already out of reach on every pass.
			local aim = trollInterceptPosition(basePart, rootPartLocal, 0.04) or basePart.Position
			if aim.X ~= aim.X or aim.Y ~= aim.Y or aim.Z ~= aim.Z then break end
			-- NaN / absurd speeds (NaN fling methods push 9e9) must not leak into
			-- the CFrame math.
			local rawVel = basePart.Velocity
			local velMag = rawVel and rawVel.Magnitude or 0
			if velMag ~= velMag then velMag = 0 end
			if velMag > 60 then velMag = 60 end
			-- Capped forward shift: the old uncapped moveDir*(velMag/1.25)
			-- pushed the spin so far ahead of a fast target that it missed.
			local moveDir = targetHumanoid.MoveDirection
			if moveDir.X ~= moveDir.X or moveDir.Y ~= moveDir.Y or moveDir.Z ~= moveDir.Z then
				moveDir = Vector3.zero
			end
			local shift = moveDir * math.min(velMag / 1.25, 6)
			local airborne = false
			pcall(function()
				local state = targetHumanoid:GetState()
				airborne = basePart.AssemblyLinearVelocity.Y > 3
					or state == Enum.HumanoidStateType.Freefall
					or state == Enum.HumanoidStateType.Jumping
			end)
			-- A jumping victim needs a taller sweep than a grounded one.
			local upY, dnY = 1.5, -1.5
			if airborne then upY, dnY = 3.2, -3.2 end
			angle += 100
			local ang = CFrame.Angles(math.rad(angle), 0, 0)
			local high = CFrame.Angles(math.rad(90), 0, 0)
			local zero = CFrame.new()
			-- Above/below and fore/aft of the aim point, plus two horizontal
			-- passes through the torso at a 90° tilt.
			spinAt(aim + shift + Vector3.new(0, upY, 0), ang)
			RunService.Heartbeat:Wait()
			spinAt(aim + shift + Vector3.new(0, dnY, 0), ang)
			RunService.Heartbeat:Wait()
			spinAt(aim - shift + Vector3.new(0, upY, 0), ang)
			RunService.Heartbeat:Wait()
			spinAt(aim - shift + Vector3.new(0, dnY, 0), ang)
			RunService.Heartbeat:Wait()
			spinAt(aim + Vector3.new(0, upY, 0), high)
			RunService.Heartbeat:Wait()
			spinAt(aim + Vector3.new(0, dnY, 0), zero)
			RunService.Heartbeat:Wait()
			spinAt(aim + shift + Vector3.new(0, upY, 0), ang)
			RunService.Heartbeat:Wait()
			doneFrames += 1
			-- Stop as soon as the victim is actually launched (their assembly
			-- speed explodes) instead of pinning them for the full duration.
			if doneFrames >= 2 then
				local launched = false
				pcall(function()
					launched = basePart.AssemblyLinearVelocity.Magnitude > 150
						or (targetHumanoid.Health or 100) <= 0
				end)
				if launched then break end
			end
		until tick() - startTime >= (spinTime or 2) or (noReturn and not loopFlingActive) or (not noReturn and not flingActive)
	end

	Workspace.FallenPartsDestroyHeight = 0 / 0

	-- Selected Fling.lua method drives the force; the spin loop above drives position.
	local flingBase = targetRootPart or targetHead or handle
	if not flingBase then
		humanoidLocal:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
		Workspace.CurrentCamera.CameraSubject = humanoidLocal
		pcall(sethiddenproperty, rootPartLocal, "PhysicsRepRootPart", rootPartLocal)
		return notify("Error", targetPlayer.Name .. " has no valid parts", 2)
	end

	flingMethodTargetRoot = flingBase
	local dir = Vector3.new(0, 1, 0)
	local power = 10
	local methodObjs = nil
	pcall(function()
		local fn = FlingMethods[flingCurrentMethod()]
		if fn then methodObjs = fn(rootPartLocal, power, dir) end
	end)

	humanoidLocal:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	flingBasePart(flingBase)

	flingDestroyMethodObjs(methodObjs)
	flingMethodTargetRoot = nil
	if noReturn then
		-- Loop mode: stay on the target, keep fling physics, no return.
		-- stopLoopFling restores camera/seated state and returns to OldPos.
		return
	end
	humanoidLocal:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	pcall(function() humanoidLocal.PlatformStand = false end)
	Workspace.CurrentCamera.CameraSubject = humanoidLocal
	pcall(sethiddenproperty, rootPartLocal, "PhysicsRepRootPart", rootPartLocal)

	if getgenv().OldPos then
		repeat
			rootPartLocal.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
			characterLocal:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
			humanoidLocal:ChangeState("GettingUp")
			for _, part in ipairs(characterLocal:GetChildren()) do
				if part:IsA("BasePart") then
					part.Velocity = Vector3.zero
					part.RotVelocity = Vector3.zero
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
			task.wait()
		until (rootPartLocal.Position - getgenv().OldPos.Position).Magnitude < 25 or not flingActive
		Workspace.FallenPartsDestroyHeight = getgenv().FPDH
	end
end

function startFling()
	if flingActive then return end
	if loopFlingActive then stopLoopFling() end
	local count = countSelectedTargets()
	if count == 0 then
		if multiFlingStatusLabel then
			multiFlingStatusLabel.Text = "No targets selected!"
			multiFlingStatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			task.delay(1, updateFlingStatus)
		end
		return
	end

	flingActive = true
	updateFlingStatus()
	notify("Started", "Flinging " .. count .. " targets", 2)

	task.spawn(function()
		while flingActive do
			local validTargets = {}
			for name, plr in pairs(selectedTargets) do
				if plr and plr.Parent then
					validTargets[name] = plr
				else
					selectedTargets[name] = nil
					local checkboxData = playerCheckboxes[name]
					if checkboxData then
						if checkboxData.SetSelected then checkboxData.SetSelected(false) else checkboxData.Checkmark.Visible = false end
					end
				end
			end

			for _, plr in pairs(validTargets) do
				if not flingActive then break end
				SkidFling(plr)
				task.wait(0.1)
			end

			updateFlingStatus()
			task.wait(0.5)
		end
	end)
end

function stopFling()
	if not flingActive then return end
flingActive = false
loopFlingActive = false
loopFlingTargetTime = 2
	local character = player.Character
	if character then
		for _, v in pairs(character:GetDescendants()) do
			if v:IsA("BodyVelocity") or v:IsA("BodyForce") or v:IsA("BodyThrust") or
				v:IsA("LinearVelocity") or v:IsA("VectorForce") or v:IsA("RocketPropulsion") or
				v:IsA("AlignPosition") or v:IsA("Torque") then
				pcall(function() v:Destroy() end)
			end
		end
		pcall(function()
			sethiddenproperty(character.HumanoidRootPart, "PhysicsRepRootPart", character.HumanoidRootPart)
		end)
	end
	updateFlingStatus()
	notify("Stopped", "Fling has been stopped", 2)
end

-- Returns our character to the pre-fling position (used by LoopFling on stop).
function flingReturnToOldPos()
	local characterLocal = player.Character
	local humanoidLocal = characterLocal and characterLocal:FindFirstChildOfClass("Humanoid")
	local rootPartLocal = humanoidLocal and humanoidLocal.RootPart
	if not (characterLocal and humanoidLocal and rootPartLocal) then return end
	if getgenv().OldPos then
		local guard = 0
		repeat
			guard += 1
			rootPartLocal.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
			characterLocal:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
			humanoidLocal:ChangeState("GettingUp")
			for _, part in ipairs(characterLocal:GetChildren()) do
				if part:IsA("BasePart") then
					part.Velocity = Vector3.zero
					part.RotVelocity = Vector3.zero
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
			task.wait()
		until (rootPartLocal.Position - getgenv().OldPos.Position).Magnitude < 25 or not rootPartLocal.Parent or guard > 300
		Workspace.FallenPartsDestroyHeight = getgenv().FPDH
	end
end

function startLoopFling()
	if loopFlingActive then return end
	if flingActive then stopFling() end
	local characterLocal = player.Character
	local rootPartLocal = characterLocal and characterLocal:FindFirstChild("HumanoidRootPart")
	if not rootPartLocal then
		return notify("Error", "Your character is not ready", 2)
	end
	local count = countSelectedTargets()
	if count == 0 then
		if multiFlingStatusLabel then
			multiFlingStatusLabel.Text = "No targets selected!"
			multiFlingStatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
			task.delay(1, updateFlingStatus)
		end
		return
	end
	getgenv().OldPos = rootPartLocal.CFrame

	loopFlingActive = true
	updateFlingStatus()
	notify("Started", "Loop flinging " .. count .. " target(s)", 2)

	task.spawn(function()
		while loopFlingActive do
			local myChar = player.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myRoot then
				task.wait(1)
			else
				local validTargets = {}
				for name, plr in pairs(selectedTargets) do
					if plr and plr.Parent then
						validTargets[name] = plr
					else
						selectedTargets[name] = nil
						local checkboxData = playerCheckboxes[name]
						if checkboxData then
							if checkboxData.SetSelected then checkboxData.SetSelected(false) else checkboxData.Checkmark.Visible = false end
						end
					end
				end

				for _, plr in pairs(validTargets) do
					if not loopFlingActive then break end
					pcall(SkidFling, plr, true, loopFlingTargetTime)
				end

				updateFlingStatus()
				task.wait(0.5)
			end
		end
	end)
end

function stopLoopFling()
	if not loopFlingActive then return end
	loopFlingActive = false
	task.spawn(function()
		task.wait(0.3)
		local characterLocal = player.Character
		if characterLocal then
			for _, v in pairs(characterLocal:GetDescendants()) do
				if v:IsA("BodyVelocity") or v:IsA("BodyForce") or v:IsA("BodyThrust") or
					v:IsA("LinearVelocity") or v:IsA("VectorForce") or v:IsA("RocketPropulsion") or
					v:IsA("AlignPosition") or v:IsA("Torque") then
					pcall(function() v:Destroy() end)
				end
			end
		end
		local humanoidLocal = characterLocal and characterLocal:FindFirstChildOfClass("Humanoid")
		local rootPartLocal = humanoidLocal and humanoidLocal.RootPart
		if humanoidLocal and rootPartLocal then
			humanoidLocal:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
			pcall(function() humanoidLocal.PlatformStand = false end)
			Workspace.CurrentCamera.CameraSubject = humanoidLocal
			pcall(sethiddenproperty, rootPartLocal, "PhysicsRepRootPart", rootPartLocal)
		end
		flingReturnToOldPos()
	end)
	updateFlingStatus()
	notify("Stopped", "Loop fling has been stopped", 2)
end

-- Spectate (IY view/unview logic): spectate the first valid selected target
-- from the fling list instead of typing a nickname.
spectateTargetName = nil
spectateDiedConn = nil
spectateChangedConn = nil

function startSpectate()
	local names = {}
	for name, plr in pairs(selectedTargets) do
		if plr and plr.Parent and plr.Character then
			names[#names + 1] = name
		end
	end
	if #names == 0 then
		return notify("Spectate", "No targets selected!", 2)
	end
	if #names > 1 then
		return notify("Spectate", "Select only ONE player!", 2)
	end
	table.sort(names)
	local plr = selectedTargets[names[1]]
	if not (plr and plr.Parent and plr.Character) then
		return notify("Spectate", "Target is not available", 2)
	end
	stopSpectate(true)
	spectateTargetName = plr.Name
	Workspace.CurrentCamera.CameraSubject = plr.Character
	spectateDiedConn = plr.CharacterAdded:Connect(function(newChar)
		task.wait()
		if spectateTargetName == plr.Name and newChar then
			Workspace.CurrentCamera.CameraSubject = newChar
		end
	end)
	spectateChangedConn = Workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
		if spectateTargetName then
			local t = Players:FindFirstChild(spectateTargetName)
			local tc = t and t.Character
			if tc and Workspace.CurrentCamera.CameraSubject ~= tc then
				Workspace.CurrentCamera.CameraSubject = tc
			end
		end
	end)
	notify("Spectate", "Viewing " .. plr.Name, 2)
end

function stopSpectate(silent)
	if spectateDiedConn then
		spectateDiedConn:Disconnect()
		spectateDiedConn = nil
	end
	if spectateChangedConn then
		spectateChangedConn:Disconnect()
		spectateChangedConn = nil
	end
	if not spectateTargetName then return end
	spectateTargetName = nil
	local myChar = player.Character
	if myChar then
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		Workspace.CurrentCamera.CameraSubject = myHum or myChar
	end
	if not silent then
		notify("Spectate", "View turned off", 2)
	end
end

Players.PlayerRemoving:Connect(function(leftPlr)
	if spectateTargetName and leftPlr and leftPlr.Name == spectateTargetName then
		stopSpectate(true)
		notify("Spectate", "Target left the game", 2)
	end
end)

function stopCurrentAnimation()
	if animationTrack then
		-- pcall: the track may belong to a dead character (respawn) and :Stop()
		-- would throw, leaving playingAnimationId stuck forever. Always clear it.
		pcall(function() animationTrack:Stop() end)
		animationTrack = nil
	end
	if playingAnimationId ~= 0 and animationUiById[playingAnimationId] then
		animationUiById[playingAnimationId].Button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		animationUiById[playingAnimationId].Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
	playingAnimationId = 0
	if updateAllDetachedEmoteVisuals then updateAllDetachedEmoteVisuals() end
end

function playAnimation(animationId, speedValue)
	local currentCharacter = player.Character
	if not currentCharacter then return end
	local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
	if not currentHumanoid then return end

	stopCurrentAnimation()
	animationObject.AnimationId = "rbxassetid://" .. tostring(animationId)
	animationTrack = currentHumanoid:LoadAnimation(animationObject)
	animationTrack.Looped = true
	animationTrack.Priority = Enum.AnimationPriority.Action
	animationTrack:Play()
	animationTrack:AdjustSpeed(tonumber(speedValue) or 1)
	playingAnimationId = animationId

	if animationUiById[animationId] then
		animationUiById[animationId].Button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		animationUiById[animationId].Button.TextColor3 = Color3.fromRGB(0, 0, 0)
	end
	if updateAllDetachedEmoteVisuals then updateAllDetachedEmoteVisuals() end
end

-- ============================================
-- Detached emote buttons (выносимые кнопки эмоций)
-- A star toggle (☆/★) on each emote row pops that emote out as a small draggable
-- on-screen button, so emotes like Take the L, Dahood Stomp, etc. can be played
-- without opening the menu. Position + which emotes are detached are saved to the
-- config and restored on the next load.
-- ============================================
detachedEmotes = {}

function isEmoteDetached(animationId)
	return detachedEmotes[animationId] ~= nil
end

function updateDetachedEmoteVisual(animationId)
	local d = detachedEmotes[animationId]
	if not d or not d.btn then return end
	if playingAnimationId == animationId then
		d.btn.BackgroundColor3 = extractedBtnActiveBgColor
		d.btn.TextColor3 = extractedBtnActiveTextColor
	else
		d.btn.BackgroundColor3 = extractedBtnBgColor
		d.btn.TextColor3 = extractedBtnTextColor
	end
end

function updateAllDetachedEmoteVisuals()
	for id in pairs(detachedEmotes) do
		updateDetachedEmoteVisual(id)
	end
end

function removeDetachedEmote(animationId, skipSave)
	local d = detachedEmotes[animationId]
	if not d then return end
	if d.conns then
		for _, c in ipairs(d.conns) do pcall(function() c:Disconnect() end) end
	end
	if d.frame then d.frame:Destroy() end
	detachedEmotes[animationId] = nil
	-- Also drop it from the loaded config so the keep-saved-emotes merge in saveConfig
	-- doesn't resurrect an intentionally removed button.
	if loadedConfig and loadedConfig.detachedEmotes then loadedConfig.detachedEmotes[tostring(animationId)] = nil end
	local ui = animationUiById[animationId]
	if ui and ui.PopOut then ui.PopOut.Text = "☆" end
	if not skipSave then pcall(saveConfig) end
end

function createDetachedEmote(animationId, animationName, savedPos, skipSave, savedLocked)
	if not popupBtnGui then return end
	if detachedEmotes[animationId] then return end
	local ui = animationUiById[animationId]
	animationName = animationName or (ui and ui.Name) or "Emote"

	-- Built with the exact same anatomy as the other extracted buttons (border frame +
	-- inner TextScaled button + U/L lock button) so the "Popup Button Size" controls
	-- resize it too and it matches their look.
	local frame = Instance.new("Frame")
	frame.Name = "DetachedEmote_" .. tostring(animationId)
	frame.Size = UDim2.new(0, popupBtnWidth, 0, popupBtnHeight)
	if savedPos then
		frame.Position = UDim2.new(savedPos.X.Scale, savedPos.X.Offset, savedPos.Y.Scale, savedPos.Y.Offset)
	else
		local n = 0
		for _ in pairs(detachedEmotes) do n = n + 1 end
		frame.Position = UDim2.new(0, 140, 0, 120 + n * (popupBtnHeight + 6))
	end
	frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Parent = popupBtnGui

	local borderStroke = Instance.new("UIStroke")
	borderStroke.Color = popupStrokeColor or Color3.fromRGB(255, 255, 255)
	borderStroke.Thickness = 1.5
	borderStroke.Transparency = popupStrokeTransparency or 0
	borderStroke.Enabled = popupStrokesEnabled
	borderStroke.Parent = frame

	local borderCorner = Instance.new("UICorner")
	borderCorner.CornerRadius = (shapeCornerMap and popupShapeMode and shapeCornerMap[popupShapeMode]) or UDim.new(0, 6)
	borderCorner.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -30, 1, -4)
	btn.Position = UDim2.new(0, 2, 0, 2)
	btn.BackgroundColor3 = extractedBtnBgColor
	btn.BackgroundTransparency = popupBgTransparency
	btn.TextColor3 = extractedBtnTextColor
	btn.Text = animationName
	btn.Font = Enum.Font.SourceSansBold
	btn.TextScaled = true
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.ClipsDescendants = true
	btn.Parent = frame
	pcall(function()
		btn:SetAttribute("ClickSoundHooked", true)
	end)
	btn.MouseButton1Click:Connect(function() playClickSoundThrottled() end)
	if addBtnPressAnim then addBtnPressAnim(btn) end
	local btnTSC = Instance.new("UITextSizeConstraint")
	btnTSC.MaxTextSize = 17
	btnTSC.MinTextSize = 9
	btnTSC.Parent = btn

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = (shapeCornerMap and popupShapeMode and shapeCornerMap[popupShapeMode]) or UDim.new(0, 6)
	btnCorner.Parent = btn

	local lockBtn = Instance.new("TextButton")
	lockBtn.Size = UDim2.new(0, 22, 0, 22)
	lockBtn.Position = UDim2.new(1, -27, 0.5, -11)
	lockBtn.BackgroundColor3 = extractedBtnBgColor
	lockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	lockBtn.Text = "U"
	lockBtn.Font = Enum.Font.SourceSansBold
	lockBtn.TextSize = 12
	lockBtn.AutoButtonColor = false
	lockBtn.BorderSizePixel = 0
	lockBtn.Parent = frame
	lockBtn.BackgroundTransparency = miniLockBgTransparency
	pcall(function() refreshMiniLockBtn(lockBtn, false) end)
	pcall(function()
		lockBtn:SetAttribute("ClickSoundHooked", true)
	end)
	lockBtn.MouseButton1Click:Connect(function() playClickSoundThrottled() end)

	local lockCorner = Instance.new("UICorner")
	lockCorner.CornerRadius = UDim.new(0, 4)
	lockCorner.Parent = lockBtn

	local d = { frame = frame, btn = btn, popupBtn = btn, popupLockBtn = lockBtn, name = animationName, conns = {} }
	detachedEmotes[animationId] = d
	if hideMiniButtonsEnabled and lockBtn then lockBtn.Visible = false; btn.Size = UDim2.new(1, -4, 1, -4) end

	if savedLocked then
		lockBtn.Text = "L"
		lockBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
		pcall(function() refreshMiniLockBtn(lockBtn, true) end)
	end

	lockBtn.MouseButton1Click:Connect(function()
		if lockBtn.Text == "L" then
			lockBtn.Text = "U"
			lockBtn.BackgroundColor3 = extractedBtnBgColor
		else
			lockBtn.Text = "L"
			lockBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
		end
		pcall(function() refreshMiniLockBtn(lockBtn, lockBtn.Text == "L") end)
		pcall(saveConfig)
	end)

	local dragging, moved, justDragged, startPos, framePos, dragIpt = false, false, false, nil, nil, nil
	-- Drag handlers live on the inner button so the whole pill can be moved by holding
	-- it (important on touch screens). The U/L button locks dragging exactly like the
	-- other extracted buttons. A small threshold + justDragged flag keeps a normal tap
	-- playing the emote and stops a drag from triggering it.
	table.insert(d.conns, btn.InputBegan:Connect(function(ipt)
		if popupDragLocked or lockBtn.Text == "L" then return end
		if ipt.UserInputType == Enum.UserInputType.MouseButton1 or ipt.UserInputType == Enum.UserInputType.Touch then
			dragging = true; moved = false; startPos = ipt.Position; framePos = frame.Position; dragIpt = ipt
		end
	end))
	table.insert(d.conns, btn.InputChanged:Connect(function(ipt)
		if ipt.UserInputType == Enum.UserInputType.MouseMovement or ipt.UserInputType == Enum.UserInputType.Touch then
			dragIpt = ipt
		end
	end))
	table.insert(d.conns, UserInputService.InputChanged:Connect(function(ipt)
		if popupDragLocked or lockBtn.Text == "L" then return end
		if ipt == dragIpt and dragging then
			local delta = ipt.Position - startPos
			if delta.Magnitude >= 5 then moved = true end
			if moved then
				frame.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
			end
		end
	end))
	table.insert(d.conns, btn.InputEnded:Connect(function(ipt)
		if ipt.UserInputType == Enum.UserInputType.MouseButton1 or ipt.UserInputType == Enum.UserInputType.Touch then
			-- Touch screens often emit BOTH Touch and MouseButton1 InputEnded for a
			-- single tap; without this guard one tap would toggle twice (play then
			-- instantly replay), so the emote looks unstoppable.
			local nowTap = os.clock()
			if d.lastTapT and (nowTap - d.lastTapT) < 0.35 and ipt.UserInputType ~= d.lastTapType then
				dragging = false; moved = false; dragIpt = nil
				return
			end
			d.lastTapT = nowTap
			d.lastTapType = ipt.UserInputType
			local wasDragged = dragging and moved
			dragging = false; moved = false; dragIpt = nil
			if wasDragged then
				pcall(saveConfig)
			else
				-- Toggle: second press stops the emote/animation instead of replaying it
				if playingAnimationId == animationId then
					stopCurrentAnimation()
				else
					local stoppedEmote = false
					if d.emoteTrack then
						local stillPlaying = false
						pcall(function() stillPlaying = d.emoteTrack.IsPlaying end)
						if stillPlaying then
							pcall(function() d.emoteTrack:Stop() end)
							stoppedEmote = true
						end
						d.emoteTrack = nil
					end
					if not stoppedEmote then
						local char2 = player.Character
						local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
						if hum2 and hum2.RigType == Enum.HumanoidRigType.R15 then
							local desc = hum2:FindFirstChildOfClass("HumanoidDescription")
							local isEmote = false
							if emoteOrder then for _, e in ipairs(emoteOrder) do if e.id == animationId then isEmote = true; break end end end
							local track
							local ok = false
							if isEmote then
								ok = pcall(function() track = hum2:PlayEmoteAndGetAnimTrackById(animationId) end)
								if not ok and desc then
									local nm = (emoteUiById[animationId] and emoteUiById[animationId].Name) or ("Emote "..tostring(animationId))
									pcall(function() desc:AddEmote(nm, animationId) end)
									pcall(function() track = hum2:PlayEmoteAndGetAnimTrackById(animationId) end)
								end
							end
							if not track then
								local spd = (emoteUiById[animationId] and emoteUiById[animationId].Box and emoteUiById[animationId].Box.Text) or (animationUiById[animationId] and animationUiById[animationId].Box and animationUiById[animationId].Box.Text) or "1"
								pcall(function() playAnimation(animationId, spd) end)
							elseif track then
								d.emoteTrack = track
								local s = tonumber((emoteUiById[animationId] and emoteUiById[animationId].Box and emoteUiById[animationId].Box.Text) or "1") or 1
								pcall(function() track:AdjustSpeed(s) end)
							end
						elseif hum2 then
							notify("Emotions", "R15 required", 2)
						end
					end
					updateDetachedEmoteVisual(animationId)
				end
			end
		end
	end))

	if ui and ui.PopOut then ui.PopOut.Text = "★" end
	updateDetachedEmoteVisual(animationId)
	if not skipSave then pcall(saveConfig) end
end



-- Hide Mini Buttons: hides the small lock buttons shown on extracted buttons
hideMiniButtonsEnabled = false

function applyHideMiniButtons()
	-- When mini buttons are hidden, the inner text button expands over the freed space:
	-- the text fills the whole pill and the whole area becomes a drag zone.
	local fullSize = UDim2.new(1, -4, 1, -4)
	local normalSize = UDim2.new(1, -30, 1, -4)
	for _, data in pairs(extractedButtons) do
		if data.popupLockBtn then
			data.popupLockBtn.Visible = not hideMiniButtonsEnabled
			if data.popupBtn then
				data.popupBtn.Size = hideMiniButtonsEnabled and fullSize or normalSize
			end

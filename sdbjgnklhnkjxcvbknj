-- Own function on purpose: the main chunk is near the 200-local limit, so the
-- per-owner widgets keep their locals in this scope instead of the chunk.
function buildSubTabPositionRows(frame, startOrder)
	if not frame then return startOrder end
	local cursor = startOrder or 946.5
	for _, owner in ipairs(subTabOwnerSequence) do
		local entry = subTabButtons[owner]
		if entry and #entry.names > 0 then
			cursor = cursor + 0.2
			local ownerHdr = Instance.new("TextLabel")
			ownerHdr.Name = "SubTabsPositionsHeader_" .. owner
			ownerHdr.Size = UDim2.new(1, 0, 0, 24)
			ownerHdr.BackgroundTransparency = 1
			ownerHdr.Text = owner .. " Sub-tabs"
			ownerHdr.TextColor3 = Color3.fromRGB(255, 255, 255)
			ownerHdr.TextXAlignment = Enum.TextXAlignment.Left
			ownerHdr.Font = Enum.Font.SourceSansBold
			ownerHdr.TextSize = 15
			ownerHdr.LayoutOrder = cursor
			ownerHdr.Parent = frame
			subTabOrderHeaders[owner] = ownerHdr
			subTabOrderRows[owner] = {}
			subTabOrderRowRefs[owner] = {}

			for i = 1, #entry.names do
				cursor = cursor + 0.1
				local row = Instance.new("Frame")
				row.Name = "SubTabOrderRow_" .. owner .. "_" .. i
				row.Size = UDim2.new(1, 0, 0, 32)
				row.BackgroundTransparency = 1
				row.LayoutOrder = cursor
				row.Parent = frame

				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, -80, 1, 0)
				label.BackgroundTransparency = 1
				label.Text = "-"
				label.TextColor3 = Color3.fromRGB(255, 255, 255)
				label.Font = Enum.Font.SourceSansBold
				label.TextSize = 15
				label.TextXAlignment = Enum.TextXAlignment.Left
				label.Parent = row

				local function makeSubArrow(text, xOffset)
					local b = Instance.new("TextButton")
					b.Size = UDim2.new(0, 34, 0, 26)
					b.Position = UDim2.new(1, xOffset, 0.5, -13)
					b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
					b.TextColor3 = Color3.fromRGB(255, 255, 255)
					b.Text = text
					b.Font = Enum.Font.SourceSansBold
					b.TextSize = 16
					b.AutoButtonColor = false
					b.Parent = row
					Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
					return b
				end

				local up = makeSubArrow("^", -74)
				local down = makeSubArrow("v", -36)
				subTabOrderRows[owner][i] = row
				subTabOrderRowRefs[owner][i] = { label = label, up = up, down = down }

				up.MouseButton1Click:Connect(function()
					moveSubTabOrder(owner, i, -1)
				end)
				down.MouseButton1Click:Connect(function()
					moveSubTabOrder(owner, i, 1)
				end)
			end
		end
	end
	return cursor
end


	{"run","Run"}, {"jump","Jump"}, {"climb","Climb"}, {"fall","Fall"}, {"swim","Swim"}, {"swimidle","Swim Idle"} }

-- NOTE: global (not local) on purpose: the chunk is at the local-registers limit.
function customSlotId(holder, child, id)
	if not (holder and child and holder:FindFirstChild(child)) then return end
	-- Only overwrite slots the user actually filled: empty slots stay at their
	-- default IDs instead of becoming broken "rbxassetid://nil" assets.
	if id == nil then return end
	local s = tostring(id):gsub("%s", "")
	if s == "" then return end
	holder[child].AnimationId = "rbxassetid://" .. s
end

function applyCustomAnim(char, slots)
	local animate = char:WaitForChild("Animate", 10)
	if not animate then return end
	captureAnimOriginals(char)
	if not ensureAnimateReady(animate) then task.wait(0.3) if not ensureAnimateReady(animate, 2) then return end end
	local humanoid = char:WaitForChild("Humanoid", 5)
	if not humanoid then return end
	local animator = humanoid:FindFirstChild("Animator") or humanoid:WaitForChild("Animator", 5)
	if not animator then return end
	pcall(function() for _, track in pairs(animator:GetPlayingAnimationTracks()) do track:Stop() end end)
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then return end
	pcall(function()
		customSlotId(animate.idle, "Animation1", slots.idle1 or slots.idle)
		customSlotId(animate.idle, "Animation2", slots.idle2 or slots.idle)
		if slots.pose then
			local poseId = tostring(slots.pose):gsub("%s", "")
			if animate.idle:FindFirstChild("Animation3") then
				animate.idle.Animation3.AnimationId = "rbxassetid://" .. poseId
			else
				local pose = Instance.new("Animation"); pose.Name = "Animation3"
				pose.AnimationId = "rbxassetid://" .. poseId; pose.Parent = animate.idle
			end
		end
		customSlotId(animate.walk, "WalkAnim", slots.walk)
		customSlotId(animate.run, "RunAnim", slots.run)
		customSlotId(animate.jump, "JumpAnim", slots.jump)
		customSlotId(animate.climb, "ClimbAnim", slots.climb)
		customSlotId(animate.fall, "FallAnim", slots.fall)
		customSlotId(animate.swim, "Swim", slots.swim)
		customSlotId(animate.swimidle, "SwimIdle", slots.swimid)
	end)
	pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	pcall(function() animate.Disabled = false end)
end

-- Preloads custom animation assets in the background so the first apply
-- (and every re-apply after respawn) doesn't stall on downloading them.
function preloadCustomAnim(slots)
	if not slots then return end
	task.spawn(function()
		pcall(function()
			local cp = game:GetService("ContentProvider")
			local assets = {}
			for _, def in ipairs(customSlotDefs) do
				local v = slots[def[1]]
				if v ~= nil and tostring(v):gsub("%s", "") ~= "" then
					local a = Instance.new("Animation")
					a.AnimationId = "rbxassetid://" .. tostring(v):gsub("%s", "")
					table.insert(assets, a)
				end
			end
			if #assets > 0 then cp:PreloadAsync(assets) end
			for _, a in ipairs(assets) do pcall(function() a:Destroy() end) end
		end)
	end)
end

function enableCustomAnim(name)
	disableAnyOtherAnim()
	activeCustomAnimName = name
	local e0 = findCustomAnimByName(name)
	if e0 then preloadCustomAnim(e0) end
	customAnimConn = player.CharacterAdded:Connect(function(c)
		if activeCustomAnimName == name then
			local e = findCustomAnimByName(name)
			if e then applyCustomAnim(c, e) end
		end
	end)
	if player.Character then
		local e = findCustomAnimByName(name)
		if e then applyCustomAnim(player.Character, e) end
	end
	customRefreshUi()
	pcall(saveConfig)
end

function disableCustomAnim()
	if customAnimConn then customAnimConn:Disconnect() customAnimConn = nil end
	activeCustomAnimName = nil
	restoreCharacterAnimations(player.Character)
	customRefreshUi()
	pcall(saveConfig)
end


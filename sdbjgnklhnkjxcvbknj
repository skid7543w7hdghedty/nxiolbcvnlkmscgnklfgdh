		task.wait(1)
		for _, otherPlr in Players:GetPlayers() do
			if otherPlr ~= plr and otherPlr ~= player then
				local ok, result = pcall(function()
					return plr:IsFriendsWith(otherPlr.UserId)
				end)
				if not (ok and result) then
					task.wait(0.15)
					ok, result = pcall(function()
						return otherPlr:IsFriendsWith(plr.UserId)
					end)
				end
				if ok and result then
					local found = false
					for _, pair in ipairs(teamerFriendships) do
						if (pair[1] == plr and pair[2] == otherPlr) or (pair[1] == otherPlr and pair[2] == plr) then
							found = true
							break
						end
					end
					if not found then
						table.insert(teamerFriendships, {plr, otherPlr})
					end
				end
				task.wait(0.15)
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and teamerFriendLabels and teamerFriendLabels[p.Name] then
				local count = 0
				for _, pair in ipairs(teamerFriendships) do
					if pair[1] == p or pair[2] == p then
						count = count + 1
					end
				end
				teamerFriendLabels[p.Name].Text = "Friends: " .. count
			end
		end
	end)
end)


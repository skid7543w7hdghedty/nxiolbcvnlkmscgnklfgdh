	lucideIconFallbacks = lucideIconFallbacks or {lock = "🔒", ["lock-open"] = "🔓", search = "🔍"}
	function lucideIconAsset(name)
		if not name or name == "" then return nil end
		local localPath = lucideIconFolder .. "/" .. name .. ".png"
		local asset = nil
		pcall(function()
			if isfile and isfile(localPath) and getcustomasset then
				asset = getcustomasset(localPath)
			end
		end)
		if asset and asset ~= "" then return asset end
		local urls = {
			"https://unpkg.com/lucide-static@" .. tostring(lucideIconVersion) .. "/icons/" .. name .. ".png",
			"https://cdn.jsdelivr.net/npm/lucide-static@" .. tostring(lucideIconVersion) .. "/icons/" .. name .. ".png",
		}
		for _, u in ipairs(urls) do
			local ok = pcall(function()
				makefolder(lucideIconFolder)
				writefile(localPath, game:HttpGet(u))
				if getcustomasset then asset = getcustomasset(localPath) end
			end)
			if ok and asset and asset ~= "" then return asset end
		end
		return nil
	end

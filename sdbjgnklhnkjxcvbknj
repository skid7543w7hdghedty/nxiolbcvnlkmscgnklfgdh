	for i, btn in ipairs(animStyleBtns) do
		btn.Position = UDim2.new(0, (i - 1) * (styleBtnW + styleBtnGap) - styleOffset, 0.5, -14)
	end
end

local function updateStyleHighlight()
	for i, btn in ipairs(animStyleBtns) do
		if i == animationStyle then
			btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			btn.TextColor3 = Color3.fromRGB(0, 0, 0)
		else
			btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end
end

local function clampStyleOffset()
	local totalW = #animStyles * (styleBtnW + styleBtnGap) - styleBtnGap
	local visible = styleClip.AbsoluteSize.X
	local maxOff = math.max(0, totalW - visible)
	styleOffset = math.clamp(styleOffset, 0, maxOff)
end

for i, styleName in ipairs(animStyles) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, styleBtnW, 0, 28)
	btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = styleName
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 11
	btn.BorderSizePixel = 0
	btn.Parent = styleClip

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 4)
	btnCorner.Parent = btn

	btn.MouseButton1Click:Connect(function()
		animationStyle = i
		updateStyleHighlight()
		saveConfig()
	end)
	table.insert(animStyleBtns, btn)
end
updateStylePositions()
updateStyleHighlight()


-- ============================================
-- Lay & Freeze (from IY) — Utilities tab
-- ============================================
layEnabled = false
freezeEnabled = false

function doLay()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChildWhichIsA("Humanoid")
	if not humanoid then return end
	humanoid.Sit = true
	task.wait(0.1)
	if humanoid.RootPart then
		humanoid.RootPart.CFrame = humanoid.RootPart.CFrame * CFrame.Angles(math.pi * 0.5, 0, 0)
	end
	for _, v in ipairs(humanoid:GetPlayingAnimationTracks()) do
		v:Stop()
	end
end

function doFreeze()
	local char = player.Character
	if not char then return end
	for _, x in ipairs(char:GetDescendants()) do
		if x:IsA("BasePart") and not x.Anchored then
			x.Anchored = true
		end
	end
end

function doUnfreeze()
	local char = player.Character
	if not char then return end
	for _, x in ipairs(char:GetDescendants()) do
		if x:IsA("BasePart") and x.Anchored then
			x.Anchored = false
		end
	end
end

function toggleLay()
	layEnabled = not layEnabled
	if layEnabled then
		doLay()
	else
		local char = player.Character
		if char then
			local humanoid = char:FindFirstChildWhichIsA("Humanoid")
			if humanoid then humanoid.Sit = false end
		end
	end
end

function toggleFreeze()
	freezeEnabled = not freezeEnabled
	if freezeEnabled then
		doFreeze()
	else
		doUnfreeze()
	end
end

-- ============ Auto Freeze Glitch ============
-- A standalone anti-void save that instantly applies Freeze the moment it
-- rescues the character from the void. Unlike Anti-Void it never enables or
-- disables other features on its own toggling; the automatic freeze is released
-- on death of the local player or when the round roles get reset
-- (Murderer/Sheriff change), and Anti-Void is switched off along with it.
autoFreezeGlitchEnabled = false
-- True while the current freeze was applied by this feature (not the user),
-- so a manual user freeze is never touched by the auto-unfreeze.
autoFreezeGlitchFrozeByUs = false
autoFreezeGlitchLastRoundKey = nil
-- Snapshot of the destroy height used by the feature's own rescue.
autoFreezeGlitchBaseHeight = nil
autoFreezeGlitchSteppedConn = nil

function autoFreezeGlitchUpdateFreezeUI()
	if freezeButton then setToggleState(freezeButton, freezeEnabled, "Freeze: ON", "Freeze: OFF") end
	setExtractedBtnState("Freeze", freezeEnabled)
end

-- Releases only the freeze that this feature applied.
function autoFreezeGlitchReleaseFreeze()
	if not autoFreezeGlitchFrozeByUs then return end
	autoFreezeGlitchFrozeByUs = false
	freezeEnabled = false
	doUnfreeze()
	autoFreezeGlitchUpdateFreezeUI()
end

-- On death / role reset the feature also switches off Anti-Void, so it does
-- not keep interfering with the character after the automatic freeze is gone.
function autoFreezeGlitchDisableAntiVoid()
	if antiVoidEnabled then
		toggleAntiVoid()
		if antiVoidButton then setToggleState(antiVoidButton, false, "Anti-Void: ON", "Anti-Void: OFF") end
		setExtractedBtnState("Anti-Void", false)
	end
end

-- Applies the freeze right after a save (the feature's own rescue or, when
-- Anti-Void happens to be running, its own rescue through the hook in
-- antiVoidFixchar).
function autoFreezeGlitchOnVoidSave()
	if freezeEnabled then return end -- already frozen (e.g. manually), nothing to do
	freezeEnabled = true
	doFreeze()
	autoFreezeGlitchFrozeByUs = true
	autoFreezeGlitchUpdateFreezeUI()
	notify("Auto Freeze Glitch", "Void save — frozen. Unfreezes on death or role reset.", 3)
end

-- The feature's own rescue: the same math as Anti-Void (PivotTo above the
-- destroy height, zero all velocities) followed by the instant freeze.
function autoFreezeGlitchSaveChar(part)
	local char = player.Character
	if not char then return end
	local piv = char:GetPivot()
	char:PivotTo(CFrame.new(piv.Position.X, autoFreezeGlitchBaseHeight + antiVoidDhto + char:GetExtentsSize().Y, piv.Position.Z))
	if part then
		part.Velocity = Vector3.new(0,0,0)
	end
	for _, v in ipairs(char:GetChildren()) do
		if v:IsA("BasePart") then
			v.Velocity = Vector3.new(0,0,0)
		end
	end
	autoFreezeGlitchOnVoidSave()
end

-- Watches the character against the destroy height (same prediction as
-- Anti-Void) and rescues + freezes it before the game destroys the parts.
function autoFreezeGlitchStartVoidWatcher()
	autoFreezeGlitchSteppedConn = game:GetService("RunService").Stepped:Connect(function()
		local char = player.Character
		if char and char:FindFirstChildWhichIsA("BasePart") then
			local part = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
			local cfr = (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame) or char:GetPivot()
			local heightNew = autoFreezeGlitchBaseHeight + antiVoidDhoffset
			if cfr.Position.Y < heightNew then
				autoFreezeGlitchSaveChar(part)
				return
			end
			local partvel = part.Velocity
			if (partvel.Y / antiVoidFpsdiv) + part.Position.Y < heightNew then
				autoFreezeGlitchSaveChar(part)
			end
		end
	end)
end

-- Checks the local player death and polls the Murderer/Sheriff pair: on
-- death or on a role reset the automatic freeze is released.
function autoFreezeGlitchStartWatcher()
	task.spawn(function()
		while autoFreezeGlitchEnabled do
			task.wait(1)
			-- Local player died -> release the automatic freeze.
			if autoFreezeGlitchFrozeByUs and freezeEnabled then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not char or (hum and hum.Health <= 0) then
					autoFreezeGlitchReleaseFreeze()
					autoFreezeGlitchDisableAntiVoid()
					notify("Auto Freeze Glitch", "You died — Freeze and Anti-Void disabled.", 3)
				end
			end
			local ok, result = pcall(function() return invokePlayerData() end)
			if ok and result then
				local murdererName, sheriffName
				for name, data in pairs(result) do
					if data.Role == "Murderer" then
						murdererName = name
					elseif data.Role == "Sheriff" then
						sheriffName = name
					end
				end
				local roundKey = (murdererName or "") .. "_" .. (sheriffName or "")
				if autoFreezeGlitchFrozeByUs and freezeEnabled and roundKey ~= autoFreezeGlitchLastRoundKey then
					autoFreezeGlitchReleaseFreeze()
					autoFreezeGlitchDisableAntiVoid()
					notify("Auto Freeze Glitch", "Roles reset — Freeze and Anti-Void disabled.", 3)
				end
				autoFreezeGlitchLastRoundKey = roundKey
			end
		end
	end)
end

function enableAutoFreezeGlitch()
	-- Snapshot the destroy height for the feature's own rescue. Reuses the
	-- original height Anti-Void keeps around so both stay consistent.
	autoFreezeGlitchBaseHeight = antiVoidDestroyHeight or workspace.FallenPartsDestroyHeight
	autoFreezeGlitchStartVoidWatcher()
	autoFreezeGlitchStartWatcher()
end

function disableAutoFreezeGlitch()
	autoFreezeGlitchReleaseFreeze()
	if autoFreezeGlitchSteppedConn then
		autoFreezeGlitchSteppedConn:Disconnect()
		autoFreezeGlitchSteppedConn = nil
	end
	autoFreezeGlitchLastRoundKey = nil
end

function toggleAutoFreezeGlitch()
	autoFreezeGlitchEnabled = not autoFreezeGlitchEnabled
	if autoFreezeGlitchEnabled then
		enableAutoFreezeGlitch()
	else
		disableAutoFreezeGlitch()
	end
end


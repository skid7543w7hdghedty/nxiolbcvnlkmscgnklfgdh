clumsyGhostAdornments = {}

function clearClumsyAdornments()
	for _, ad in ipairs(clumsyGhostAdornments) do
		if ad and ad.Parent then
			ad:Destroy()
		end
	end
	table.clear(clumsyGhostAdornments)
end


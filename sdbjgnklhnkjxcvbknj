function tpToRole(roleName)
	tpGetRoles()
	if not tpRoles then
		notify("Error", "Could not get roles", 2)
		return
	end

	-- Prefer the PHYSICAL gun holder for Sheriff/Hero: role flags can lag right
	-- after a death, so "TP to Hero" would send us to a stale/dead hero instead
	-- of the live player who actually holds the Gun tool now.
	local physHolder = nil
	if roleName == "Sheriff" or roleName == "Hero" then
		physHolder = findCurrentGunHolderPlayer()
	end

	local lastTarget = nil
	local lastName = nil
	local lastAliveTarget = nil
	local lastAliveName = nil

	if physHolder then
		local ch = physHolder.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			lastTarget = physHolder
			lastName = physHolder.Name
			lastAliveTarget = physHolder
			lastAliveName = physHolder.Name
		else
			lastTarget = physHolder
			lastName = physHolder.Name
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local data = tpRoles[plr.Name]
			if data then
				local isTarget = false

				if roleName == "Sheriff" then
					isTarget = (data.Role == "Sheriff" or data.HasGun)
				elseif roleName == "Hero" then
					-- Only the CURRENT hero (Role "Hero" AND holding the gun): a dead /
					-- old hero whose Role is still "Hero" must not be teleported to.
					isTarget = (data.Role == "Hero" and data.HasGun)
				elseif roleName == "Murderer" then
					isTarget = (data.Role == "Murderer")
				end

				if isTarget then
					lastTarget = plr
					lastName = plr.Name
					local ch = plr.Character
					local hum = ch and ch:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						lastAliveTarget = plr
						lastAliveName = plr.Name
					end
				end
			end
		end
	end

	-- Always prefer the LAST target that is still alive (the current hero/sheriff), so we
	-- never teleport to an older / dead role holder instead of the most recent one.
	lastTarget = lastAliveTarget or lastTarget
	lastName = lastAliveName or lastName

	if lastTarget then
		local char = lastTarget.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local myChar = player.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

		if hrp and myHrp then
			local targetCF = hrp.CFrame * CFrame.new(0, 0, 3)
			for i = 1, 10 do
				myHrp.CFrame = targetCF
				myChar:SetPrimaryPartCFrame(targetCF)
				myHrp.Velocity = Vector3.new(0, 0, 0)
				myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				myHrp.RotVelocity = Vector3.new(0, 0, 0)
			end
			local fixConn
			fixConn = RunService.Heartbeat:Connect(function()
				myHrp.CFrame = targetCF
				myHrp.Velocity = Vector3.new(0, 0, 0)
				myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				fixConn:Disconnect()
			end)
			notify("Teleported", "TP to " .. roleName .. ": " .. lastName, 2)
		end
		return
	end

	notify("Error", "No " .. roleName .. " found", 2)
end

-- TP to Map / TP Above Map
-- The old build teleported to a hand-measured Vector3 per map. Those numbers
-- only describe the platform a map stood on when they were measured, and MM2
-- reuses platforms, so the teleport could land in the void or on a different
-- map's platform. The target is now computed from the map model that is
-- actually loaded: its SpawnLocation when it has one, otherwise the middle of
-- its bounding box, so every map is reached through its own platform.

-- The map model currently in Workspace, or nil while you are in the lobby.
-- Map models are Workspace children named like ESP_MAP_NAMES, but the old test
-- (a direct Model child with no Humanoid whose first BasePart sat more than 400
-- studs away on Z) missed real maps - a map parented under a folder, a map with
-- a rig inside it, or a map that sits closer to the lobby - so TP to Map and TP
-- Above Map answered "No map loaded" even while a round was running. The lookup
-- now tries a registry-named model first, then the model farthest from the
-- lobby, and caches the answer for half a second so the farm loop and Auto TP
-- do not walk Workspace on every call.
loadedMapModelCache = nil
loadedMapModelCacheAt = 0

function loadedMapModelOrigin()
	local lobby = Workspace:FindFirstChild("RegularLobby")
	local part = lobby and (lobby.PrimaryPart or lobby:FindFirstChildWhichIsA("BasePart", true))
	return part and part.Position or Vector3.new(14, 505, 35)
end

function loadedMapModel()
	local now = os.clock()
	if loadedMapModelCache and (now - loadedMapModelCacheAt) < 0.5 then
		if loadedMapModelCache.Parent then return loadedMapModelCache end
		loadedMapModelCache = nil
	end
	local lobby = Workspace:FindFirstChild("RegularLobby")
	local mapSet = mapNameSet(ESP_MAP_NAMES)
	local found = nil
	-- 1) Registry name, at most two levels deep (a map folder directly under
	--    Workspace). A deep search would also match decoration models that
	--    repeat a map's name inside the map itself.
	local parents = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		if child:IsA("Model") and mapSet[child.Name] and child ~= lobby then
			found = child
			break
		end
		if child ~= lobby and (child:IsA("Folder") or child:IsA("Model")) then
			parents[#parents + 1] = child
		end
	end
	if not found then
		for _, parent in ipairs(parents) do
			for _, child in ipairs(parent:GetChildren()) do
				if child:IsA("Model") and mapSet[child.Name] and child ~= lobby then
					found = child
					break
				end
			end
			if found then break end
		end
	end
	-- 2) Any model far from the lobby (map platforms sit hundreds of studs
	--    away), so a map missing from the registry still resolves.
	if not found then
		local origin = loadedMapModelOrigin()
		local bestDist = 250
		for _, d in ipairs(Workspace:GetChildren()) do
			if d:IsA("Model") and d ~= lobby and not d:FindFirstChildOfClass("Humanoid") then
				local p = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
				if p then
					local dist = (p.Position - origin).Magnitude
					if dist > bestDist then
						bestDist = dist
						found = d
					end
				end
			end
		end
	end
	-- Only a found map is cached: caching "nil" could answer "No map loaded"
	-- for half a second right after the round's map spawns.
	if found then
		loadedMapModelCache = found
		loadedMapModelCacheAt = now
	else
		loadedMapModelCache = nil
	end
	return found
end

-- Same lookup, but a manual TP retries briefly: the model can land a frame or
-- two after the round starts, and that used to answer "No map loaded".
function loadedMapModelSoon()
	local model = loadedMapModel()
	for _ = 1, 3 do
		if model then return model end
		task.wait(0.15)
		model = loadedMapModel()
	end
	return model
end

-- Measured landing spots per map (Teleports.lua). "map" drops you onto the
-- platform, "above" floats over it. Keys are the Workspace model names, so the
-- pads' "Hotel 2" maps to the "Hotel" model. A map missing here (for example a
-- new one) still works through mapTeleportPosition's own measurement.
MAP_TELEPORTS = {
	Hospital3 = { map = Vector3.new(-51, 284, 9003), above = Vector3.new(-1, 317, 9000) },
	Workplace = { map = Vector3.new(15, 892, 2957), above = Vector3.new(0, 919, 3000) },
	Bank2 = { map = Vector3.new(-35, 295, 8982), above = Vector3.new(0, 328, 9000) },
	Factory = { map = Vector3.new(35, 274, 8877), above = Vector3.new(-11, 325, 8942) },
	PoliceStation = { map = Vector3.new(37, 849, 2925), above = Vector3.new(0, 907, 3000) },
	Hotel = { map = Vector3.new(60, 294, 9001), above = Vector3.new(-2, 330, 9000) },
	Mansion2 = { map = Vector3.new(-62, 272, 8969), above = Vector3.new(-6, 284, 9022) },
	MilBase = { map = Vector3.new(37, 208, 9223), above = Vector3.new(0, 318, 9051) },
	House2 = { map = Vector3.new(49, 265, 9058), above = Vector3.new(7, 293, 8957) },
	BioLab = { map = Vector3.new(69, 297, 9105), above = Vector3.new(-60, 322, 9105) },
	Office3 = { map = Vector3.new(-7, 905, 2907), above = Vector3.new(-43, 928, 2955) },
}

function mapTeleportByName(name)
	if not name then return nil end
	local direct = MAP_TELEPORTS[name]
	if direct then return direct end
	local want = voteMapNorm(name)
	for key, entry in pairs(MAP_TELEPORTS) do
		if voteMapNorm(key) == want then return entry end
	end
	return nil
end

-- Ground spot (or a point above the map) for a loaded map model.
function mapTeleportPosition(model, above)
	local fixed = model and mapTeleportByName(model.Name)
	if fixed then
		return above and fixed.above or fixed.map
	end
	local okSpawn, spawn = pcall(function()
		return model:FindFirstChildWhichIsA("SpawnLocation", true)
	end)
	if okSpawn and spawn then
		return spawn.Position + Vector3.new(0, above and 25 or 3, 0)
	end
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if ok and cf and size then
		if above then
			return Vector3.new(cf.Position.X, cf.Position.Y + size.Y / 2 + 25, cf.Position.Z)
		end
		return Vector3.new(cf.Position.X, cf.Position.Y - size.Y / 2 + 6, cf.Position.Z)
	end
	return nil
end

function teleportCharacterTo(worldPos)
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then
		notify("Error", "Character not found", 2)
		return false
	end
	local targetCF = CFrame.new(worldPos)
	for i = 1, 10 do
		myHrp.CFrame = targetCF
		myChar:SetPrimaryPartCFrame(targetCF)
		myHrp.Velocity = Vector3.new(0, 0, 0)
		myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		myHrp.RotVelocity = Vector3.new(0, 0, 0)
	end
	local fixConn
	fixConn = RunService.Heartbeat:Connect(function()
		myHrp.CFrame = targetCF
		myHrp.Velocity = Vector3.new(0, 0, 0)
		myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		fixConn:Disconnect()
	end)
	return true
end

function tpToMap()
	local model = loadedMapModelSoon()
	if not model then
		notify("Error", "No map loaded - wait for a round to start", 2)
		return
	end
	local pos = mapTeleportPosition(model, false)
	if not pos then
		notify("Error", "Could not measure " .. model.Name, 2)
		return
	end
	if teleportCharacterTo(pos) then
		notify("Teleported", "TP to " .. model.Name, 2)
	end
end


				data.stroke.Color = active and Color3.fromRGB(0, 0, 0) or (tabStrokeColor or Color3.fromRGB(255, 255, 255))
				data.stroke.Transparency = active and 0 or 1
				data.stroke.Thickness = tabStrokeThickness or 1
				data.stroke.Enabled = (tabStrokesEnabled ~= false)
			end
			local icon = data.icon
			local iconShown = false
			if icon and icon.Parent then
				if tabIconsEnabled == false then
					icon.Visible = false
				else
					local asset = nil
					pcall(function()
						local offAsset, onAsset = nil, nil
						if tabIconAsset then offAsset = tabIconAsset(data.iconTab) end
						if tabIconActiveAsset then onAsset = tabIconActiveAsset(data.iconTab) end
						if active then
							asset = onAsset
							if (not asset or asset == "") then asset = offAsset end
						else
							asset = offAsset
							if (not asset or asset == "") then asset = onAsset end
						end
					end)
					if asset and asset ~= "" then
						icon.Image = asset
						icon.Visible = true
						iconShown = true
					else
						icon.Visible = false
					end
				end
			end
			if data.label then
				data.label.Position = iconShown and UDim2.new(0, 32, 0, 0) or UDim2.new(0, 10, 0, 0)
				data.label.Size = iconShown and UDim2.new(1, -36, 1, 0) or UDim2.new(1, -16, 1, 0)
			end
		end
	end
	group.refreshIcons = refreshIcons

	local function applyVisibility()
		local onOwner = (currentCategory == ownerName)
		if holderFrame then holderFrame.Visible = false end
		for _, def in ipairs(group.defs) do
			if def.frame then
				def.frame.Visible = onOwner and (def.name == group.current)
			end
		end
	end
	group.applyVisibility = applyVisibility

	local function setSub(name)
		if not name then return end
		group.current = name
		refreshIcons()
		applyVisibility()
	end
	group.setSub = setSub

	for index, def in ipairs(defs) do
		local subBtn = Instance.new("TextButton")
		subBtn.Name = ownerName .. "Sub" .. index .. "Btn"
		subBtn.Size = UDim2.new(0, 132, 0, 32)
		subBtn.BackgroundColor3 = tabBgColor
		subBtn.BorderSizePixel = 0
		subBtn.Text = ""
		subBtn.AutoButtonColor = false
		subBtn.LayoutOrder = index
		subBtn.Parent = barScroll

		local subCorner = Instance.new("UICorner")
		subCorner.CornerRadius = UDim.new(0, 16)

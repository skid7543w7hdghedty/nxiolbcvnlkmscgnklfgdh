-- ============================================================
-- Shared "realistic" avatar row for every player selector.
-- Mirrors the Teamers overview rows (avatar + "DisplayName (Name)")
-- but WITHOUT the friend counter and WITHOUT opening a stats popup:
-- clicking the row only selects/deselects the player.
-- opts: { nameSuffix, prefix, selected, accent, baseBg, selectedBg,
--         baseTextColor, avatarBg, onClick }
-- ============================================================
function createAvatarSelectorRow(parent, plr, opts)
	opts = opts or {}
	local accent = opts.accent or Color3.fromRGB(255, 255, 255)
	local baseBg = opts.baseBg or Color3.fromRGB(0, 0, 0)
	local selectedBg = opts.selectedBg or Color3.fromRGB(40, 10, 10)
	local baseText = opts.baseTextColor or Color3.fromRGB(255, 255, 255)
	local isSelected = opts.selected and true or false

	local row = Instance.new("TextButton")
	row.Name = plr.Name .. (opts.nameSuffix or "AvatarEntry")
	row.Size = UDim2.new(1, 0, 0, 60)
	row.BackgroundColor3 = isSelected and selectedBg or baseBg
	row.BorderSizePixel = 0
	row.Text = ""
	row.AutoButtonColor = false
	row.Parent = parent

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 6)
	rowCorner.Parent = row

	-- Selection is made obvious even on dark rows: a colored left bar + outline.
	local accentBar = Instance.new("Frame")
	accentBar.Name = "SelectedBar"
	accentBar.Size = UDim2.new(0, 3, 1, -14)
	accentBar.Position = UDim2.new(0, 2, 0, 7)
	accentBar.BackgroundColor3 = accent
	accentBar.BorderSizePixel = 0
	accentBar.Visible = isSelected
	accentBar.Parent = row
	local accentBarCorner = Instance.new("UICorner")
	accentBarCorner.CornerRadius = UDim.new(1, 0)
	accentBarCorner.Parent = accentBar

	local rowStroke = Instance.new("UIStroke")
	rowStroke.Color = accent
	rowStroke.Thickness = 1.5
	rowStroke.Transparency = isSelected and 0 or 1
	rowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rowStroke.Parent = row

	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.Size = UDim2.new(0, 40, 0, 40)
	avatar.Position = UDim2.new(0, 8, 0, 10)
	avatar.BackgroundColor3 = opts.avatarBg or Color3.fromRGB(0, 0, 0)
	avatar.BorderSizePixel = 0
	avatar.Parent = row

	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(0, 6)
	avatarCorner.Parent = avatar

	coroutine.wrap(function()
		local thumb = ""
		if getCachedThumb then
			thumb = getCachedThumb(plr.UserId)
		else

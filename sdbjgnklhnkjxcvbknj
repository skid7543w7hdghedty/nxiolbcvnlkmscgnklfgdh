-- Manual stock throws (LMB with bomb equipped) leave no inventory/attribute
-- trace the observer can see, so catch the click itself. Stock refuses the
-- throw while IT cools down; we mirror that by starting our countdown only
-- when nothing is already counting (a plausible fresh throw). No debug API,
-- no namecall — a passive extra listener next to the stock one.
pcall(function()
	local m = player:GetMouse()
	if not m then return end
	m.Button1Down:Connect(function()
		local ch = player.Character
		if not (ch and ch:FindFirstChild("FakeBomb")) then return end
		local hum = ch:FindFirstChildOfClass("Humanoid")
		if not (hum and hum.Health > 0 and ch:FindFirstChild("UpperTorso")) then return end
		local nowB, remB = os.clock(), 0
		pcall(function() remB = bombTimerRemaining() end)
		if nowB < fakeBombNextReadyAt or remB > 0.5 then return end
		fakeBombNextReadyAt = nowB + FAKE_BOMB_COOLDOWN
		fakeBombPendingAt = nowB
		pcall(bombTimerReset)
	end)
end)

-- Bomb Timer: 22s countdown display, restarted on EVERY bomb throw via the
-- observer hook below. Display only everywhere.
BOMB_TIMER_LEN = BOMB_TIMER_LEN or 22
bombTimerEnd = 0
bombTimerLastText = ""
bombTimerLastReset = 0
function bombTimerReset()
	bombTimerEnd = os.clock() + (BOMB_TIMER_LEN or 22)
	bombTimerLastReset = os.clock()
end
function bombTimerRemaining()
	local r = (bombTimerEnd or 0) - os.clock()
	if r < 0 then r = 0 end
	return r
end
function bombTimerPushText()
	local r = bombTimerRemaining()
	local txt = (r > 0) and string.format("Bomb: %ds", math.ceil(r)) or "Bomb Ready"
	if txt == bombTimerLastText then return end
	bombTimerLastText = txt
	if fakeBombTimerButton then
		pcall(function() fakeBombTimerButton.Text = txt end)
	end
	local ex = extractedButtons and extractedButtons["Bomb Timer"]
	if ex then
		if ex.bombTimerText then
			pcall(function() ex.bombTimerText.Text = txt end)
		end
		if ex.popupBtn then
			pcall(function() ex.popupBtn.Text = txt end)
		end
	end
end

fakeBombTimerButton = createButton("FakeBombTimerButton", "Bomb Ready", 209.06)
fakeBombTimerButton.AutoButtonColor = false
-- Display only: no click action, the timer restarts itself on throws.

bombTimerHadBomb = nil
bombTimerToolAttrSnap = nil
task.spawn(function()
	while true do
		local now = os.clock()
		local ch = player.Character
		local bp = player:FindFirstChild("Backpack")
		local toolNow = nil
		if ch ~= nil then toolNow = ch:FindFirstChild("FakeBomb") end
		if toolNow == nil and bp ~= nil then toolNow = bp:FindFirstChild("FakeBomb") end
		local hasNow = toolNow ~= nil
		local h = ch ~= nil and ch:FindFirstChildOfClass("Humanoid") or nil
		local alive = h ~= nil and h.Health > 0
		-- Layer 1: tool consumed from inventory while alive — but ONLY right
		-- after OUR fire attempt (pending window). Round-end cleanup also wipes
		-- the inventory while alive and must not start the timer. Stock manual
		-- throws are caught by the Button1Down listener below instead.
		if bombTimerHadBomb == true and hasNow == false and alive and (now - (fakeBombPendingAt or -99)) < 3 then
			bombTimerReset()
			now = os.clock()
		end
		bombTimerHadBomb = hasNow
		-- Death / round-end wipe: everyone dies, the bomb is retakeable fresh —
		-- drop any running countdown instead of letting it linger.
		if bombTimerWasAlive == true and alive == false then
			bombTimerEnd = 0
			fakeBombNextReadyAt = 0
		end
		bombTimerWasAlive = alive
		-- Layer 2: tool attribute churn (cooldown stamps etc.), debounced so a
		-- fluttering attribute can't pin the timer.
		if toolNow ~= nil then
			local snap = nil
			pcall(function()
				local parts = {}
				for k, v in pairs(toolNow:GetAttributes()) do
					parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
				end
				table.sort(parts)
				snap = table.concat(parts, ";")
			end)
			if snap ~= nil then
				if bombTimerToolAttrSnap ~= nil and snap ~= bombTimerToolAttrSnap and alive
					and (now - (bombTimerLastReset or 0)) > 5 then
					bombTimerReset()
				end
				bombTimerToolAttrSnap = snap
			end
		else
			bombTimerToolAttrSnap = nil
		end
		pcall(bombTimerPushText)
		-- Visual cooldown mirror: stock shows a faded bomb while ITS cooldown
		-- runs, but our direct fire bypasses its `check`. Re-equipping mid-
		-- cooldown would otherwise show a live-looking (but dead) bomb —
		-- keep it faded until every cooldown (ours or observed) expires.
		pcall(function()
			local ch2 = player.Character
			local fb = ch2 ~= nil and ch2:FindFirstChild("FakeBomb") or nil
			if fb ~= nil then
				local hd = fb:FindFirstChild("Handle")
				if hd ~= nil then
					local now2 = os.clock()
					local rem2 = 0
					pcall(function() rem2 = bombTimerRemaining() end)
					if now2 < fakeBombNextReadyAt or rem2 > 0.5 then
						hd.Transparency = 1
					else
						hd.Transparency = 0
					end
				end
			end
		end)
		task.wait(0.25)
	end
end)

-- Instant visual mirror on equip: re-equipping mid-cooldown must not flash a
-- live-looking bomb (stock `check` stays true after our bypassed fire).

	for _, r in ipairs(rebuilt) do
		if not finalSeen[r.id] then
			final[#final+1] = r
			finalSeen[r.id] = true
		end
	end
	if #final > 0 then emotionOrder = final end
end

-- Load per-emotion keybinds from config
if loadedConfig and type(loadedConfig.emotionKeyBinds) == "table" then
	for idStr, keyCodeStr in pairs(loadedConfig.emotionKeyBinds) do
		local id = tonumber(idStr)
		if id and keyCodeStr then
			local ok, kc = pcall(function()
				local kc2 = Enum.KeyCode[keyCodeStr]
				if kc2 then return kc2 end
				return Enum.UserInputType[keyCodeStr]
			end)
			if ok and kc then
				emotionKeyBinds[id] = kc
			end
		end
	end
end

-- Register saved emotion keybinds into the global keyBinds table.
-- NOTE: emote-ness is resolved lazily at press time (emoteOrder is built much
-- later in the file, so snapshotting it here would mark every restored bind
-- as a non-emote and R15 emotes would silently do nothing after a rejoin).
function emotionIsEmote(animId)
	if emoteOrder then
		for _, e in ipairs(emoteOrder) do
			if e.id == animId then return true end
		end
	end
	return false
end
keyBinds = keyBinds or {}
for animId, kc in pairs(emotionKeyBinds) do
	keyBinds[kc] = {
		callback = function()
			if emotionIsEmote(animId) then
				local char2 = player.Character
				local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
				if hum2 and hum2.RigType == Enum.HumanoidRigType.R15 then
					local desc = hum2:FindFirstChildOfClass("HumanoidDescription")
					local ok = pcall(function() hum2:PlayEmoteAndGetAnimTrackById(animId) end)
					if not ok and desc then
						local nm = (emoteUiById[animId] and emoteUiById[animId].Name) or ("Emote "..tostring(animId))
						pcall(function() desc:AddEmote(nm, animId) end)
						pcall(function() hum2:PlayEmoteAndGetAnimTrackById(animId) end)
					end
				end
			else
				if playingAnimationId == animId then
					stopCurrentAnimation()
				else
					playAnimation(animId, "1")
				end
			end
		end,
		description = "Emotion: " .. tostring(animId),
	}
end


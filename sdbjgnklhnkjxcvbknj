function fakeBombWatchEquip(char)
	if not char then return end
	pcall(function()
		char.ChildAdded:Connect(function(inst)
			if inst.Name ~= "FakeBomb" then return end
			task.spawn(function()
				task.wait(0.05)
				pcall(function()
					local nowE, remE = os.clock(), 0
					pcall(function() remE = bombTimerRemaining() end)
					if nowE < fakeBombNextReadyAt or remE > 0.5 then
						local hd = inst:FindFirstChild("Handle")
						if hd then hd.Transparency = 1 end
					end
				end)
			end)
		end)
	end)
end

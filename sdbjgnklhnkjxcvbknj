-- Knife Stab Aura: while the knife is IN YOUR HAND, slashing (clicking to cut) kills
-- every alive player within `range` studs of you. It never pulls anyone toward
-- you and never auto-kills on its own — the kill only fires the moment you
-- actually swing the knife. Distance is measured from you to each victim, so a
-- player you merely walk past (e.g. within 7 studs) is killed when you slash.
reachActivatedConns = {}
reachHookConns = {}
reachHookedTools = {}

function reachDoSlashKill()
	if not reachEnabled then return end
	local myChar = player.Character
	local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if not (hrp and myHum and myHum.Health > 0) then return end
	-- Only while the knife is actually equipped in your hand.
	local tool = myChar:FindFirstChildOfClass("Tool")
	if not (tool and tool.Name:lower():find("knife") and tool:FindFirstChild("Handle")) then return end
	local handle = tool.Handle
	local handleTouched = tkaGetHandleTouched()
	local origin = killGetRealCFrame().Position
	local p = reachCachePlayers
	for i = 1, #p do
		local plr = p[i]
		if plr ~= player then
			local v = plr.Character
			local tRoot = v and v:FindFirstChild("HumanoidRootPart")
			local tHum = v and v:FindFirstChildOfClass("Humanoid")
			if tRoot and tHum and tHum.Health > 0
				and (origin - tRoot.Position).Magnitude <= range then
				for _, part in ipairs(v:GetDescendants()) do
					if part:IsA("BasePart") then
						if handleTouched then
							pcall(function() handleTouched:FireServer(part) end)
						end
						safeFireTouch(handle, part)
					end
				end
			end
		end
	end
end

-- Hook a knife tool's Activated event so each swing triggers a distance kill.
-- Guarded so the same tool instance is never hooked twice (avoids double hits).
function reachHookTool(tool)
	if not (tool and tool:IsA("Tool")) then return end
	if not tool.Name:lower():find("knife") then return end
	if reachHookedTools[tool] then return end
	reachHookedTools[tool] = true
	local conn = tool.Activated:Connect(function()
		reachDoSlashKill()
	end)
	table.insert(reachActivatedConns, conn)
end

function reachWatchChar(char)
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then reachHookTool(tool) end
	table.insert(reachHookConns, char.ChildAdded:Connect(function(ch)
		if reachEnabled then reachHookTool(ch) end
	end))
end

function toggleReach()
	reachEnabled = not reachEnabled
	if reachEnabled then
		reachHookedTools = {}
		reachWatchChar(player.Character)
		table.insert(reachHookConns, player.CharacterAdded:Connect(function(newChar)
			if reachEnabled then reachWatchChar(newChar) end
		end))
	else
		for _, c in ipairs(reachActivatedConns) do pcall(function() c:Disconnect() end) end
		for _, c in ipairs(reachHookConns) do pcall(function() c:Disconnect() end) end
		reachActivatedConns = {}
		reachHookConns = {}
		reachHookedTools = {}
	end
end

-- ============================================
-- Throwing Knife Aura
-- ============================================
-- When enabled and the local player is the Murderer, throwing the knife kills
-- every alive player whose body passes within `throwingKnifeAuraRadius` studs of
-- the FLYING KNIFE itself — not of you. So a knife thrown across the map that
-- sails 7 studs past a target (with the field set to 7) still kills them, even
-- on a complete miss. We detect the throw by the projectile appearing in the
-- Workspace, track it every frame along its whole flight, and for each player
-- within range register a hit through the knife's own Events.HandleTouched
-- remote plus a firetouchinterest fallback on the projectile Handle. The
-- murderer is never teleported.
throwingKnifeAuraEnabled = false
throwingKnifeAuraConnection = nil
throwingKnifeAuraRadius = 6
tkaThrowCooldownUntil = 0

-- True only for a thrown-knife projectile living directly in the Workspace
-- (not the tool sitting in someone's Backpack / Character).
function tkaIsThrownKnife(inst)
	if not inst then return false end
	if not (inst:IsA("BasePart") or inst:IsA("Model")) then return false end
	local n = inst.Name:lower()
	if not (n == "throwingknife" or n:find("throwingknife") or n:find("throwing_knife")) then
		return false
	end
	local a = inst.Parent
	while a and a ~= game do
		if a:IsA("Backpack") then return false end
		if a:IsA("Model") and Players:GetPlayerFromCharacter(a) then return false end
		a = a.Parent
	end
	return inst:IsDescendantOf(Workspace)
end

-- BasePart of the flying projectile, used for the firetouchinterest fallback.
function tkaGetThrownHandle(inst)
	if not inst then return nil end
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst:FindFirstChild("Handle")
			or inst.PrimaryPart
			or inst:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

-- Current world position of the flying knife.
function tkaGetKnifePosition(inst)
	local h = tkaGetThrownHandle(inst)
	if h then return h.Position end
	if inst and inst:IsA("Model") then
		local ok, cf = pcall(function() return inst:GetBoundingBox() end)
		if ok and cf then return cf.Position end
	end
	return nil
end

-- Shortest distance from point p to the segment a-b. Using the segment (rather
-- than a single sampled point) means a knife moving fast enough to skip past a
-- target between two frames is still caught if its PATH grazed within range.
function tkaPointSegDist(p, a, b)
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 <= 0 then return (p - a).Magnitude end
	local t = (p - a):Dot(ab) / len2
	if t < 0 then t = 0 elseif t > 1 then t = 1 end
	local proj = a + ab * t
	return (p - proj).Magnitude
end

-- Locate the knife tool (equipped, or in the Backpack while on post-throw
-- cooldown) and return its Events.HandleTouched remote.
function tkaGetHandleTouched()
	local knifeTool = player.Character and player.Character:FindFirstChild("Knife")
	if not knifeTool then
		local bp = player:FindFirstChild("Backpack")
		knifeTool = bp and bp:FindFirstChild("Knife")
	end
	if not knifeTool then return nil end
	local ev = knifeTool:FindFirstChild("Events")
	return ev and ev:FindFirstChild("HandleTouched")
end

-- Track the SINGLE closest alive player to the knife over the whole flight.
-- Returns the closest player found this frame (within range), or nil. The caller
-- accumulates the overall closest across frames and kills only that one at the end.
--
-- Why only the closest: a thrown knife impales only ONE person — the player
-- physically nearest the blade's path. We never kill "everyone the blade passed
-- within range of".
--
-- Far-side safety: a Q-slice look-behind, not the whole throw. Right after a
-- throw (or a single dropped frame) the slice prevPos->curPos can stretch across
-- the map, and measuring distance to that long segment would hit a player who is
-- geometrically near the line but kilometres from the knife. We clamp the look-
-- behind so only a realistic slice (up to ~1 radius) behind the current position
-- is considered.
function tkaFindClosest(prevPos, curPos)
	if not curPos then return nil, math.huge end

	-- Build the effective flight slice.
	local segB = curPos
	local segA = prevPos or segB
	if prevPos then
		local lookback = throwingKnifeAuraRadius
		if (segB - segA).Magnitude > lookback then
			segA = segB - (segB - segA).Unit * lookback
		end
	end

	local bestPlr = nil
	local bestDist = math.huge
	local players = Players:GetPlayers()
	for i = 1, #players do
		local plr = players[i]
		if plr ~= player then
			local tChar = plr.Character
			local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
			if tRoot and tHum and tHum.Health > 0 then
				local dist
				if prevPos then
					dist = tkaPointSegDist(tRoot.Position, segA, segB)
				else
					dist = (tRoot.Position - curPos).Magnitude
				end
				if dist <= throwingKnifeAuraRadius and dist < bestDist then
					bestDist = dist
					bestPlr = plr
				end
			end
		end
	end
	return bestPlr, bestDist
end

-- Kill a single player at distance (fire the knife's HandleTouched remote + fallback).
function tkaKillOne(targetPlr)
	if not targetPlr then return end
	local handleTouched = tkaGetHandleTouched()
	local tChar = targetPlr.Character
	if not tChar then return end
	for _, part in ipairs(tChar:GetDescendants()) do
		if part:IsA("BasePart") then
			if handleTouched then
				pcall(function() handleTouched:FireServer(part) end)
			end
		end
	end
end

-- Toggle: hook the Workspace so each detected throw is tracked in flight and
-- kills anyone the knife passes within range of.
function toggleThrowingKnifeAura()
	throwingKnifeAuraEnabled = not throwingKnifeAuraEnabled
	if throwingKnifeAuraEnabled then
		if throwingKnifeAuraConnection then
			throwingKnifeAuraConnection:Disconnect()
			throwingKnifeAuraConnection = nil
		end
		throwingKnifeAuraConnection = Workspace.DescendantAdded:Connect(function(inst)
			if not throwingKnifeAuraEnabled then return end
			if not tkaIsThrownKnife(inst) then return end
			if not isPlayerMurderer() then return end
			-- Debounce: one throw can spawn several descendants; track once.
			if os.clock() < tkaThrowCooldownUntil then return end
			tkaThrowCooldownUntil = os.clock() + 0.15
			task.spawn(function()
				-- Follow the projectile for its whole flight, sampling every frame.
				-- Accumulate the SINGLE closest player seen at any point during the
				-- flight, then kill only that one player once the flight ends.
				-- This guarantees exactly one kill per throw — the nearest victim.
				local prevPos = nil
				local startT = os.clock()
				local bestPlr = nil
				local bestDist = math.huge
				while throwingKnifeAuraEnabled and (os.clock() - startT) < 5 do
					if not (inst and inst.Parent and inst:IsDescendantOf(Workspace) and tkaIsThrownKnife(inst)) then
						break
					end
					local curPos = tkaGetKnifePosition(inst)
					if curPos then
						local plr, dist = tkaFindClosest(prevPos, curPos)
						if plr and dist < bestDist then
							bestDist = dist
							bestPlr = plr
						end
						prevPos = curPos
					end
					RunService.Heartbeat:Wait()
				end
				-- Kill only the single closest player found during the whole flight
				if bestPlr then
					tkaKillOne(bestPlr)
				end
			end)
		end)
	else
		if throwingKnifeAuraConnection then
			throwingKnifeAuraConnection:Disconnect()
			throwingKnifeAuraConnection = nil
		end
	end
end

-- Air Strafe functions
function checkStrafeSequence(keyCode)
	if not airStrafeEnabled then return end
	local currentTime = tick()
	if keyCode == Enum.KeyCode.A or keyCode == Enum.KeyCode.D then
		if lastKey and lastKey ~= keyCode and (currentTime - lastKeyTime) <= strafeInterval then
			isStrafing = true
			task.delay(strafeInterval, function()
				isStrafing = false
			end)
		end
		lastKey = keyCode
		lastKeyTime = currentTime
	end
end

function setupAirStrafe()
	if airStrafeConnection then
		airStrafeConnection:Disconnect()
		airStrafeConnection = nil
	end
	if airStrafeInputConnection then
		airStrafeInputConnection:Disconnect()
		airStrafeInputConnection = nil
	end

	if not airStrafeEnabled then return end

	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) then return end

	airStrafeInputConnection = UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.D then
			checkStrafeSequence(input.KeyCode)
		end
	end)

	airStrafeConnection = RunService.Heartbeat:Connect(function()
		if not airStrafeEnabled then return end
		local c = player.Character
		if not c then return end
		local h = c:FindFirstChild("Humanoid")
		local r = c:FindFirstChild("HumanoidRootPart")
		if not (h and r) then return end
		local state = h:GetState()
		if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then
			if isStrafing then
				local moveDir = Vector3.new(0, 0, 0)
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then
					moveDir = moveDir + Vector3.new(-1, 0, 0)
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then
					moveDir = moveDir + Vector3.new(1, 0, 0)
				end
				local strafeSpeed = maxAirSpeed * airStrafeMultiplier
				local vel = r.Velocity
				if moveDir.Magnitude > 0 then
					moveDir = moveDir.Unit
					local cameraCF = Workspace.CurrentCamera.CFrame
					moveDir = cameraCF:VectorToWorldSpace(moveDir)
					moveDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
					r.Velocity = Vector3.new(
						moveDir.X * strafeSpeed,
						vel.Y,
						moveDir.Z * strafeSpeed
					)
				elseif moveDir.Magnitude == 0 then
					-- No strafe key held: kill the leftover horizontal impulse so the
					-- character doesn't keep gliding in one direction after a burst
					-- (the "stuck flying sideways" jam when strafing very fast).
					r.Velocity = Vector3.new(vel.X * 0.85, vel.Y, vel.Z * 0.85)
				end
			end
		end
	end)

	local diedConn
	diedConn = hum.Died:Connect(function()
		if airStrafeConnection then
			airStrafeConnection:Disconnect()
			airStrafeConnection = nil
		end
		if airStrafeInputConnection then
			airStrafeInputConnection:Disconnect()
			airStrafeInputConnection = nil
		end
		if diedConn then
			diedConn:Disconnect()
			diedConn = nil
		end
	end)
end

function toggleAirStrafe()
	airStrafeEnabled = not airStrafeEnabled
	setupAirStrafe()
end


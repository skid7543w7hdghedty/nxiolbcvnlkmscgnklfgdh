	local restoreBinds = c.binds
	if type(restoreBinds) ~= "table" then restoreBinds = {} end
	do
		for name, oldKey in pairs(featureBinds) do
			if oldKey and keyBinds[oldKey] then
				keyBinds[oldKey] = nil
			end
			featureBinds[name] = nil
		end
		for name, keyStr in pairs(restoreBinds) do
			local key = stringToKey(keyStr)
			if key then
				featureBinds[name] = key
				for _, feature in ipairs(bindableFeatures) do
					if feature.name == name then
						keyBinds[key] = {callback = feature.callback, description = name}
						break
					end
				end
			end
		end
		for _, feature in ipairs(bindableFeatures) do
			local row = categoryFrames["Binds"]:FindFirstChild("BindRow_" .. feature.name:gsub("%W", ""))

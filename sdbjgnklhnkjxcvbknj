-- Physically scan for the player holding the Gun tool (same method as the
-- notification system). Returns sheriffName, heroName — the real gun holder(s).
-- dataRoleMap is the GetPlayerData() result used to distinguish Sheriff vs Hero.
function combatStatsScanGunHolder(dataRoleMap)
	local sheriffName = nil
	local heroName = nil
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if char and hum and hum.Health > 0 then
			local hasGun = false
			for _, tool in ipairs(char:GetChildren()) do
				if tool:IsA("Tool") and tool.Name:lower():find("gun") then hasGun = true; break end
			end
			if not hasGun then
				local bp = p:FindFirstChild("Backpack")
				if bp then
					for _, tool in ipairs(bp:GetChildren()) do
						if tool:IsA("Tool") and tool.Name:lower():find("gun") then hasGun = true; break end
					end
				end
			end
			if hasGun then
				local role = dataRoleMap and dataRoleMap[p.Name] and dataRoleMap[p.Name].Role
				if role == "Sheriff" then
					sheriffName = p.Name
				elseif role == "Hero" then
					heroName = p.Name
				else
					-- Has gun but no definitive role — treat as hero
					heroName = p.Name
				end
			end
		end
	end
	return sheriffName, heroName
end

-- Gun Dropped detection (based on GunDrop in workspace, like AutoGrab Gun)
combatStatsRoundActive = false

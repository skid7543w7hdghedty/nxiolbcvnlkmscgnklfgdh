-- [perf] Throttled config saving. The full encode + writefile is heavy, and it
-- used to run on EVERY single change (every setToggleState, every color/dropdown
-- click). During "Load Config" that meant dozens of back-to-back full-table
-- serializations -> visible freezes while the config applied. Now a change
-- always writes immediately if enough time passed since the last write, and
-- rapid-fire calls are coalesced into ONE trailing write. Result: identical
-- end state on disk, but 1 disk sync instead of N.
_saveLastWriteAt = 0
_saveWritePending = false
function saveConfig()
	local now = os.clock()
	if (now - _saveLastWriteAt) >= 0.4 then
		_saveLastWriteAt = now
		pcall(saveConfigNow)
		return
	end
	if not _saveWritePending then
		_saveWritePending = true
		task.delay(math.max(0.05, 0.45 - (now - _saveLastWriteAt)), function()
			_saveWritePending = false
			if isApplyingConfig then return end
			_saveLastWriteAt = os.clock()
			pcall(saveConfigNow)
		end)
	end
end


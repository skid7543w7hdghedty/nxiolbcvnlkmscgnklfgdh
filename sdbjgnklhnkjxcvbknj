-- Seeds Icons/<Folder>/ with the default lucide icon when the folder is empty,
-- so top buttons have images on fresh installs while keeping the strict folder structure.
function ensureTopIconDefault(slotKey, folder, legacyName)
	if topIconPaths and topIconPaths[slotKey] and topIconPaths[slotKey] ~= "" then return end
	local files = findTopIconFiles(folder)
	if #files > 0 then
		if not topIconPaths then topIconPaths = {} end
		if not topIconPaths[slotKey] or topIconPaths[slotKey] == "" then
			local pickIdx = slotKey:match("Open$") and 2 or 1
			topIconPaths[slotKey] = files[pickIdx] or files[1]
		end
		return
	end
	-- game:HttpGet yields for the whole request; doing it inline made the
	-- seeding loop wait for every empty folder before the rest of the startup
	-- work continued. Fetch in the background and refresh when it arrives.
	task.spawn(function()
		local ok = pcall(function()
			local data = game:HttpGet("https://unpkg.com/lucide-static@" .. tostring(lucideIconVersion or "0.469.0") .. "/icons/" .. legacyName .. ".png")
			local dest = ICONS_DIR .. "/" .. folder .. "/" .. legacyName .. ".png"
			writefile(dest, data)
			if not topIconPaths then topIconPaths = {} end
			topIconPaths[slotKey] = dest
		end)
		if ok then
			pcall(refreshTopButtons)
			pcall(saveConfig)
		end
	end)
end


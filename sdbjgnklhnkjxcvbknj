-- ===== Auto server hop when you're the only player left =====
createSection("Server Hop", 334)

-- Queue the script for re-execution after the teleport so it auto-loads on the
-- new server and the config restore re-enables everything that was turned on.
-- REQUIRES: the 'Script URL' box filled with a raw link to THIS script
-- (e.g. https://raw.githubusercontent.com/your-user/your-repo/main/script.lua)
-- Only queue the script ONCE per session. Kicks fire several events at once
-- (ErrorMessageChanged, PlayerRemoving, AncestryChanged, OnTeleport) and some
-- executors APPEND to the queue_on_teleport queue, so without this guard the
-- script gets queued several times and spam-loads after the rejoin.
autofarmRejoinQueued = false
function autofarmQueueRejoin()
	if autofarmRejoinQueued then return true end
	-- Auto Re-Execute on Rejoin only makes sense in Murder Mystery 2. On any
	-- other place we must NOT queue the script (and must not mark it queued).
	if game.PlaceId ~= MM2_PLACE_ID then return false end
	local url = tostring(AUTOFARM_SCRIPT_URL or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if url == "" then return false end
	local q = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
	if not q then pcall(function() q = getgenv().queue_on_teleport end) end
	if not q then return false end
	local ok = pcall(q, string.format('task.wait(3) loadstring(game:HttpGet(%q))()', url))
	-- Mark as queued ONLY after the executor actually accepted the payload.
	-- The old code set the flag before validating the URL/executor, so one
	-- failed attempt permanently blocked every later rejoin attempt.
	if ok then
		autofarmRejoinQueued = true
	end
	return ok
end

function autofarmServerHop()
	-- Persist the current toggles FIRST: autofarm state, speed, webhook etc are
	-- restored straight from the saved config after the rejoin. saveConfigNow is
	-- used instead of the debounced saveConfig so the file is on disk BEFORE the
	-- teleport starts (a pending debounced write would be lost on rejoin).
	pcall(saveConfigNow)
	-- Clear the one-time guard so the script can re-activate on the new server.
	-- Some executors keep getgenv() across teleports; without this the queued
	-- loadstring hits the "Script already loaded!" guard and silently returns.
	pcall(function() getgenv().AdrenalinWinLoaded = nil end)
	if not autofarmQueueRejoin() then
		notify("Server Hop", "Fill Script URL box to auto-load after hop (or your executor lacks queue_on_teleport)", 5)
		return
	end
	local hopped = false
	pcall(function()
		local raw = game:HttpGet(string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100",
			game.PlaceId))
		local data = game:GetService("HttpService"):JSONDecode(raw)
		local candidates = {}
		for _, srv in ipairs((data and data.data) or {}) do
			if srv.id and srv.id ~= game.JobId and type(srv.playing) == "number" and srv.playing >= 2 and srv.playing < (srv.maxPlayers or 12) then
				table.insert(candidates, srv.id)
			end
		end
		if #candidates > 0 then
			TeleportService:TeleportToPlaceInstance(game.PlaceId, candidates[math.random(1, #candidates)], player)
			hopped = true
		end
	end)
	if not hopped then
		-- Fallback: plain re-teleport into the place (Roblox picks the server)
		pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
	end
end

-- Monitor: hop after being alone on the server for ~10 seconds straight
task.spawn(function()
	local aloneSince = nil
	local hopInProgress = false
	while task.wait(2) do
		if autofarmServerHopEnabled and not hopInProgress then
			if #Players:GetPlayers() <= 1 then
				aloneSince = aloneSince or os.clock()
				if (os.clock() - aloneSince) >= 10 then
					hopInProgress = true
					notify("Server Hop", "Alone on the server — hopping to another one...", 3)
					onDisconnecting()
					autofarmServerHop()
					task.wait(30) -- teleport failed/throttled -> allow a retry
					hopInProgress = false
					aloneSince = nil
				end
			else
				aloneSince = nil
			end
		end
	end
end)

-- Kick / disconnect handler: save config + queue script before the game closes so
-- the player can re-execute on rejoin and Server Hop continues working.
local lastHopAttempt = 0
local function onDisconnecting()
	if os.clock() - lastHopAttempt < 5 then return end
	lastHopAttempt = os.clock()
	-- Write synchronously: a debounced save would still be pending when the
	-- game closes/teleports, so the latest toggle states (including Auto
	-- Re-Execute on Rejoin) would not survive the rejoin.
	pcall(saveConfigNow)
	pcall(function() getgenv().AdrenalinWinLoaded = nil end)
	-- Only queue the script on disconnect if auto-reexecute is enabled.
	if autoReexecuteOnRejoin then
		pcall(autofarmQueueRejoin)
	end
end
if player then
	player.OnTeleport:Connect(function(state)
		if state == Enum.TeleportState.Started or state == Enum.TeleportState.Failed then
			onDisconnecting()
		end
	end)
	-- Detect player removal (kicked / banned mid-session)
	player.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			onDisconnecting()
		end
	end)
	-- Detect player leaving the game (server hop, manual leave, kick)
	Players.PlayerRemoving:Connect(function(plr)
		if plr == player then
			onDisconnecting()
		end
	end)
end
-- Detect game shutdown / server-side kick
pcall(function()
	game:BindToClose(function()
		onDisconnecting()
	end)
end)


	popupGui.Name = "ExploiterPopupGui"
	popupGui.ResetOnSpawn = false
	popupGui.DisplayOrder = 999999
	popupGui.IgnoreGuiInset = true
	-- Early popup cleanup: Destroying is connected BEFORE any yield below, so
	-- closing the popup while reg-date HTTP is still loading cannot leak the
	-- 0.15s live-stats loop and global handlers (stacking periodic freezes).
	local popupAlive = true
	local popupConns = {}
	local escConn = nil
	local popupDragCon = nil
	popupGui.Destroying:Connect(function()
		popupAlive = false
		for _, c in ipairs(popupConns) do pcall(function() c:Disconnect() end) end
		popupConns = {}
		if escConn then pcall(function() escConn:Disconnect() end) end
		if popupDragCon then pcall(function() popupDragCon:Disconnect() end) end

-- Per-role gate for an ESP part ("outlines" / "skeleton" / "health").
-- class: "murderer" | "sheriff" | "innocent" | "dead" (anything else = innocent).
function espPartRoleEnabled(part, class)
	if class == "murderer" then
		if part == "skeleton" then return espSkeletonRoleMurderer end
		if part == "health" then return espHealthRoleMurderer end
		return espOutlinesRoleMurderer
	elseif class == "sheriff" then
		if part == "skeleton" then return espSkeletonRoleSheriff end
		if part == "health" then return espHealthRoleSheriff end
		return espOutlinesRoleSheriff
	elseif class == "dead" then
		if part == "skeleton" then return espSkeletonRoleDead end
		if part == "health" then return espHealthRoleDead end
		return espOutlinesRoleDead
	else
		if part == "skeleton" then return espSkeletonRoleInnocent end
		if part == "health" then return espHealthRoleInnocent end
		return espOutlinesRoleInnocent
	end
end


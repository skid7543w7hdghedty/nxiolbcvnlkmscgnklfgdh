-- ============================================
-- Fly + Teleport Walk (ported from IY.lua)
-- ============================================
-- Fly builds a BodyVelocity/BodyGyro on the HumanoidRootPart and steers with
-- the camera + WASD (ControlModule) exactly like IY.lua's fly command. E/Q add
-- vertical movement. Speed is the same multiplier IY accepts: "fly 3".
function stopFly()
	flyEnabled = false
	flyUpHeld = false
	flyDownHeld = false
	if flyConn then pcall(function() flyConn:Disconnect() end); flyConn = nil end
	if flyKeyDownConn then pcall(function() flyKeyDownConn:Disconnect() end); flyKeyDownConn = nil end
	if flyKeyUpConn then pcall(function() flyKeyUpConn:Disconnect() end); flyKeyUpConn = nil end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		for _, nm in ipairs({"AdrenalinFlyVelocity", "AdrenalinFlyGyro"}) do
			local inst = root:FindFirstChild(nm)
			if inst then pcall(function() inst:Destroy() end) end
		end
	end
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.PlatformStand = false end) end
end

function startFly()
	stopFly()
	flyEnabled = true
	-- No character required here: RenderStepped picks the current character
	-- up on every frame, so Fly also survives respawns and config restores
	-- that happen before the player spawns.

	local controlModule = nil
	pcall(function()
		controlModule = require(player.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
	end)

	flyKeyDownConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.E then
			flyUpHeld = true
		elseif input.KeyCode == Enum.KeyCode.Q then
			flyDownHeld = true
		end
	end)
	flyKeyUpConn = UserInputService.InputEnded:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.E then
			flyUpHeld = false
		elseif input.KeyCode == Enum.KeyCode.Q then
			flyDownHeld = false
		end
	end)

	flyConn = RunService.RenderStepped:Connect(function()
		if not flyEnabled then return end
		local c = player.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		if not (root and hum and hum.Health > 0) then return end

		local bv = root:FindFirstChild("AdrenalinFlyVelocity")
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "AdrenalinFlyVelocity"
			bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			bv.Velocity = Vector3.zero
			bv.Parent = root
		end
		local bg = root:FindFirstChild("AdrenalinFlyGyro")
		if not bg then
			bg = Instance.new("BodyGyro")
			bg.Name = "AdrenalinFlyGyro"
			bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
			bg.P = 9e4
			bg.CFrame = root.CFrame
			bg.Parent = root
		end

		pcall(function() hum.PlatformStand = true end)
		local camera = workspace.CurrentCamera
		if not camera then return end
		bg.CFrame = camera.CFrame

		local move = Vector3.zero
		if controlModule then
			local ok, dir = pcall(function() return controlModule:GetMoveVector() end)
			if ok and dir then
				-- IY mapping: +Z (S / back) goes against the look vector.
				move = camera.CFrame.RightVector * (dir.X * 50 * flySpeed) - camera.CFrame.LookVector * (dir.Z * 50 * flySpeed)
			end
		end
		if flyUpHeld then move = move + Vector3.new(0, 50 * flySpeed, 0) end
		if flyDownHeld then move = move - Vector3.new(0, 50 * flySpeed, 0) end
		bv.Velocity = move
	end)
end

function toggleFly()
	if flyEnabled then
		stopFly()
	else
		startFly()
	end
end

-- TP Walk: every Heartbeat the character is translated along its move direction.
-- Kept as one persistent heartbeat so it survives respawns without extra hooks.
function stopTpwalk()
	tpwalkEnabled = false
	if tpwalkConn then pcall(function() tpwalkConn:Disconnect() end); tpwalkConn = nil end
end

function startTpwalk()
	stopTpwalk()
	tpwalkEnabled = true
	tpwalkConn = RunService.Heartbeat:Connect(function(delta)
		if not tpwalkEnabled then return end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (char and hum and hum.Health > 0) then return end
		if hum.MoveDirection.Magnitude > 0 then
			pcall(function()
				char:TranslateBy(hum.MoveDirection * (tpwalkSpeed * 10) * delta)
			end)
		end
	end)
end

function toggleTpwalk()
	if tpwalkEnabled then
		stopTpwalk()
	else
		startTpwalk()
	end
end


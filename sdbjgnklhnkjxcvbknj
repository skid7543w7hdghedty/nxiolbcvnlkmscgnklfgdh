local function aimGetPing()
	local ok, v = pcall(function()
		return AimStats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	return ok and v or 0
end

-- Smoothed ping (EMA) + jitter tracker, tuned for 65-100ms VPN (NL).
-- Raw Data Ping jitters ±15-30ms; predicting with raw swings aim ~0.5 studs.
-- Single bullet => mean lead must be unbiased, jitter expands the sweep, not the mean.
_aimPingEMA = _aimPingEMA or 0
_aimPingJitter = _aimPingJitter or 0
local function aimGetLeadTime()
	local raw = aimGetPing()
	if raw and raw > 0 then
		if not _aimPingEMA or _aimPingEMA <= 0 then
			_aimPingEMA = raw
			_aimPingJitter = 0
		else
			-- Spike reject: VPN hiccup >60ms in one frame is packet loss, not real RTT shift.
			-- Don't let it yank the mean; absorb slowly into jitter instead.
			local spike = math.abs(raw - _aimPingEMA)
			if spike > 60 then
				_aimPingJitter = _aimPingJitter * 0.9 + spike * 0.1
			else
				_aimPingEMA = _aimPingEMA * 0.8 + raw * 0.2
				_aimPingJitter = _aimPingJitter * 0.92 + spike * 0.08
			end
		end
	end
	local pingMs = (_aimPingEMA and _aimPingEMA > 0) and _aimPingEMA or raw or 0
	local ping = pingMs / 1000
	-- Lead model tuned for 65-100ms VPN: ~1.5*ping + interp + fire latency.
	-- renderDelta = interpolation delay (~65ms), extraLeadSec covers the frame
	-- from sampling to FireServer + small VPN bias (0.035).
	local lead = ping * (AIM_CONFIG.pingScale or 1.5) + (AIM_CONFIG.renderDelta or 0.065) + (AIM_CONFIG.extraLeadSec or 0.035)
	if lead > (AIM_CONFIG.maxLeadSec or 0.5) then lead = AIM_CONFIG.maxLeadSec or 0.5 end
	if lead < 0 then lead = 0 end
	return lead
end

-- Ping jitter in seconds (for adaptive sweep expansion). Clamped to sane range.
function aimGetPingJitter()
	local j = _aimPingJitter or 0
	if j < 0 then j = 0 end
	if j > 60 then j = 60 end
	return j / 1000
end

local function aimIsAirborne(character)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	if hum.FloorMaterial == Enum.Material.Air then return true end
	local st = hum:GetState()
	return st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Jumping
end

-- Extended airborne test: remote humanoid state often lies (replication shows
-- Running while the target visibly jumps), so a jumping target was predicted
-- as grounded and bullets went into the floor. Adds two history signals:
-- fast vertical motion right now, or recent Y range (apex hover / jump spam).
-- Globals on purpose (chunk is at the local-registers limit).
function aimIsAirborneEx(character, vel)
	if aimIsAirborne(character) then return true end
	if vel and math.abs(vel.Y) > 6 then return true end
	local rec = _aimHist and _aimHist[character]
	local s = rec and rec.samples or nil
	if s and #s >= 3 then
		local mn, mx = math.huge, -math.huge
		local from = math.max(1, #s - 7)
		for i = from, #s do
			local y = s[i].p.Y
			if y < mn then mn = y end
			if y > mx then mx = y end
		end
		if mx - mn > 1.2 then return true end
	end
	return false
end

function aimAirborneNow(character, vel)
	if not AIM_CONFIG.gravityComp then return false end
	return aimIsAirborneEx(character, vel)
end

-- ============================================================
-- V2 PREDICTOR (single-bullet accuracy):
-- The old tracker sampled position deltas SPARSELY (only at shot time, seconds
-- apart) and smoothed them with a fixed alpha, so velocity was always stale and
-- strafe changes were invisible. It then ADDED up to ~90ms of pre-shot waits
-- (prime + stable-velocity hold), during which the target kept moving — the
-- prediction was dead on arrival.
-- New model:
--  * Background Heartbeat sampler records HRP position every frame into a
--    short ring buffer (~0.18s). At shot time velocity comes from a FRESH
--    regression over that window — zero added latency, no waits.
--  * Two estimates are blended: short-window (last ~2 frames, reactive) and
--    long-window (full buffer, stable). Agreement = stable sprint -> full lead
--    + acceleration; disagreement = turn/stop/start -> shortened minimax lead.
--  * Acceleration (from velocity delta) corrects starts/stops, clamped to
--    ±35% of the linear term so spikes can't fling the aim point.
--  * Globals (not locals) on purpose: the chunk is at the local-registers limit.
-- ============================================================
_aimHist = _aimHist or setmetatable({}, {__mode = "k"})
_aimHistLoopOn = _aimHistLoopOn or false

function aimRecordSample(character)
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local now = os.clock()
	local rec = _aimHist[character]
	local p = root.Position
	if not rec then
		rec = { samples = {}, velPrev = Vector3.new(0, 0, 0), accSm = Vector3.new(0, 0, 0) }
		_aimHist[character] = rec
	end
	local s = rec.samples
	s[#s + 1] = { p = p, t = now }
	local maxN = AIM_CONFIG.histMaxSamples or 24
	local win = AIM_CONFIG.histWindow or 0.22
	while #s > maxN or (#s >= 2 and (now - s[1].t) > (win + 0.08)) do
		table.remove(s, 1)
	end
	-- Teleport / respawn / desync snap: positions jump >60 studs in one frame.
	-- Drop the buffer so the jump never becomes a fake 1000+ st/s velocity.
	if #s >= 2 then
		local a, b = s[#s - 1], s[#s]
		local dt = b.t - a.t
		if dt > 1e-4 and (b.p - a.p).Magnitude / dt > (AIM_CONFIG.teleportSpeed or 90) then
			rec.samples = { b }
			rec.velPrev = Vector3.new(0, 0, 0)
			rec.accSm = Vector3.new(0, 0, 0)
		end
	end
end

if not _aimHistLoopOn then
	_aimHistLoopOn = true
	_aimHistLastTick = 0
	task.spawn(function()
		while true do
			RunService.Heartbeat:Wait()
			-- [perf] cap sampling at 60Hz: regression windows (0.14-0.36s) gain
			-- nothing from 120-240Hz sampling; at 240fps this cuts ~75% of cost.
			local nowS = os.clock()
			if nowS - _aimHistLastTick >= 1 / 60 then
				_aimHistLastTick = nowS
				pcall(function()
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= player and plr.Character then
							aimRecordSample(plr.Character)
						end
					end
				end)
			end
		end
	end)
end

-- Returns: vel (Vector3, horizontal+Y), accSm (smoothed accel), stability 0..1,
-- hSpeed. Never errors; falls back to AssemblyLinearVelocity when history is cold.
function aimEstimateMotion(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return Vector3.new(0, 0, 0), Vector3.new(0, 0, 0), 1, 0 end
	local reported = root.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
	local rec = _aimHist[character]
	local s = rec and rec.samples or nil
	if not s or #s < 2 then
		local h = math.sqrt(reported.X * reported.X + reported.Z * reported.Z)
		return reported, Vector3.new(0, 0, 0), 0.5, h
	end
	local now = os.clock()
	local win = AIM_CONFIG.histWindow or 0.22
	-- Long window: oldest sample still inside [now-win, now].
	local i0 = 1
	for i = 1, #s do
		if (now - s[i].t) <= win then i0 = i break end
		i0 = i
	end
	local B = s[#s]
	-- V3: least-squares regression velocity over the full window.
	-- Endpoints (B-A)/dt amplify single-sample replication noise (~0.5 stud jitter
	-- => 3-5 studs/s velocity noise). Regression over N samples cuts noise by
	-- ~sqrt(N) — critical for single-bullet lead at 65-100ms ping.
	local longV
	do
		local n = #s - i0 + 1
		if n < 2 then
			longV = reported
		else
			local sumT, sx, sy, sz = 0, 0, 0, 0
			for i = i0, #s do
				sumT = sumT + s[i].t
				sx = sx + s[i].p.X
				sy = sy + s[i].p.Y
				sz = sz + s[i].p.Z
			end
			local mt = sumT / n
			local mx, my, mz = sx / n, sy / n, sz / n
			local varT, covX, covY, covZ = 0, 0, 0, 0
			for i = i0, #s do
				local dt = s[i].t - mt
				varT = varT + dt * dt
				covX = covX + dt * (s[i].p.X - mx)
				covY = covY + dt * (s[i].p.Y - my)
				covZ = covZ + dt * (s[i].p.Z - mz)
			end
			if varT > 1e-8 then
				longV = Vector3.new(covX / varT, covY / varT, covZ / varT)
			else
				longV = reported
			end
		end
	end
	-- V3 short window: weighted last-3 (reactive but denoised).
	-- Pure 2-frame delta reacts fastest but carries full replication noise;
	-- blending last two deltas 70/30 keeps strafe-start reaction, cuts jitter.
	local dtS
	local shortV
	do
		local n = #s
		local C = s[n - 1]
		dtS = B.t - C.t
		if dtS > 1e-4 then shortV = (B.p - C.p) / dtS
		else shortV = longV end
		if n >= 3 then
			local P0 = s[n - 2]
			local dt0 = C.t - P0.t
			if dt0 > 1e-4 then
				local v0 = (C.p - P0.p) / dt0
				if v0.Magnitude <= (AIM_CONFIG.teleportSpeed or 90) then
					shortV = shortV * 0.7 + v0 * 0.3
				end
			end
		end
	end
	if shortV.Magnitude > (AIM_CONFIG.teleportSpeed or 90) then shortV = reported end
	if longV.Magnitude > (AIM_CONFIG.teleportSpeed or 90) then longV = reported end
	-- If physics says standing but replication clearly moves (assembly asleep /
	-- spoofed zero), replication wins. If replication says standing but physics
	-- reports speed (interpolation gap), physics wins for that axis.
	local lH = math.sqrt(longV.X * longV.X + longV.Z * longV.Z)
	local sH = math.sqrt(shortV.X * shortV.X + shortV.Z * shortV.Z)
	local rH = math.sqrt(reported.X * reported.X + reported.Z * reported.Z)
	if rH > lH + 3 and rH > sH + 3 and rH < (AIM_CONFIG.seedSpeedMax or 40) then
		-- Fresh strafe the replication window hasn't caught yet: seed with reported.
		longV = Vector3.new(reported.X, longV.Y, reported.Z)
		lH = rH
	end
	-- V3 stability: direction + magnitude + accel-consistency.
	-- A hard strafe shows as large |short-long| even when directions still agree
	-- for one frame; penalizing it shortens lead one frame earlier (minimax).
	local stab = 1
	do
		local lh = Vector3.new(longV.X, 0, longV.Z)
		local sh = Vector3.new(shortV.X, 0, shortV.Z)
		local lm, sm = lh.Magnitude, sh.Magnitude
		if lm < 2 and sm < 2 then stab = 1
		elseif lm < 2 or sm < 2 then stab = 0.35
		else
			local cosA = math.clamp(lh.Unit:Dot(sh.Unit), -1, 1)
			local dirScore = (cosA + 1) * 0.5 -- 1 = same dir, 0 = opposite
			local magScore = 1 - math.clamp(math.abs(lm - sm) / math.max(lm, sm, 1), 0, 1)
			local dv = (sh - lh).Magnitude
			local winH = AIM_CONFIG.histWindow or 0.22
			local instA = dv / math.max(winH * 0.5, 0.06)
			-- >60 studs/s^2 = hard start/stop/strafe; ramp penalty to 0 at 120.
			local accScore = 1 - math.clamp((instA - 60) / 60, 0, 1)
			stab = math.clamp(dirScore * 0.6 + magScore * 0.25 + accScore * 0.15, 0, 1)
		end
	end
	-- V3 blend: stable -> 15% short / 85% long (smoother mean for single bullet);
	-- chaos -> 100% short (fresh). Smoother mean + sweep covers residual error.
	local wShort = 1 - stab * 0.85
	local vel = longV + (shortV - longV) * math.clamp(wShort, 0, 1)
	-- V3 acceleration: (short - long) / half-window, lightly smoothed.
	-- Timescale-matched to lead (~0.11s vs old per-frame 0.016s): ~7x less noise,
	-- still captures starts/stops within the lead horizon. Single bullet => clamp.
	local acc = Vector3.new(0, 0, 0)
	do
		local winH = AIM_CONFIG.histWindow or 0.22
		local denom = math.max(winH * 0.5, 0.06)
		local inst = (shortV - longV) / denom
		if inst.Magnitude > (AIM_CONFIG.accelSpikeCap or 400) then inst = Vector3.new(0, 0, 0) end
		local prev = rec.accSm or Vector3.new(0, 0, 0)
		acc = prev + (inst - prev) * 0.4
		acc = Vector3.new(acc.X, 0, acc.Z) -- horizontal only; Y handled by gravity model
		rec.accSm = acc
		rec.velPrev = shortV
	end
	-- Cap horizontal speed at a plausible sprint so a fling spike can't overshoot.
	local hum = character:FindFirstChildOfClass("Humanoid")
	local maxH = math.max((hum and hum.WalkSpeed or 16) * (AIM_CONFIG.maxHMult or 1.7), (AIM_CONFIG.maxHMin or 32))
	local hv = Vector3.new(vel.X, 0, vel.Z)
	local hSpeed = hv.Magnitude
	if hSpeed > maxH then
		hv = hv.Unit * maxH
		vel = Vector3.new(hv.X, vel.Y, hv.Z)
		hSpeed = maxH
	end
	return vel, acc, stab, hSpeed
end

-- Legacy shims (kept so any external reference keeps working, now wait-free).
local aimVelTrack = setmetatable({}, {__mode = "k"})
local function aimTrackVelocity(character)
	local v = aimEstimateMotion(character)
	return v
end
local function aimFreshVelocity(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local rec = _aimHist and _aimHist[character]
	local s = rec and rec.samples or nil
	if s and #s >= 2 then
		local A, B = s[#s - 1], s[#s]
		local dt = B.t - A.t
		if dt > 1e-4 then
			local d = (B.p - A.p) / dt
			if d.Magnitude <= (AIM_CONFIG.teleportSpeed or 90) then return d end
		end
	end
	return root and root.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
end
function aimPrimeVelocity(character)
	-- No-op by design: history is sampled every Heartbeat in the background, so
	-- there is nothing stale to "prime" and any Wait() here only delays the shot
	-- and lets the target walk away from the prediction. Kept for compatibility.
	if character then pcall(aimRecordSample, character) end
end
local function aimGetTargetVelocity(character)
	local v = aimEstimateMotion(character)
	return v
end

-- Jump-spam Y: window-averaged vy cancels out (up/down phases average ~0)
-- while the target actually moves ±20 at the lead moment. Blend in the fresh
-- 2-frame vy so rising/falling phases predict correctly. Globals on purpose
-- (chunk is at the local-registers limit).
function aimAirVy(vel, freshV)
	local fy = (freshV and freshV.Y) or (vel and vel.Y) or 0
	if fy ~= fy then fy = 0 end
	local ly = (vel and vel.Y) or 0
	if ly ~= ly then ly = 0 end
	return math.clamp(ly * 0.35 + fy * 0.65, -55, 55)
end

-- leadFrac scales the full ping-lead (0 = current pos, 1 = full lead).
-- V2: uses regression velocity + clamped acceleration + stability-scaled lead.
local function aimPredictTorso(character, leadFrac)
	if not character then return nil end
	local root = character:FindFirstChild("HumanoidRootPart")
	local aimPart = character:FindFirstChild(AIM_CONFIG.aimPart)
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("HumanoidRootPart")
		or root
	if not aimPart then return nil end
	local vel, acc, stab, hSpeed = aimEstimateMotion(character)
	local freshV = aimFreshVelocity(character)
	-- [aimfix] Mobile proven: raw Torso center as base (no HRP-average smoothing).
	-- V4 smoothing mixed HIP position into torso aim (~1 stud low) causing systematic low/edge misses; jitter is covered by the path-sweep instead.
	local p = aimPart.Position
	local fullT = aimGetLeadTime()
	local frac = (leadFrac == nil and 1 or leadFrac)
	local t = fullT * frac
	if t < 0 then t = 0 end
	local stopSpd = AIM_CONFIG.stopSpeed or 2.0
	-- Standing: aim at the exact current position (no lead error possible).
	-- Exception: a strafe that started THIS frame (fresh >> 0 while long ~ 0)
	-- gets a short minimax nudge so we don't aim a full lead behind.
	if hSpeed < stopSpd then
		local fh = math.sqrt(freshV.X * freshV.X + freshV.Z * freshV.Z)
		local px, pz = p.X, p.Z
		if fh >= 3.5 and fh <= (AIM_CONFIG.seedSpeedMax or 40) and frac > 0 then
			-- V3: strafe started this frame while long window still says "standing".
			-- Half-lead nudge (0.5): single bullet can't afford full-behind miss.
			local t0 = math.min(t, fullT) * 0.5
			px = p.X + freshV.X * t0
			pz = p.Z + freshV.Z * t0
		end
		local airborne = aimAirborneNow(character, vel)
		if airborne then
			local g = workspace.Gravity
			local py = p.Y + aimAirVy(vel, freshV) * t - 0.5 * g * t * t
			return Vector3.new(px, py, pz)
		end
		return Vector3.new(px, p.Y, pz)
	end
	-- V3 moving: stability-scaled minimax lead, jitter-aware for 65-100ms VPN.
	-- Stable sprint -> full lead; turning -> shorten. Jitter widens uncertainty,
	-- so unstable lead shortens further when ping spikes (bounded, mean stays put).
	local leadScale = 0.55 + 0.45 * math.clamp(stab or 1, 0, 1)
	local uScale = AIM_CONFIG.unstableLeadScale or 0.5
	if (stab or 1) < 0.5 then leadScale = uScale + (leadScale - uScale) * ((stab or 0) / 0.5) end
	do
		local j = 0
		pcall(function() j = aimGetPingJitter() end)
		if j and j > 0 then
			local extra = math.clamp(j * (AIM_CONFIG.pingJitterGain or 1.2) * 0.35, 0, 0.12)
			leadScale = math.clamp(leadScale - (1 - math.clamp(stab or 1, 0, 1)) * extra, 0.35, 1)
		end
	end
	-- For sweep endpoints (frac outside [0,1]) keep geometry exact: scale only
	-- the full-lead shot, not the path-fan geometry.
	local teff = t
	if frac == 1 then teff = fullT * leadScale end
	-- Acceleration correction, clamped to ±frac of the linear term.
	local ax, az = acc.X, acc.Z
	local linX, linZ = vel.X * teff, vel.Z * teff
	do
		local cX, cZ = 0.5 * ax * teff * teff, 0.5 * az * teff * teff
		local maxF = AIM_CONFIG.accelClampFrac or 0.38
		if math.abs(linX) > 1e-4 then cX = math.clamp(cX, -math.abs(linX) * maxF, math.abs(linX) * maxF)
		else cX = math.clamp(cX, -2, 2) end
		if math.abs(linZ) > 1e-4 then cZ = math.clamp(cZ, -math.abs(linZ) * maxF, math.abs(linZ) * maxF)
		else cZ = math.clamp(cZ, -2, 2) end
		-- Deceleration (stopping): never predict past the stopping point.
		if (vel.X * ax + vel.Z * az) < 0 then
			local dec = math.sqrt(ax * ax + az * az)
			if dec > 1e-3 then
				local vmag = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
				local tStop = vmag / dec
				if teff > tStop then
					local k = tStop / teff
					linX, linZ = linX * k, linZ * k
					cX, cZ = cX * k * k, cZ * k * k
				end
			end
		end
		linX, linZ = linX + cX, linZ + cZ
	end
	local outX = p.X + linX
	local outZ = p.Z + linZ
	local py
	local airborne = aimAirborneNow(character, vel)
	if airborne then
		local g = workspace.Gravity
		-- V3: fresh-blended vertical (jump-spam phases) clamped, teff so
		-- unstable shortening applies to Y too (consistent minimax).
		local vy = aimAirVy(vel, freshV)
		local yt = teff
		py = p.Y + vy * yt - 0.5 * g * yt * yt
		local boost = AIM_CONFIG.jumpAimYBoost or 0
		if vy > 8 then py = py + boost * 0.5 end
	else
		py = p.Y
	end
	return Vector3.new(outX, py, outZ)
end

-- Generate scatter positions around a predicted point for multi-hit
local function aimScatterPositions(center)
	local positions = {center}
	local r = AIM_CONFIG.scatterRadius or 0
	local n = AIM_CONFIG.scatterShots or 0
	if r > 0 and n > 0 then
		for i = 1, n do
			local angle = math.random() * math.pi * 2
			local dist = math.random() * r
			local ox = math.cos(angle) * dist
			local oz = math.sin(angle) * dist
			table.insert(positions, center + Vector3.new(ox, 0, oz))
		end
	end
	return positions
end

-- The murderer the aim is currently locked on. It survives his death: after a
-- kill the role data can flip to "Dead"/drop the Murderer role entirely, and the
-- aim used to switch itself off ("I killed the murderer but aim stopped").
-- The lock is only replaced by a NEW murderer or cleared when he leaves / the
-- next round starts (see aimTargetStillMurderer + CharacterAdded reset below).
aimStickyMurderer = nil
aimStickyMurdererAt = 0

local function aimFindMurderer()
	-- Prefer the freshest shared role snapshot: espRoles is refreshed only every
	-- 0.75 s and can still name the PREVIOUS round's murderer, which made both
	-- Default and Intercept aim at / wait for the wrong player after a reset.
	local data = nil
	if type(aimFreshRoleData) == "function" then
		pcall(function() data = aimFreshRoleData(1.5) end)
	end
	if type(data) ~= "table" then data = aimGetRoleData() end
	if data then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local info = data[plr.Name]
				if info and info.Role == "Murderer" then
					aimStickyMurderer = plr
					aimStickyMurdererAt = os.clock()
					return plr
				end
			end
		end
		-- A living/known non-murderer role for the sticky target means a NEW
		-- round is already replicated: drop the old corpse lock.
		local stickyInfo = aimStickyMurderer and data[aimStickyMurderer.Name]
		if type(stickyInfo) == "table" and (stickyInfo.Role == "Innocent"
			or stickyInfo.Role == "Sheriff" or stickyInfo.Role == "Hero") then
			aimStickyMurderer = nil
		end
	end
	for _, i in ipairs(Players:GetPlayers()) do
		if i ~= player then
			local bp = i:FindFirstChild("Backpack")
			if bp and bp:FindFirstChild("Knife") then
				aimStickyMurderer = i
				aimStickyMurdererAt = os.clock()
				return i
			end
		end
	end
	for _, i in ipairs(Players:GetPlayers()) do
		if i ~= player and i.Character and i.Character:FindFirstChild("Knife") then
			aimStickyMurderer = i
			aimStickyMurdererAt = os.clock()
			return i
		end
	end
	-- Killed murderer: keep aiming at his body until the round actually ends.
	if aimStickyMurderer and aimStickyMurderer.Parent and aimStickyMurderer ~= player then
		return aimStickyMurderer
	end
	return nil
end

-- A new round spawns a new character for us -> the previous murderer lock is
-- stale. (The new murderer is picked up by aimFindMurderer on the next call.)
function aimClearStickyMurdererOnRespawn()
	aimStickyMurderer = nil
	aimStickyMurdererAt = 0
end

local function aimFindNearestPlayer()
	if not player.Character then return nil end
	local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end
	local nearest, best = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local r = p.Character:FindFirstChild("HumanoidRootPart")
			if r then
				local d = (myRoot.Position - r.Position).Magnitude
				if d < best then best = d; nearest = p end
			end
		end
	end
	return nearest
end

local function aimMurdererAlive(m)
	if not m or not m.Character then return false end
	local hum = m.Character:FindFirstChildOfClass("Humanoid")
	if hum ~= nil and hum.Health > 0 then return true end
	-- [aimfix] The murderer is already dead but is STILL the aim target of this
	-- round: keep firing at his body instead of switching the aim off. The body
	-- (and its hitbox) is what the player asked the aim to keep shooting.
	return aimStickyMurderer ~= nil and m == aimStickyMurderer and m.Parent ~= nil
end

local function aimGetShootRemote()
	local char = player.Character
	if not char then return nil end
	local gun = char:FindFirstChild("Gun")
	if not gun then
		local bp = player:FindFirstChild("Backpack")
		local bg = bp and bp:FindFirstChild("Gun")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if bg and hum then
			pcall(function() hum:EquipTool(bg) end)
			task.wait()
			gun = char:FindFirstChild("Gun") or bg
		else
			gun = bg
		end
	end
	if not gun then return nil end
	-- Kill the stock click the instant the gun is known, so it cannot win the
	-- same-frame race and consume the single server-side shot.
	pcall(aimApplyStockShotBlock)
	return gun:FindFirstChild("Shoot")
end

-- A piercer ray must START OUTSIDE the victim's hitbox. Roblox raycasts skip a
-- part whose volume contains the ray origin, so the old fixed 0.6-stud offset
-- (inside a 2-stud-wide torso from the side / from above) let the bullet pass
-- straight through the victim and hit the wall behind it. Measure the real
-- torso box and place the origin just beyond its surface along the shot line.
function aimPartExitDistance(part, worldDir)
	if not (part and part:IsA("BasePart")) then return nil end
	local d = part.CFrame:VectorToObjectSpace(worldDir)
	local s = part.Size * 0.5
	local best = math.huge
	if math.abs(d.X) > 1e-4 then best = math.min(best, s.X / math.abs(d.X)) end
	if math.abs(d.Y) > 1e-4 then best = math.min(best, s.Y / math.abs(d.Y)) end
	if math.abs(d.Z) > 1e-4 then best = math.min(best, s.Z / math.abs(d.Z)) end
	if best == math.huge then return nil end
	return best
end

function aimShootOriginDistance(targetChar, worldDir)
	local base = (AIM_CONFIG and AIM_CONFIG.wallbangOriginDist) or 0.6
	local part = targetChar and (targetChar:FindFirstChild((AIM_CONFIG and AIM_CONFIG.aimPart) or "Torso")
		or targetChar:FindFirstChild("Torso")
		or targetChar:FindFirstChild("UpperTorso")
		or targetChar:FindFirstChild("HumanoidRootPart"))
	if part and part:IsA("BasePart") then
		local exit = worldDir and aimPartExitDistance(part, worldDir)
		local need
		if exit then
			-- Exact distance to the torso surface along this direction + margin.
			need = exit + 0.3
		else
			local s = part.Size
			need = math.sqrt(s.X * s.X + s.Y * s.Y + s.Z * s.Z) * 0.5 + 0.4
		end
		if need > base then base = need end
	end
	-- Hard floor: never go back to the old inside-the-body distance.
	if base < 0.85 then base = 0.85 end
	return base
end

-- Push a sweep origin behind the aim point until it clears the torso box.
-- Keeps the original path line (origin -> aim point) intact.
function aimSafeSweepOrigin(aimPoint, pathPoint, targetChar)
	local delta = pathPoint - aimPoint
	local dist = delta.Magnitude
	local unit
	if dist > 1e-3 then
		unit = delta.Unit
	else
		local myChar = player.Character
		local myPart = myChar and (myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("HumanoidRootPart"))
		local myPos = myPart and myPart.Position or (aimPoint + Vector3.new(0, 0, 1))
		local back = myPos - aimPoint
		unit = back.Magnitude > 1e-3 and back.Unit or Vector3.new(0, 0, 1)
	end
	local minDist = aimShootOriginDistance(targetChar, unit)
	if dist >= minDist then return pathPoint end
	return aimPoint + unit * minDist
end

local function aimGetShootOrigin(target, targetChar)
	local char = player.Character
	local originPart = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("HumanoidRootPart"))
	local myPos = originPart and originPart.Position or Vector3.new(0, 0, 0)
	-- Always use piercer-style origin when enabled or when desync features are active
	-- This ensures shots hit even when using Invisible, Desync, or Anti-Shoot
	-- [aimfix] Mobile proven: ALWAYS near-target origin so Piercer ON/OFF hit equally + bypass walls/desync/invis.
	local forcePierce = (AIM_CONFIG and AIM_CONFIG.alwaysPierceOrigin) or aimWallbangEnabled
		or PastedSources or DesyncSpinActive or hiddenfling
	if forcePierce then
		local dir = myPos - target
		local unit = dir.Magnitude > 1e-3 and dir.Unit or Vector3.new(0, 1, 0)
		return target + unit * aimShootOriginDistance(targetChar, unit)
	end
	return myPos
end

-- originOverride lets path-sweep shots place the ray origin themselves (behind
-- the target on its movement path) instead of the default near-target origin.
local function aimFireOnce(shoot, target, originOverride, targetChar)
	local origin = originOverride or aimGetShootOrigin(target, targetChar)
	-- Stock GunClient sets CantShoot when the barrel is inside geometry; the
	-- server may reject wall-adjacent shots while it is enabled. Our piercer
	-- origin is deliberate, so clear the flag before firing.
	pcall(function()
		local tool = shoot and shoot.Parent
		local cs = tool and tool:FindFirstChild("CantShoot")
		if cs ~= nil then cs.Enabled = false end
	end)
	return pcall(function() shoot:FireServer(CFrame.new(origin), CFrame.new(target)) end)
end

-- burstOverride lets the Auto Shot loop fire smaller bursts than a manual click.
--
-- ACCURACY OVERHAUL — why the old version missed:
--   1. The whole burst fired on ONE stale snapshot of position/velocity: every
--      bullet inherited the same prediction error.
--   2. Every bullet was a POINT shot at a guessed future position — with any
--      lead error (variable ping, strafe change) ALL bullets missed together.
-- New approach:
--   * Every bullet against a moving target is a PATH-SWEEP ray: the origin is
--     placed BEHIND the aim point along the target's movement direction and the
--     endpoint AHEAD of it, so the server-side ray passes through a whole
--     segment of the target's path. Wherever on that segment the target really
--     is on the server, the ray crosses its hitbox — lead error no longer
--     causes a clean miss.
--   * One extra "full-path" sweep covers current position -> past full lead in
--     a single ray, guaranteeing coverage even if the lead estimate is way off.
--   * The burst is spread across frames (Heartbeat between shots) and position,
--     velocity and lead are re-read for EVERY bullet, so later bullets self-
--     correct instead of repeating the first bullet's error.
--   * Vertical bracket shots cover jumping / crouching / FakeDuck hitbox shifts
--     for both standing AND moving targets.

-- Flick Shot: rotates the character to face the target before shooting, then
-- rotates back. Designed for first-person / shift-lock where character rotation
-- = camera rotation. The rotation takes flickShotDuration seconds so other
-- players can see the turn.
function doFlickToTarget(targetPlayer, callback)
	if not flickShotEnabled then callback() return end
	local char = player.Character
	if not char then callback() return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) then callback() return end
	local targetChar = targetPlayer.Character
	if not targetChar then callback() return end
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if not targetRoot then callback() return end

	-- [movement-safe] We never freeze your position: each frame we read your
	-- LIVE position (which keeps updating as you walk) and only override the
	-- facing/yaw, blended toward the target so the turn is still visible to
	-- others. AutoRotate is disabled only for the brief aim window and the shot
	-- fires immediately after — there is no forced "rotate back" phase that used
	-- to lock you in place next to the murderer.
	local startCF = hrp.CFrame
	local wasAutoRotate = hum.AutoRotate
	hum.AutoRotate = false

	local steps = math.max(2, math.floor(flickShotDuration * 60))
	for i = 1, steps do
		local curPos = hrp.Position
		local dir = (targetRoot.Position - curPos) * Vector3.new(1, 0, 1)
		if dir.Magnitude >= 0.1 then
			local aimCF = CFrame.lookAt(curPos, curPos + dir.Unit)
			local blended = startCF:Lerp(aimCF, i / steps)
			hrp.CFrame = CFrame.new(curPos) * (blended - blended.Position)
		end
		RunService.Heartbeat:Wait()
	end

	callback()

	-- Restore normal control instantly; the humanoid re-orients to your movement
	-- on its own, so you can keep walking right away.
	hum.AutoRotate = wasAutoRotate
end

-- Spin 360: performs a full 360-degree spin in place over spin360Duration seconds.
function doSpin360(callback)
	if not spin360Enabled then callback() return end
	local char = player.Character
	if not char then callback() return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) then callback() return end

	-- [faster + movement-safe] Spins over spin360Duration (now 0.5s: quick but
	-- still long enough for other players to actually SEE the spin), keeps your
	-- live position each frame so you are not frozen, and fires the shot the
	-- instant the spin completes instead of after extra waits.
	local wasAutoRotate = hum.AutoRotate
	hum.AutoRotate = false

	local startYaw = math.atan2(-hrp.CFrame.LookVector.X, -hrp.CFrame.LookVector.Z)
	local totalAngle = math.rad(360)
	local steps = math.max(2, math.floor(spin360Duration * 60))
	for i = 1, steps do
		local curPos = hrp.Position
		local currentAngle = startYaw + totalAngle * (i / steps)
		local dir = Vector3.new(math.sin(currentAngle), 0, math.cos(currentAngle))
		hrp.CFrame = CFrame.lookAt(curPos, curPos + dir)
		RunService.Heartbeat:Wait()
	end

	callback()

	hum.AutoRotate = wasAutoRotate
end

-- V2: wait-free. Any pre-shot hold lets the target walk off the prediction,
-- so stability is handled INSIDE the predictor (shortened lead) instead.
function aimWaitForStableVelocity(character)
	return
end

function aimFireGunAt(murderer, burstOverride, allowAnyTarget)
	-- V2: fire instantly with the background tracker's freshest data. No priming
	-- waits, no stability holds — both only made the snapshot older.
	-- Silence the stock click up front (flick/spin preamble included): otherwise
	-- the stock shot can fire during the animation and eat the only shot.
	pcall(aimApplyStockShotBlock)
	local function fire()
		return aimFireGunAtOriginal(murderer, burstOverride, allowAnyTarget)
	end
	if flickShotEnabled and murderer then
		local result = false
		local function afterFlick()
			if spin360Enabled then
				doSpin360(function()
					result = fire()
				end)
			else
				result = fire()
			end
		end
		doFlickToTarget(murderer, afterFlick)
		return result
	end
	if spin360Enabled then
		local result = false
		doSpin360(function()
			result = fire()
		end)
		return result
	end
	return fire()
end

-- (V4 aimPierceThrough removed: its past-the-body endpoint let the server
-- sail bullets through players. Endpoints stay inside the torso.)
-- True when a wall (anything except the two characters) sits between two
-- points, i.e. a sweep along that segment would eat the wall before the victim.
function aimSweepBlocked(targetChar, from, to)
	local ok, blocked = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local list = {targetChar}
		if player.Character then table.insert(list, player.Character) end
		params.FilterDescendantsInstances = list
		params.IgnoreWater = true
		local dir = to - from
		if dir.Magnitude < 1e-3 then return false end
		return Workspace:Raycast(from, dir, params) ~= nil
	end)
	return ok and blocked
end

-- Fresh role snapshot for the aim path. The shared _roleDataCache is refreshed
-- by the role pollers and is preferred while it is recent; espRoles (refreshed
-- every 0.75 s) is the fallback. Using a stale previous-round snapshot here was
-- vetoing perfectly valid murderer shots at round start.
function aimFreshRoleData(maxAge)
	maxAge = maxAge or 1.5
	local now = os.clock()
	if type(_roleDataCache) == "table" and (now - (_roleDataCacheAt or 0)) <= maxAge then
		return _roleDataCache
	end
	local data = nil
	pcall(function() data = aimGetRoleData() end)
	if type(data) == "table" then return data end
	if type(_roleDataCache) == "table" then return _roleDataCache end
	return nil
end

-- A murderer carries the knife (in hand or in the backpack) even when the role
-- snapshot has not replicated yet — used as the fallback proof of role.
function aimHasKnifeEquipped(plr)
	plr = plr or player
	local char = plr.Character
	if char and char:FindFirstChild("Knife") then return true end
	local bp = plr:FindFirstChild("Backpack")
	return bp ~= nil and bp:FindFirstChild("Knife") ~= nil
end

-- A target is only shot while it is STILL the murderer: if the murderer left
-- the server (Player.Parent == nil / no character) or the freshest role cache
-- lists them as someone else, the shot is refused. This prevents the old
-- "murderer left -> shoot the nearest random innocent" behavior.
function aimTargetStillMurderer(m)
	if not (m and m.Parent and m.Character) then return false end
	-- The murderer we killed this round stays a valid target even after his
	-- role flips to Dead / disappears from the role data. This is deliberate:
	-- the player wants the aim to KEEP working after the murderer is killed.
	if m == aimStickyMurderer then
		local sdata = aimFreshRoleData(1.5)
		local sinfo = sdata and sdata[m.Name]
		-- Safety net: if he is ALIVE with a clearly different role the sticky
		-- lock is from the previous round, so drop it instead of shooting an
		-- innocent. A dead body / "Dead" role never trips this.
		if type(sinfo) == "table" and sinfo.Role then
			local srole = sinfo.Role
			if srole == "Innocent" or srole == "Sheriff" or srole == "Hero" then
				local shum = m.Character and m.Character:FindFirstChildOfClass("Humanoid")
				if shum and shum.Health > 0 then
					aimStickyMurderer = nil
					return false
				end
			end
		end
		return true
	end
	local data = aimFreshRoleData(1.5)
	local info = data and data[m.Name]
	if type(info) == "table" and info.Role then
		if info.Role == "Murderer" then
			-- Dead or not does NOT matter here: shoot his body until the round
			-- ends (the old Dead/Killed veto was why the aim stopped firing).
			aimStickyMurderer = m
			aimStickyMurdererAt = os.clock()
			return true
		end
		-- Role says someone else, but the snapshot may still describe the
		-- previous round: a knife is authoritative proof of the new role.
		return aimHasKnifeEquipped(m)
	end
	-- No role entry at all (round transition / remote outage): require the
	-- knife so a random innocent is never shot by the auto-aim.
	return aimHasKnifeEquipped(m)
end

-- True when the first PLAYER hit along the shot is someone other than the
-- intended victim. Walls are ignored on purpose (the piercer is meant to shoot
-- through them); only other players count.
function aimShotHitsBystander(origin, endpoint, targetChar)
	if not (origin and endpoint) then return false end
	local myChar = player.Character
	local ok, res = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {myChar}
		params.IgnoreWater = true
		local dir = endpoint - origin
		if dir.Magnitude < 1e-3 then return nil end
		return Workspace:Raycast(origin, dir, params)
	end)
	if not ok or not res then return false end
	local model = res.Instance and res.Instance:FindFirstAncestorOfClass("Model")
	local plr = model and Players:GetPlayerFromCharacter(model)
	if not plr or plr == player then return false end
	return model ~= targetChar
end

function aimFireGunAtOriginal(murderer, burstOverride, allowAnyTarget)
	-- allowAnyTarget is used ONLY by "Shoot Player" (an explicit player picked
	-- from the list): the murderer-only filter and the bystander protection must
	-- not veto that deliberate shot. Every automatic/aim path keeps them.
	if not allowAnyTarget and not aimTargetStillMurderer(murderer) then return false end
	local function blocked(origin, endpoint, targetChar)
		if allowAnyTarget then return false end
		return aimShotHitsBystander(origin, endpoint, targetChar)
	end
	local shoot = aimGetShootRemote()
	if not shoot then return false end
	pcall(aimApplyStockShotBlock)
	if not (murderer and murderer.Character) then return false end
	if not aimMurdererAlive(murderer) then return false end
	local char = murderer.Character
	-- Freshest sample: include the frame that just replicated (no waiting).
	pcall(aimRecordSample, char)
	local vel, acc, stab, hSpeed = aimEstimateMotion(char)
	local stopSpd = AIM_CONFIG.stopSpeed or 2.0
	if (hSpeed or 0) < stopSpd then
		-- Standing: point shot with the endpoint INSIDE the torso. The endpoint
		-- must never sit past the body — a V4 through-shot did that and the
		-- server let bullets sail through standing players into the back wall.
		-- The origin is placed beyond the real torso surface so the ray does
		-- not START inside the hitbox (Roblox skips a part containing the ray
		-- origin — the cause of bullets sailing through the victim).
		local center = aimPredictTorso(char, 0.5)
		if not center then return false end
		local origin = aimGetShootOrigin(center, char)
		-- Body-blocked on our side: refuse rather than hit an innocent.
		if blocked(origin, center, char) then return false end
		return aimFireOnce(shoot, center, origin, char)
	end
	if (stab or 1) < 0.5 then
		-- V4: turning hard / strafe reversal: movement AXIS is a guess, a long
		-- sweep would lie along the wrong line. Short sweep from behind the
		-- current position to the shortened lead: bounded error either way, and
		-- the origin is pushed outside the body so the hit always registers.
		local cur = aimPredictTorso(char, 0)
		local pt = aimPredictTorso(char, 1)
		if not (cur and pt) then return false end
		local origin = aimSafeSweepOrigin(cur, cur - (pt - cur), char)
		if aimSweepBlocked(char, origin, cur) then
			-- Wall on the back side: bet on a guaranteed near-target point shot
			-- at the current position instead (wall-immune origin).
			local safeOrigin = aimGetShootOrigin(cur, char)
			if blocked(safeOrigin, cur, char) then return false end
			return aimFireOnce(shoot, cur, safeOrigin, char)
		end
		if blocked(origin, pt, char) then
			-- Someone is standing on the sweep line: use a precise point shot on
			-- the victim instead of spraying the whole path through a bystander.
			local safeOrigin = aimGetShootOrigin(cur, char)
			if blocked(safeOrigin, cur, char) then return false end
			return aimFireOnce(shoot, cur, safeOrigin, char)
		end
		return aimFireOnce(shoot, pt, origin, char)
	end
	-- V3 stable sprint: ONE ray ALONG the path, adaptively expanded.
	-- Base -0.35 -> 1.25 covers ping-mean error; jitter (VPN) + residual
	-- instability widen it so the server-side ray still crosses the hitbox
	-- wherever on the segment the target really is (early/late/strafe wobble).
	local backFrac, aheadFrac = (AIM_CONFIG.sweepBackFrac or -0.35), (AIM_CONFIG.sweepAheadFrac or 1.25)
	do
		local j = 0
		pcall(function() j = aimGetPingJitter() end)
		local extra = 0
		if j and j > 0 then
			extra = extra + math.clamp(j * (AIM_CONFIG.pingJitterGain or 1.2), 0, (AIM_CONFIG.sweepJitterMax or 0.45))
		end
		-- Residual instability: (1-stab) widens sweep so a mid-sprint micro-turn
		-- doesn't slide the target off the ray. Bounded to keep ray tight.
		extra = extra + (1 - math.clamp(stab or 1, 0, 1)) * 0.22
		if extra > 0.9 then extra = 0.9 end
		backFrac = backFrac - extra
		aheadFrac = aheadFrac + extra * 0.9
	end
	local back = aimPredictTorso(char, backFrac)
	local ahead = aimPredictTorso(char, aheadFrac)
	local cur = aimPredictTorso(char, 0)
	if not (back and ahead and cur) then return false end
	-- If a wall sits between the (extended) back point and the target
	-- (corner-hugging), the sweep would hit the wall first — fall back to a
	-- near-target point shot at the full-lead position instead.
	local origin = aimSafeSweepOrigin(cur, back, char)
	if aimSweepBlocked(char, origin, cur) then
		-- V3 wall fallback: corner-hugging target, long sweep would hit the wall
		-- first. Fire a short near-target ray that still spans cur->lead so it
		-- keeps path forgiveness instead of betting on one point.
		local leadPt = aimPredictTorso(char, 1)
		if not leadPt then return false end
		local safeOrigin = aimGetShootOrigin(cur, char)
		if blocked(safeOrigin, leadPt, char) then return false end
		return aimFireOnce(shoot, leadPt, safeOrigin, char)
	end
	if blocked(origin, ahead, char) then
		-- Bystander on the sweep line: precise victim point shot instead.
		local safeOrigin = aimGetShootOrigin(cur, char)
		if blocked(safeOrigin, cur, char) then return false end
		return aimFireOnce(shoot, cur, safeOrigin, char)
	end
	return aimFireOnce(shoot, ahead, origin, char)
end

-- Line of sight: true when nothing but the two characters sits between our
-- head and the target's head (i.e. the murderer is NOT behind a wall).
-- NOTE: global (not local) on purpose: the chunk is at the local-registers
-- limit, every top-level local counts. Behavior is identical.
function aimHasLineOfSight(m)
	local myChar = player.Character
	local myHead = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
	local tChar = m and m.Character
	local tPart = tChar and (tChar:FindFirstChild("Head") or tChar:FindFirstChild("HumanoidRootPart"))
	if not (myHead and tPart) then return false end
	local origin = myHead.Position
	local dir = tPart.Position - origin
	if dir.Magnitude < 1e-3 then return true end
	local ok, hit = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local list = {tChar}
		if myChar then table.insert(list, myChar) end
		params.FilterDescendantsInstances = list
		params.IgnoreWater = true
		return Workspace:Raycast(origin, dir, params)
	end)
	if not ok then return false end
	return hit == nil
end

-- Red dot on the current murderer (same aim indicator as the standalone script)
local function aimCreateTargetDot()
	if aimTargetDot then aimTargetDot:Destroy() end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AimTargetDot"
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.new(0, 8, 0, 8)
	billboard.MaxDistance = math.huge
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(1, 0, 1, 0)
	dot.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	dot.BorderSizePixel = 0
	dot.BackgroundTransparency = 1
	dot.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot
	aimTargetDot = billboard
	return billboard
end

local function aimUpdateTargetDot()
	local murderer = aimFindMurderer()
	if murderer == player then murderer = nil end
	if murderer and murderer.Character then
		local torso = murderer.Character:FindFirstChild("Torso") or murderer.Character:FindFirstChild("UpperTorso")
		if torso then
			if not aimTargetDot or not aimTargetDot.Parent then
				aimCreateTargetDot()
				aimTargetDot.Parent = torso
			elseif aimTargetDot.Parent ~= torso then
				aimTargetDot.Parent = torso
			end
		else
			if aimTargetDot then aimTargetDot:Destroy(); aimTargetDot = nil end
		end
	else
		if aimTargetDot then aimTargetDot:Destroy(); aimTargetDot = nil end
	end
end
-- [perf] The target-dot tracker used to run aimFindMurderer() every single frame
-- regardless of any toggle, which cost FPS for nothing. The dot is parented to the
-- target so it follows automatically; re-resolving the murderer ~10x/sec is plenty.
_targetDotFrame = 0
RunService.RenderStepped:Connect(function()
	_targetDotFrame = _targetDotFrame + 1
	if _targetDotFrame % 6 ~= 0 then return end
	pcall(aimUpdateTargetDot)
end)

function aimUnequipGun()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum:UnequipTools() end) end
end

-- ============================================================
-- ACCURATE SILENT AIM modes.
-- Default Accurate / Intercept Accurate: the aim HOLSTERS the gun first, then
-- STUDIES the victim's movement for a dynamic length of time (0.05-2.0 s,
-- driven by the target: standing -> almost instant, jumping/running -> longer),
-- then equips the gun itself, fires the precise pierced shot and — for Default
-- Accurate only — holsters it again. Intercept Accurate keeps it out.
-- Both are also used by Auto Shoot Murderer when selected.
-- ============================================================
aimAccurateBusy = false

function aimAccurateModeSelected()
	local mode = (lmbShootAimMode and lmbShootAimMode()) or "Default"
	return mode == "Default Accurate" or mode == "Intercept Accurate"
end

function aimAccurateKeepEquipped()
	local mode = (lmbShootAimMode and lmbShootAimMode()) or "Default"
	return mode == "Intercept Accurate"
end

function aimAccurateEnsureGun(maxWait)
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local gun = char:FindFirstChild("Gun")
	if gun then return gun end
	local bp = player:FindFirstChild("Backpack")
	local bg = bp and bp:FindFirstChild("Gun")
	if not (bg and hum) then return nil end
	pcall(function() hum:EquipTool(bg) end)
	local started = os.clock()
	maxWait = tonumber(maxWait) or 0.6
	while os.clock() - started < maxWait do
		RunService.Heartbeat:Wait()
		if player.Character ~= char then return nil end
		gun = char:FindFirstChild("Gun")
		if gun then return gun end
	end
	-- Still not equipped: return the backpack tool so the caller can retry via
	-- aimGetShootRemote (which equips again) instead of aborting the shot.
	return char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
end

-- How long the aim should STUDY the target before shooting, decided by the
-- target's own motion. A standing player is fired at almost instantly; a
-- sprinting / jumping / erratic one is studied for longer, hard-capped at
-- 2.0 s (inclusive) so a jumping target never stalls the shot forever.
function aimAccurateStudyTime(char)
	if not (char and char.Parent) then return 0.05 end
	pcall(aimRecordSample, char)
	local vel, acc, stab, hSpeed = aimEstimateMotion(char)
	local vSpeed = vel and math.abs(vel.Y) or 0
	local aMag = (acc and acc.Magnitude) or 0
	hSpeed = hSpeed or 0
	stab = math.clamp(stab or 1, 0, 1)
	local airborne = vSpeed > 3.5
	if hSpeed < 1.5 and (not airborne) and aMag < 8 and stab >= 0.78 then
		-- Stationary target: shoot almost immediately.
		return 0.06
	end
	-- The background sampler already records every player each frame, so the
	-- study only needs to top the velocity window up: long waits let the target
	-- walk away from the studied snapshot and cost more shots than they win.
	local delay = 0.12
		+ math.clamp(hSpeed / 24, 0, 1) * 0.45
		+ math.clamp(vSpeed / 30, 0, 1) * 0.30
		+ math.clamp(aMag / 60, 0, 1) * 0.28
		+ (1 - stab) * 0.55
	if airborne then delay = delay + 0.22 end
	return math.clamp(delay, 0.05, 1.4)
end

-- Wait the dynamically chosen study time (0.05-2.0 s). If the target starts
-- jumping / turning mid-study the deadline is pushed out, never past 2.0 s.
function aimAccurateStudy(char, maxT)
	maxT = math.clamp(maxT or 2.0, 0.05, 2.0)
	local started = os.clock()
	local deadline = math.min(maxT, aimAccurateStudyTime(char))
	local lastCheck = 0
	while true do
		local elapsed = os.clock() - started
		if elapsed >= deadline then break end
		RunService.Heartbeat:Wait()
		if not (char and char.Parent) then break end
		pcall(aimRecordSample, char)
		if elapsed - lastCheck >= 0.12 then
			lastCheck = elapsed
			local want = math.min(maxT, aimAccurateStudyTime(char))
			if want > deadline then deadline = want end
		end
	end
	return os.clock() - started
end

-- The stock GunClient fires the instant the player clicks. While an Accurate
-- mode is selected (Gun Silent Aim or Auto Shoot on) we keep Tool.Enabled off
-- so the stock shot can never pre-empt the studied shot. A direct :FireServer()
-- on the Shoot remote is NOT affected by Enabled, so our own shot still works.
aimStockBlockedTools = aimStockBlockedTools or {}

function aimGetGunTools()
	local out = {}
	local char = player.Character
	if char then
		for _, obj in ipairs(char:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == "Gun" then table.insert(out, obj) end
		end
	end
	local bp = player:FindFirstChild("Backpack")
	if bp then
		for _, obj in ipairs(bp:GetChildren()) do
			if obj:IsA("Tool") and obj.Name == "Gun" then table.insert(out, obj) end
		end
	end
	return out
end

function aimStockShotBlocked()
	if not (aimLmbShootEnabled or aimAutoShotEnabled) then return false end
	-- Every mode where THIS script fires the real shot must silence the stock
	-- click. The server accepts only ONE shot per reload and the stock shot is
	-- aimed at the mouse cursor — when it wins the same-frame race, the studied/
	-- predicted shot is discarded. That race was why "Default" missed so often
	-- (Accurate modes were already blocked; Intercept is the only mode that
	-- deliberately USES the stock shot, so it stays enabled there).
	local mode = (lmbShootAimMode and lmbShootAimMode()) or "Default"
	return mode ~= "Intercept"
end

function aimApplyStockShotBlock()
	local block = aimStockShotBlocked()
	if block then
		for tool in pairs(aimStockBlockedTools) do
			if not tool.Parent then aimStockBlockedTools[tool] = nil end
		end
		for _, tool in ipairs(aimGetGunTools()) do
			pcall(function()
				if tool.Enabled then
					tool.Enabled = false
					aimStockBlockedTools[tool] = true
				end
			end)
		end
	else
		for tool in pairs(aimStockBlockedTools) do
			pcall(function()
				if tool and tool.Parent then tool.Enabled = true end
			end)
			aimStockBlockedTools[tool] = nil
		end
	end
end

function aimAccurateFire(murderer, keepEquipped, allowAnyTarget)
	if aimAccurateBusy then return false end
	if not allowAnyTarget and not aimTargetStillMurderer(murderer) then return false end
	aimAccurateBusy = true
	local fired = false
	pcall(function()
		-- Hard total budget: holster -> study -> equip -> shoot must never take
		-- longer than 2.5 s, even against a jumping / erratic victim.
		local deadline = os.clock() + 2.5
		local function remaining() return deadline - os.clock() end
		-- Holster FIRST: the stock gun must not fire while the aim studies the
		-- target. The study itself runs with the gun put away.
		pcall(aimUnequipGun)
		RunService.Heartbeat:Wait()
		if not aimMurdererAlive(murderer) then return end
		if not allowAnyTarget and not aimTargetStillMurderer(murderer) then return end
		-- Dynamic study: ~0.06 s for a standing player, up to 2.0 s for a
		-- jumping / erratic one. Leave 0.35 s for equip + remote + fire.
		local studyCap = math.min(2.0, math.max(0.05, remaining() - 0.35))
		aimAccurateStudy(murderer.Character, studyCap)
		if not aimMurdererAlive(murderer) then return end
		if not allowAnyTarget and not aimTargetStillMurderer(murderer) then return end
		-- Now equip (the aim equips the gun itself — no manual equip needed)
		-- and fire the precise pierced shot.
		local gun = aimAccurateEnsureGun(math.max(0.05, remaining() - 0.1))
		if not gun then return end
		-- One frame so the equip replicates to the server before the shot: firing
		-- in the very same frame the Gun appears was another silent-miss source.
		if remaining() > 0.05 then RunService.Heartbeat:Wait() end
		if not aimMurdererAlive(murderer) then return end
		local shoot = nil
		while remaining() > 0.02 do
			shoot = aimGetShootRemote()
			if shoot then break end
			RunService.Heartbeat:Wait()
			if not aimMurdererAlive(murderer) then return end
		end
		if not shoot then return end
		aimApplyStockShotBlock()
		fired = aimFireGunAtOriginal(murderer, 1, allowAnyTarget) and true or false
		-- Exactly ONE shot: the server only processes one shot per reload, so the
		-- old 0.12 s "insurance" second shot only added latency and never landed.
		if fired and not keepEquipped then
			-- Let the server process the shot BEFORE holstering. Unequipping in
			-- the firing frame made the server reject it as "player has no Gun",
			-- which is why Default Accurate missed while Intercept Accurate (which
			-- keeps the gun out) hit reliably.
			local settleUntil = os.clock() + 0.16
			while os.clock() < settleUntil do RunService.Heartbeat:Wait() end
		end
	end)
	if not keepEquipped then pcall(aimUnequipGun) end
	aimAccurateBusy = false
	aimApplyStockShotBlock()
	return fired
end

-- Keep the stock shot disabled for as long as an Accurate mode is active.
task.spawn(function()
	while true do
		task.wait(0.15)
		pcall(aimApplyStockShotBlock)
	end
end)

-- One-shot manual fire (Shoot Murderer button / keybind)
function doShootMurderer()
	local char = player.Character
	local hasGun = char and (char:FindFirstChild("Gun")
		or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Gun")))
	if not hasGun then
		game.StarterGui:SetCore("SendNotification", {Title = "Error", Text = "You don't have the gun.", Duration = 2})
		return
	end
	local murderer = aimFindMurderer()
	if not (murderer and murderer.Character) or not aimTargetStillMurderer(murderer) then
		game.StarterGui:SetCore("SendNotification", {Title = "Error", Text = "No target to shoot.", Duration = 2})
		return
	end
	if aimAccurateModeSelected() then
		local keep = aimAccurateKeepEquipped()
		local ok = aimAccurateFire(murderer, keep)
		game.StarterGui:SetCore("SendNotification", {
			Title = ok and "Shot Fired" or "Shot Failed",
			Text = string.format("%s shot on %s (studied motion, ping: %dms)",
				keep and "Intercept Accurate" or "Default Accurate", murderer.Name, math.floor(aimGetPing())),
			Duration = 1.5
		})
		return
	end
	local ok = aimFireGunAtOriginal(murderer)
	-- Give the server a moment to process the shot while the Gun is still out;
	-- holstering in the same frame voided the shot ("player has no Gun").
	if ok then task.wait(0.16) end
	aimUnequipGun()
	game.StarterGui:SetCore("SendNotification", {
		Title = ok and "Shot Fired" or "Shot Failed",
		Text = string.format("Ping-predicted shot on %s (Ping: %dms)", murderer.Name, math.floor(aimGetPing())),
		Duration = 1.5
	})
end

-- Gun Silent Aim: Default fires our own predicted shot on click, Intercept
-- silently retargets the stock shot (WeaponService hook), and the two Accurate
-- modes run the study-then-shoot flow above. Ignores clicks consumed by the
-- menu UI and stays silent with no gun.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	pcall(function()
		if gameProcessed then return end
		if not aimLmbShootEnabled then return end
		local mode = lmbShootAimMode()
		if mode ~= "Default" and mode ~= "Default Accurate" and mode ~= "Intercept Accurate" then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local char = player.Character
		local bp = player:FindFirstChild("Backpack")
		local hasGun = char and (char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")))
		if not hasGun then return end
		local equippedTool = char:FindFirstChildOfClass("Tool")
		if equippedTool and equippedTool.Name ~= "Gun" then return end
		local murderer = aimFindMurderer()
		if murderer and murderer.Character and aimMurdererAlive(murderer) and aimTargetStillMurderer(murderer) then
			if mode == "Default Accurate" then
				aimAccurateFire(murderer, false)
			elseif mode == "Intercept Accurate" then
				aimAccurateFire(murderer, true)
			else
				local ok = aimFireGunAt(murderer)
				if ok then
					-- Keep the Gun equipped until the server has actually processed
					-- the FireServer call. Holstering in the SAME frame made the
					-- server see "no gun" and drop the shot (the main reason the
					-- Default mode missed while Intercept, which never holsters,
					-- hit reliably).
					task.wait(0.16)
				end
				aimUnequipGun()
			end
		end
	end)
end)

-- Auto Shot loop: uses the SAME technique as the Autofarm end-of-farm shot —
-- predicted fire + unequip (aimFireGunAtOriginal does the full ping-prediction
-- and fires the remote with NO waiting; all the extra latency lives only in the
-- aimFireGunAt wrapper's stable-velocity flick/spin preamble, which we skip).
-- On gun pickup it fires INSTANTLY (bypassing the cooldown) and then keeps
-- spamming at autoShotCooldown so a miss (e.g. role cache still empty) retries
-- on the very next heartbeat — no delay between grabbing the gun and shooting.
local aimHadGunLast = false
local aimLastRoleRefresh = 0
local aimLastAutoShotAt = 0

-- [perf] Event-based gun detection: the Heartbeat loop detects the Gun tool on
-- the NEXT frame after it appears (~16 ms at 60 fps). At round start the role
-- cache is stale (espRoles was just reset), so the first aimFindMurderer() call
-- falls through to a blocking aimRefreshRoleNow() (InvokeServer ~100-200 ms).
-- By listening for Backpack.ChildAdded we trigger the role refresh the INSTANT
-- the Gun tool arrives — up to a full frame earlier — so by the time the
-- Heartbeat loop picks it up the data is already fresh. Mid-round the ESP cache
-- is already populated so the event is redundant but harmless.
autoShotGunDetectConn = nil
autoShotGunRoleRefreshing = false
local function autoShotOnGunDetected()
	if not aimAutoShotEnabled then return end
	if autoShotGunRoleRefreshing then return end
	autoShotGunRoleRefreshing = true
	task.spawn(function()
		pcall(aimRefreshRoleNow)
		autoShotGunRoleRefreshing = false
	end)
end

-- Kill the stock trigger the instant a Gun is picked up or equipped (Accurate
-- modes only — aimApplyStockShotBlock checks that itself), so the player's own
-- click can never beat the studied shot.
-- Global (not local) on purpose: the chunk is close to the local-register limit.
function hookGunOnChar(char)
	if not char then return end
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Gun" then
			pcall(aimApplyStockShotBlock)
			if aimAutoShotEnabled then autoShotOnGunDetected() end
		end
	end)
end

autoShotGunDetectConn = player.Backpack.ChildAdded:Connect(function(child)
	if child.Name == "Gun" then
		pcall(aimApplyStockShotBlock)
		autoShotOnGunDetected()
	end
end)
hookGunOnChar(player.Character)
player.CharacterAdded:Connect(function(char)
	hookGunOnChar(char)
	-- New character = new round: forget the previous round's (dead) murderer.
	pcall(aimClearStickyMurdererOnRespawn)
	-- Spawned again: bring back anything the death screen watcher hid.
	pcall(deathScreenRestore)
	pcall(deathScreenHookChar, char)
end)

-- ============================================
-- Death black screen remover
-- Many MM2 maps put a full-screen black frame over PlayerGui when you die. It is
-- not ours, and while it is up the respawn feels like a black-screen freeze.
-- On death we scan PlayerGui for near-black full-screen frames and hide them
-- (never destroy), then restore them on the next spawn. Toggle: Settings.
-- ============================================
deathScreenRemoverEnabled = true
deathScreenHidden = {}
deathScreenWatching = false

function deathScreenIsBlackFrame(obj)
	if not obj or not obj:IsA("GuiObject") then return false end
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(0, 0)
	if vp.X <= 0 or vp.Y <= 0 then return false end
	local sz = obj.AbsoluteSize
	if sz.X < vp.X * 0.85 or sz.Y < vp.Y * 0.85 then return false end
	local c = obj.BackgroundColor3
	if c.R > 0.09 or c.G > 0.09 or c.B > 0.09 then return false end
	return (obj.BackgroundTransparency or 0) < 0.6
end

function deathScreenHiddenHas(obj)
	for _, o in ipairs(deathScreenHidden) do
		if o == obj then return true end
	end
	return false
end

function deathScreenClean()
	if not deathScreenRemoverEnabled then return end
	local roots = {}
	for _, g in ipairs(playerGui:GetChildren()) do
		if g:IsA("ScreenGui") and g.Enabled then
			if not (type(isAdrenalinSoundGui) == "function" and isAdrenalinSoundGui(g)) then
				-- Only visibly enabled, on-screen GUIs can be the death overlay.
				roots[#roots + 1] = g
			end
		end
	end
	for _, g in ipairs(roots) do
		-- pcall keeps one broken custom GUI from stopping the others
		pcall(function()
			local objects = { g }
			for _, d in ipairs(g:GetDescendants()) do
				if d:IsA("Frame") or d:IsA("ImageLabel") then
					objects[#objects + 1] = d
				end
			end
			for _, obj in ipairs(objects) do
				if obj.Visible and not deathScreenHiddenHas(obj) and deathScreenIsBlackFrame(obj) then
					obj.Visible = false
					deathScreenHidden[#deathScreenHidden + 1] = obj
				end
			end
		end)
	end
end

function deathScreenRestore()
	for _, obj in ipairs(deathScreenHidden) do
		pcall(function()
			if obj and obj.Parent then obj.Visible = true end
		end)
	end
	deathScreenHidden = {}
end

-- The overlay is usually created a frame or two AFTER the death, so keep
-- scanning for a few seconds instead of doing one single pass.
function deathScreenStartWatch()
	if deathScreenWatching then return end
	-- [VoteDupe lag fix] While the vote dupe is killing/respawning the character
	-- every few seconds the death overlay is irrelevant - and this watcher would
	-- scan EVERY enabled ScreenGui (all descendants) 4x per second for 8 s after
	-- EACH death. That per-death GUI scan was part of the stutter right after
	-- every vote, so it is skipped completely while the dupe is running.
	if voteDupeActive then return end
	deathScreenWatching = true
	task.spawn(function()
		-- 8 s covers games that fade in the overlay a couple of seconds after
		-- the humanoid dies (and re-show it once more after the ragdoll).
		local deadline = os.clock() + 8
		while os.clock() < deadline do
			if not deathScreenRemoverEnabled then break end
			pcall(deathScreenClean)
			task.wait(0.25)
		end
		deathScreenWatching = false
	end)
end

function deathScreenHookChar(char)
	deathScreenRestore()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	hum.Died:Connect(function()
		deathScreenStartWatch()
	end)
	hum.HealthChanged:Connect(function(h)
		if h <= 0 then deathScreenStartWatch() end
	end)
end

pcall(deathScreenHookChar, player.Character)

-- Auto Shoot Murderer follows the Gun Silent Aim mode selected in Combat:
--   Default          -> predicted shot, then holster
--   Intercept        -> predicted shot, keep the gun out
--   *Accurate        -> full holster -> dynamic study -> equip -> fire flow
-- The aim always equips the gun itself, so the player never has to.
function aimAutoShootDispatch(murderer, forcePiercer)
	if not aimTargetStillMurderer(murderer) then return false end
	local mode = (lmbShootAimMode and lmbShootAimMode()) or "Default"
	if mode == "Default Accurate" or mode == "Intercept Accurate" then
		if aimAccurateBusy then return false end
		local keep = (mode == "Intercept Accurate")
		task.spawn(function()
			local wasWallbang = aimWallbangEnabled
			if forcePiercer then aimWallbangEnabled = true end
			pcall(aimAccurateFire, murderer, keep)
			aimWallbangEnabled = wasWallbang
		end)
		-- The accurate shot is asynchronous but it IS going to happen; report
		-- success so the loop applies its cooldown instead of re-dispatching.
		return true
	end
	local wasWallbang = aimWallbangEnabled
	if forcePiercer then aimWallbangEnabled = true end
	local ok, fired = pcall(aimFireGunAtOriginal, murderer, AIM_CONFIG.autoShotBurst)
	aimWallbangEnabled = wasWallbang
	if ok and fired and mode == "Default" then
		-- Defer the holster: unequipping in the same frame as FireServer made
		-- the server reject the shot ("player has no Gun"). The shot itself is
		-- already sent, so this delay never adds shooting latency.
		local gunAtShot = player.Character and player.Character:FindFirstChild("Gun")
		task.delay(0.16, function()
			-- Only holster the same tool the shot was fired with, and only while
			-- it is still equipped (never touch a gun the player swapped to).
			local cur = player.Character and player.Character:FindFirstChild("Gun")
			if cur and gunAtShot and cur == gunAtShot then pcall(aimUnequipGun) end
		end)
	end
	return (ok and fired) and true or false
end

task.spawn(function()
	while true do
		RunService.Heartbeat:Wait()
		pcall(function()
			if (not aimAutoShotEnabled) or autoShotAimMode() ~= "Default" then aimHadGunLast = false; return end
			local char = player.Character
			local bp = player:FindFirstChild("Backpack")
			local hasGun = (char and (char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")))) and true or false
			if hasGun and not aimHadGunLast then
				-- Gun just appeared: fire INSTANTLY with zero added latency.
				-- No blocking role InvokeServer, no velocity-stability wait — go
				-- straight to the raw single-bullet shot so the trigger matches the
				-- frame the gun spawned. Role refresh is deferred async so the next
				-- (rate-limited) burst still benefits from fresh data.
				local m = aimFindMurderer()
				if m and m ~= player and aimMurdererAlive(m) then
					task.spawn(function()
						if not autoShotGunRoleRefreshing then
							autoShotGunRoleRefreshing = true
							pcall(aimRefreshRoleNow)
							autoShotGunRoleRefreshing = false
						end
					end)
				else
					-- No cached role yet: refresh in the BACKGROUND (never block
					-- the loop on an InvokeServer) — the next heartbeat retries
					-- instantly, so the shot still lands the moment the data and
					-- the Shoot remote are both ready.
					task.spawn(function()
						if not autoShotGunRoleRefreshing then
							autoShotGunRoleRefreshing = true
							pcall(aimRefreshRoleNow)
							autoShotGunRoleRefreshing = false
						end
					end)
				end
				if m and m ~= player and aimMurdererAlive(m) then
					local fired = aimAutoShootDispatch(m)
					if fired then aimLastAutoShotAt = os.clock() end
				end
			end
			aimHadGunLast = hasGun
			if not hasGun then return end
			local now = os.clock()
			-- Rate limit: skip this heartbeat entirely while on cooldown (also skips
			-- the murderer lookup, keeping the loop nearly free between bursts)
			if (now - aimLastAutoShotAt) < (AIM_CONFIG.autoShotCooldown or 0.35) then return end
			local murderer = aimFindMurderer()
			if not murderer and (now - aimLastRoleRefresh) > 0.08 then
				aimLastRoleRefresh = now
				task.spawn(function()
					if not autoShotGunRoleRefreshing then
						autoShotGunRoleRefreshing = true
						pcall(aimRefreshRoleNow)
						autoShotGunRoleRefreshing = false
					end
				end)
				murderer = aimFindMurderer()
			end
			if murderer and murderer ~= player and aimMurdererAlive(murderer) then
				-- Fire with zero added latency (no stable-velocity hold): the
				-- standalone Auto Shoot Murderer must respond instantly. Cooldown
				-- is set
				-- ONLY on a successful shot, so if the Shoot remote wasn't ready
				-- the instant the gun appeared, the next heartbeat retries
				-- immediately instead of waiting a full autoShotCooldown.
				local fired = aimAutoShootDispatch(murderer)
				if fired then aimLastAutoShotAt = now end
			end
		end)
	end
end)

-- AutoWall: same technique as Auto Shoot Murderer (predicted fire at the same
-- cooldown), but fires ONLY while the murderer is in line of sight — never
-- through walls. MAX SPEED: the hidden→visible edge bypasses the cooldown and
-- fires instantly, and a stale role cache is refreshed in the background.
aimAutoWallEnabled = false
-- NOTE: globals (not locals) on purpose: the chunk is at the local-registers limit.
aimLastAutoWallAt = 0
aimWallWasVisible = false
aimWallLastRoleRefresh = 0

task.spawn(function()
	while true do
		RunService.Heartbeat:Wait()
		pcall(function()
			if (not aimAutoShotEnabled) or autoShotAimMode() ~= "Wall Check" then aimWallWasVisible = false; return end
			local char = player.Character
			local bp = player:FindFirstChild("Backpack")
			local hasGun = char and (char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")))
			if not hasGun then aimWallWasVisible = false; return end
			local now = os.clock()
			local murderer = aimFindMurderer()
			if not murderer and (now - aimWallLastRoleRefresh) > 0.08 then
				aimWallLastRoleRefresh = now
				task.spawn(function()
					if not autoShotGunRoleRefreshing then
						autoShotGunRoleRefreshing = true
						pcall(aimRefreshRoleNow)
						autoShotGunRoleRefreshing = false
					end
				end)
				murderer = aimFindMurderer()
			end
			local visible = murderer and murderer ~= player and aimMurdererAlive(murderer) and aimHasLineOfSight(murderer)
			if not visible then aimWallWasVisible = false; return end
			-- Just peeked out: fire instantly, bypassing the cooldown.
			-- While staying visible, keep the normal rate limit.
			if not aimWallWasVisible then
				aimWallWasVisible = true
			elseif (now - aimLastAutoWallAt) < (AIM_CONFIG.autoShotCooldown or 0.35) then
				return
			end
			local fired = aimAutoShootDispatch(murderer)
			if fired then aimLastAutoWallAt = now end
		end)
	end
end)


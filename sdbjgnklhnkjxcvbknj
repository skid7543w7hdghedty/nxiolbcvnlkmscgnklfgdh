-- ============================================
-- Map Vote Dupe (3 buttons) + Vote Map — Utilities tab
-- ============================================

-- Fallback pad coordinates. The real touch surface is VotePadN.Pad, which MM2
-- rebuilds whenever the lobby reloads, so votePadCFrame() prefers that live
-- part and only falls back to these numbers.
voteMapCoords = {
	CFrame.new(26, 507, 49),   -- Map 1
	CFrame.new(14, 507, 52),   -- Map 2
	CFrame.new(1, 507, 49),    -- Map 3
}

voteDupeActive = false
voteDupeAutoStarted = false
voteDupeMode = "Multiple"
voteDupeCurrentMap = 0

-- ============================================
-- Vote Map — reads the three live vote pads
-- ============================================
-- Everything the game shows about a vote lives on the VotePadN models:
-- VoteInfoGui.Container.MapName ("MAP NAME" when the pads are empty),
-- .Votes ("Votes: 3") and MapInfoGui.GameMode. The VoteIcons parts are only
-- the floating icons (always Transparency 1) and their Map/Votes/Voting values
-- are never written, so they are not used here.
-- (The priority list, the Auto toggle and the small string helpers are declared
-- at the top of the file, because saveConfigNow() reads them.)

-- Rank of a map name in the priority list (1 = most wanted), or nil.
function voteMapPriorityRank(name)
	local key = voteMapKey(name)
	local want = key or voteMapNorm(name)
	if want == nil or want == "" then return nil end
	for i, p in ipairs(voteMapPriority) do
		local pk = voteMapKey(p)
		if pk == want or (not pk and voteMapNorm(p) == want) then return i end
	end
	-- Unknown map names still get a rank when they match exactly one entry.
	local n = voteMapNorm(name)
	local hit, hits = nil, 0
	for i, p in ipairs(voteMapPriority) do
		local pn = voteMapNorm(voteMapLabel(p))
		if #pn >= 4 and (n:find(pn, 1, true) or pn:find(n, 1, true)) then
			hit, hits = i, hits + 1
		end
	end
	if hits == 1 then return hit end
	return nil
end

-- The pads are NOT numbered in the order the game shows them: VotePad2 is the
-- middle one and the two sides are mirrored, so left-to-right the game lists
-- VotePad3, VotePad2, VotePad1. Everything the user sees (panel tiles, "Vote
-- Dupe Map 1-3", the status line) therefore works in SLOTS: slot 1 = leftmost
-- pad. The order is read from the live pad positions (highest X is leftmost, as
-- seen from the vote area) so a rebuilt/moved lobby still lines up and looking
-- away does not flip the row. While the pads are not streamed in, the known
-- order is used.
votePadSlotOrderCache = nil
votePadSlotOrderAt = 0
function votePadSlotOrder()
	local now = os.clock()
	if votePadSlotOrderCache and (now - votePadSlotOrderAt) < 1 then
		return votePadSlotOrderCache
	end
	local lobby = Workspace:FindFirstChild("RegularLobby")
	local items = {}
	if lobby then
		for i = 1, 3 do
			local model = lobby:FindFirstChild("VotePad" .. i)
			local part = model and (model:FindFirstChild("Pad") or model:FindFirstChildWhichIsA("BasePart", true))
			if part and part:IsA("BasePart") and part.Position then
				items[#items + 1] = {index = i, pos = part.Position}
			end
		end
	end
	local order
	if #items == 3 then
		-- The pads do not move, so the on-screen order is a property of the
		-- lobby, not of where the camera happens to look. Sorting by the live
		-- camera used to flip the whole row the moment the player turned around
		-- (WorldToViewportPoint fell behind the near plane and the fallback used
		-- ascending X), which is exactly how slots 1 and 3 ended up swapped in
		-- the panel and in the "Vote Started" toast. From the vote area the
		-- player faces the row with +X on their left, so slot order is X
		-- DESCENDING and it is the same in every camera direction.
		table.sort(items, function(a, b) return a.pos.X > b.pos.X end)
		order = {items[1].index, items[2].index, items[3].index}
	end
	if not order then order = {3, 2, 1} end
	votePadSlotOrderCache = order
	votePadSlotOrderAt = now
	return order
end

-- Slot (what the user sees, 1 = left) -> real VotePadN index.
function votePadForSlot(slot)
	return votePadSlotOrder()[slot] or slot
end

-- Real VotePadN index -> slot, so a running dupe can highlight its own button.
function votePadSlotOf(padIndex)
	local order = votePadSlotOrder()
	for slot, pad in ipairs(order) do
		if pad == padIndex then return slot end
	end
	return padIndex
end

-- Live vote pads: index (1-3 = VotePadN), slot (1-3 = on-screen order), map
-- name, vote count and game mode.
function voteMapSnapshot()
	local list = {}
	local lobby = Workspace:FindFirstChild("RegularLobby")
	if not lobby then return list end
	local order = votePadSlotOrder()
	local slotOf = {}
	for slot = 1, #order do slotOf[order[slot]] = slot end
	for i = 1, 3 do
		local model = lobby:FindFirstChild("VotePad" .. i)
		if model then
			local name, votes, mode = nil, 0, nil
			local vg = model:FindFirstChild("VoteInfoGui")
			local c = vg and vg:FindFirstChild("Container")
			local nl = c and c:FindFirstChild("MapName")
			local vl = c and c:FindFirstChild("Votes")
			if nl then name = nl.Text end
			if vl then votes = tonumber(tostring(vl.Text):match("(%d+)")) or 0 end
			local mg = model:FindFirstChild("MapInfoGui")
			local ml = mg and mg:FindFirstChild("GameMode")
			if ml and ml.Visible then mode = ml.Text end
			if name and name ~= "" and name ~= "MAP NAME" then
				list[#list + 1] = {index = i, slot = slotOf[i] or i, name = name, votes = votes, mode = mode}
			end
		end
	end
	return list
end

function voteMapSignature(snap)
	local parts = {}
	for _, m in ipairs(snap or {}) do parts[#parts + 1] = m.name end
	return table.concat(parts, "|")
end

-- Name of the map the round is running, taken from the pads themselves: MM2
-- adds the winning map as a Workspace Model with exactly that name. While a
-- round runs it is non-nil and the pads keep showing the vote that picked it;
-- it becomes nil when the round ends, and ~13 s later the pads switch to the
-- next three maps - that switch is the moment a new vote opens.
function voteMapRoundName(snap)
	if not snap or #snap == 0 then return nil end
	-- The pad label and the Workspace model do not always match character for
	-- character ("Mil Base" vs "MilBase", and the pad's "Hotel 2" loads the
	-- model "Hotel"), so resolve both sides to a registry key first.
	local byName, byKey = {}, {}
	for _, m in ipairs(snap) do
		byName[voteMapNorm(m.name)] = m.name
		local key = voteMapKey(m.name)
		if key then byKey[key] = m.name end
	end
	-- Use the same lookup as TP to Map: the map can be nested or carry a rig,
	-- and a plain Workspace child scan missed it, so voting stayed "closed"
	-- (or the round name stayed nil) on those maps.
	local model = loadedMapModel()
	if model then
		local direct = byName[voteMapNorm(model.Name)]
		if direct then return direct end
		local key = voteMapKey(model.Name)
		if key and byKey[key] then return byKey[key] end
	end
	return nil
end

-- True while the pads do not accept votes: a map is loaded or the pads are
-- empty (between rounds, before the next three maps are shown).
function voteMapClosed()
	local snap = voteMapSnapshot()
	if #snap == 0 then return true end
	return voteMapRoundName(snap) ~= nil
end

-- Highest-priority map that is actually up for vote, or nil.
function voteMapBest(snap)
	local best, bestRank = nil, nil
	for _, m in ipairs(snap or {}) do
		local rank = voteMapPriorityRank(m.name)
		if rank and (bestRank == nil or rank < bestRank) then
			best, bestRank = m, rank
		end
	end
	return best
end

-- The real touch surface: VotePadN.Pad. The numbers above are a fallback for
-- a lobby that is still streaming in.
function votePadCFrame(mapIndex)
	local lobby = Workspace:FindFirstChild("RegularLobby")
	local model = lobby and lobby:FindFirstChild("VotePad" .. tostring(mapIndex))
	local pad = model and model:FindFirstChild("Pad")
	if pad and pad:IsA("BasePart") then
		return CFrame.new(pad.Position + Vector3.new(0, 0.2, 0))
	end
	return voteMapCoords[mapIndex]
end

function voteResetSelf()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.Health = 0 end) end
	if char then pcall(function() char:BreakJoints() end) end
	-- [VoteDupe lag fix] Quiesce OUR body the instant it dies: transparent, no
	-- collisions and ANCHORED, so the physics solver has no broken-joint ragdoll
	-- to simulate between the death and the respawn. Together with the corpse
	-- cleanup in voteDupeStart (which removes the game's cloned "Raggy") this
	-- removes the stall that happened right after every vote death.
	pcall(function()
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CanCollide = false
				p.CanTouch = false
				p.Massless = true
				p.Anchored = true
				p.Transparency = 1
			end
		end
	end)
end

function voteDupeStart(mapIndex, autoStarted)
	if voteDupeActive then
		voteDupeActive = false
		task.wait(0.2)
	end
	voteDupeCurrentMap = mapIndex
	voteDupeAutoStarted = autoStarted and true or false
	voteDupeActive = true
	local voteCF = votePadCFrame(mapIndex)
	if not voteCF then return end
	-- Map this pad is showing right now: the panel's optimistic counter needs it
	-- so a bump can never land on the wrong map after the pads switch.
	local votePadName = nil
	for _, m in ipairs(voteMapSnapshot()) do
		if m.index == mapIndex then votePadName = m.name end
	end

	task.spawn(function()
		-- [VoteDupe speed] The old build stopped after a fixed 13 s, and that was
		-- exactly what capped a press at ~20 votes - the real map-vote window is
		-- longer. The dupe now runs for the WHOLE window and stops only when the
		-- game ends it: a new round is set up (roles assigned) or the character
		-- respawns on the map instead of in the lobby. 45 s is a safety net,
		-- not the working limit.
		local voteWindowStart = os.clock()
		local voteWindowMax = 45
		local voteCheckAt = 0
		local voteVotesDone = 0
		local voteOverReason = nil

		-- Never start killing when the pads do not accept votes (a round is
		-- running, or the pads are still empty between rounds). Checked twice
		-- because MM2 rebuilds the pads right after a round ends.
		if voteMapClosed() then
			task.wait(1.2)
			if not voteDupeActive then return end
			if voteMapClosed() then
				voteDupeActive = false
				voteDupeClearButtons()
				notify("Vote Dupe", "Map voting is closed - wait for the next vote.", 3)
				return
			end
		end
		-- Vote-pad parts do not move during a round, so cache the nearby parts
		-- once. Previously EVERY vote rescanned all Workspace descendants twice,
		-- which was most of the time between votes.
		local votePadParts = nil
		local function getVotePadParts()
			local cacheOK = votePadParts ~= nil and #votePadParts > 0
			if cacheOK then
				for _, p in ipairs(votePadParts) do
					if not p.Parent then cacheOK = false break end
				end
			end
			if cacheOK then return votePadParts end
			local parts = {}
			pcall(function()
				-- [perf] Spatial query instead of a full Workspace:GetDescendants()
				-- scan: MM2 has tens of thousands of parts and the old scan walked
				-- ALL of them. GetPartBoundsInRadius returns just the parts around
				-- the vote pad (the descendant scan stays only as a fallback).
				local ok = pcall(function()
					for _, d in ipairs(Workspace:GetPartBoundsInRadius(voteCF.Position, 8)) do
						-- Same 6-stud selection the old scan used, so the touched
						-- set is identical (radius 8 only widens the query bounds).
						if d:IsA("BasePart") and (d.Position - voteCF.Position).Magnitude <= 6 then
							table.insert(parts, d)
						end
					end
				end)
				if not ok or #parts == 0 then
					for _, d in ipairs(Workspace:GetDescendants()) do
						if d:IsA("BasePart") and (d.Position - voteCF.Position).Magnitude < 6 then
							table.insert(parts, d)
						end
					end
				end
			end)
			votePadParts = parts
			return parts
		end
		-- [perf] Character parts are cached per character instead of being rebuilt
		-- on every burst. Touching with EVERY body part (both directions) makes the
		-- vote register even when the pad's handler debounces a single part.
		local voteBodyParts, voteBodyPartsChar
		local function getVoteBodyParts(char, hrp)
			if voteBodyPartsChar ~= char then
				voteBodyPartsChar = char
				voteBodyParts = {hrp}
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") and p ~= hrp then
						voteBodyParts[#voteBodyParts + 1] = p
					end
				end
			end
			return voteBodyParts
		end
		-- full = every body part (first frame of a vote cycle, maximum reliability);
		-- light = root only. The pad debounces PER PAD PART, so the root already
		-- covers every pad part - hammering all ~15 body parts on every extra
		-- frame only added hundreds of touch calls per frame for no extra vote,
		-- which is what made the whole tool feel laggy while it was voting.
		local function voteTouchBurst(char, hrp, full)
			pcall(function()
				local pads = getVotePadParts()
				if not full then
					for _, d in ipairs(pads) do
						safeFireTouch(hrp, d)
						safeFireTouch(d, hrp)
					end
					return
				end
				local body = getVoteBodyParts(char, hrp)
				for _, d in ipairs(pads) do
					for _, p in ipairs(body) do
						safeFireTouch(p, d)
						safeFireTouch(d, p)
					end
				end
			end)
		end
		-- [VoteDupe lag fix] Every vote death leaves an MM2 "Raggy" corpse behind.
		-- A corpse is a FULLY SIMULATED ragdoll that stays in the map until the
		-- round ends, and the dupe creates one per vote, so after a couple of
		-- votes the client is simulating several ragdolls on top of the normal
		-- round - that is the stall that showed up right after every death and
		-- that slowly ate the vote speed. Remove the fresh corpse the moment MM2
		-- spawns it (only around the vote pad, i.e. our own body).
		local function voteKillCorpse(obj)
			if not obj or not obj.Parent then return end
			pcall(function()
				for _, p in ipairs(obj:GetDescendants()) do
					if p:IsA("BasePart") then
						p.CanCollide = false
						p.CanTouch = false
						p.CanQuery = false
						p.Anchored = true
						p.Transparency = 1
					end
				end
			end)
			pcall(function() obj:Destroy() end)
		end
		local voteCorpseConn = Workspace.DescendantAdded:Connect(function(obj)
			if not voteDupeActive then return end
			if obj.Name ~= "Raggy" then return end
			-- Never touch the live character model itself (only copies/corpses).
			if obj == player.Character then return end
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
			if not part then return end
			if (part.Position - voteCF.Position).Magnitude > 40 then return end
			task.spawn(voteKillCorpse, obj)
		end)
		-- Warm the pad-part cache BEFORE the first vote so the spatial query does
		-- not run in the middle of a vote cycle (it used to cost the first burst
		-- a frame right after the respawn).
		pcall(getVotePadParts)
		while voteDupeActive do
			-- Auto Vote can be switched off while it is mid-window; the dupe then
			-- stops immediately instead of finishing the whole vote.
			if voteDupeAutoStarted and not voteMapAutoEnabled then
				voteOverReason = "auto vote off"
				voteDupeActive = false
				break
			end
			-- More votes per press: at least 5 cycles even in a nearly empty
			-- server. The old "#players - 1" produced a SINGLE vote when playing
			-- with one friend, which looked like the dupe did nothing at all.
			local voteCount = math.max(5, #Players:GetPlayers() - 1)
			-- Original cadence (as in the reference build): one respawn per
			-- vote, a full body-part volley on the landing frame, three cheap
			-- root volleys over the next frames, then reset immediately. The
			-- respawn poll is the real time limiter, so no extra dwell is used.
			for voteCast = 1, voteCount do
				if not voteDupeActive then break end
				-- Auto Vote can be switched off while it is mid-window; the dupe
				-- then stops immediately instead of finishing the whole vote.
				if voteDupeAutoStarted and not voteMapAutoEnabled then
					voteOverReason = "auto vote off"
					voteDupeActive = false
					break
				end
				-- The 45 s cap is only a fallback; the real end of the window is
				-- detected below, so the dupe votes for the whole intermission.
				if (os.clock() - voteWindowStart) >= voteWindowMax then
					voteOverReason = "time cap"
					break
				end
				-- The pads stop accepting votes the moment the winning map is
				-- loaded into Workspace. Checked at most every 1.2 s: one vote
				-- cycle is about one second long.
				local now = os.clock()
				if now >= voteCheckAt then
					voteCheckAt = now + 1.2
					if voteMapClosed() then
						voteOverReason = "round started"
						break
					end
				end

				-- Wait for the respawned body (fast poll, clock-based cap).
				local char, hrp, hum
				local waitStart = os.clock()
				repeat
					RunService.Heartbeat:Wait()
					char = player.Character
					hrp = char and char:FindFirstChild("HumanoidRootPart")
					hum = char and char:FindFirstChildOfClass("Humanoid")
				until (hrp and hum and hum.Health > 0) or (os.clock() - waitStart) > 6 or not voteDupeActive

				if not voteDupeActive then break end
				if not (hrp and hum and hum.Health > 0) then break end
				-- Lobby pads sit around z = 35; every MM2 map is hundreds of
				-- studs away on z. Respawned out there = the map already loaded
				-- and voting is over.
				if math.abs(hrp.Position.Z - voteCF.Position.Z) > 400 then
					voteOverReason = "map loaded"
					break
				end

				-- Teleport onto the pad and touch it for a few frames. The first
				-- frame uses EVERY body part so the pickup cannot be missed; the
				-- follow-up frames only use the root, which still covers every pad
				-- part at a fraction of the cost.
				pcall(function() hrp.CFrame = voteCF end)
				voteTouchBurst(char, hrp, true)
				for _ = 1, 3 do
					voteTouchBurst(char, hrp, false)
					RunService.Heartbeat:Wait()
				end
				-- Counted on the panel right away (pending); the pad's own number
				-- replaces the optimistic value as soon as the server echoes it.
				voteVotesDone = voteVotesDone + 1
				pcall(voteMapNotifBump, mapIndex, votePadName)
				local voteSlot = votePadSlotOf(mapIndex)
				local voteBtn = voteDupeBtns and voteDupeBtns[voteSlot]
				if voteBtn and voteBtn.Parent then
					voteBtn.Text = "Vote Dupe Map " .. voteSlot .. ": ON [" .. voteVotesDone .. "]"
				end
				-- Reset as soon as the votes are in. The respawn poll on the next
				-- pass is the real limiter, so a fixed post-death wait is overhead.
				voteResetSelf()
			end

			-- Multiple: run one set of votes then stop; Infinite: keep looping
			-- until the voting window closes.
			if voteDupeMode == "Multiple" then
				voteDupeActive = false
			end
			if voteOverReason then
				voteDupeActive = false
			end
		end

		if voteCorpseConn then voteCorpseConn:Disconnect() end
		voteDupeAutoStarted = false
		voteDupeClearButtons()
		if voteOverReason == "auto vote off" then
			notify("Vote Dupe", "Stopped - Auto Vote Map was switched off.", 2)
		elseif voteVotesDone > 0 then
			notify("Vote Dupe", "Votes cast: " .. voteVotesDone .. ".", 3)
		else
			notify("Vote Dupe", "Finished vote duplication.", 2)
		end
	end)
end


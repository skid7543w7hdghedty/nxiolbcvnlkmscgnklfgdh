-- Invisibility (Invis.lua technique). Semi-transparent body (0.5) so you can
-- still be seen up close, plus a per-frame heartbeat that parks your REAL root
-- 200000 studs below the map while keeping the camera glued to you via a
-- CameraOffset trick. Other players see you far under the map = effectively
-- invisible while you keep full control of your character.
invisParts = {}

local function collectInvisParts(char)
	invisParts = {}
	if not char then return end
	for _, v in pairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v.Transparency == 0 then
			invisParts[#invisParts + 1] = v
		end
	end
end

function applyInvisibility()
	if invisHoldConnection then invisHoldConnection:Disconnect() invisHoldConnection = nil end
	if invisRespawnConn then invisRespawnConn:Disconnect() invisRespawnConn = nil end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hrp and hum) then return end
	collectInvisParts(char)
	for _, part in pairs(invisParts) do
		part.Transparency = part.Transparency == 0 and 0.5 or 0
	end
	invisRespawnConn = player.CharacterAdded:Connect(function(newChar)
		if not invis_on then return end
		collectInvisParts(newChar)
		for _, part in pairs(invisParts) do
			pcall(function() part.Transparency = 0.5 end)
		end
	end)
	invisHoldConnection = RunService.Heartbeat:Connect(function()
		if not invis_on then
			if invisHoldConnection then invisHoldConnection:Disconnect() invisHoldConnection = nil end
			return
		end
		local c = player.Character
		local root = c and c:FindFirstChild("HumanoidRootPart")
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if root and h and h.Health > 0 then
			local savedCF = root.CFrame
			local savedOffset = h.CameraOffset
			local movedCF = savedCF * CFrame.new(invisOffsetX, invisOffsetY, invisOffsetZ)
			root.CFrame = movedCF
			h.CameraOffset = movedCF:ToObjectSpace(CFrame.new(savedCF.Position)).Position
			RunService.RenderStepped:Wait()
			if root.Parent then root.CFrame = savedCF end
			h.CameraOffset = savedOffset
		end
	end)
	return true
end

function removeInvisibility()
	if invisHoldConnection then invisHoldConnection:Disconnect() invisHoldConnection = nil end
	if invisRespawnConn then invisRespawnConn:Disconnect() invisRespawnConn = nil end
	invisRealCF = nil
	for _, part in pairs(invisParts) do
		pcall(function() part.Transparency = 0 end)
	end
	invisParts = {}
	-- Legacy cleanup: remove any leftover seat from the old invisibility method.
	local chair = workspace:FindFirstChild("invischair")
	if chair then chair:Destroy() end
end


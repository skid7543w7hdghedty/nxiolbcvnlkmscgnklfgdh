	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
	end)

	local function addInfoLine(text)
		local line = Instance.new("TextLabel")
		line.Size = UDim2.new(1, 0, 0, 20)
		line.BackgroundTransparency = 1
		line.Text = text
		line.TextColor3 = Color3.fromRGB(255, 255, 255)
		line.Font = Enum.Font.Gotham
		line.TextSize = 13
		line.TextXAlignment = Enum.TextXAlignment.Left
		line.Parent = scroll
		return line
	end

	addInfoLine("Display Name: " .. plr.DisplayName)
	addInfoLine("Username: " .. plr.Name)
	addInfoLine("User ID: " .. plr.UserId)

	local years = math.floor(plr.AccountAge / 365)
	local remaining = plr.AccountAge % 365
	local months = math.floor(remaining / 30)
	local days = remaining % 30
	local ageText = plr.AccountAge .. " days"
	if years > 0 or months > 0 or days > 0 then
		ageText = ageText .. " (" .. years .. "y, " .. months .. "m, " .. days .. "d)"
	end
	addInfoLine("Account Age: " .. ageText)

	local function calcRegDate(accountAge)
		local now = os.time()
		local utc = os.date("!*t", now)
		local d = utc.day - math.max(accountAge - 1, 0)
		local m = utc.month
		local y = utc.year
		local dim = {31,28,31,30,31,30,31,31,30,31,30,31}
		while d < 1 do
			m = m - 1
			if m < 1 then m = 12; y = y - 1 end
			local dm = dim[m]
			if m == 2 and (y%4==0 and (y%100~=0 or y%400==0)) then dm = 29 end
			d = d + dm
		end
		return string.format("%02d/%02d/%04d", d, m, y)
	end

	local function fetchRegDate(userId, accountAge)
		local created = nil
		local exactUnix = nil
		local ok, result = pcall(function()
			return (syn or _G).request({
				Url = "https://users.roblox.com/v1/users/" .. userId,
				Method = "GET"
			})
		end)
		if not (ok and result and result.StatusCode == 200) then
			ok, result = pcall(function()
				return game:HttpGetAsync("https://users.roblox.com/v1/users/" .. userId)
			end)
		end
		if ok and result then
			local rawCreated = nil
			if type(result) == "string" then
				local data = game:GetService("HttpService"):JSONDecode(result)
				if data and data.created then
					rawCreated = data.created
					local y, m, d = data.created:match("(%d+)-(%d+)-(%d+)")
					if y and m and d then created = string.format("%02d/%02d/%04d", tonumber(d), tonumber(m), tonumber(y)) end
				end
			elseif result.StatusCode == 200 and result.Body then
				local data = game:GetService("HttpService"):JSONDecode(result.Body)
				if data and data.created then
					rawCreated = data.created
					local y, m, d = data.created:match("(%d+)-(%d+)-(%d+)")
					if y and m and d then created = string.format("%02d/%02d/%04d", tonumber(d), tonumber(m), tonumber(y)) end
				end
			end
			if rawCreated then
				exactUnix = isoToUnix(rawCreated)
			end
		end
		return (created or calcRegDate(accountAge)), exactUnix
	end

	local regDateStr, exactRegUnix = fetchRegDate(plr.UserId, plr.AccountAge)
	if not popupAlive then return end
	addInfoLine("Registered: " .. regDateStr)

	local exactAgeLine = addInfoLine("Current Age: N/A")
	local healthLine = addInfoLine("Health: N/A")
	local speedLine = addInfoLine("Walk Speed: N/A")
	local jumpLine = addInfoLine("Jump Power: N/A")
	local positionLine = addInfoLine("Position: N/A")


	local function disconnectConns()
		for _, c in ipairs(popupConns) do c:Disconnect() end
		popupConns = {}
	end

	local function attachCharStats(char)
		disconnectConns()
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end
		local function updateJP()
			if jumpLine and jumpLine.Parent then
				jumpLine.Text = "Jump Power: " .. hum.JumpPower
			end
		end
		updateJP()
		table.insert(popupConns, hum:GetPropertyChangedSignal("JumpPower"):Connect(updateJP))
	end

	attachCharStats(plr.Character)
	table.insert(popupConns, plr.CharacterAdded:Connect(function(newChar)
		task.wait(1)
		if popupAlive then attachCharStats(newChar) end
	end))

	local creationTime = exactRegUnix or (os.time() - plr.AccountAge * 86400)

	task.spawn(function()
		while popupAlive do
			task.wait(0.15)
			local char = plr.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local root = char:FindFirstChild("HumanoidRootPart")
				if hum and root then
					if healthLine and healthLine.Parent then
						healthLine.Text = "Health: " .. math.floor(hum.Health) .. "/" .. hum.MaxHealth
					end
					local vel = root.AssemblyLinearVelocity
					local horizSpeed = math.floor(math.sqrt(vel.X*vel.X + vel.Z*vel.Z) + 0.5)
					if speedLine and speedLine.Parent then
						speedLine.Text = "Walk Speed: " .. horizSpeed
					end
					if positionLine and positionLine.Parent then
						local p = root.Position
						positionLine.Text = string.format("Position: %.1f, %.1f, %.1f", p.X, p.Y, p.Z)
					end
				end
			end
			if exactAgeLine and exactAgeLine.Parent then
				local diff = os.time() - creationTime
				local totalDays = math.floor(diff / 86400)
				local y = math.floor(totalDays / 365)
				local rd = totalDays % 365
				local m = math.floor(rd / 30)
				local d = rd % 30
				local h = math.floor((diff % 86400) / 3600)
				local mn = math.floor((diff % 3600) / 60)
				local s = diff % 60
				exactAgeLine.Text = string.format("Current Age: %dy, %dm, %dd, %dh, %dm, %ds", y, m, d, h, mn, s)
			end
		end
	end)

	addInfoLine("Gravity: " .. math.floor(workspace.Gravity))


	-- Draggable popup
	local popupDragging = false
	local popupDragInput
	local popupDragStart
	local popupStartPos

	popupTitle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			popupDragging = true
			popupDragStart = input.Position
			popupStartPos = popup.Position
			table.insert(popupConns, input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					popupDragging = false
				end
			end))
		end
	end)

	popupTitle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			popupDragInput = input
		end
	end)

	popupDragCon = UserInputService.InputChanged:Connect(function(input)
		if input == popupDragInput and popupDragging then
			local delta = input.Position - popupDragStart
			popup.Position = UDim2.new(popupStartPos.X.Scale, popupStartPos.X.Offset + delta.X, popupStartPos.Y.Scale, popupStartPos.Y.Offset + delta.Y)
		end
	end)


	escConn = UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape then
			exploiterPopupCache[plr.Name] = nil
			popupGui:Destroy()
		end
	end)

	exploiterPopupCache[plr.Name] = popupGui
end


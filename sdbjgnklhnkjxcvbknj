flingSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local searchText = string.lower(flingSearchBox.Text)
	local matches = {}
	local nonMatches = {}
	for _, data in pairs(playerCheckboxes) do
		if data.Entry and data.NameLabel then
			local playerName = data.NameLabel.Text
			local match = searchText == "" or string.find(string.lower(playerName), searchText, 1, true) ~= nil
			data.Entry.Visible = match
			if match then
				table.insert(matches, data)
			else
				table.insert(nonMatches, data)
			end
		end
	end
	-- Reposition: matches at top, non-matches below
	local yPos = 0
	for _, data in ipairs(matches) do
		data.Entry.Position = UDim2.new(0, 0, 0, yPos)
		yPos = yPos + 65
	end
	for _, data in ipairs(nonMatches) do
		data.Entry.Position = UDim2.new(0, 0, 0, yPos)
		yPos = yPos + 65
	end
	playerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPos)
	playerScrollFrame.CanvasPosition = Vector2.new(0, 0)
end)


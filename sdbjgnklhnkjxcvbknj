	end
end)

-- Fake Bomb Jump: the FakeBomb tool fires Remote:FireServer(mouse.Hit, 50) on
-- LMB while equipped (long client cooldown). We replicate that shape with the
-- CFrame strictly under our feet, then jump instantly (pro double-jump).
-- No fixed waits when already held: equip only polls until the tool lands.
-- Cooldown mirror: stock gates re-throws with local `check` + wait(22), which
-- also fades the Handle and drives the Bomb Ready timer. Our direct fire
-- bypasses it, so without a mirror the bomb looks ready while the server
-- still cools down and the re-throw fizzles.
FAKE_BOMB_COOLDOWN = 22
fakeBombNextReadyAt = 0
fakeBombPendingAt = 0
fakeBombBusy = false

-- Best-effort: flip the stock `check` upvalue so its visuals/timer run too.
-- Fingerprints the Button1Down closure by (firerate==22, power==50).
function fakeBombSyncStock()
	task.spawn(function()
		pcall(function()
			if type(getconnections) ~= "function" then return end
			local m = player:GetMouse()
			if not m then return end
			for _, conn in ipairs(getconnections(m.Button1Down)) do
				local fn = conn.Function
				if type(fn) == "function" and type(getupvalue) == "function" then
					local hasPower, hasRate, checkIdx, checkVal = false, false, nil, nil
					local i = 1
					while i <= 64 do
						local n, v = getupvalue(fn, i)
						if n == nil then break end
						if n == "power" and v == 50 then hasPower = true end
						if n == "firerate" and v == 22 then hasRate = true end
						if n == "check" and type(v) == "boolean" then checkIdx, checkVal = i, v end
						i += 1
					end
					if hasPower and hasRate and checkIdx ~= nil and checkVal == true and type(setupvalue) == "function" then
						setupvalue(fn, checkIdx, false)
						task.delay(FAKE_BOMB_COOLDOWN, function()
							pcall(setupvalue, fn, checkIdx, true)
						end)
					end
				end
			end
		end)
	end)
end

function doFakeBombJump()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum) then return end
	-- Cooldown gate: our own stamp (synchronous, closes double-press races)
	-- plus the shared Bomb Timer observer (also catches manual stock throws).
	-- NOTE: never gate on Handle.Transparency — stock never restores it after
	-- its own wait, so that check would block forever.
	local rem = 0
	pcall(function() rem = bombTimerRemaining() end)
	local now = os.clock()
	local waitLeft = math.max(fakeBombNextReadyAt - now, rem)
	if waitLeft > 0.5 then
		notify("Fake Bomb Jump", "Recharging " .. math.ceil(waitLeft) .. "s.", 1.5)
		return
	end
	if waitLeft > 0.5 then
		notify("Fake Bomb Jump", "Recharging " .. math.ceil(waitLeft) .. "s.", 1.5)
		return
	end
	if fakeBombBusy then return end
	fakeBombBusy = true
	local justEquipped = false
	local bomb = char:FindFirstChild("FakeBomb")
	if not bomb then
		local bp = player:FindFirstChild("Backpack")
		local bb = bp and bp:FindFirstChild("FakeBomb")
		if not bb then
			notify("Fake Bomb Jump", "No FakeBomb in inventory.", 2)
			fakeBombBusy = false
			return
		end
		pcall(function() hum:EquipTool(bb) end)
		local t0 = os.clock()
		while not char:FindFirstChild("FakeBomb") and os.clock() - t0 < 0.5 do
			task.wait()
		end
		bomb = char:FindFirstChild("FakeBomb")
		if not bomb then
			notify("Fake Bomb Jump", "Equip failed.", 2)
			fakeBombBusy = false
			return
		end
		justEquipped = true
	end
	local remote = bomb:FindFirstChild("Remote")
	if not remote then
		notify("Fake Bomb Jump", "No Remote in FakeBomb.", 2)
		fakeBombBusy = false
		return
	end
	-- Sequenced by mode. Full modes: jump first, visible hold while rising,
	-- throw, short pause, jump again. Pro modes stash right after the throw.
	-- Default stays instant (mid-air timing); Pro holds the fresh take a beat
	-- so taking the bomb is actually visible.
	local bjMode = (fakeBombJumpModes and fakeBombJumpModes[fakeBombJumpModeIndex]) or "Default"
	local bjFull = bjMode == "Full Jump" or bjMode == "Pro Full"
	local bjPro = bjMode == "Pro Mode" or bjMode == "Pro Full"
	local function bjFireNow()
		local chF = player.Character
		local hrpF = chF and chF:FindFirstChild("HumanoidRootPart")
		local bombF = chF and chF:FindFirstChild("FakeBomb")
		local remF = bombF and bombF:FindFirstChild("Remote")
		if not (hrpF and remF) then return false end
		local okFire = false
		pcall(function()
			remF:FireServer(CFrame.new(hrpF.Position + Vector3.new(0, -2.5, 0)), 50)
			okFire = true
		end)
		if okFire then
			fakeBombPendingAt = os.clock()
			fakeBombNextReadyAt = os.clock() + FAKE_BOMB_COOLDOWN
			pcall(bombTimerReset)
			local handleF = bombF:FindFirstChild("Handle")
			pcall(function() if handleF then handleF.Transparency = 1 end end)
			task.delay(FAKE_BOMB_COOLDOWN, function()
				pcall(function() if handleF and handleF.Parent then handleF.Transparency = 0 end end)
			end)
			pcall(fakeBombSyncStock)
		end
		return okFire
	end
	local function bjJumpNow()
		local chJ = player.Character
		local humJ = chJ and chJ:FindFirstChildOfClass("Humanoid")
		if humJ then
			pcall(function() humJ:ChangeState(Enum.HumanoidStateType.Jumping) end)
			pcall(function() humJ.Jump = true end)
		end
	end
	local function bjStashNow()
		if not bjPro then return end
		pcall(function()
			local chU = player.Character
			local humU = chU and chU:FindFirstChildOfClass("Humanoid")
			if humU then humU:UnequipTools() end
		end)
	end
	if bjFull then
		bjJumpNow()
		task.wait(0.15)
		if not bjFireNow() then fakeBombBusy = false; return end
		bjStashNow()
		task.wait(0.2)
		bjJumpNow()
	else
		if bjPro and justEquipped then task.wait(0.15) end
		if not bjFireNow() then fakeBombBusy = false; return end
		bjStashNow()
		bjJumpNow()
	end
	fakeBombBusy = false
end


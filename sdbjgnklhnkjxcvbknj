-- Saved extracted-button positions are USER DATA: they must never be rewritten
-- just because the viewport changed. The old "clamp every popup on resize" pass
-- used only the Offset component, clamped EVERY out-of-bounds pill to the same
-- corner and then saved that - so after a rejoin (or a death + auto-rejoin) all
-- extracted buttons appeared stacked in one place. Positions are now repaired
-- only at restore time, and only when they are genuinely unusable: off-screen
-- or shared by more than one button.
function extractedSanitizePositions()
	local cam = workspace.CurrentCamera
	if not (cam and popupBtnGui) then return end
	local vs = cam.ViewportSize
	if not vs or vs.X <= 0 or vs.Y <= 0 then return end
	local insetY = 0
	pcall(function() insetY = game:GetService("GuiService"):GetGuiInset().Y end)
	local used = {}
	local function keyFor(x, y)
		return math.floor(x / 4 + 0.5) .. ":" .. math.floor(y / 4 + 0.5)
	end
	local function sizeOf(f)
		local w, h = nil, nil
		pcall(function() local s = f.AbsoluteSize; w, h = s.X, s.Y end)
		if not w or w <= 0 then w = f.Size.X.Offset end
		if not h or h <= 0 then h = f.Size.Y.Offset end
		if not w or w <= 0 then w = 120 end
		if not h or h <= 0 then h = 40 end
		return w, h
	end
	local function defaultSpot(w, h)
		local stepX = math.max(40, w + 4)
		local stepY = math.max(24, h + 2)
		local cols = math.max(1, math.floor((vs.X - 20) / stepX))
		for row = 0, 80 do
			for col = 0, cols - 1 do
				local x = 10 + col * stepX
				local y = insetY + 10 + row * stepY
				if y + h > vs.Y then break end
				local k = keyFor(x, y)
				if not used[k] then
					used[k] = true
					return UDim2.new(0, x, 0, y)
				end
			end
		end
		return UDim2.new(0, 10, 0, insetY + 10)
	end
	-- Pass 1: keep the first occurrence of each on-screen position.
	local pending = {}
	for _, data in pairs(extractedButtons) do
		local f = data and (data.frame or data.btn)
		if f ~= nil and typeof(f) == "Instance" and f:IsA("GuiObject") and f.Parent ~= nil then
			local pos = f.Position
			local w, h = sizeOf(f)
			local x = pos.X.Scale * vs.X + pos.X.Offset
			local y = pos.Y.Scale * vs.Y + pos.Y.Offset
			local onScreen = x >= -1 and y >= -1 and (x + w) <= (vs.X + 1) and (y + h) <= (vs.Y + 1)
			local k = keyFor(x, y)
			if onScreen and not used[k] then
				used[k] = true
			else
				pending[#pending + 1] = f
			end
		end
	end
	-- Pass 2: give every duplicate / off-screen pill a free grid slot.
	for _, f in ipairs(pending) do
		local w, h = sizeOf(f)
		pcall(function() f.Position = defaultSpot(w, h) end)
	end
end

-- Viewport guard (F11 fullscreen <-> windowed): the executor Drawing overlay
-- and the ESP skeleton transform go stale on resize, so rebuild the skeleton.
-- Button positions are deliberately NOT touched here - see the sanitizer above.
task.spawn(function()
	local lastVp = nil
	while true do
		task.wait(0.5)
		pcall(function()
			local cam = workspace.CurrentCamera
			if not cam then return end
			local vs = cam.ViewportSize
			if lastVp ~= nil and (vs.X ~= lastVp.X or vs.Y ~= lastVp.Y) then
				if espSkelDrawings ~= nil then
					local keys = {}
					for plr, _ in pairs(espSkelDrawings) do keys[#keys + 1] = plr end
					for _, plr in ipairs(keys) do pcall(espSkeletonClearPlayer, plr) end
				end
			end
			lastVp = vs
		end)
	end
end)
end


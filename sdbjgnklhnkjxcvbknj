-- Re-apply saved avatar instantly after each respawn (zero delay).
-- First removes all accessories/clothing, then applies the saved avatar.
-- NOTE: Headless / Korblox are NOT called here — they have their own
-- CharacterAdded connections via enableHeadless / enableKorblox / enableHeadlessAllHats.
-- [changerfix] wait until the respawned appearance has streamed in. Stripping
-- right after Humanoid existed was WHY natives randomly survived across deaths:
-- accessories arrive later, so an early single pass always missed the late ones.
function changerWaitAppearance(char)
    char:WaitForChild("Humanoid", 5)
    char:WaitForChild("Head", 5)
    local lastN, stable = -1, 0
    for _ = 1, 50 do
        if (not char.Parent) or (player.Character ~= char) then return false end
        local n = 0
        for _, d in ipairs(char:GetChildren()) do
            if d:IsA("Accessory") or d:IsA("Hat") then n = n + 1 end
        end
        if n == lastN then stable = stable + 1 else stable = 0; lastN = n end
        if (stable >= 3 and n > 0) or (stable >= 10) then break end
        task.wait(0.1)
    end
    return (player.Character == char) and (char.Parent ~= nil)
end

function changerAutoApplyNow(char)
    if not changerAutoApply then return end
    if not changerWaitAppearance(char) then return end
    -- Reset saved original so it captures this new character's fresh state
    changerOriginalState = nil
    -- Strip native accessories FIRST
    changerUnchange()
    changerRemoveAllAccessories()
    pcall(function()
        -- Priority: 1) last applied avatar name, 2) selected picker, 3) current fields
        local nm = changerLastAvatarName
        if nm and savedAvatars[nm] then
            changerApplyData(savedAvatars[nm])
        else
            nm = changerAvatarPickerState and changerAvatarPickerState.selectedName
            if nm and savedAvatars[nm] then
                changerApplyData(savedAvatars[nm])
            elseif changerLastAvatarFields and next(changerLastAvatarFields) then
                changerApplyData(changerLastAvatarFields)
            else
                local data = {}
                for key, box in pairs(changerSlotInputs) do
                    local ids = changerExtractIds(box.Text)
                    if #ids > 0 then data[key] = table.concat(ids, ",") end
                end
                if next(data) ~= nil then changerApplyData(data) end
            end
        end
    end)
    -- [headlessfix] Headless AFTER the avatar lands: its removal pass otherwise
    -- runs before our hats finish loading (GetObjects yields) and they slip
    -- through until the next death.
    if headlessEnabled then task.spawn(applyHeadless, char) end
    if headlessAllHatsEnabled then task.spawn(applyHeadlessAllHats, char) end
    -- Verification passes: catch natives that streamed in even later.
    -- Tagged avatar items are skipped, so the avatar itself is never harmed.
    for _ = 1, 2 do
        task.wait(0.8)
        if (player.Character ~= char) or (not char.Parent) then return end
        changerRemoveAllAccessories(true)
    end
end

player.CharacterAdded:Connect(function(char)
    if not changerAutoApply then return end
    task.spawn(changerAutoApplyNow, char)
end)


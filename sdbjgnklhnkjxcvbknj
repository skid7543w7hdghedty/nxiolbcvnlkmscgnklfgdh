tabIconInputs = {}
tabIconActiveInputs = {}
tabIconRows = {}
local function makeTabIconRow(tabName, isActive, order)
	local suffix = isActive and " (ON)" or " (OFF)"
	local rowKey = tabName .. (isActive and "_ON" or "_OFF")
	local row = Instance.new("Frame")
	row.Name = "TabIconRow_" .. rowKey
	row.Size = UDim2.new(1, 0, 0, 42)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = categoryFrames["Settings"]
	tabIconRows[rowKey] = row

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -176, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "Icon: " .. tabDisplayName(tabName) .. suffix
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 15
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local paths = isActive and tabIconActivePaths or tabIconPaths
	local input = Instance.new("TextBox")
	input.Name = "TabIconInput_" .. rowKey
	input.Size = UDim2.new(0, 90, 1, 0)
	input.Position = UDim2.new(1, -172, 0, 0)
	input.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	input.TextColor3 = Color3.fromRGB(255, 255, 255)
	input.Text = (paths and paths[tabName]) or ""
	input.PlaceholderText = "URL or filename"
	input.Font = Enum.Font.SourceSansBold
	input.TextSize = 12
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.ClipsDescendants = true
	input.ClearTextOnFocus = false
	input.Parent = row
	Instance.new("UICorner", input).CornerRadius = UDim.new(0, 6)
	if isActive then tabIconActiveInputs[tabName] = input else tabIconInputs[tabName] = input end

	local function applyPath(newPath)
		if isActive then
			if not tabIconActivePaths then tabIconActivePaths = {} end
			tabIconActivePaths[tabName] = newPath
		else
			if not tabIconPaths then tabIconPaths = {} end
			tabIconPaths[tabName] = newPath
		end
		tabIconFilesCache[tabName] = findTabIconFiles(tabName)
		input.Text = newPath
		refreshTabIcons()
		saveConfig()
	end
	input.FocusLost:Connect(function()
		applyPath(input.Text)
	end)

	local prev = Instance.new("TextButton")
	prev.Size = UDim2.new(0, 16, 0, 20)
	prev.Position = UDim2.new(1, -78, 0.5, -10)
	prev.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	prev.TextColor3 = Color3.fromRGB(255, 255, 255)
	prev.Text = "<"
	prev.Font = Enum.Font.SourceSansBold
	prev.TextSize = 14
	prev.BorderSizePixel = 1
	prev.BorderColor3 = Color3.fromRGB(80, 80, 80)
	prev.Parent = row
	Instance.new("UICorner", prev).CornerRadius = UDim.new(0, 2)
	prev.MouseButton1Click:Connect(function()
		local files, pos
		if isActive then files, pos = findTabIconActiveIndex(tabName)
		else files, pos = findTabIconIndex(tabName) end
		if #files == 0 then return end
		pos = pos - 1
		if pos < 1 then pos = #files end
		applyPath(files[pos])
	end)

	local nxt = Instance.new("TextButton")
	nxt.Size = UDim2.new(0, 16, 0, 20)
	nxt.Position = UDim2.new(1, -58, 0.5, -10)
	nxt.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	nxt.TextColor3 = Color3.fromRGB(255, 255, 255)
	nxt.Text = ">"
	nxt.Font = Enum.Font.SourceSansBold
	nxt.TextSize = 14
	nxt.BorderSizePixel = 1
	nxt.BorderColor3 = Color3.fromRGB(80, 80, 80)
	nxt.Parent = row
	Instance.new("UICorner", nxt).CornerRadius = UDim.new(0, 2)
	nxt.MouseButton1Click:Connect(function()
		local files, pos
		if isActive then files, pos = findTabIconActiveIndex(tabName)
		else files, pos = findTabIconIndex(tabName) end
		if #files == 0 then return end
		pos = pos + 1
		if pos > #files then pos = 1 end
		applyPath(files[pos])
	end)

	local scan = Instance.new("TextButton")

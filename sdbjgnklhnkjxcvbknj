-- Headless (All Hats) (toggleable) — like Headless, but also deletes the
-- accessories worn on the HEAD (hats, face, glasses) so nothing floats above
-- the neck. Back/waist/shoulder extras are KEPT — only head-tied items go.
headlessAllHatsEnabled = false
headlessAllHatsConn = nil
headlessAllHatsChildConn = nil
headlessAllHatsPassGen = 0
headlessAllHatsOriginals = setmetatable({}, {__mode = "k"})
headlessRemovedHats = setmetatable({}, {__mode = "k"})

-- Single-item test shared by the instant pass, the delayed passes and the
-- live ChildAdded hook: true only for accessories tied to the Head.
-- Back/chest gear welds to Torso/arms, so it stays.
local function headlessHatIsOnHead(child, head)
	if not (child:IsA("Accessory") or child:IsA("Hat")) then return false end
	if not head then return false end
	for _, desc in ipairs(child:GetDescendants()) do
		-- Wear point = the Motor6D in the accessory that welds to the Head.
		if desc:IsA("Motor6D") and desc.Part0 == head then return true end
		-- [headlessfix] Changer welds avatar hats with a Weld named
		-- ChangerAccessoryWeld (never a Motor6D), so without this check
		-- every Changer head item survived the All-Hats pass
		if desc:IsA("Weld") and desc.Name == "ChangerAccessoryWeld" and desc.Part0 == head then return true end
	end
	-- Fallback: if no weld is found, use position height (head items sit
	-- at/above the head; chest/back items sit below the head's centre).
	local handle = child:FindFirstChild("Handle")
	if handle and handle.Position.Y >= head.Position.Y - 0.75 then return true end
	return false
end

-- Capture / restore helpers for All-Hats: the Head override is saved like the
-- plain Headless toggle, and every head accessory we delete is cloned so the
-- toggle can put the hats back without respawning.
function captureHeadlessAllHatsOriginals(char)
	if not char then return nil end
	local cached = headlessAllHatsOriginals[char]
	if cached then return cached end
	-- Plain Headless may already have snapshotted the real Head appearance.
	local shared = headlessOriginals and headlessOriginals[char]
	if shared then
		local copy = {MeshId = shared.MeshId, TextureID = shared.TextureID, Transparency = shared.Transparency}
		headlessAllHatsOriginals[char] = copy
		return copy
	end
	local head = char:FindFirstChild("Head")
	if not head then return nil end
	-- R6 heads are plain Parts; guarded reads (see captureHeadlessOriginals).
	local mesh, tex
	pcall(function() mesh = head.MeshId end)
	pcall(function() tex = head.TextureID end)
	local originals = {
		MeshId = mesh,
		TextureID = tex,
		Transparency = head.Transparency
	}
	headlessAllHatsOriginals[char] = originals
	return originals
end

function restoreHeadlessAllHats(char, skipHead)
	if not char then return end
	local originals = headlessAllHatsOriginals[char] or (headlessOriginals and headlessOriginals[char])
	headlessAllHatsOriginals[char] = nil
	local function apply()
		local head = char:FindFirstChild("Head")
		if not head then return false end
		headlessRestoreHeadPart(head, originals)
		return true
	end
	if not skipHead then
		if not apply() then
			task.spawn(function()
				for _ = 1, 20 do
					RunService.Heartbeat:Wait()
					if not char.Parent then return end
					if apply() then return end
				end
			end)
		end
		-- Same delayed re-assert as plain Headless: spawn/Changer passes can
		-- hide the Head again right after it is restored.
		task.delay(0.4, function()
			if headlessEnabled or headlessAllHatsEnabled then return end
			if player.Character ~= char then return end
			apply()
		end)
	end
	-- Re-add the hats that were destroyed while the toggle was on.
	local saved = headlessRemovedHats[char]
	headlessRemovedHats[char] = nil
	local head = char:FindFirstChild("Head")
	if head and saved then
		for _, item in ipairs(saved) do
			if item and item.Parent == nil then
				local handle = item:FindFirstChild("Handle")
				if handle then
					for _, desc in ipairs(item:GetDescendants()) do
						if desc:IsA("JointInstance") then
							pcall(function()
								desc.Part0 = head
								desc.Part1 = handle
							end)
						end
					end
					pcall(function() item.Parent = char end)
				end
			end
		end
	end
end

function removeHeadHatItem(char, child)
	if not (char and child and child.Parent == char) then return end
	-- Keep a clone so disabling the feature restores the original look.
	local clone = nil
	pcall(function() clone = child:Clone() end)
	if clone then
		headlessRemovedHats[char] = headlessRemovedHats[char] or {}
		table.insert(headlessRemovedHats[char], clone)
	end
	pcall(function() child:Destroy() end)
end

local function removeHeadHats(char) -- destroy only accessories tied to the Head
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end
	for _, child in ipairs(char:GetChildren()) do
		if headlessHatIsOnHead(child, head) then
			removeHeadHatItem(char, child)
		end
	end
end

function applyHeadlessAllHats(char)
	if not char then return end
	-- [headlessfix] same retry as applyHeadless (see above)
	for _ = 1, 4 do
		local head = char:FindFirstChild("Head")
		if head then
			headlessWaitForHeadMesh(head, 1.0)
			captureHeadlessAllHatsOriginals(char)
			pcall(function() head.Transparency = 1 end)
			pcall(function()
				head.MeshId = "http://www.roblox.com/asset/?id=6686307858"
				head.TextureID = "http://www.roblox.com/asset/?id=6686307858"
			end)
			break
		end
		char:WaitForChild("Head", 2)
	end
	removeHeadHats(char)
	-- Delayed re-passes: hats that streamed in AFTER the first pass (the reason
	-- respawns only removed "part" of the hats) get caught here.
	headlessAllHatsPassGen = headlessAllHatsPassGen + 1
	local gen = headlessAllHatsPassGen
	task.spawn(function()
		for _ = 1, 3 do
			task.wait(0.7)
			if not headlessAllHatsEnabled then return end
			if gen ~= headlessAllHatsPassGen then return end
			if (player.Character ~= char) or (not char.Parent) then return end
			removeHeadHats(char)
		end
	end)
end

-- Live guard: while enabled, any head-bound accessory added later (late
-- streaming, manual Changer apply) is removed as it lands.
local function headlessAllHatsOnChildAdded(child)
	if not headlessAllHatsEnabled then return end
	if not (child:IsA("Accessory") or child:IsA("Hat")) then return end
	local char = player.Character
	if not char or child.Parent ~= char then return end
	task.delay(0.4, function()
		if not headlessAllHatsEnabled then return end
		if (player.Character ~= char) or (child.Parent ~= char) then return end
		local head = char:FindFirstChild("Head")
		if headlessHatIsOnHead(child, head) then
			removeHeadHatItem(char, child)
		end
	end)
end

local function headlessAllHatsHookChar(char)
	if headlessAllHatsChildConn then headlessAllHatsChildConn:Disconnect() headlessAllHatsChildConn = nil end
	if not char then return end
	headlessAllHatsChildConn = char.ChildAdded:Connect(headlessAllHatsOnChildAdded)
end

function enableHeadlessAllHats()
	headlessAllHatsEnabled = true
	headlessAllHatsPassGen = headlessAllHatsPassGen + 1
	if player.Character then
		headlessAllHatsHookChar(player.Character)
		task.spawn(applyHeadlessAllHats, player.Character)
	end
	headlessAllHatsConn = player.CharacterAdded:Connect(function(char)
		headlessAllHatsHookChar(char)
		applyHeadlessAllHats(char)
	end)
end

function disableHeadlessAllHats()
	headlessAllHatsEnabled = false
	headlessAllHatsPassGen = headlessAllHatsPassGen + 1
	if headlessAllHatsConn then headlessAllHatsConn:Disconnect() headlessAllHatsConn = nil end
	if headlessAllHatsChildConn then headlessAllHatsChildConn:Disconnect() headlessAllHatsChildConn = nil end
	restoreHeadlessAllHats(player.Character, headlessEnabled)
	-- Plain Headless may still be ON; keep its head-hiding in place.
	if headlessEnabled then task.spawn(applyHeadless, player.Character) end
end


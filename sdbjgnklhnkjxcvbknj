-- ============================================================
-- AA/FQ Manuals: peek assist, works ONLY paired with Anti-Aim or Fake Duck.
-- Constrains the spin to a small jitter window around the chosen peek side
-- (Left/Right are mutually exclusive) instead of a full 360 spin, so you can
-- peek around a wall edge without facing it. Spin rate follows the paired
-- function (antiAimSpeed / fakeDuckAntiAimSpeed).
-- ============================================================
manualsEnabled = false
manualsSide = "Right"
manualsPeekDeg = 90
manualsJitterDeg = 30

function manualsPeekYaw()
	if not manualsEnabled then return nil end
	if not (antiAimIsActive() or fakeDuckEnabled) then return nil end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	if not (hrp and cam) then return nil end
	local lv = cam.CFrame.LookVector
	local fx, fz = lv.X, lv.Z
	if (fx * fx + fz * fz) < 0.0001 then return nil end
	local base = math.atan2(-fx, -fz)
	local sideSign = (manualsSide == "Left") and 1 or -1
	local peek = base + sideSign * math.rad(manualsPeekDeg)
	local j = math.rad(manualsJitterDeg)
	return peek + (math.random() * 2 - 1) * j
end

function toggleManuals()
	manualsEnabled = not manualsEnabled
	setToggleState(manualsBtn, manualsEnabled, "AA/FQ Manuals: ON", "AA/FQ Manuals: OFF")
	setExtractedBtnState("AA/FQ Manuals", manualsEnabled)
	saveConfig()
end

function manualsSetSide(side)
	if side ~= "Left" and side ~= "Right" then return end
	manualsSide = side
	if manualsSideSelect then manualsSideSelect.Text = side .. " ▼" end
	saveConfig()
end

function manualsSwitchSide()
	manualsSetSide(manualsSide == "Left" and "Right" or "Left")
end


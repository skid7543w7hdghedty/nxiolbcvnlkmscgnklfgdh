-- Live-projectile watcher (hook-free backup): a thrown FakeBomb appears in
-- Workspace outside any Backpack/Character. Single string prefilter first, so
-- the per-event cost is ~zero; full parent walk only on name match.
pcall(function()
	Workspace.DescendantAdded:Connect(function(inst)
		if inst.Name ~= "FakeBomb" then return end
		local now = os.clock()
		if now - (bombTimerLastSeen or 0) < 1 then return end
		local a = inst.Parent
		if a == nil then return end
		local inside = false
		while a ~= nil and a ~= game do
			if a:IsA("Backpack") then inside = true break end
			if a:IsA("Model") and Players:GetPlayerFromCharacter(a) ~= nil then inside = true break end
			a = a.Parent
		end
		if not inside then
			bombTimerLastSeen = now
			bombTimerEnd = now + (BOMB_TIMER_LEN or 22)
		end
	end)
end)


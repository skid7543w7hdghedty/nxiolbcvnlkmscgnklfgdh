configLoadBtn = createButton("ConfigLoadButton", "Load Config", 733)
configLoadBtn.MouseButton1Click:Connect(function()
	local name = configListSelect.Text:gsub(" ▼$", ""):gsub(" ▲$", "")
	if name and name ~= "" then
		confirmAction("Load Config?", "Load '" .. name .. "'? Current settings will be replaced.", function()
			local fullPath = CONFIGS_DIR .. "/" .. name .. ".json"
			local ok, data = pcall(function() return readfile(fullPath) end)
			if ok and data then
				local okJson, decoded = pcall(function()
					return game:GetService("HttpService"):JSONDecode(data)
				end)
				if okJson and decoded then
					loadedConfig = decoded
					currentConfigName = name
					configListLabel.Text = "Config: " .. currentConfigName
					-- [configfix] Same save-blocking wrapper as the startup
					-- restore: no partial-state save can race the apply.
					applyLoadedConfigSafely()
					notify("Config", "Loaded '" .. name .. "'", 2)
				else
					notify("Config", "Config '" .. name .. "' is corrupted", 2)
				end
			else
				notify("Config", "Config '" .. name .. "' not found", 2)
			end
		end)
	end
end)


	function applyFunctionSearch()
		local frame = categoryFrames and categoryFrames[currentCategory]
		if not frame then return end
		local q = string.lower(tostring(searchQuery or ""))
		q = q:gsub("^%s+", ""):gsub("%s+$", "")
		-- Search over: put the Settings rows back in their canonical order so a
		-- row that drifted out of its sub-tab during the search snaps back
		-- immediately (previously this only happened on tab re-entry).
		if q == "" and currentCategory == "Settings" then
			pcall(restoreSettingsLayout)
		end
		local function applySearchTo(targetFrame)
			for _, child in ipairs(targetFrame:GetChildren()) do
				if child:IsA("GuiObject") then
					if q == "" then
						child.Visible = searchDefaultVisible(child)
					else
						local hay = ""
						if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
							hay = hay .. " " .. tostring(child.Text)
						end
						for _, d in ipairs(child:GetDescendants()) do
							if d:IsA("TextButton") or d:IsA("TextLabel") or d:IsA("TextBox") then
								hay = hay .. " " .. tostring(d.Text)
							end
						end
						child.Visible = (string.find(string.lower(hay), q, 1, true) ~= nil) and searchDefaultVisible(child)
					end
				end
			end
		end
		applySearchTo(frame)
		if currentCategory == "Combat" then
			local subName = currentCombatSubTab or "Combat"
			if subName == "Sheriff" and combatSheriffPage then applySearchTo(combatSheriffPage) end
			if subName == "Murderer" and combatMurdererPage then applySearchTo(combatMurdererPage) end
		end
		if currentCategory == "Emotes" then
			if emotesDefaultPage then applySearchTo(emotesDefaultPage) end
			if emotesLoopPage then applySearchTo(emotesLoopPage) end
		end
		-- Grouped tabs (Utilities / Changer / Selections): search every sub-page.
		if sidebarSubTabGroups then
			for _, group in pairs(sidebarSubTabGroups) do
				if group.owner == currentCategory then
					for _, def in ipairs(group.defs) do
						if def.frame then applySearchTo(def.frame) end
					end
				end
			end
		end
	end
	function setSearchOpen(open)
		searchOpen = open and true or false
		if searchBox then
			searchBox.Visible = searchOpen
			if searchOpen then
				if titleBar then titleBar.Visible = false end
				pcall(function() searchBox:CaptureFocus() end)
			else
				searchBox.Text = ""
				if titleBar then titleBar.Visible = true end
			end
		end
		pcall(applyFunctionSearch)
	end

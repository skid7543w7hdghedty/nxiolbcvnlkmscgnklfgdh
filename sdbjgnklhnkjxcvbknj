	-- it on does it get switched off (a user-enabled AutoGrab Gun stays on).
	-- Disabling only drops the grab connections and never touches WalkSpeed, so
	-- movement speed is unaffected.
	function glitchRestoreAutoGrabGun()
		if not glitchAutoGrabGunTurnedOn then return end
		glitchAutoGrabGunTurnedOn = false
		if autoGrabGunEnabled then
			pcall(toggleAutoGrabGun)

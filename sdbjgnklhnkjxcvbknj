do
	-- GLITCH TAB (after Reset): one-shot Glitch Server exploit flow —
	-- AutoGrab Gun (if off) -> Reset Sheriff -> wait for our gun ->
	-- Shoot Murderer until dead -> kick -> same-server rejoin after Rejoin Delay.
	glitchRunning = false
	glitchRejoinDelay = 15
	glitchGunTimeout = 10
	glitchFindTimeout = 10
	glitchShootTimeout = 10
	-- Set only when THIS script switched AutoGrab Gun on for the glitch run, so
	-- it can be switched back off before the kick.
	glitchAutoGrabGunTurnedOn = false
	-- Fall guard: a fling onto the Sheriff drags us wherever he goes. If he dies
	-- under the map we keep following him down and would otherwise fall forever.
	-- The last grounded spot is remembered and restored as soon as no fling is
	-- driving the character anymore.
	glitchReturnCF = nil -- filled by the first grounded sample (see guard below)
	glitchFallGuardActive = false
	glitchFallDropLimit = 150 -- studs below the safe spot = fell off the map
	function glitchRememberSafePoint()
		local char = player.Character
		local h = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (h and hrp and h.Health > 0) then return end
		local floorY = (workspace.FallenPartsDestroyHeight or -500) + 100
		if hrp.Position.Y < floorY then return end
		-- Only a grounded, settled character is a safe reference: while falling
		-- (or being flung) the position would keep moving the safe spot down.
		local vel = hrp.AssemblyLinearVelocity
		if math.abs(vel.Y) > 12 then return end
		local state = h:GetState()
		if state ~= Enum.HumanoidStateType.Running
			and state ~= Enum.HumanoidStateType.RunningNoPhysics
			and state ~= Enum.HumanoidStateType.Landed
			and state ~= Enum.HumanoidStateType.GettingUp then
			return
		end
		glitchReturnCF = CFrame.new(hrp.Position)
	end
	function glitchBelowMap()
		local char = player.Character
		local h = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (h and hrp and h.Health > 0) then return false end
		local refY = glitchReturnCF and glitchReturnCF.Position.Y
		local belowSafeSpot = refY ~= nil and hrp.Position.Y < (refY - (glitchFallDropLimit or 150))
		-- Safety net for when no grounded spot was recorded yet (or it went
		-- stale): anything this close to the destroy plane is a fall, never a
		-- real map floor.
		local nearVoid = hrp.Position.Y < ((workspace.FallenPartsDestroyHeight or -500) + 100)
		return belowSafeSpot or nearVoid
	end
	function glitchRecoverFromFall()
		local dest = glitchReturnCF or CFrame.new(14, 505, -55)
		for _ = 1, 20 do
			-- A new fling may have started while we were recovering: it owns the
			-- character now, so stop fighting it (the guard retries later).
			if nanFlingConnection then return false end
			local char = player.Character
			local h = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not (h and hrp and h.Health > 0) then return false end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end
			hrp.CFrame = dest
			pcall(function() char:SetPrimaryPartCFrame(dest) end)
			pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
			task.wait(0.05)
			if not glitchBelowMap() then return true end
		end
		return not glitchBelowMap()
	end
	function glitchStartFallGuard()
		if glitchFallGuardActive then return end
		glitchFallGuardActive = true
		task.spawn(function()
			while glitchFallGuardActive do
				local char = player.Character
				local h = char and char:FindFirstChildOfClass("Humanoid")
				if not (h and h.Health > 0) then break end
				-- A live fling owns the character; only step in once it released.
				if not nanFlingConnection then
					if glitchBelowMap() then
						glitchRecoverFromFall()
					else
						glitchRememberSafePoint()
					end
				end
				if not glitchRunning and not glitchBelowMap() then break end
				task.wait(0.2)
			end
			glitchFallGuardActive = false
		end)
	end

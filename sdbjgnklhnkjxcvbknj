-- Rejoin on Kick: detects a server-side kick (error message shown by the game)
-- and rejoins the SAME server (same JobId via TeleportToPlaceInstance).
-- Independent of Server Hop When Alone — can be
-- enabled even when alone-hopping is off. Uses the Hop.lua mechanism:
-- GuiService.ErrorMessageChanged fires when the game kicks the player.
local function setupRejoinOnKick()
	local kickGuiService = game:GetService("GuiService")
	-- ErrorMessageChanged can fire several times per kick; run the rejoin flow only once.
	local rejoinInProgress = false
	kickGuiService.ErrorMessageChanged:Connect(function(errorMessage)
		if not rejoinOnKickEnabled then return end
		if errorMessage and errorMessage ~= "" and player then
			if rejoinInProgress then return end
			rejoinInProgress = true
			notify("Rejoin on Kick", "Kicked — rejoining the game...", 3)
			-- Glitch: if the script switched AutoGrab Gun ON for the run, put it
			-- back OFF before the state is saved (a user-enabled one stays ON).
			if glitchAutoGrabGunTurnedOn and glitchRestoreAutoGrabGun then
				pcall(glitchRestoreAutoGrabGun)
			end
			-- Persist state + queue the script so it reloads after the rejoin
			pcall(saveConfigNow)
			pcall(function() getgenv().AdrenalinWinLoaded = nil end)
			if autoReexecuteOnRejoin then
				pcall(autofarmQueueRejoin)
			end
			-- Rejoin on Kick: always rejoin the SAME server (same JobId).
			-- Glitch Server case has priority, otherwise use the current JobId.
			if glitchRejoinSameServer and glitchRejoinJobId then
				local job = glitchRejoinJobId
				glitchRejoinSameServer = false
				glitchRejoinJobId = nil
				task.wait(glitchRejoinDelay or 15)
				pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, job, player) end)
				return
			end
			local sameJobId = game.JobId
			task.wait(1)
			if sameJobId and sameJobId ~= "" then
				local okSame = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, sameJobId, player) end)
				if okSame then return end
			end
			pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
		end
	end)
end

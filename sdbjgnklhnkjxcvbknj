-- Dropdown option separators: clean 1px frames around every mode-select
-- option (Teleports Auto TP look), unified across all dropdowns. The old
-- blue-ish tint came from Roblox's default BorderColor3 — killed everywhere.
separatorEnabled = true
separatorColor = Color3.fromRGB(255, 255, 255)
separatorBtns = {}

function applySeparatorStyle(btn)
	if not btn then return end
	local st = btn:FindFirstChild("SeparatorBtnStroke")
	if separatorEnabled then
		btn.BorderSizePixel = 1
		btn.BorderColor3 = separatorColor or Color3.fromRGB(255, 255, 255)
		-- [sepfix] Dropdown option rows sit flush (no gap), so the classic
		-- BorderSizePixel border of one row was overdrawn by the next row's
		-- opaque background — the config dropdown showed only the outer shell
		-- outline. A UIStroke child renders on the button's own layer and
		-- keeps the 1px line visible on every option row, sharing the same
		-- colour/enable state as the rest of the separators system.
		if not st then
			st = Instance.new("UIStroke")
			st.Name = "SeparatorBtnStroke"
			st.Thickness = 1
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			st.Parent = btn
		end
		st.Enabled = true
		st.Color = separatorColor or Color3.fromRGB(255, 255, 255)
		st.Transparency = 0
	else
		btn.BorderSizePixel = 0
		if st then st.Enabled = false end
	end
end

function styleSeparatorBtn(btn)
	if not btn then return end
	pcall(function() btn:SetAttribute("SepOption", true) end)
	table.insert(separatorBtns, btn)
	applySeparatorStyle(btn)
end

-- Frames (dropdown containers) get the same outline treatment. The config-list
-- dropdown had separators on its option rows but not around the menu shell
-- itself, which made it look "unfinished" next to e.g. Auto TP Before Farm.
separatorFrames = {}

function applySeparatorFrameStyle(fr)
	if not fr then return end
	local st = fr:FindFirstChild("SeparatorFrameStroke")
	-- UIStroke instead of the classic BorderSizePixel border: option rows inside
	-- the dropdown (and overlapping sibling rows of the tab list) render ON TOP
	-- of a classic border, which is exactly why the config dropdown's outline
	-- was invisible. UIStroke draws above the children and stays visible.
	if st then
		st.Enabled = separatorEnabled and true or false
		st.Color = separatorColor or Color3.fromRGB(255, 255, 255)
		st.Transparency = 0
	end
	pcall(function() fr.BorderSizePixel = 0 end)
end

function styleSeparatorFrame(fr)
	if not fr then return end
	pcall(function() fr:SetAttribute("SepFrame", true) end)
	local st = fr:FindFirstChild("SeparatorFrameStroke")
	if not st then
		st = Instance.new("UIStroke")
		st.Name = "SeparatorFrameStroke"
		st.Thickness = 1
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = fr
	end
	table.insert(separatorFrames, fr)
	applySeparatorFrameStyle(fr)
end

function refreshAllSeparators()
	-- Registry first: works no matter which gui root the menu lives under.
	-- Dead rows (dropdown options rebuilt every open) get pruned here so the
	-- registry can't grow unboundedly over a long session.
	pcall(function()
		for i = #separatorBtns, 1, -1 do
			local b = separatorBtns[i]
			if typeof(b) ~= "Instance" or not b.Parent then
				table.remove(separatorBtns, i)
			else
				pcall(applySeparatorStyle, b)
			end
		end
	end)
	pcall(function()
		for i = #separatorFrames, 1, -1 do
			local f = separatorFrames[i]
			if typeof(f) ~= "Instance" or not f.Parent then
				table.remove(separatorFrames, i)
			else
				pcall(applySeparatorFrameStyle, f)
			end
		end
	end)
	-- Attribute walk as fallback (catches any dynamically built dropdowns).
	pcall(function()
		for _, d in ipairs(playerGui:GetDescendants()) do
			if d:IsA("Frame") then
				local ok, marked = pcall(function() return d:GetAttribute("SepFrame") end)
				if ok and marked then applySeparatorFrameStyle(d) end
			elseif d:IsA("TextButton") then
				local ok, marked = pcall(function() return d:GetAttribute("SepOption") end)
				if ok and marked then applySeparatorStyle(d) end
			end
		end
	end)
end


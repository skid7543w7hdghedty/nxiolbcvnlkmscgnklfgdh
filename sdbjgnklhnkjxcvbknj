-- File names inside are free; the active file per tab is chosen in Settings
-- (same idea as Background Image / sounds) and stored in tabIconPaths.
function findTabIconFiles(tabName)
	local files = {}
	if not tabName or tabName == "" then return files end
	local ok, result = pcall(function() return listfiles(ICONS_DIR .. "/" .. tabIconFolder(tabName)) end)
	if ok and type(result) == "table" then
		for _, path in ipairs(result) do
			local lower = string.lower(path)
			if lower:match("%.png$") or lower:match("%.jpg$") or lower:match("%.jpeg$") then
				table.insert(files, path)
			end
		end
	end
	table.sort(files)
	return files
end


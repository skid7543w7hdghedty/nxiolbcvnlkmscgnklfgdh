function countSelectedTargets()
	local count = 0
	for _ in pairs(selectedTargets) do
		count += 1
	end
	return count
end

function updateFlingStatus()
	if not multiFlingStatusLabel then return end
	local count = countSelectedTargets()
	if loopFlingActive then
		multiFlingStatusLabel.Text = "Loop flinging " .. count .. " target(s)"
		multiFlingStatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	elseif flingActive then
		multiFlingStatusLabel.Text = "Flinging " .. count .. " target(s)"
		multiFlingStatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	else
		multiFlingStatusLabel.Text = count == 0 and "Select targets to fling" or (count .. " target(s) selected")
		multiFlingStatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

function refreshPlayerList()
	if not playerScrollFrame then return end
	for _, child in ipairs(playerScrollFrame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	playerCheckboxes = {}

	local playerList = Players:GetPlayers()
	table.sort(playerList, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	local yPosition = 0
	for _, plr in ipairs(playerList) do
		if plr ~= player then
			local rowData
			rowData = createAvatarSelectorRow(playerScrollFrame, plr, {
				nameSuffix = "Entry",
				selected = selectedTargets[plr.Name] ~= nil,
				accent = Color3.fromRGB(255, 80, 80),
				baseBg = Color3.fromRGB(0, 0, 0),
				selectedBg = Color3.fromRGB(70, 18, 18),
				onClick = function()
					if selectedTargets[plr.Name] then
						selectedTargets[plr.Name] = nil
						rowData.SetSelected(false)
					elseif isPlayerWhitelisted(plr.Name) then
						notify("Fling", plr.Name .. " is in exceptions", 2)
					else
						selectedTargets[plr.Name] = plr
						rowData.SetSelected(true)
					end
					updateFlingStatus()
				end,
			})
			rowData.Entry.Position = UDim2.new(0, 0, 0, yPosition)

			playerCheckboxes[plr.Name] = {
				Entry = rowData.Entry,
				Checkmark = rowData.Checkmark,
				NameLabel = rowData.NameLabel,
				SetSelected = rowData.SetSelected,
			}

			yPosition += 65
		end
	end

	playerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPosition)
	updateFlingStatus()
	if flingSearchBox then
		local searchText = string.lower(flingSearchBox.Text)
		for _, data in pairs(playerCheckboxes) do
			if data.Entry and data.NameLabel then
				local playerName = data.NameLabel.Text
				data.Entry.Visible = searchText == "" or string.find(string.lower(playerName), searchText, 1, true) ~= nil
			end
		end
	end
end

function toggleAllPlayers(selectAll)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and not isPlayerWhitelisted(plr.Name) then
			local checkboxData = playerCheckboxes[plr.Name]
			if checkboxData then
				if selectAll then
					selectedTargets[plr.Name] = plr
					if checkboxData.SetSelected then checkboxData.SetSelected(true) else checkboxData.Checkmark.Visible = true end
				else
					selectedTargets[plr.Name] = nil
					if checkboxData.SetSelected then checkboxData.SetSelected(false) else checkboxData.Checkmark.Visible = false end
				end
			end
		end
	end
	updateFlingStatus()
end

-- Single-target helpers for Teleport / Spectate: these actions only make
-- sense with exactly ONE selected player.
function flingSelectedList()
	local list = {}
	for _, plr in pairs(selectedTargets) do
		if plr and plr.Parent and plr.Character then
			list[#list + 1] = plr
		end
	end
	return list
end

function flingSingleTarget()
	local list = flingSelectedList()
	if #list == 0 then return nil, "No targets selected!" end
	if #list > 1 then return nil, "Select only ONE player!" end
	return list[1], nil
end

flingTeleportBackCF = nil

function flingTeleportToSelected()
	local plr, err = flingSingleTarget()
	if err then return notify("Teleport", err, 2) end
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local tHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not (myChar and myHrp and tHrp) then return notify("Teleport", "Not available", 2) end
	flingTeleportBackCF = myHrp.CFrame
	pcall(doInstantTp, myHrp, myChar, tHrp.CFrame + Vector3.new(0, 0, 3))
	notify("Teleport", "Teleported to " .. plr.Name, 2)
end

function flingTeleportBack()
	if not flingTeleportBackCF then return notify("Teleport", "No saved position", 2) end
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not (myChar and myHrp) then return notify("Teleport", "Not available", 2) end
	pcall(doInstantTp, myHrp, myChar, flingTeleportBackCF)
	notify("Teleport", "Teleported back", 2)
end

flingAutoSelectAll = false

function flingSelectPlayer(plr)
	if not plr or plr == player then return end
	if isPlayerWhitelisted(plr.Name) then return end
	selectedTargets[plr.Name] = plr
	local data = playerCheckboxes and playerCheckboxes[plr.Name]
	if data then
		if data.SetSelected then data.SetSelected(true)
		elseif data.Checkmark then data.Checkmark.Visible = true end
	end
	updateFlingStatus()
end

-- Fling methods (ported from Fling.lua): all 14, switchable from the multi-fling UI.
-- Globals (not locals) on purpose: the chunk is at the local-registers limit.
flingMethodModes = {"BodyVelocity", "FlingNEW", "BodyThrust", "BodyForce", "VectorForce", "LinearVelocity", "ExplodeFling", "RocketFling", "TorqueFling", "ImpulseFling1", "ImpulseFling2", "AlignPositionFling", "PhysicsRepFling", "NaNFling"}
flingMethodIndex = 1
flingMethodTargetRoot = nil
function flingCurrentMethod()
	return flingMethodModes[flingMethodIndex] or flingMethodModes[1]
end
FlingMethods = {
	BodyVelocity = function(rootPart, power, dir)
		local bv = Instance.new("BodyVelocity")
		bv.Velocity = dir * power * 100
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Parent = rootPart
		return bv
	end,
	BodyThrust = function(rootPart, power, dir)
		local bt = Instance.new("BodyThrust")
		bt.Force = dir * power * 500
		bt.Location = rootPart.Position + Vector3.new(0, 1, 0)
		bt.Parent = rootPart
		return bt
	end,
	BodyForce = function(rootPart, power, dir)
		local bf = Instance.new("BodyForce")
		bf.Force = dir * power * 500
		bf.Parent = rootPart
		return bf
	end,
	VectorForce = function(rootPart, power, dir)
		local vf = Instance.new("VectorForce")
		vf.Force = dir * power * 500
		vf.Parent = rootPart
		return vf
	end,
	LinearVelocity = function(rootPart, power, dir)
		local lv = Instance.new("LinearVelocity")
		lv.Velocity = dir * power * 100
		lv.MaxForce = 9e9
		lv.Parent = rootPart
		return lv
	end,
	ExplodeFling = function(rootPart, power, dir)
		local bf = Instance.new("BodyForce")
		bf.Force = dir * power * 999999
		bf.Parent = rootPart
		local bv = Instance.new("BodyVelocity")
		bv.Velocity = Vector3.new(math.random(-1000, 1000), math.random(500, 1500), math.random(-1000, 1000))
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Parent = rootPart
		game:GetService("Debris"):AddItem(bf, 0.3)
		game:GetService("Debris"):AddItem(bv, 0.3)
		return {bf, bv}
	end,
	NaNFling = function(rootPart, power, dir)
		local targetRoot = flingMethodTargetRoot
		if not targetRoot then return nil end
		local nan_value = 0 / 0
		local nan_vector = Vector3.new(nan_value, nan_value, nan_value)
		local humanoid = rootPart.Parent and rootPart.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.PlatformStand = true end
		rootPart.CFrame = targetRoot.CFrame
		rootPart.AssemblyLinearVelocity = nan_vector
		rootPart.AssemblyAngularVelocity = nan_vector
		pcall(function() sethiddenproperty(rootPart, "PhysicsRepRootPart", targetRoot) end)
		return nil
	end,
	PhysicsRepFling = function(rootPart, power, dir)
		if not sethiddenproperty then warn("sethiddenproperty not available!") return nil end
		local targetRoot = flingMethodTargetRoot
		if not targetRoot then return nil end
		pcall(function() sethiddenproperty(rootPart, "PhysicsRepRootPart", targetRoot) end)
		rootPart.CFrame = targetRoot.CFrame
		rootPart.Velocity = Vector3.new(9e9, 9e9, 9e9)
		rootPart.RotVelocity = Vector3.new(9e9, 9e9, 9e9)
		return nil
	end,
	FlingNEW = function(rootPart, power, dir)
		local targetRoot = flingMethodTargetRoot
		if not targetRoot then return nil end
		local bodies = {}
		pcall(function()
			sethiddenproperty(rootPart, "PhysicsRepRootPart", targetRoot)
			sethiddenproperty(player, "SimulationRadius", math.huge)
		end)
		for i = 1, 100 do
			local bv = Instance.new("BodyVelocity")
			bv.Parent = rootPart

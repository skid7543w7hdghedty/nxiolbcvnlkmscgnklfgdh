-- Auto Anti-Shoot: enable Anti-Shoot at round start, disable when farming begins.
-- The pre-farm TP loop detects round start — we piggyback on the same detection:
-- when a new round starts and Auto Anti-Shoot is ON, enable Anti-Shoot immediately
-- (it protects you during the pre-farm wait). The farming loop then disables it
-- the moment it starts flying to coins.
autofarmAutoAntiShootLastRound = ""
autofarmAutoAntiShootActive = false -- true while Anti-Shoot is ON due to this feature

-- Returns true when our current role matches the selected Auto Anti-Shoot mode.
-- "Default" (index 1) always allows. "Sheriff" = only when we are the Sheriff or
-- the gun-carrying Hero, "Murderer" = only when we are the Murderer,
-- "Sheriff/Murderer" = any of those roles.
function autofarmAutoAntiShootRoleAllowed()
	if autofarmAutoAntiShootModeIndex <= 1 then return true end
	local role = autofarmGetMyRole()
	local isSheriff = role == "Sheriff" or role == "Hero"
	local isMurderer = role == "Murderer"
	local mode = autofarmAutoAntiShootModes[autofarmAutoAntiShootModeIndex]
	if mode == "Sheriff" then return isSheriff end
	if mode == "Murderer" then return isMurderer end
	if mode == "Sheriff/Murderer" then return isSheriff or isMurderer end
	return true
end


-- One-time rename of the old icon tab/folder to "LoopEmotes" (shown as
-- "Loop Emotes"): saved icon choices and the on-disk files are moved over so
-- nothing keeps pointing at the old folder name.
loopEmotesIconsMigrated = false
function migrateLoopEmotesIconFolder()
	local function migratedPath(p)
		if type(p) ~= "string" then return p end
		local idx = p:find("Ragebait", 1, true)
		if idx then
			return p:sub(1, idx - 1) .. "LoopEmotes" .. p:sub(idx + 8)
		end
		return p
	end
	if type(tabIconPaths) ~= "table" then tabIconPaths = {} end
	if tabIconPaths["Ragebait"] ~= nil then
		if not tabIconPaths["LoopEmotes"] or tabIconPaths["LoopEmotes"] == "" then
			tabIconPaths["LoopEmotes"] = migratedPath(tabIconPaths["Ragebait"])
		end
		tabIconPaths["Ragebait"] = nil
	end
	if type(tabIconActivePaths) ~= "table" then tabIconActivePaths = {} end
	if tabIconActivePaths["Ragebait"] ~= nil then
		if not tabIconActivePaths["LoopEmotes"] or tabIconActivePaths["LoopEmotes"] == "" then
			tabIconActivePaths["LoopEmotes"] = migratedPath(tabIconActivePaths["Ragebait"])
		end
		tabIconActivePaths["Ragebait"] = nil
	end
	if loopEmotesIconsMigrated then return end
	loopEmotesIconsMigrated = true
	local legacyDir = ICONS_DIR .. "/Ragebait"
	local newDir = ICONS_DIR .. "/LoopEmotes"
	local ok, files = pcall(function() return listfiles(legacyDir) end)
	if ok and type(files) == "table" and #files > 0 then
		pcall(function() makefolder(newDir) end)
		for _, path in ipairs(files) do
			local lower = string.lower(tostring(path))
			if lower:match("%.png$") or lower:match("%.jpg$") or lower:match("%.jpeg$") then
				local name = tostring(path):match("[^/\\]+$")
				if name then
					pcall(function() writefile(newDir .. "/" .. name, readfile(path)) end)
				end
			end
		end
		pcall(function() delfolder(legacyDir) end)
	end
end


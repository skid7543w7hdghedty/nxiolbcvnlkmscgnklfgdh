-- Anti-Lag (toggleable): removes particles, visual effects, decals/textures,
-- smooths part materials and hides the sky to boost FPS. Every change is recorded
-- so toggling OFF restores everything to its original state.

function antiLagSaveAndApply(inst)
	if antiLagApplied[inst] then return end
	pcall(function()
		if inst:IsA("Part") or inst:IsA("Union") or inst:IsA("BasePart") then
			antiLagRestoreList[inst] = {prop = "Material", value = inst.Material}
			inst.Material = Enum.Material.SmoothPlastic
		end
		if inst:IsA("ParticleEmitter") or inst:IsA("Smoke") or inst:IsA("Explosion") or inst:IsA("Sparkles") or inst:IsA("Fire") then
			antiLagRestoreList[inst] = {prop = "Enabled", value = inst.Enabled}
			inst.Enabled = false
		end
		if inst:IsA("BloomEffect") or inst:IsA("BlurEffect") or inst:IsA("DepthOfFieldEffect") or inst:IsA("SunRaysEffect") then
			antiLagRestoreList[inst] = {prop = "Enabled", value = inst.Enabled}
			inst.Enabled = false
		end
		if inst:IsA("Decal") or inst:IsA("Texture") then
			antiLagRestoreList[inst] = {prop = "Texture", value = inst.Texture}
			inst.Texture = ""
		end
		if inst:IsA("Sky") then
			antiLagRestoreList[inst] = {prop = "Parent", value = inst.Parent}
			inst.Parent = nil
		end
	end)
	antiLagApplied[inst] = true
end

function antiLagScanAll()
	-- [perf] Chunked walk instead of game:GetDescendants(): that single call
	-- built a table of EVERY instance in the game in one frame, which froze the
	-- client for a moment on load and when restoring a config with Anti-Lag ON.
	-- Now it processes ~300 nodes per frame, so the same work costs no hitch.
	task.spawn(function()
		local stack = { game }
		local budget = 0
		while #stack > 0 and antiLagEnabled do
			local v = table.remove(stack)
			if v == game or v.Parent then
				antiLagSaveAndApply(v)
				local kids = v:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
			end
			budget = budget + 1
			if budget >= 300 then
				budget = 0
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

function enableAntiLag()
	antiLagEnabled = true
	antiLagScanAll()
	antiLagNewConn = game.DescendantAdded:Connect(function(child)
		if not antiLagEnabled then return end
		pcall(function() antiLagSaveAndApply(child) end)
	end)
	if antiLagButton then setToggleState(antiLagButton, true, "Anti-Lag: ON", "Anti-Lag: OFF") end
end

function disableAntiLag()
	antiLagEnabled = false
	if antiLagNewConn then antiLagNewConn:Disconnect(); antiLagNewConn = nil end
	for inst, record in pairs(antiLagRestoreList) do
		pcall(function()
			inst[record.prop] = record.value
		end)
	end
	antiLagRestoreList = {}
	antiLagApplied = {}
	if antiLagButton then setToggleState(antiLagButton, false, "Anti-Lag: ON", "Anti-Lag: OFF") end
end

function toggleAntiLag()
	if antiLagEnabled then
		disableAntiLag()
	else
		enableAntiLag()
	end
end


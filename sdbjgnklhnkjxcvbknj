function isPlayerWhitelisted(name)
	if not exceptionsEnabled then return nil end
	return resetWhitelist[name]
end

-- Player exceptions (shared by Reset / Trolling / Fling). Names are stored
-- exactly as typed (or as the in-server spelling when the player is online).
-- Globals (not locals) on purpose: the chunk is at the local-registers limit.
exceptionsEnabled = true
exceptionsListUIs = {}

function addExceptionName(rawName)
	local name = tostring(rawName or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then notify("Exceptions", "Type a nickname first", 2) return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name:lower() == name:lower() then name = plr.Name break end
	end
	if resetWhitelist[name] then notify("Exceptions", name .. " is already added", 2) return end
	resetWhitelist[name] = true
	saveConfig()
	refreshExceptionsLists()
	notify("Exceptions", name .. " added", 2)
end

function removeExceptionName(name)
	if resetWhitelist[name] then
		resetWhitelist[name] = nil
		saveConfig()
		refreshExceptionsLists()
		notify("Exceptions", name .. " removed", 2)
	end
end

function refreshExceptionsLists()
	local names = {}
	for name in pairs(resetWhitelist) do names[#names + 1] = name end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	for _, ui in ipairs(exceptionsListUIs) do
		if ui.title and ui.title.Parent then
			ui.title.Text = "Exceptions (" .. #names .. ")"
		end
		if ui.list and ui.list.Parent then
			for _, child in ipairs(ui.list:GetChildren()) do
				if child:IsA("Frame") then
					child:Destroy()
				end
			end
			local y = 0
			for _, name in ipairs(names) do
				local entryName = name
				local row = Instance.new("Frame")

function autofarmGetPlayerData()
	if autofarmRoleCache and (os.clock() - autofarmRoleCacheAt) < 1 then
		return autofarmRoleCache
	end
	local ok, result = pcall(function()
		return invokePlayerData()
	end)
	if ok and result then
		autofarmRoleCache = result
		autofarmRoleCacheAt = os.clock()
		return result
	end
	return nil
end

function autofarmGetMyRole()
	local result = autofarmGetPlayerData()
	if result then
		local me = result[player.Name]
		if me then return me.Role end
	end
	return nil
end

function autofarmFindMurdererPlayer()
	local result = autofarmGetPlayerData()
	if result then
		for name, data in pairs(result) do
			if data.Role == "Murderer" and name ~= player.Name then
				return Players:FindFirstChild(name)
			end
		end
	end
	return nil
end

-- Only farm while we are ALIVE and IN THE ROUND (not dead, not in the lobby
-- waiting for the round). FAIL-OPEN: we only block the farm when we POSITIVELY
-- know we're dead/out of round. If the Alive attribute is missing and player
-- data can't be fetched, we allow farming — otherwise the farm silently never
-- starts (that was the bug: the old check returned false on unknown state).
function autofarmIsAliveInRound()
	local char = player.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	local attr = char:GetAttribute("Alive")
	if attr ~= nil then return attr == true end
	local result = autofarmGetPlayerData()
	if result then
		local me = result[player.Name]
		if me and (me.Killed or me.Dead) then return false end
	end
	-- Unknown state -> assume alive (health > 0 already verified above)
	return true
end

function autofarmHasGun()
	local char = player.Character
	if char and char:FindFirstChild("Gun") then return true end
	local bp = player:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Gun") then return true end
	return false
end

-- Read the REAL coin count from the MM2 coin-bag GUI (the "12/40" label).
-- This is the exact number the server has accepted into the bag, so the
-- 40/50 end-of-farm reset fires at the true limit even if a local count
-- drifts (missed removal event, coin collected by walking over it, etc).
-- Returns nil when the label can't be found (fallback: local counter).

-- Does this GUI label look like the coin-bag counter? We match on the TEXT,
-- NOT on the instance name (MM2 renames the bag GUI between updates), so the
-- counter is found regardless of what the bag is called. We only accept a
-- "current/total" number where the TOTAL equals the current farm limit (40 or
-- 50) — that pins it to OUR bag and avoids matching unrelated numbers.
-- The bag size is AUTO-DETECTED from the "X/Y" label (40 normal, 50 Elite) —
-- that is what lets ONE "Autofarm Coins" button work with both bags.
-- [40/50 fix] When the HUD only exposes a bare count (the usual case) there is
-- nothing to read the capacity from, so we must NOT assume the smaller 40 bag:
-- the old default of 40 made the farm "finish" at 40/50 and skip Elite coins.
-- Start at 50 and only lower it when the label explicitly says "/40".
autofarmBagTotalExplicit = false
autofarmBagDetectedTotal = 50
if loadedConfig and loadedConfig.values and loadedConfig.values.autofarmBagTotalExplicit == true then
	autofarmBagTotalExplicit = true
	autofarmBagDetectedTotal = math.floor(math.clamp(tonumber(loadedConfig.values.autofarmBagDetectedTotal) or 50, 20, 200))
end
function autofarmResolveTargetLimit()
	if autofarmCustomTargetEnabled then
		local custom = tonumber(autofarmCustomTarget) or 50
		return math.max(1, math.floor(custom))
	end
	local total = tonumber(autofarmBagDetectedTotal) or 50
	if total < 20 or total > 200 then total = 50 end
	return math.floor(total)
end

local function isCoinBagText(t)
	local num, den = t:match("^%s*(%d+)%s*/%s*(%d+)%s*$")
	if num and den then
		local total = tonumber(den) or 0
		-- Real MM2 bags are 40 (normal) / 50 (Elite). Accept that whole range so
		-- the limit can be detected automatically, while ignoring unrelated
		-- "1/3" style counters elsewhere in the HUD.
		if total >= 20 and total <= 200 then
			autofarmBagDetectedTotal = total
			autofarmBagTotalExplicit = true
			return tonumber(num), total
		end
		return nil
	end
	num = t:match("^%s*(%d+)%s*$")
	if num then
		local n = tonumber(num)
		-- Elite inference: the visible bag label is sometimes a bare count with
		-- no "X/50" form. Collecting a 41st coin proves the bag is bigger than
		-- the normal 40, i.e. the Elite 50-slot bag.
		if n and n > 40 and n <= 60 then
			autofarmBagDetectedTotal = 50
		end
		return n
	end
	return nil
end
function autofarmGetBagCount()
	-- [perf] Throttled + label cached. This used to re-find the CoinBag GUI and
	-- scan ALL its descendants EVERY heartbeat — one of the mid-flight stutter
	-- sources. Now the label is found once (by TEXT matching, name-agnostic) and
	-- only re-read every 0.25s.
	local now = os.clock()
	if (now - autofarmBagCountAt) < 0.05 then
		return autofarmBagCountCache
	end
	autofarmBagCountAt = now
	local ok, count = pcall(function()
		-- Fast path: re-read the cached label directly (no descendant scan at all)
		local lbl = autofarmBagLabelCache
		if lbl and lbl.Parent then
			-- keep it if it still matches our target; otherwise drop and rescan
			local match = isCoinBagText(tostring(lbl.Text))
			if match then return match end
		end
-- Slow path (runs until the right label is found, then cached). [perf] The
		-- full MainGUI descendant scan is expensive: while no bag label exists
		-- (lobby / between rounds) it now runs at most every 0.4 s instead of
		-- 20x per second, which was a real periodic stutter on mobile.
		if (now - (autofarmBagScanAt or 0)) < 0.4 then
			return autofarmBagCountCache
		end
		autofarmBagScanAt = now
		autofarmBagLabelCache = nil
		local mainGui = playerGui:FindFirstChild("MainGUI")
		local gameGui = mainGui and mainGui:FindFirstChild("Game")
		if not gameGui then return nil end
		-- The decompiled CoinBag.lua shows the real layout:
		--   MainGUI.Game.CoinBags.Container.<Frame>.CurrencyFrame.Icon.Coins
		-- Each round you have a bag FRAME (a DIRECT child of Container); only
		-- YOUR frame is .Visible=true — server toggles it via CoinsStarted.
		-- The "Coins" label holds the exact bag amount as a BARE number (not
		-- "12/40"). Read the Coins label that belongs to the VISIBLE frame.
		local bagsc = gameGui and (gameGui:FindFirstChild("CoinBags") or gameGui:FindFirstChild("CoinBag", true))
		if bagsc then
			local container = bagsc:FindFirstChild("Container") or bagsc:FindFirstChildWhichIsA("Frame")
			local bagFrames = {} -- { eraVisible, label }
			if container then
				for _, f in ipairs(container:GetChildren()) do
					if f:IsA("Frame") then
						-- the DIRECT container child is the bag frame; track its visibility
						local ic = f:FindFirstChild("CurrencyFrame") and f:FindFirstChild("CurrencyFrame"):FindFirstChild("Icon")
						local coins = ic and ic:FindFirstChild("Coins")
						if coins then table.insert(bagFrames, { f, coins }) end
					end
				end
			end
			-- Prefer the bag frame that is Visible RIGHT NOW (the live bag)
			for _, ef in ipairs(bagFrames) do
				if ef[1].Visible then
					local cur = isCoinBagText(tostring(ef[2].Text))
					if cur then
						autofarmBagLabelCache = ef[2]
						return cur
					end
				end
			end
			-- Fall back: any Coins label that parses (even if its frame is hidden)
			for _, ef in ipairs(bagFrames) do
				local cur = isCoinBagText(tostring(ef[2].Text))
				if cur then
					autofarmBagLabelCache = ef[2]
					return cur
				end
			end
		end
		-- Very last resort: any label in the game tree shaped like a bag count
		for _, d in ipairs(gameGui:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				local cur = isCoinBagText(tostring(d.Text))
				if cur then
					autofarmBagLabelCache = d
					return cur
				end
			end
		end
		return nil
	end)
	if ok then autofarmBagCountCache = count end
	return autofarmBagCountCache
end

function autofarmFindCoinContainer()
	-- MM2 keeps coins in <MapModel>.CoinContainer during the round. The container
	-- is searched RECURSIVELY: on some maps/updates the map model is nested inside
	-- a folder (or the container sits deeper than one level).
	-- [perf] The recursive Workspace scan used to run EVERY heartbeat — scanning
	-- the entire map every frame was THE main cause of the small mid-flight
	-- freezes. The container is now cached; the expensive recursive scan only
	-- reruns when the cached one is gone (round/map change), at most every 0.5s.
	local cc = autofarmContainerCache
	if cc and cc.Parent then return cc end
	local now = os.clock()
	if (now - autofarmContainerCheckedAt) < 0.5 then return nil end
	autofarmContainerCheckedAt = now
	autofarmContainerCache = Workspace:FindFirstChild("CoinContainer", true)
	return autofarmContainerCache
end

function autofarmGetCoinPart(coin)
	if coin:IsA("BasePart") then return coin end
	local p = coin:FindFirstChild("Coin")
	if p and p:IsA("BasePart") then return p end
	return coin:FindFirstChildWhichIsA("BasePart")
end

-- The coin's hitbox BasePart is always transparent in current MM2 — the VISIBLE
-- spinning coin is a child visual/mesh. Cache that visible part once per coin so
-- we can detect "collected but not yet removed" coins cheaply every frame.
function autofarmGetCoinVisiblePart(coin)
	local cached = autofarmCoinVisiblePart[coin]
	if cached and cached.Parent then return cached end
	-- [perf] Hitbox-only coins never have a visible part, so this descendant scan
	-- used to rerun for them EVERY frame. Throttle rescans to every 0.5s per coin
	-- (visuals that stream in late are still picked up within half a second).
	local now = os.clock()
	local last = autofarmCoinVisCheckedAt[coin]
	if last and (now - last) < 0.5 then return nil end
	autofarmCoinVisCheckedAt[coin] = now
	for _, d in ipairs(coin:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.95 then
			autofarmCoinVisiblePart[coin] = d
			return d
		end
	end
	return nil
end

-- [perf] Cached list of the character's BaseParts. The flight loop used to call
-- char:GetDescendants() 2-3 times per frame (CanCollide loop + full-body touch
-- volley); now the list is rebuilt only when the character changes or every 1s.
function autofarmGetCharParts(char)
	local now = os.clock()
	if char ~= autofarmCharPartsChar or (now - autofarmCharPartsAt) > 1 then
		autofarmCharPartsChar = char
		autofarmCharPartsAt = now
		autofarmCharParts = {}
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				table.insert(autofarmCharParts, p)
			end
		end
	end
	return autofarmCharParts
end

-- [autofarm] FIRST-COIN TELEPORT -------------------------------------------
-- A round starts with the character wherever it spawned (or died), so the farm
-- used to spend the first seconds just flying over to the coin field. Instead
-- the very FIRST coin of a round is collected by snapping the root straight
-- onto it (once per round), and the normal flight continues from that coin to
-- the next one. Only the CHARACTER moves - the coin is never snapped/pulled
-- toward it, so the normal collection stays exactly as it was.
function autofarmTeleportToFirstCoin(root, coin, coinPart)
	if not (root and root.Parent and coinPart and coinPart.Parent) then return false end
	local target = coinPart.Position
	local ok = pcall(function()
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.CFrame = CFrame.new(target)
	end)
	if not ok then return false end
	-- Ride the rest of the body along with no collision, exactly like the flight
	-- loop does, so the character does not get wedged in the map geometry.
	pcall(function()
		for _, p in ipairs(autofarmGetCharParts(root.Parent)) do
			if p ~= root and p.CanCollide then p.CanCollide = false end
		end
	end)
	-- Claim it right away with the same plain two-way root touch the loop uses.
	pcall(function() safeFireTouch(coinPart, root) end)
	if coin then
		autofarmTouchedAt[coin] = os.clock()
		autofarmClaimCoin(coin)
	end
	return true
end

-- Is this coin already gone / already collected?
-- A collected coin sometimes STAYS in the container with its visual hidden —
-- that's exactly why the farm kept flying back to long-gone coins. So besides
-- Parent == nil we also treat a coin as gone when its previously-VISIBLE visual
-- part disappeared or turned invisible. Spent coins are permanently blacklisted.
function autofarmCoinIsGone(coin)
	if autofarmSpentCoins[coin] then return true end
	if coin.Parent == nil then return true end
	local part = autofarmGetCoinPart(coin)
	if not part then return true end
	local vis = autofarmCoinVisiblePart[coin]
	if vis then
		if not vis.Parent or vis.Transparency >= 0.95 then
			autofarmSpentCoins[coin] = true
			return true
		end
	else
		-- Cache the visible part the first time we see this coin (may legitimately
		-- be nil for hitbox-only coins — those are handled via removal instead)
		autofarmGetCoinVisiblePart(coin)
	end
	return false
end

-- Closest coin that isn't gone yet: keeps targeting the same coin every frame
-- until it disappears (no more 'touch once and move on' — that was why the farm
-- flew past coins without collecting them). Coins we last touched > 3 s ago
-- without collection (i.e. we already flew past them) are blacklisted so we
-- never keep circling a bugged coin.
function autofarmNearestCoin(container, fromPos)
	local bestCoin, bestPart, bestDist = nil, nil, math.huge
	for _, coin in ipairs(container:GetChildren()) do
		if not autofarmCoinIsGone(coin) then
			-- Coins already inside the Coin Aura pull are not movement targets:
			-- the aura collects them while we fly straight on to the next coin.
			-- If the aura somehow fails, the coin becomes targetable again after 2s.
			local pendingAt = autofarmAuraPending[coin]
			if pendingAt and (os.clock() - pendingAt) >= 2 then
				autofarmAuraPending[coin] = nil
				pendingAt = nil
			end
			if not autofarmSpentCoins[coin] and not pendingAt then
				local part = autofarmGetCoinPart(coin)
				if part then
					local d = (part.Position - fromPos).Magnitude
					if d < bestDist then
						bestDist = d
						bestCoin = coin
						bestPart = part
					end
				end
			end
		end
	end
	return bestCoin, bestPart, bestDist
end

function autofarmWatchCoin(coin)
	if autofarmCoinWatched[coin] then return end
	autofarmCoinWatched[coin] = true
	coin.AncestryChanged:Connect(function(_, parent)
		if parent == nil and autofarmEnabled and autofarmCoinWatched[coin] then
			autofarmCoinWatched[coin] = nil
			autofarmSpentCoins[coin] = true
			-- Only count if WE were actively collecting this coin when it vanished
			-- (our last touch within the window). autofarmTouchedAt is updated on
			-- EVERY touch, so a coin another player grabs long after we flew past it
			-- is no longer counted as collected by us.
			if autofarmTouchedAt[coin]
				and (os.clock() - autofarmTouchedAt[coin]) <= AUTOFARM_TOUCH_WINDOW
				and (autofarmGetBagCount() == nil and os.clock() >= autofarmBagWarmupUntil) then
				-- Local fallback only. A coin vanishing near us does NOT prove we
				-- collected it (someone can scoop it right before us), so this path
				-- fires only when the bag count is truly unavailable AND we are past
				-- the warmup — never during warmup, or we'd tally other players' runs.
				autofarmCollected = math.min(autofarmCollected + 1, autofarmTargetCoins)
				autofarmSessionCoins += 1
				autofarmRefreshStatsLabel()
			end
		end
	end)
end

-- [perf] autofarmClaimCoin is called EVERY frame while touching a coin; without
-- this guard each call scheduled a brand-new task.delay(1.2) closure (dozens of
-- pending tasks per coin = garbage-collector churn = micro-stutters).
autofarmClaimPending = {}
function autofarmClaimCoin(coin)
	-- Count the coin only when the server actually removes it (= really collected).
	-- The counting connection is attached ONCE per coin, even if the coin is
	-- unclaimed and retried later — so a coin can never be counted twice.
	autofarmWatchCoin(coin)
	-- Only ONE delayed verification per coin at a time; the flag clears when the
	-- check runs, so the retry logic keeps working exactly as before.
	if autofarmClaimPending[coin] then return end
	autofarmClaimPending[coin] = true
	-- Remember whether the coin's VISUAL part was visible at touch time: if it
	-- turns invisible afterwards the coin was collected (fallback count in case
	-- the removal event was missed). Hitbox-only coins count only via removal.
	local visAtClaim = autofarmGetCoinVisiblePart(coin)
	task.delay(1.2, function()
		autofarmClaimPending[coin] = nil
		local part = autofarmGetCoinPart(coin)
		local removed = (coin.Parent == nil) or (not part)
		local turnedInvisible = visAtClaim and (not visAtClaim.Parent or visAtClaim.Transparency >= 0.95)
		if removed or turnedInvisible then
			-- Collected: permanently blacklist so we never fly back to it.
			autofarmSpentCoins[coin] = true
			if autofarmCoinWatched[coin] then
				autofarmCoinWatched[coin] = nil
				-- Only count if WE were actively collecting this coin when it turned
				-- invisible (our last touch within the window) — not when another
				-- player's collection makes it invisible locally.
				if turnedInvisible and autofarmEnabled
					and autofarmTouchedAt[coin]
					and (os.clock() - autofarmTouchedAt[coin]) <= AUTOFARM_TOUCH_WINDOW then
					if autofarmGetBagCount() == nil and os.clock() >= autofarmBagWarmupUntil then
						autofarmCollected = math.min(autofarmCollected + 1, autofarmTargetCoins)
						autofarmSessionCoins += 1
						autofarmRefreshStatsLabel()
					end
				end
			end
		else
			-- Coin is STILL there after a moment — the touch failed (e.g. lag).
			-- Allow up to 5 retries, then permanently blacklist it.
			local tries = (autofarmCoinRetries[coin] or 0) + 1
			autofarmCoinRetries[coin] = tries
			if tries > 5 then
				autofarmSpentCoins[coin] = true
			end
		end
	end)
end

function autofarmResetSelf()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.Health = 0 end) end
	if char then pcall(function() char:BreakJoints() end) end
end

-- Innocent: just reset after the farm
function autofarmFinishInnocent()
	if autofarmResetInnocentEnabled then
		autofarmResetSelf()
	end
end

-- Shoot the murderer until they (or we) die, or the timeout runs out.
-- Routes through the SAME dispatcher as the standalone Auto Shoot Murderer, so
-- the selected Gun Silent Aim mode (Default / Intercept / *Accurate) is honored
-- in the Autofarm tab too. The piercer toggle only forces the wallbang origin.
function autofarmShootMurderer(forcePiercer)
	if not autofarmHasGun() then return false end
	local startedAt = os.clock()
	while os.clock() - startedAt < 10 do
		local m = autofarmFindMurdererPlayer()
		if not (m and m.Character) then break end
		local mh = m.Character:FindFirstChildOfClass("Humanoid")
		if not mh or mh.Health <= 0 then break end
		-- Our own death also ends the attempt
		local myChar = player.Character
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		if not myHum or myHum.Health <= 0 then return false end
		-- One dispatch per attempt at the standalone's cooldown. The dispatcher
		-- handles Default (predicted + holster), Intercept (keep the gun) and
		-- *Accurate (holster -> study -> equip -> fire) exactly like the
		-- standalone Auto Shoot Murderer.
		pcall(aimAutoShootDispatch, m, forcePiercer)
		task.wait(AIM_CONFIG.autoShotCooldown or 0.35)
	end
	return true
end

-- Sheriff/Hero: always shoot the murderer if you have the gun (piercer toggle
-- controls wallbang mode, not whether we shoot). Reset only if the toggle is on.
function autofarmFinishSheriff()
	autofarmShootMurderer(autofarmShootPiercerEnabled)
	if autofarmResetSheriffEnabled then
		autofarmResetSelf()
	end
end

-- Auto teleport after the farm to the selected Teleports-tab place.
-- Returns true when a teleport was actually performed.
function autofarmDoEndTeleport()
	if not autofarmTpEnabled then return false end
	local mode = autofarmTpModes[autofarmTpModeIndex]
	if not mode or mode == "OFF" then return false end
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then return false end
	local teleported = false
	if mode == "Lobby" then
		teleported = pcall(doInstantTp, myHrp, myChar, CFrame.new(14, 505, -55))
	elseif mode == "VoteMap" then
		teleported = pcall(doInstantTp, myHrp, myChar, CFrame.new(14, 507, 35))
	elseif mode == "Map" then
		teleported = pcall(tpToMap)
	elseif mode == "Above Map" then
		teleported = pcall(tpAboveMap)
	elseif mode == "Void" then
		teleported = pcall(createVoidBaseplate)
		teleported = pcall(function()
			voidTpPreviousPos = myHrp.CFrame
			myHrp.CFrame = CFrame.new(voidBaseplatePos.X, voidBaseplatePos.Y + 1, voidBaseplatePos.Z)
		end) and teleported
	elseif mode == "Above Lobby" then
		teleported = pcall(doInstantTp, myHrp, myChar, CFrame.new(19, 609, 34))
	end
	notify("Autofarm", "Auto TP: " .. mode, 2)
	return teleported and true or false
end

-- Murderer: kill everyone at the end of the farm, then reset
function autofarmFinishMurderer()
	if autofarmKillAllEnabled then
		for _ = 1, 3 do
			local alive = 0
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					local h = plr.Character:FindFirstChildOfClass("Humanoid")
					if h and h.Health > 0 then alive += 1 end
				end
			end
			if alive == 0 then break end
			pcall(doKillEveryone, false)
			task.wait(0.3)
		end
	end
	if autofarmResetMurdererEnabled then
		autofarmResetSelf()
	end
end

function autofarmFinishRound()
	task.spawn(function()
		-- Auto TP runs FIRST (before any reset kills the character); the kill-all
		-- remote and the predicted piercer shot both work from any position.
		local teleported = autofarmDoEndTeleport()
		if teleported then
			-- Let the teleport settle/replicate BEFORE any reset kills the
			-- character. Without this the reset (Health = 0) won the race and the
			-- character died at the old spot, so the TP looked like it never
			-- happened. ~0.25 s covers doInstantTp/tpToMap's frame holds.
			local settleUntil = os.clock() + 0.25
			while os.clock() < settleUntil do
				RunService.Heartbeat:Wait()
			end
		end
		local role = autofarmGetMyRole()
		if role == "Murderer" then
			autofarmFinishMurderer()
		elseif role == "Sheriff" or role == "Hero" then
			autofarmFinishSheriff()
		else
			-- Innocent: if we picked up the gun, shoot the murderer (piercer toggle
			-- controls wallbang mode only). Then reset if the toggle is on.
			if autofarmHasGun() then
				autofarmShootMurderer(autofarmShootPiercerEnabled)
			end
			autofarmFinishInnocent()
		end
	end)
end

-- True while the farm flight loop is actively moving the character every frame.
-- While it is true the root is fully non-colliding (fly through anything);
-- while false the root collides so the invisible platform catches the character.
autofarmFlightMoving = false

function autofarmStopFlight()
	autofarmHoldPos = nil
	autofarmFlightMoving = false
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) then return end
	-- In under-floor modes (Default/Fast Safe) the character flies BELOW the map
	-- with CanCollide=false parts. Dropping it (PlatformStand=false) there makes it
	-- fall straight through the map into the void. If there is no solid ground
	-- within the same 60-stud range the route uses (i.e. we are under the lowest
	-- floor / in the void), float in place instead; the round-end / avoid-murderer
	-- teleport moves us afterwards. Anywhere a floor exists below, drop normally.
	local below = nil
	local ok = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {char}
		below = Workspace:Raycast(hrp.Position, Vector3.new(0, -60, 0), params)
	end)
	if ok and below then
		pcall(function() hum.PlatformStand = false end)
	else
		pcall(function() hum.PlatformStand = true end)
	end
end

-- Pause flight between coins WITHOUT dropping the character: zero velocity,
-- keep PlatformStand = true so the character floats in place instead of falling.
-- This eliminates the sharp dip and the delay when switching coin targets.
autofarmHoldPos = nil
function autofarmPauseFlight()
	-- Keep the flight flag TRUE while pinned between coins: the noclip heartbeat
	-- restores root collision when this is false, and a colliding root inside the
	-- map geometry wedges the character (it then never reaches the next coin).
	-- Root collision is restored only when the farm truly stops.
	autofarmFlightMoving = true
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	-- [mobile fix] Keep the character AIRBORNE while waiting between coins.
	-- On mobile the game's own control scripts reset PlatformStand between
	-- frames, so zeroing the velocity was not enough: gravity started pulling
	-- the character down the moment a coin disappeared ("collects the coin and
	-- drops sharply"). Re-assert PlatformStand and PIN the position every frame
	-- so the hold is rock solid on PC and mobile alike.
	if hum then pcall(function() hum.PlatformStand = true end) end
	local hold = autofarmHoldPos
	if not hold or (hrp.Position - hold.Position).Magnitude > 12 then
		hold = CFrame.new(hrp.Position) * autofarmLieCF
		autofarmHoldPos = hold
	end
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		hrp.CFrame = hold
	end)
end

-- Teleport to the selected Avoid Murderer destination
function autofarmDoAvoidMurdererTp()
	local mode = autofarmAvoidMurdererModes[autofarmAvoidMurdererModeIndex]
	if mode == "OFF" then return end
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then return end
	if mode == "Lobby" then
		pcall(doInstantTp, myHrp, myChar, CFrame.new(14, 505, -55))
	elseif mode == "VoteMap" then
		pcall(doInstantTp, myHrp, myChar, CFrame.new(14, 507, 35))
	elseif mode == "Map" then
		pcall(tpToMap)
	elseif mode == "Above Map" then
		pcall(tpAboveMap)
	elseif mode == "Void" then
		pcall(createVoidBaseplate)
		pcall(function()
			voidTpPreviousPos = myHrp.CFrame
			myHrp.CFrame = CFrame.new(voidBaseplatePos.X, voidBaseplatePos.Y + 1, voidBaseplatePos.Z)
		end)
	elseif mode == "Above Lobby" then
		pcall(doInstantTp, myHrp, myChar, CFrame.new(19, 609, 34))
	end
	notify("Autofarm", "Avoid Murderer TP: " .. mode, 2)
end

-- ===== Anti-Stop destination: where to teleport when the farm gets stuck =====
autofarmStuckTpModes = {"Map", "Above Map", "Void", "Lobby", "VoteMap", "Above Lobby"}
autofarmStuckTpModeIndex = 1 -- default "Map" (old behaviour)

function autofarmDoStuckTp()
	local mode = autofarmStuckTpModes[autofarmStuckTpModeIndex]
	local myChar = player.Character
	local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHrp then return end
	if mode == "Lobby" then
		pcall(doInstantTp, myHrp, myChar, CFrame.new(14, 505, -55))
	elseif mode == "VoteMap" then
		pcall(doInstantTp, myHrp, myChar, CFrame.new(14, 507, 35))
	elseif mode == "Map" then
		pcall(tpToMap)
	elseif mode == "Above Map" then
		pcall(tpAboveMap)
	elseif mode == "Void" then
		pcall(createVoidBaseplate)
		pcall(function()
			voidTpPreviousPos = myHrp.CFrame
			myHrp.CFrame = CFrame.new(voidBaseplatePos.X, voidBaseplatePos.Y + 1, voidBaseplatePos.Z)
		end)
	elseif mode == "Above Lobby" then
		pcall(doInstantTp, myHrp, myChar, CFrame.new(19, 609, 34))
	end
	notify("Autofarm", "Anti-Stop TP: " .. mode, 2)
end

-- Check distance to the murderer and teleport away if too close during autofarm
function autofarmCheckAvoidMurderer(hrp)
	if not autofarmAvoidMurdererEnabled then return false end
	if autofarmAvoidMurdererModeIndex <= 1 then return false end -- "OFF" selected
	if not isPlayerMurderer() then
		local murderer = autofarmFindMurdererPlayer()
		if murderer and murderer.Character then
			local mHrp = murderer.Character:FindFirstChild("HumanoidRootPart")
			if mHrp then
				local dist = (hrp.Position - mHrp.Position).Magnitude
				if dist <= autofarmAvoidMurdererDist then
					autofarmDoAvoidMurdererTp()
					return true
				end
			end
		end
	end
	return false
end

function startAutofarm()
	task.spawn(function()
		while autofarmEnabled do
			local dt = RunService.Heartbeat:Wait()
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			-- Farm ONLY while alive and in the round: no collecting after death,
			-- in the lobby, or before the round starts. Also pause while the
			-- pre-farm TP is being applied so the flight can't fight it.
			if autofarmPreTpHold or not (char and hum and hrp and hum.Health > 0) or not autofarmIsAliveInRound() then
				autofarmStopFlight()
				task.wait()
			else
				local container = autofarmFindCoinContainer()
				-- New round / new map -> reset the per-round state
				if container ~= autofarmActiveContainer then
					autofarmActiveContainer = container
					-- [40/50 fix] A fresh round that starts with 45+ coins in the
					-- container can only be a 50-slot (Elite) bag — raise the target
					-- even when the HUD only shows a bare count.
					local okCc, ccCount = pcall(function() return #container:GetChildren() end)
					if okCc and ccCount and ccCount >= 45 then
						autofarmBagDetectedTotal = 50
					end
					autofarmCollected = 0
					autofarmCoinWatched = {}
					autofarmCoinRetries = {}
					autofarmSpentCoins = {}
					autofarmCoinVisiblePart = {}
					autofarmCoinVisCheckedAt = {}
					autofarmTouchedAt = {}
					autofarmFullTouchAt = {}
					autofarmClaimPending = {}
					autofarmAuraPending = {}
					autofarmCoinRetries = {}   -- reset retry counters for new round
					autofarmBagLabelCache = nil -- new round = the bag GUI may be rebuilt
					autofarmBagCountCache = nil -- never trust a count carried over from the previous round
					autofarmBagCountAt = 0      -- force an immediate rescan of the fresh HUD
					autofarmBagScanAt = 0
					autofarmBagPrev = nil       -- restart the bag-delta baseline
					autofarmBagWarmupUntil = os.clock() + AUTOFARM_BAG_WARMUP -- ignore the bag during the HUD rebuild
					autofarmDelayCoinBase = nil -- new round: seed from the first observed count
					autofarmCoinDelayUntil = nil
					autofarmFirstCoinTeleported = false -- teleport to this round's first coin
					autofarmNoCoinSince = nil   -- restart the no-coin grace timer
					autofarmRoundFinished = false
					autofarmStuckSince = nil    -- reset stuck detector for new round
					autofarmStuckLastPos = nil
				end

				-- ONE "Autofarm Coins" button: the bag size is resolved
				-- automatically from the HUD (40 normal / 50 Elite) every
				-- iteration, so the farm stops exactly when the bag is FULL.
				autofarmTargetCoins = autofarmResolveTargetLimit()
				-- Effective count = the max of the local counter and the REAL
				-- server-accepted bag count from the GUI. The reset always fires
				-- exactly at the detected farm limit (40 normal / 50 Elite).
				local bagCount = autofarmGetBagCount()
				-- Round-start grace: ignore the bag while the HUD may still be
				-- showing the PREVIOUS round's count (a stale "40/40" would make
				-- the farm finish the round instantly with nothing collected).
				if os.clock() < autofarmBagWarmupUntil then
					bagCount = nil
				end
				-- 41/40 FIX: the GUI bag label can briefly over-read the true
				-- count (server double-count / stale HUD refresh), so any value
				-- above the farm limit is clamped down to the limit here. This
				-- keeps the round counter, the bag-delta session counter and the
				-- effective display count from ever exceeding the target.
				if bagCount ~= nil and bagCount > autofarmTargetCoins then
					bagCount = autofarmTargetCoins
				end
				-- SESSION COUNTER FIX: the top-of-tab counter used to rely on coin
				-- removal events, which MISSED coins (e.g. picked up by Coin Aura on
				-- untargeted coins, or removal events swallowed under lag). Now the
				-- session counter follows the server-accepted bag count directly:
				-- every increase of the bag adds the exact delta — nothing can be
				-- skipped or double-counted. Decreases (bag reset on round change /
				-- deposit) are ignored, they just move the baseline.
				-- FIRST-COIN FIX: the OLD code set prev=nil on the first read of a
				-- round, so the first coin (already on the label after the warmup
				-- scan-gap) was pushed into the baseline and never summed -> every
				-- round under-counted by one. Now the first read of a round seeds
				-- the session from ZERO (the round's bag always starts at 0), so the
				-- whole round total is counted; decreases move the baseline only.
				if bagCount ~= nil then
					if autofarmBagPrev == nil then
						-- First valid label of this round: it (or a stale 0) is the
						-- whole round amount collected so far — count it fully.
						autofarmSessionCoins += bagCount
						autofarmRefreshStatsLabel()
					elseif bagCount > autofarmBagPrev then
						autofarmSessionCoins += (bagCount - autofarmBagPrev)
						autofarmRefreshStatsLabel()
					end
					autofarmBagPrev = bagCount
					if bagCount > autofarmCollected then
						autofarmCollected = math.min(bagCount, autofarmTargetCoins)
					end
				end
				-- BAG-FIRST: the bag count is the ONLY source that proves a coin
				-- landed in OUR bag (it only rises when our own pickup is accepted).
				-- So it drives the round count. The local counter is used only when
				-- the bag can't be read, because local "coin vanished near us" events
				-- can't tell apart a genuine pickup from someone else scooping it.
				local effectiveCollected = math.min(bagCount or autofarmCollected, autofarmTargetCoins)

				if not container or autofarmRoundFinished then
					autofarmStopFlight()
				elseif effectiveCollected >= autofarmTargetCoins then
					autofarmRoundFinished = true
					autofarmStopFlight()
					notify("Autofarm", "Collected " .. effectiveCollected .. "/" .. autofarmTargetCoins .. " coins!", 2)
					autofarmFinishRound()
				else
					local coin, part, dist = autofarmNearestCoin(container, hrp.Position)
					-- Are any coins still being pulled in by the Coin Aura? If so, the
					-- round is NOT over even when no targetable coin is left.
					local auraStillPulling = false
					if autofarmMode == 2 or autofarmMode == 3 then
						for c, t in pairs(autofarmAuraPending) do
							if (os.clock() - t) < 2 and not autofarmCoinIsGone(c) then
								auraStillPulling = true
								break
							end
						end
					end
					if coin then autofarmNoCoinSince = nil end
					if not coin and auraStillPulling then
						-- Last remaining coins are inside the aura pull — just hold
						-- position and let the aura finish collecting them.
						autofarmNoCoinSince = nil
						autofarmPauseFlight()
					elseif not coin then
						-- 39/40 FIX: no targetable coin does NOT mean the round is over.
						-- Two real causes of finishing one coin short:
						--   1. A still-existing coin was blacklisted too eagerly (3s of
						--      failed touches / 3 retries under lag) — give those coins a
						--      SECOND CHANCE before giving up on them for good.
						--   2. MM2 spawns coins in WAVES: the last coin of the bag often
						--      belongs to the NEXT wave. The old code finished the round
						--      the moment the current wave was empty -> 39/40. Now we
						--      wait up to 8s for a new wave before finishing.
						local revived = false
						if effectiveCollected > 0 and effectiveCollected < autofarmTargetCoins then
							for _, c in ipairs(container:GetChildren()) do
								if autofarmSpentCoins[c] and not autofarmCoinIsGone(c)
									and (autofarmCoinRetries[c] or 0) < 9 then
									autofarmSpentCoins[c] = nil
									autofarmTouchedAt[c] = nil
									autofarmCoinRetries[c] = nil
									revived = true
								end
							end
						end
						if revived then
							autofarmNoCoinSince = nil
						elseif effectiveCollected > 0 then
							autofarmNoCoinSince = autofarmNoCoinSince or os.clock()
							if (os.clock() - autofarmNoCoinSince) >= 8 then
								autofarmRoundFinished = true
								autofarmStopFlight()
								notify("Autofarm", "No more coins — finishing round (" .. effectiveCollected .. "/" .. autofarmTargetCoins .. ")", 2)
								autofarmFinishRound()
							else
								autofarmPauseFlight()
							end
						else
							autofarmPauseFlight()
						end
					else
						-- FIRST-COIN TELEPORT: snap onto this round's first coin.
						-- The round starts wherever the character spawned, so the old
						-- behaviour wasted the first seconds flying over to the coin
						-- field. The teleport runs ONCE per round; the target/delay
						-- state is re-armed so the flight continues from coin #2.
						if coin and not autofarmFirstCoinTeleported then
							autofarmFirstCoinTeleported = true
							if autofarmTeleportToFirstCoin(hrp, coin, part) then
								autofarmCoinDelayUntil = nil
							end
						end
						-- Avoid murderer: teleport away if too close during autofarm
						if autofarmCheckAvoidMurderer(hrp) then
							autofarmStopFlight()
							task.wait()
						else
						-- Wait Before Next Coin: arm the hold ONLY when the
						-- collected count actually rose, i.e. a coin was really
						-- picked up. The old code armed it whenever the NEAREST
						-- coin changed, which happens constantly during flight
						-- (coins move / are grabbed by others), so the character
						-- stopped in mid-air at random. A target change must never
						-- arm the delay.
						if autofarmDelayCoinBase == nil then
							autofarmDelayCoinBase = effectiveCollected
						elseif effectiveCollected > autofarmDelayCoinBase then
							autofarmDelayCoinBase = effectiveCollected
							if autofarmCoinDelay > 0 then
								autofarmCoinDelayUntil = os.clock() + autofarmCoinDelay
							end
						end
						if autofarmCoinDelayUntil and os.clock() < autofarmCoinDelayUntil then
							pcall(function() hum.PlatformStand = true end)
							autofarmPauseFlight()
						else
							autofarmCoinDelayUntil = nil
						-- Fly: through walls, lying on the back (face up).
						-- Auto Anti-Shoot: disable now that farming has started
						if autofarmAutoAntiShootActive then
							autofarmAutoAntiShootActive = false
							if PastedSources then
								toggleDesync()
								if desyncButton then setToggleState(desyncButton, false, "Anti-Shoot: ON", "Anti-Shoot: OFF") end
								setExtractedBtnState("Anti-Shoot", false)
							end
						end
						-- NO teleport snaps anywhere — instant position jumps are exactly
						-- what the anti-cheat kicked for. Every frame the character moves
						-- at most autofarmSpeed studs/sec toward the target, and dt is
						-- clamped so a lag spike can never become one huge step either.
						pcall(function() hum.PlatformStand = true end)
						-- [perf] Cached part list + write CanCollide only when it actually
						-- changed (property writes on every part every frame are not free).
						-- EVERY part (root included) must be non-colliding while flying:
						-- the farm spot sits INSIDE the map textures, so a colliding root
						-- gets wedged in geometry and the character never reaches a coin
						-- ("flies to the coin and stops collecting"). Root collision is
						-- only restored when the farm goes idle (autofarmStopFlight).
						for _, p in ipairs(autofarmGetCharParts(char)) do
							if p.CanCollide then p.CanCollide = false end
						end
						-- Horizontal distance to the target coin: only the Fast Safe
						-- retarget and the stuck detector care about XZ. Collection
						-- itself uses the real 3D distance, exactly like the old build:
						-- the character stays on its route and the touch does the work.
						local coinDx = hrp.Position.X - part.Position.X
						local coinDz = hrp.Position.Z - part.Position.Z
						local horizToCoin = math.sqrt(coinDx * coinDx + coinDz * coinDz)

						-- Keep touching the coin EVERY frame while in range (not just once).
						-- The coin stays targetable until it disappears, so we keep hitting
						-- it until the server accepts the touch — no more flying past coins.
						-- [perf] HRP touch still fires EVERY frame (that's the one that
						-- collects), but the full-body volley over all ~15 parts is now
						-- throttled to every 0.15s per coin — the old every-frame volley
						-- was 30+ firetouchinterest pcalls per frame, another hitch source.
						-- Stop-to-hold only applies when the mode is Default. In Fast
						-- mode we rely on the fly-through block below (which claims the coin,
						-- marks it pending and immediately retargets the NEXT coin) — so
						-- the flight never pauses at a coin to collect it.
						-- Collection strategy (identical to the old, proven build):
						-- every mode touches the coin from the root while it is within
						-- pickup range; the modes differ only in when they move on:
						--   * Default (1): parks on the coin and keeps touching until the
						--     server removes it - slowest, but never skips a coin.
						--   * Fast (2) / Fast Safe (3): fly THROUGH. Once the coin is
						--     reached it is marked pending and the next coin becomes
						--     the target immediately, so the flight never stops.
						if dist <= autofarmPickupRange then
							-- Old-build collection: a plain two-way touch from the root
							-- is enough (the coin is NOT snapped onto the character, so
							-- it never bobs up to the coin - it just flies its route).
							safeFireTouch(part, hrp)
							-- Last-touch timestamp: updated EVERY frame so we can later
							-- tell whether WE were collecting the coin when it vanished.
							autofarmTouchedAt[coin] = os.clock()
							autofarmClaimCoin(coin)
							-- Full-body volley throttled to 0.15s per coin (the old
							-- every-frame volley was 30+ firetouchinterest pcalls per
							-- frame - a real hitch source on weaker executors).
							if not autofarmFullTouchAt[coin] or (os.clock() - autofarmFullTouchAt[coin]) >= 0.15 then
								autofarmFullTouchAt[coin] = os.clock()
								for _, bp in ipairs(autofarmGetCharParts(char)) do
									if bp ~= hrp then
										safeFireTouch(part, bp)
									end
								end
							end
							if autofarmMode ~= 1 then
								-- Reached the coin? Fast compares the real 3D distance
								-- (it flies straight at the coin); Fast Safe flies
								-- directly under the coin, so only XZ matters.
								local reachedCoin
								if autofarmMode == 2 then
									reachedCoin = dist <= autofarmFastRetargetDist
								else
									reachedCoin = horizToCoin <= autofarmFastSafeRetargetDist
								end
								if reachedCoin then
									-- Hand the coin to the pending list (it is being
									-- touched right now, and a missed coin becomes
									-- targetable again automatically after 2s - see
									-- autofarmNearestCoin) and pick the NEXT coin.
									-- If no other coin exists we keep this one as the
									-- target instead of handing off the last coin to
									-- nothing, so the round can never stall.
									autofarmAuraPending[coin] = os.clock()
									local nextCoin, nextPart, nextDist = autofarmNearestCoin(container, hrp.Position)
									if nextCoin then
										coin, part, dist = nextCoin, nextPart, nextDist
										coinDx = hrp.Position.X - part.Position.X
										coinDz = hrp.Position.Z - part.Position.Z
										horizToCoin = math.sqrt(coinDx * coinDx + coinDz * coinDz)
									else
										autofarmAuraPending[coin] = nil
									end
								end
							end
						end


						-- Route: in Default and Fast Safe modes, fly UNDER the floor
						-- whenever one exists below the coin (harder to be killed). In Fast
						-- mode, fly DIRECTLY to the coin position for fastest collection —
						-- the speed and continuous movement make it hard to hit anyway.
						local target
						if autofarmMode == 2 then
							-- Fast mode: fly straight to the coin
							target = part.Position
						else
							-- Default / Fast Safe: stay on the under-floor route. No
							-- rising up to the coin - the touch collects it from below.
							local underFloorDepth = autofarmUnderFloorDepth
							autofarmFloorRayParams.FilterDescendantsInstances = {char, container}
							local floorHit = Workspace:Raycast(
								part.Position - Vector3.new(0, 0.5, 0),
								Vector3.new(0, -60, 0),
								autofarmFloorRayParams
							)
							if floorHit then
								target = Vector3.new(part.Position.X, floorHit.Position.Y - underFloorDepth, part.Position.Z)
							else
								target = part.Position - Vector3.new(0, 2, 0)
							end
						end

						-- SINGLE clamped 3D step at constant speed. The old code
						-- split the step into horizontal (up to maxStep) PLUS
						-- vertical (up to 3x maxStep via the ascent multiplier)
						-- applied in the SAME frame — so the moment the farm
						-- switched from same-level coins to a coin higher up,
						-- the effective speed spiked to ~3.16x the configured
						-- speed. That spike was the "jerk" the anti-cheat can
						-- kick for. Now the total displacement per frame is
						-- NEVER more than autofarmSpeed * dt in ANY direction:
						-- ascents, descents and level changes are all perfectly
						-- smooth at the same constant speed.
						-- Resuming flight: drop the pinned hold position.
						autofarmHoldPos = nil
						autofarmFlightMoving = true
						local delta = target - hrp.Position
						local dMag = delta.Magnitude
						local maxStep = autofarmSpeed * math.min(dt, autofarmMaxStepDt)
						local newPos = hrp.Position
						if dMag > 0.05 then
							newPos = newPos + delta * (math.min(maxStep, dMag) / dMag)
						end
						pcall(function()
							hrp.CFrame = CFrame.new(newPos) * autofarmLieCF
						end)
						pcall(function()
							hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
							hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
						end)
						-- Stuck detector: check position over a 1-second window.
						-- Every ~1 second, compare current position to where we were.
						-- If moved less than STUCK_MIN_DIST studs in that second, start the
						-- stuck timer. After autofillStuckTimeout seconds stuck, TP to map.
						-- Can be toggled off or the timeout tuned via the Autofarm tab.
						if autofarmStuckEnabled then
							local curPos = hrp.Position
							local now = os.clock()
							if (now - autofarmStuckCheckAt) >= 1 then
								autofarmStuckCheckAt = now
								if autofarmStuckLastPos then
									local movedDist = (curPos - autofarmStuckLastPos).Magnitude
									-- Deliberately parked on a coin is NOT "stuck": the farm
									-- holds the touch until the server accepts the pickup.
									if movedDist < AUTOFARM_STUCK_MIN_DIST and horizToCoin > autofarmTouchHorizRange then
										if not autofarmStuckSince then
											autofarmStuckSince = now
										elseif (now - autofarmStuckSince) >= autofarmStuckTimeout then
											autofarmStuckSince = nil
											autofarmStuckLastPos = nil
											notify("Autofarm", "Stuck detected — teleporting...", 2)
											pcall(autofarmDoStuckTp)
										end
									else
										autofarmStuckSince = nil
									end
								end
								autofarmStuckLastPos = curPos
							end
						end
						end -- per-coin delay hold else
						end -- avoid murderer else
					end
				end
			end
		end
		autofarmStopFlight()
	end)
end

function setAutofarmEnabled(state, target, silent)
	autofarmEnabled = state
	if state then
		autofarmTargetCoins = target or autofarmResolveTargetLimit()
		autofarmActiveContainer = nil -- force per-round state refresh
		autofarmFirstCoinTeleported = false -- start the next round ON the first coin
		if not autofarmSessionStart then
			autofarmSessionStart = os.clock()
		end
		-- Pre-farm teleport is handled by the round-start watcher below:
		-- it fires exactly ONCE per round (when the sheriff+murderer roles
		-- appear — same moment the round-start notification shows), waits
		-- 3 seconds, then teleports reliably. Re-arm it so that enabling
		-- the farm mid-round also teleports once for the current round.
		autofarmPreTpLastRound = ""
		startAutofarm()
	else
		autofarmStopFlight()
		-- Every disable resets the session stats — timer and coin counter
		-- start from zero on the next enable.
		autofarmSessionCoins = 0
		autofarmSessionStart = nil
		saveConfig() -- persist the zeroed stats immediately (not 30s later)
		if not silent then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				pcall(doInstantTp, hrp, char, CFrame.new(14, 505, -55))
			end
		end
	end
end

-- ============================================
-- Pre-farm TP: ONE reliable trigger per round
-- ============================================
-- Round start is detected exactly the way the sheriff/murderer notification
-- works: the moment BOTH roles appear in the player data a new round has
-- begun. We then wait 3 seconds and teleport ONCE — re-applying the CFrame
-- for several frames so the teleport is guaranteed to stick even if the game
-- (or the farm flight itself) tries to move the character back.
autofarmPreTpLastRound = ""
autofarmPreTpHold = false -- pauses the farm flight while the TP is being applied

function autofarmDoPreTp()
	local mode = autofarmPreTpModes[autofarmPreTpModeIndex]
	local myChar = player.Character
	local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	autofarmPreTpHold = true
	local fixedCF = nil
	if mode == "Lobby" then
		fixedCF = CFrame.new(14, 505, -55)
	elseif mode == "VoteMap" then
		fixedCF = CFrame.new(14, 507, 35)
	elseif mode == "Map" then
		pcall(tpToMap)
	elseif mode == "Above Map" then
		pcall(tpAboveMap)
	elseif mode == "Void" then
		pcall(createVoidBaseplate)
		if voidBaseplatePos then
			voidTpPreviousPos = hrp.CFrame
			fixedCF = CFrame.new(voidBaseplatePos.X, voidBaseplatePos.Y + 1, voidBaseplatePos.Z)
		end
	elseif mode == "Above Lobby" then
		fixedCF = CFrame.new(19, 609, 34)
	end
	if fixedCF then
		pcall(doInstantTp, hrp, myChar, fixedCF)
		-- Guarantee the teleport STUCK: re-apply for up to 15 frames while
		-- zeroing velocity, until the character is actually at the target.
		for _ = 1, 15 do
			task.wait()
			local c = player.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if not r then break end
			if (r.Position - fixedCF.Position).Magnitude > 8 then
				pcall(function()
					r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					r.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					r.CFrame = fixedCF
				end)
			else
				break
			end
		end
	end

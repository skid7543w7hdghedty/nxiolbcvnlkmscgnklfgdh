	if not c or not c.toggles then return end
	local T = c.toggles

	-- Collapse states + picker selections FIRST, decoupled from the long restore
	-- below: even if a later step errors, saved collapse states and selections
	-- are already applied. Every item is isolated via pcall.
	pcall(function()
		if c and c.pickerCollapsed then
			local pickers = { Troll = trollPicker, Reset = resetPicker, Shoot = shootPicker, Kill = killPicker, WatchMurderer = watchMurdererPicker, WatchSheriff = watchSheriffPicker }
			for key, picker in pairs(pickers) do
				pcall(function()
					if picker and c.pickerCollapsed[key] ~= nil and c.pickerCollapsed[key] ~= picker.collapsed then
						picker.collapsed = c.pickerCollapsed[key]
						local titleBar = picker.statusLabel and picker.statusLabel.Parent
						local titleParent = titleBar and titleBar.Parent
						local cb = picker.collapseBtn or (titleBar and (titleBar:FindFirstChild(key .. "PickerCollapse") or titleBar:FindFirstChild(key .. "MultiPickerCollapse")))
						local sb = picker.searchBox or (titleParent and (titleParent:FindFirstChild(key .. "PickerSearch") or titleParent:FindFirstChild(key .. "MultiPickerSearch")))
						local pf = picker.pickerFrame or (titleParent and (titleParent:FindFirstChild(key .. "PickerFrame") or titleParent:FindFirstChild(key .. "MultiPickerFrame")))
						if cb then cb.Text = picker.collapsed and "+" or "-" end
						if sb then sb.Visible = not picker.collapsed end
						if pf then pf.Visible = not picker.collapsed end
					end
				end)
			end
		end
	end)
	pcall(function()
		if c and c.pickerMultiSelect then
			local mpickers = { Kill = killPicker, WatchMurderer = watchMurdererPicker, WatchSheriff = watchSheriffPicker, Reset = resetPicker }
			for key, picker in pairs(mpickers) do
				pcall(function()
					if picker and c.pickerMultiSelect[key] then

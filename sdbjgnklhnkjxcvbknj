-- Notify about marked players that are ALREADY in the server at activation time.
-- PlayerAdded only fires for FUTURE joins, so without this you never get warned about
-- teamers / exploiters / scammers who were already here when you ran the script.
function notifyExistingMarkedPlayers()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if notifyOnExploiters and markedExploiters[plr.Name] then
				exploiterNotifSend("[!] Exploiter In Server", plr, "is in the server!")
				playSoundFile(exploiterJoinSoundPath)
			end
			if notifyOnTeamers and markedTeamers[plr.Name] then
				teamerNotifSend("[!] Teamer In Server", plr, "is in the server!")
				playSoundFile(teamerJoinSoundPath)
			end
			if notifyOnScammers and markedScammers[plr.Name] then

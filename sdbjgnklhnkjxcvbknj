-- Re-applies the canonical Settings order (and collapse states). Cheap: it
-- only writes back the exact LayoutOrder each row had at load time.
function restoreSettingsLayout()
	local frame = categoryFrames and categoryFrames["Settings"]
	if not frame then return end
	for child, order in pairs(settingsCanonicalOrder) do
		if child.Parent == frame then
			child.LayoutOrder = order
		end
	end
	pcall(applySettingsGroupsCollapse)
end

-- ============================================
-- SETTINGS > Tab Positions
-- Reorders the left sidebar tabs (Main, Player, ...) and, per owner tab, its
-- sub-tabs. Main order lives in tabOrder; sub-tab order in subTabOrder.
-- Both are applied via LayoutOrder and saved to the config.
-- ============================================
tabOrderRows = {}
tabOrderRowRefs = {}

function normalizeTabOrder()
	if type(tabOrder) ~= "table" then tabOrder = {} end
	local seen = {}
	local clean = {}
	for _, rawName in ipairs(tabOrder) do
		local name = rawName
		if name == "Buttons" then name = "Extractable" end
		if type(name) == "string" and not seen[name] then
			seen[name] = true
			clean[#clean + 1] = name
		end
	end
	for _, name in ipairs(TAB_ICON_FOLDERS) do
		if not seen[name] then
			seen[name] = true
			-- Grouped/merged tabs must be inserted at a sensible spot instead of
			-- being appended after Settings (existing configs saved the old tab
			-- order without them).
			local afterName = nil
			if name == "Selections" then afterName = "Trade"
			elseif name == "Fling" then afterName = "Utilities"
			elseif name == "Changelog" then afterName = "Extractable" end
			if afterName then
				local insertAt = #clean + 1
				for i, existing in ipairs(clean) do
					if existing == afterName then insertAt = i + 1 break end
				end
				table.insert(clean, insertAt, name)
			else
				clean[#clean + 1] = name
			end
		end
	end
	-- "Emotes" (Emotions/LoopEmotes grouped tab) has no Icons/ folder of its own,
	-- so it is not in TAB_ICON_FOLDERS. Keep it in the running order right after
	-- Emotions, otherwise it would keep its raw LayoutOrder and drift upwards.
	if not seen["Emotes"] then
		seen["Emotes"] = true
		local insertAt = #clean + 1
		for i, existing in ipairs(clean) do
			if existing == "Emotions" then insertAt = i + 1 break end
		end
		table.insert(clean, insertAt, "Emotes")
	end
	tabOrder = clean
end

function applyTabOrder()
	if type(categories) ~= "table" then return end
	normalizeTabOrder()
	for i, name in ipairs(tabOrder) do
		local data = categories[name]
		if data and data.button and data.button.Parent then
			data.button.LayoutOrder = i
		end
	end
end

-- Only tabs that actually have a sidebar button are reorderable. Merged tabs
-- (Reset, Glitch, Teamers, Exploiters, Scammers, Animations, Skybox, ...) live
-- inside grouped tabs now, so they stay in tabOrder for icon/config purposes
-- but must not show up as dead rows in Settings -> Tab Positions.
tabOrderDisplay = {}

function getTabOrderDisplay()
	if type(tabOrder) ~= "table" then tabOrder = {} end
	if type(categories) ~= "table" then return tabOrder end
	local shown = {}
	for _, name in ipairs(tabOrder) do
		local data = categories[name]
		if data and data.button then shown[#shown + 1] = name end
	end
	if #shown == 0 then return tabOrder end
	return shown
end

function renderTabOrderRows()
	if type(tabOrderRowRefs) ~= "table" then return end
	normalizeTabOrder()
	tabOrderDisplay = getTabOrderDisplay()
	for i, refs in ipairs(tabOrderRowRefs) do
		if refs.label and refs.label.Parent then
			local tabName = tabOrderDisplay[i]
			refs.label.Text = tabName and tostring(tabDisplayName(tabName)) or "-"
		end
		if refs.up then refs.up.BackgroundTransparency = (i > 1) and 0 or 0.75 end
		if refs.down then refs.down.BackgroundTransparency = (i < #tabOrderDisplay) and 0 or 0.75 end
	end
end

function moveTabOrder(idx, delta)
	normalizeTabOrder()
	local list = getTabOrderDisplay()
	local j = idx + delta
	if not list[idx] or not list[j] then return end
	local realA, realB = nil, nil
	for k, name in ipairs(tabOrder) do
		if name == list[idx] then realA = k end
		if name == list[j] then realB = k end
	end
	if not (realA and realB) then return end
	tabOrder[realA], tabOrder[realB] = tabOrder[realB], tabOrder[realA]
	applyTabOrder()
	renderTabOrderRows()
	pcall(saveConfig)
end


-- Click sound entry point. Every click path (explicit hook, global listener,
-- popup buttons) goes through here, so one physical click can never stack two
-- sounds. The window is longer than a press->release gap because the global
-- listener and GuiButton.MouseButton1Click both fire on release; a real second
-- click within 120 ms is not a realistic user action.
lastClickSoundAt = 0
function playClickSoundThrottled()
	local now = tick()
	if now - (lastClickSoundAt or 0) < 0.12 then return end
	lastClickSoundAt = now
	pcall(playSoundFile, clickSoundPath)
end


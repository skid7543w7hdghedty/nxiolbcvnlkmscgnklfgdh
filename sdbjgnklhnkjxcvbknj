-- ============================================================
-- Knife Silent Aim (Murderer): silent intercept of the normal RMB throw.
-- Remote: Knife.Events.KnifeThrown:FireServer(...CFrames...).
-- v1 model: origin = our hand (lookAt predicted), target = predicted torso.
-- Lead = ping lead (V3 EMA) + flight (dist / KNIFE_AIM_SPEED), minimax-shortened
-- when unstable + strafe-start nudge when standing, NO gravity comp (throw is
-- ~straight at play ranges).
-- Wall Check: redirects only to a VISIBLE Innocent/Sheriff/Hero; behind wall =>
-- the original throw passes through untouched. Dead/returning cheaters excluded
-- by Role filter (Innocent/Sheriff/Hero) + alive check + the game "Alive"
-- attribute and Killed/Dead player-data flags (a dead cheater back on the map
-- can still report Health > 0).
-- ============================================================
KNIFE_AIM_SPEED = KNIFE_AIM_SPEED or 100
knifeAimEnabled = false
knifeAimWeaponHooked = false
knifeAimWeaponOrig = nil
knifeAimWeaponOrigTP = nil
-- Targeting mode (dropdown next to the toggle, Auto TP Before Farm pattern):
-- "Wall Check" = nearest VISIBLE alive Innocent/Sheriff/Hero,
-- "Default" = nearest alive, walls ignored,
-- "Accurate" = Wall Check + the player the camera is actually pointing at wins
-- over a closer one behind the camera, so the knife never flies backwards.
knifeAimModes = {"Default", "Wall Check", "Accurate"}
knifeAimModeIndex = 1

function knifeAimGetKnife()
	local char = player.Character
	local tool = char and char:FindFirstChild("Knife")
	if tool then return tool end
	local bp = player:FindFirstChild("Backpack")
	return bp and bp:FindFirstChild("Knife")
end

function knifeAimGetRemote()
	local knife = knifeAimGetKnife()
	if not knife then return nil end
	local ev = knife:FindFirstChild("Events")
	return ev and ev:FindFirstChild("KnifeThrown")
end

-- Nearest alive Innocent/Sheriff/Hero with line of sight, nearest first.
-- cachedOnly=true: NEVER InvokeServer (for use inside __namecall, where any
-- yield corrupts the call and breaks game mechanics). Returns nil when no
-- cached roles exist — the original throw then goes through untouched.
function knifeAimFindTarget(cachedOnly)
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end
	local myPos = myRoot.Position
	local roleData = nil
	pcall(function() roleData = aimGetRoleData() end)
	if roleData == nil and not cachedOnly then
		pcall(function() roleData = invokePlayerData() end)
	end
	if roleData == nil and cachedOnly then
		if type(_roleDataCache) == "table" then roleData = _roleDataCache end
	end
	if roleData == nil then return nil end
	local cands = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				-- Dead-player exclusion: a dead cheater that teleported back
				-- onto the map can still report Health > 0, but the game
				-- flags the death via the "Alive" character attribute and the
				-- Killed/Dead flags in player data. Never target such players.
				-- (No yields here: safe inside __namecall.)
				local targetDead = false
				pcall(function()
					if plr.Character:GetAttribute("Alive") == false then targetDead = true end
				end)
				local okRole = true
				if roleData then
					local info = roleData[plr.Name]
					if info and (info.Killed or info.Dead) then targetDead = true end
					local role = info and info.Role
					if role ~= "Innocent" and role ~= "Sheriff" and role ~= "Hero" then
						okRole = false
					end
				end
				if not targetDead and okRole then
					local r = plr.Character:FindFirstChild("HumanoidRootPart")
					if r then
						table.insert(cands, {plr = plr, d = (myPos - r.Position).Magnitude})
					end
				end
			end
		end
	end
	table.sort(cands, function(a, b) return a.d < b.d end)
	local knifeMode = (knifeAimModes and knifeAimModes[knifeAimModeIndex]) or "Default"
	if knifeMode == "Default" then
		-- Nearest alive, walls ignored.
		return cands[1] and cands[1].plr or nil
	end
	-- Wall Check / Accurate: only players the knife can actually reach survive.
	local visible = {}
	for _, c in ipairs(cands) do
		local vis = false
		pcall(function() vis = aimHasLineOfSight(c.plr) end)
		if vis then visible[#visible + 1] = c end
	end
	if #visible == 0 then return nil end
	if knifeMode == "Accurate" then
		-- Accurate: the same wall check, but a player standing in front of the
		-- camera beats a closer player BEHIND it. Without this the knife flew
		-- backwards at the nearest body even while the player looked forward.
		local cam = workspace.CurrentCamera
		local look = cam and cam.CFrame.LookVector
		if look then
			local best, bestScore = nil, -math.huge
			for _, c in ipairs(visible) do
				local ch = c.plr.Character
				local r = ch and ch:FindFirstChild("HumanoidRootPart")
				if r then
					local to = r.Position - cam.CFrame.Position
					local dist = to.Magnitude
					if dist > 0.05 then
						local dot = look:Dot(to / dist)
						-- ~60 degrees either side of the crosshair counts as "in
						-- front"; distance only breaks near-ties.
						if dot > 0.5 then
							local score = dot * 2 - dist / 400
							if score > bestScore then
								bestScore = score
								best = c.plr
							end
						end
					end
				end
			end
			if best then return best end
		end
	end
	return visible[1].plr
end

-- Predicted impact point for a knife with flight time. Mirrors gun V3 minimax.
function knifeAimPredictPoint(char)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local aimPart = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or root)
	if not (aimPart and root) then return nil end
	local p = aimPart.Position
	pcall(aimRecordSample, char)
	local vel, acc, stab, hSpeed = aimEstimateMotion(char)
	local pingLead = 0.2
	pcall(function() pingLead = aimGetLeadTime() end)
	local myChar = player.Character
	-- The knife leaves the HAND, not the root; the root made the flight time
	-- (and with it the lead) slightly too short on long throws.
	local myPart = myChar and (myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm") or myChar:FindFirstChild("HumanoidRootPart"))
	local myPos = (myPart and myPart.Position) or p
	local knifeSpeed = KNIFE_AIM_SPEED or 100
	local dist = (myPos - p).Magnitude
	local tTotal = pingLead + dist / knifeSpeed
	if tTotal > 1.4 then tTotal = 1.4 end
	if tTotal < 0 then tTotal = 0 end
	local stopSpd = (AIM_CONFIG and AIM_CONFIG.stopSpeed) or 2.0
	if (hSpeed or 0) < stopSpd then
		-- Standing: exact torso, plus strafe-start nudge (replication lags a frame;
		-- with 0.3-0.5s knife flight even a fresh strafe needs half-lead).
		local fhx, fhz, fh = 0, 0, 0
		do
			local rec = _aimHist and _aimHist[char]
			local s = rec and rec.samples
			if s and #s >= 2 then
				local A2, B2 = s[#s - 1], s[#s]
				local dt2 = B2.t - A2.t
				if dt2 > 1e-4 then
					local d = (B2.p - A2.p) / dt2
					if d.Magnitude <= (AIM_CONFIG.teleportSpeed or 90) then
						fhx, fhz = d.X, d.Z
						fh = math.sqrt(d.X * d.X + d.Z * d.Z)
					end
				end
			end
		end
		if fh >= 3.5 and fh <= (AIM_CONFIG.seedSpeedMax or 40) then
			return Vector3.new(p.X + fhx * tTotal * 0.5, p.Y, p.Z + fhz * tTotal * 0.5)
		end
		return Vector3.new(p.X, p.Y, p.Z)
	end
	local leadScale = 0.55 + 0.45 * math.clamp(stab or 1, 0, 1)
	local uScale = (AIM_CONFIG and AIM_CONFIG.unstableLeadScale) or 0.5
	if (stab or 1) < 0.5 then leadScale = uScale + (leadScale - uScale) * ((stab or 0) / 0.5) end
	local teff = tTotal * leadScale
	-- The knife flies for 0.3-1 s (distance / KNIFE_AIM_SPEED), far longer than
	-- a bullet's ping lead, so a strafe that starts or stops inside that window
	-- actually matters: keep a knife-only acceleration term (the gun config
	-- disables it) and never predict past the target's stopping point.
	local maxF = 0.32
	local linX, linZ = vel.X * teff, vel.Z * teff
	local cX, cZ = 0.5 * acc.X * teff * teff, 0.5 * acc.Z * teff * teff
	if math.abs(linX) > 1e-4 then cX = math.clamp(cX, -math.abs(linX) * maxF, math.abs(linX) * maxF)
	else cX = math.clamp(cX, -1.5, 1.5) end
	if math.abs(linZ) > 1e-4 then cZ = math.clamp(cZ, -math.abs(linZ) * maxF, math.abs(linZ) * maxF)
	else cZ = math.clamp(cZ, -1.5, 1.5) end
	local vmag = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
	local amag = math.sqrt(acc.X * acc.X + acc.Z * acc.Z)
	if (vel.X * acc.X + vel.Z * acc.Z) < 0 and amag > 1e-3 then
		local tStop = vmag / amag
		if teff > tStop then
			local k = tStop / teff
			linX, linZ = linX * k, linZ * k
			cX, cZ = cX * k * k, cZ * k * k
		end
	end
	-- Vertical lead for airborne targets: the old point always used the CURRENT
	-- height, so jumping / falling players were consistently thrown under.
	local py = p.Y
	if aimAirborneNow(char, vel) then
		local freshV = aimFreshVelocity(char)
		local vy = aimAirVy(vel, freshV)
		py = p.Y + math.clamp(vy * teff * 0.55, -3.2, 3.2)
	end
	return Vector3.new(p.X + linX + cX, py, p.Z + linZ + cZ)
end

function knifeAimBuildArgs(target)
	if not (target and target.Character) then return nil end
	local pt = knifeAimPredictPoint(target.Character)
	if not pt then return nil end
	local myChar = player.Character
	local hand = myChar and (myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm"))
	local knife = knifeAimGetKnife()
	local handle = knife and knife:FindFirstChild("Handle")
	local originPos = nil
	if handle then originPos = handle.Position
	elseif hand and hand:IsA("BasePart") then originPos = hand.Position
	else
		local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		originPos = hrp and (hrp.Position + Vector3.new(0, 2, 0)) or pt
	end
	local c1 = nil
	pcall(function()
		if (pt - originPos).Magnitude > 0.5 then
			c1 = CFrame.new(originPos, pt)
		else
			c1 = CFrame.new(originPos)
		end
	end)
	if not c1 then return nil end
	return c1, CFrame.new(pt)
end

-- (No manual throw button by design: silent aim only redirects the normal RMB
-- throw while the knife is held. Firing the remote directly with a wrong arg
-- shape broke KnifeClient, so that path was removed.)

-- (Knife Piercer removed entirely.)
-- WeaponService method hook (NO __namecall): the stock KnifeClient builds its
-- throw as Events.KnifeThrown:FireServer(Handle.CFrame, u1) where
-- u1 = WeaponService:GetMouseTargetCFrame() (PC). Overriding that ONE method on
-- the shared module table redirects only the TARGET while origin, animations,
-- sounds and cooldowns stay stock, so the throw can never break. No visible
-- target => the original value is returned (vanilla throw).
function knifeAimGetWeaponService()
	local tbl = nil
	pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		local cs = rs and rs:FindFirstChild("ClientServices")
		local mod = cs and cs:FindFirstChild("WeaponService")
		if mod then tbl = require(mod) end
	end)
	if type(tbl) == "table" then return tbl end
	return nil
end

function knifeAimAimedTargetCF()
	-- Cache-only roles: instant, never yields (runs on the client thread).
	local tgt = nil
	pcall(function() tgt = knifeAimFindTarget(true) end)
	if tgt == nil then return nil end
	local pt = nil
	pcall(function()
		local ch = tgt.Character
		if ch then pt = knifeAimPredictPoint(ch) end
	end)
	if pt == nil then return nil end
	return CFrame.new(pt)
end

function knifeAimEnsureWeaponHook()
	if knifeAimWeaponHooked then return true end
	local WS = knifeAimGetWeaponService()
	if WS == nil then
		-- Module not replicated yet: retry in background; the toggle stays ON
		-- and starts working once WeaponService loads.
		task.spawn(function()
			task.wait(2)
			if knifeAimEnabled and not knifeAimWeaponHooked then
				pcall(knifeAimEnsureWeaponHook)
			end
		end)
		return false
	end
	if type(WS.GetMouseTargetCFrame) ~= "function" then return false end
	knifeAimWeaponOrig = WS.GetMouseTargetCFrame
	WS.GetMouseTargetCFrame = function(self, ...)
		if knifeAimEnabled then
			local cf = knifeAimAimedTargetCF()
			if cf ~= nil then return cf end
		end
		return knifeAimWeaponOrig(self, ...)
	end
	if WS.GetMouseTargetCFrame == knifeAimWeaponOrig then
		knifeAimWeaponOrig = nil
		return false
	end
	if type(WS.GetTargetPosition) == "function" then
		knifeAimWeaponOrigTP = WS.GetTargetPosition
		WS.GetTargetPosition = function(self, ...)
			if knifeAimEnabled then
				local cf = knifeAimAimedTargetCF()
				if cf ~= nil then return cf end
			end
			return knifeAimWeaponOrigTP(self, ...)
		end
	end
	knifeAimWeaponHooked = true
	return true
end

-- Gun silent intercept (NO __namecall): the stock GunClient fires as
-- Parent.Shoot:FireServer(attachmentCF, u1) where u1 comes from the SAME
-- WeaponService table (GetMouseTargetCFrame on PC LMB, GetTargetPosition on
-- touch). This wrapper chains around whatever is currently installed (e.g. the
-- knife wrapper above): each layer checks only its own flag, so install order
-- does not matter. Origin stays stock (HRP attachment); only the target is
-- replaced with the full V3 point prediction. No visible extra shot, no race
-- with the client's own FireServer — there is exactly ONE shot per click.
gunAimWeaponHooked = false
gunAimWeaponOrig = nil
gunAimWeaponOrigTP = nil

function gunAimSilentTargetCF()
	local m = nil
	pcall(function() m = aimFindMurderer() end)
	if m == nil or m == player then return nil end
	local alive = false
	pcall(function() alive = aimMurdererAlive(m) end)
	if not alive then return nil end
	local pt = nil
	pcall(function()
		if m.Character then pt = aimPredictTorso(m.Character, 1) end
	end)
	if pt == nil then return nil end
	return CFrame.new(pt)
end

-- Intercept + Piercer Bullet: the stock shot's origin is fixed by the client
-- (HRP attachment) and dies on walls, so a piercer needs OUR origin. When the
-- piercer toggle is on, fire the full piercer shot FIRST from inside the hook:
-- same-frame FIFO means ours is processed first and starts the reload, the
-- stock shot behind it is ignored. Without piercer, only the silent aim below.
function gunAimInterceptPiercer()
	if not aimWallbangEnabled then return end
	local m = nil
	pcall(function() m = aimFindMurderer() end)
	if m == nil or m == player then return end
	local alive = false
	pcall(function() alive = aimMurdererAlive(m) end)
	if alive then pcall(aimFireGunAtOriginal, m, AIM_CONFIG.autoShotBurst) end
end

function gunAimEnsureWeaponHook()
	if gunAimWeaponHooked then return true end
	local WS = knifeAimGetWeaponService()
	if WS == nil then
		task.spawn(function()
			task.wait(2)
			if aimLmbShootEnabled and not gunAimWeaponHooked then
				pcall(gunAimEnsureWeaponHook)
			end
		end)
		return false
	end
	if type(WS.GetMouseTargetCFrame) ~= "function" then return false end
	gunAimWeaponOrig = WS.GetMouseTargetCFrame
	WS.GetMouseTargetCFrame = function(self, ...)
		if aimLmbShootEnabled and lmbShootAimMode() == "Intercept" then
			pcall(gunAimInterceptPiercer)
			local cf = gunAimSilentTargetCF()
			if cf ~= nil then return cf end
		end
		return gunAimWeaponOrig(self, ...)
	end
	if WS.GetMouseTargetCFrame == gunAimWeaponOrig then
		gunAimWeaponOrig = nil
		return false
	end
	if type(WS.GetTargetPosition) == "function" then
		gunAimWeaponOrigTP = WS.GetTargetPosition
		WS.GetTargetPosition = function(self, ...)
			if aimLmbShootEnabled and lmbShootAimMode() == "Intercept" then
				pcall(gunAimInterceptPiercer)
				local cf = gunAimSilentTargetCF()
				if cf ~= nil then return cf end
			end
			return gunAimWeaponOrigTP(self, ...)
		end
	end
	gunAimWeaponHooked = true
	return true
end


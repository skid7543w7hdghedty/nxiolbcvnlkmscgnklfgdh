-- Anti-Fling (IY-style): every frame, disable collision on every part of every
-- other player's character so they cannot physically collide with / fling us.
-- Mirrors Infinite Yield's "antifling" command exactly.
function antiFlingEnable()
	for _, v in pairs(game.Players:GetPlayers()) do
		if v ~= player and v.Character then
			for _, part in pairs(v.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
end

function toggleAntiFling()
	antiFlingEnabled = not antiFlingEnabled
	if antiFlingEnabled then
		antiFlingConnection = RunService.Stepped:Connect(antiFlingEnable)
	else
		if antiFlingConnection then
			antiFlingConnection:Disconnect()
			antiFlingConnection = nil
		end
		for i,v in pairs(reachCachePlayers) do
			if v ~= player and v.Character then
				for h,b in pairs(v.Character:GetChildren()) do
					if b:IsA("BasePart") then
						b.CanCollide = true
					end
				end
			end
		end
	end
end


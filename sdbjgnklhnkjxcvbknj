-- ============================================
-- Loading Screen
-- ============================================
function playLoadingScreen()
	-- The splash plays BEFORE the config-apply step at the very end of the
	-- script, so read the saved style/duration straight from the raw config.
	if loadedConfig and loadedConfig.values then
		loadingAnimStyle = tonumber(loadedConfig.values.loadingAnimStyle) or loadingAnimStyle
		loadingScreenTime = tonumber(loadedConfig.values.loadingScreenTime) or loadingScreenTime
		loadingBlurSize = math.clamp(tonumber(loadedConfig.values.loadingBlurSize) or loadingBlurSize or 50, 0, 50)
	end
	if loadedConfig and loadedConfig.toggles and loadedConfig.toggles.skipLoadingScreenEnabled then
		skipLoadingScreenEnabled = true
	end
	if loadedConfig and loadedConfig.toggles and loadedConfig.toggles.loadingProgressBarEnabled ~= nil then
		loadingProgressBarEnabled = loadedConfig.toggles.loadingProgressBarEnabled and true or false
	end
	if loadedConfig and loadedConfig.toggles and loadedConfig.toggles.loadingPercentEnabled ~= nil then
		loadingPercentEnabled = loadedConfig.toggles.loadingPercentEnabled and true or false
	end
	if loadedConfig and loadedConfig.values then
		local cv = loadedConfig.values
		if cv.loadingBarWidth ~= nil then loadingBarWidth = math.clamp(tonumber(cv.loadingBarWidth) or loadingBarWidth, 40, 2000) end
		if cv.loadingBarHeight ~= nil then loadingBarHeight = math.clamp(tonumber(cv.loadingBarHeight) or loadingBarHeight, 2, 80) end
		if cv.loadingBarPosX ~= nil then loadingBarPosX = math.floor(tonumber(cv.loadingBarPosX) or loadingBarPosX) end
		if cv.loadingBarPosY ~= nil then loadingBarPosY = math.floor(tonumber(cv.loadingBarPosY) or loadingBarPosY) end
		if cv.loadingPctTextSize ~= nil then loadingPctTextSize = math.clamp(tonumber(cv.loadingPctTextSize) or loadingPctTextSize, 8, 72) end
		if cv.loadingPctPosX ~= nil then loadingPctPosX = math.floor(tonumber(cv.loadingPctPosX) or loadingPctPosX) end
		if cv.loadingPctPosY ~= nil then loadingPctPosY = math.floor(tonumber(cv.loadingPctPosY) or loadingPctPosY) end
	end
	-- Instant Load: skip the whole splash so the script is usable immediately
	if skipLoadingScreenEnabled then return end
	-- Editable splash duration (ported from mobile): hold = total - intro/outro
	local LOADING_DURATION = math.max(0.05, (tonumber(loadingScreenTime) or 2.4) - 0.9)
	local style = loadingAnimStyles[loadingAnimStyle] or "Letter by Letter"

	local blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = game:GetService("Lighting")

	local loaderGui = Instance.new("ScreenGui")
	loaderGui.Name = "AdrenalinLoader"
	loaderGui.IgnoreGuiInset = true
	loaderGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
	loaderGui.DisplayOrder = 999999
	loaderGui.Parent = playerGui

	local blackFrame = Instance.new("Frame")
	blackFrame.Size = UDim2.new(1, 0, 1, 0)
	blackFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	blackFrame.BackgroundTransparency = 1
	blackFrame.BorderSizePixel = 0
	blackFrame.Parent = loaderGui

	local textsFrame = Instance.new("Frame")
	textsFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	textsFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	textsFrame.Size = UDim2.new(1, 0, 0, 200)
	textsFrame.BackgroundTransparency = 1
	textsFrame.Parent = loaderGui

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, -1)
	layout.Parent = textsFrame

	-- Animate blur in
	TweenService:Create(blur, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = math.clamp(tonumber(loadingBlurSize) or 50, 0, 50)}):Play()
	TweenService:Create(blackFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.6}):Play()
	task.wait(0.3)

	-- Optional progress bar under the title (Settings -> Others)
	local progressBg, progressFill, progressPercentLabel = nil, nil, nil
	if loadingProgressBarEnabled ~= false then
		progressBg = Instance.new("Frame")
		progressBg.AnchorPoint = Vector2.new(0.5, 0)
		progressBg.Position = UDim2.new(0.5, tonumber(loadingBarPosX) or 0, 0.5, tonumber(loadingBarPosY) or 75)
		progressBg.Size = UDim2.new(0, math.clamp(tonumber(loadingBarWidth) or 300, 40, 2000), 0, math.clamp(tonumber(loadingBarHeight) or 6, 2, 80))
		progressBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		progressBg.BorderSizePixel = 0
		progressBg.Parent = loaderGui
		Instance.new("UICorner", progressBg).CornerRadius = UDim.new(1, 0)
		progressFill = Instance.new("Frame")
		progressFill.Size = UDim2.new(0, 0, 1, 0)
		progressFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		progressFill.BorderSizePixel = 0
		progressFill.Parent = progressBg
		Instance.new("UICorner", progressFill).CornerRadius = UDim.new(1, 0)
	end
	-- Optional percentage readout (independent toggle). Sits directly under the
	-- bar when it is shown, or in the bar's place when only the percent is on.
	if loadingPercentEnabled ~= false then
		progressPercentLabel = Instance.new("TextLabel")
		progressPercentLabel.AnchorPoint = Vector2.new(0.5, 0)
		progressPercentLabel.Position = UDim2.new(0.5, tonumber(loadingPctPosX) or 0, 0.5, tonumber(loadingPctPosY) or 85)
		progressPercentLabel.Size = UDim2.new(0, 300, 0, 18)
		progressPercentLabel.BackgroundTransparency = 1
		progressPercentLabel.Text = "0%"
		progressPercentLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		progressPercentLabel.TextTransparency = 0.15
		progressPercentLabel.Font = Enum.Font.GothamBold
		progressPercentLabel.TextSize = math.clamp(tonumber(loadingPctTextSize) or 14, 8, 72)
		progressPercentLabel.Parent = loaderGui
	end

	local loadText = "Adrenalin.win"
	local textObjs = {}

	if style == "Letter by Letter" then
		for i = 1, #loadText do
			local char = loadText:sub(i, i)
			local letterFrame = Instance.new("Frame")
			letterFrame.Size = UDim2.new(0, 35, 0, 100)
			letterFrame.BackgroundTransparency = 1
			letterFrame.LayoutOrder = i
			letterFrame.Parent = textsFrame

			local letterLabel = Instance.new("TextLabel")
			letterLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			letterLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
			letterLabel.Size = UDim2.new(0, 30, 0, 60)
			letterLabel.BackgroundTransparency = 1
			letterLabel.Text = char
			letterLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			letterLabel.Font = Enum.Font.GothamBold
			letterLabel.TextSize = 40
			letterLabel.TextTransparency = 1
			letterLabel.Parent = letterFrame

			table.insert(textObjs, letterLabel)
		end

		for i, lbl in ipairs(textObjs) do
			TweenService:Create(lbl, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
			task.wait(0.06)
		end

	elseif style == "Fade In" then
		local fullLabel = Instance.new("TextLabel")
		fullLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		fullLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
		fullLabel.Size = UDim2.new(0, 500, 0, 80)
		fullLabel.BackgroundTransparency = 1
		fullLabel.Text = loadText
		fullLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		fullLabel.Font = Enum.Font.GothamBold
		fullLabel.TextSize = 48
		fullLabel.TextTransparency = 1
		fullLabel.Parent = textsFrame

		TweenService:Create(fullLabel, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

	elseif style == "Scale Up" then
		local fullLabel = Instance.new("TextLabel")
		fullLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		fullLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
		fullLabel.Size = UDim2.new(0, 500, 0, 80)
		fullLabel.BackgroundTransparency = 1
		fullLabel.Text = loadText
		fullLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		fullLabel.Font = Enum.Font.GothamBold
		fullLabel.TextSize = 10
		fullLabel.TextTransparency = 0
		fullLabel.Parent = textsFrame

		TweenService:Create(fullLabel, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextSize = 48}):Play()

	elseif style == "Slide Up" then
		local fullLabel = Instance.new("TextLabel")
		fullLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		fullLabel.Position = UDim2.new(0.5, 0, 0.5, 100)
		fullLabel.Size = UDim2.new(0, 500, 0, 80)
		fullLabel.BackgroundTransparency = 1
		fullLabel.Text = loadText
		fullLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		fullLabel.Font = Enum.Font.GothamBold
		fullLabel.TextSize = 48
		fullLabel.TextTransparency = 0
		fullLabel.Parent = textsFrame

		TweenService:Create(fullLabel, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
	end

	if progressFill then
		TweenService:Create(progressFill, TweenInfo.new(LOADING_DURATION, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 1, 0)}):Play()
	end

	if progressPercentLabel then
		-- Track the same timeline as the bar fill and show a live percentage.
		local startedAt = os.clock()
		while true do
			local elapsed = os.clock() - startedAt
			local frac = math.clamp(elapsed / LOADING_DURATION, 0, 1)
			progressPercentLabel.Text = string.format("%d%%", math.floor(frac * 100 + 0.5))
			if frac >= 1 then break end
			task.wait(0.03)
		end
		progressPercentLabel.Text = "100%"
	else
		task.wait(LOADING_DURATION)
	end

	-- Fade out everything
	TweenService:Create(blur, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = 0}):Play()
	TweenService:Create(blackFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
	if progressBg then TweenService:Create(progressBg, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play() end
	if progressFill then TweenService:Create(progressFill, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play() end
	if progressPercentLabel then TweenService:Create(progressPercentLabel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play() end

	for _, lbl in ipairs(textObjs) do
		TweenService:Create(lbl, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
	end

	-- Fade out non-letter-by-letter labels too
	for _, child in ipairs(textsFrame:GetDescendants()) do
		if child:IsA("TextLabel") then
			TweenService:Create(child, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
		end
	end

	task.wait(0.5)

	loaderGui:Destroy()
	blur:Destroy()
end

-- [perf] The splash used to BLOCK the whole script: first it consumed its full
-- duration, then the giant UI build froze the game on top of that, so the menu
-- only appeared seconds later. Now the splash plays while the rest of the
-- script builds the menu underneath, and the menu itself is REVEALED at the
-- splash gate inside initToggleAndMainGUI: with the splash ON the menu becomes
-- visible/usable only after the splash finishes (classic behavior), with
-- Instant Load it is revealed instantly. Zero extra freeze either way.
_loadingSplashDone = false
task.spawn(function()
	pcall(playLoadingScreen)
	_loadingSplashDone = true
end)


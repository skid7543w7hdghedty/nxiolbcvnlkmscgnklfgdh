	-- GLITCH NOTIFY (same design as Vote Notification): watches the round ->
	-- roles-cleared transition and fires 35s later — the best window to press
	-- Glitch Server. Needs one full observed round cycle to arm.
	glitchNotificationEnabled = false
	local _prevGlitchNotifyCat = currentCategory
	currentCategory = "Glitch"
	glitchNotificationBtn = createButton("GlitchNotifyButton", "Glitch Notification: OFF", 346)
	glitchNotificationBtn.MouseButton1Click:Connect(function()
		glitchNotificationEnabled = not glitchNotificationEnabled
		setToggleState(glitchNotificationBtn, glitchNotificationEnabled, "Glitch Notification: ON", "Glitch Notification: OFF")
		saveConfig()
	end)
	currentCategory = _prevGlitchNotifyCat
	task.spawn(function()
		local wasRoundActive = false
		local clearSince = nil
		task.wait(3)
		while true do
			task.wait(1)
			if not glitchNotificationEnabled then continue end
			local roundActive = false
			pcall(function()
				local r = getPlayerDataRemote()
				if r then
					local result = invokePlayerData()
					if result then
						for name, data in pairs(result) do
							if data.Role == "Murderer" or data.Role == "Sheriff" then
								roundActive = true
								break
							end
						end
					end
				end
			end)
			if wasRoundActive and not roundActive and not clearSince then
				clearSince = os.clock()
			end
			if roundActive then
				clearSince = nil
			end
			if clearSince and (os.clock() - clearSince) >= 35 then
				gameNotifSend(
					"Glitch Window",
					"Press Glitch Server now!",
					Color3.fromRGB(255, 255, 255),
					Color3.fromRGB(255, 255, 255)
				)
				playSoundFile(voteStartSoundPath)
				clearSince = nil
			end
			wasRoundActive = roundActive
		end
	end)
end


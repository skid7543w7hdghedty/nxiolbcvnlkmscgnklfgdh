function voteMapStatusText(snap, S)
	local line1
	if #snap == 0 then
		line1 = "Vote: pads empty - waiting"
	elseif S.open then
		local bySlot, parts = {}, {}
		for _, m in ipairs(snap) do bySlot[m.slot or m.index] = m end
		for slot = 1, 3 do
			local m = bySlot[slot]
			if m then parts[#parts + 1] = voteMapLabel(m.name) .. " " .. m.votes end
		end
		line1 = "Vote: OPEN  " .. table.concat(parts, " | ")
	else
		line1 = "Vote: waiting for next vote"
	end
	-- Only an ACTIVE Auto Vote explains itself here; the old "Auto: OFF" line
	-- was permanent noise in the tab.
	if not voteMapAutoEnabled then
		return line1
	end
	local auto = "Auto: ON"
	if S.votedName then
		auto = auto .. " -> " .. voteMapLabel(S.votedName)
	elseif S.open then
		auto = auto .. " (no priority map up)"
	end
	return line1 .. "\n" .. auto
end

-- Fired the moment the pads switch to the next three maps, which is exactly
-- when the server opens voting. This replaces the old detector that polled
-- GetPlayerData: that remote returns an empty table on this game, so the
-- notification could never fire.
function voteMapAnnounceOpen(snap)
	local names, bySlot = {}, {}
	for _, m in ipairs(snap) do bySlot[m.slot or m.index] = m end
	for slot = 1, 3 do
		local m = bySlot[slot]
		if m then names[#names + 1] = voteMapLabel(m.name) end
	end
	local line = table.concat(names, "  |  ")
	-- The panel is the notification; this only adds the optional toast + sound.
	if notifyOnVoteStart then
		pcall(function()
			gameNotifSend("Vote Started", line,
				Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))
		end)
		pcall(function()
			if voteStartSoundPath and voteStartSoundPath ~= "" then
				playSoundFile(voteStartSoundPath)
			end
		end)
	end
end

-- Vote for the best available map right now (used by the Auto Vote toggle and
-- by the watcher when a new window opens).
function voteMapAutoVoteNow()
	if not voteMapAutoEnabled then return end
	if voteDupeActive then return end
	local snap = voteMapSnapshot()
	if #snap < 3 then return end
	if voteMapRoundName(snap) then return end
	local best = voteMapBest(snap)
	if not best then
		notify("Auto Vote", "None of your priority maps is up for vote.", 3)
		return
	end
	-- The pads are rebuilt a frame or two before the server accepts votes.
	task.wait(0.5)
	if not voteMapAutoEnabled then return end
	best = nil
	snap = voteMapSnapshot()
	if #snap < 3 or voteMapRoundName(snap) then return end
	best = voteMapBest(snap)
	if not best then return end
	voteMapState.votedName = best.name
	notify("Auto Vote", "Voting for " .. voteMapLabel(best.name) .. ".", 3)
	voteDupeStart(best.index, true)
end

function voteMapWatchStart()
	if voteMapWatching then return end
	voteMapWatching = true
	task.spawn(function()
		task.wait(2)
		local S = voteMapState
		local lastErr = nil
		local notifHideAt = nil
		while true do
			task.wait(0.4)
			local ok, err = pcall(function()
				local snap = voteMapSnapshot()
				local sig = voteMapSignature(snap)
				local roundName = voteMapRoundName(snap)
				if sig ~= S.sig then
					S.sig = sig
					S.votedName = nil
					S.openedAt = os.clock()
					S.open = (#snap == 3) and roundName == nil
					if S.open then
						-- Sound / extra toast only when the toggle is on; the vote
						-- panel itself always appears, it is the vote UI.
						voteMapAnnounceOpen(snap)
						if sig ~= voteNotifDismissedSig then
							voteMapNotifShow(snap)
						end
						if voteMapAutoEnabled and not voteDupeActive then
							task.spawn(voteMapAutoVoteNow)
						end
					end
				end
				if S.open and (roundName ~= nil or (os.clock() - S.openedAt) > 90) then
					S.open = false
					-- Dismissal only covers the vote it was made in.
					voteNotifDismissedSig = nil
				end
				if S.open then
					notifHideAt = nil
				elseif voteMapNotifOpen and not voteMapNotifPreviewing then
					-- Linger ~2.5 s so the final vote count is readable, then go.
					if not notifHideAt then notifHideAt = os.clock() + 2.5 end
					if os.clock() >= notifHideAt then
						notifHideAt = nil
						-- A dismissal only covers the vote it was made in.
						voteNotifDismissedSig = nil
						voteMapNotifHide()
					end
				end
				if roundName then S.lastRound = roundName end
				if voteMapStatusLabel and voteMapStatusLabel.Parent then
					voteMapStatusLabel.Text = voteMapStatusText(snap, S)
				end
				if not voteMapNotifPreviewing and voteMapNotifOpen then
					voteMapNotifRefresh(snap)
				end
			end)
			if not ok and err ~= lastErr then
				lastErr = err
				warn("[VoteMap] " .. tostring(err))
			end
		end
	end)
end

-- ============================================
-- Map Vote notification panel (this IS the vote UI)
-- ============================================
-- The panel replaces both the old "Vote Started" toast and the standalone map
-- menu: it pops up in the same instant the three pads switch to the next maps,
-- shows one tile per map on the pads (icon, name and live vote count) and
-- clicking a tile starts Vote Dupe on that map's own pad. It hides itself once
-- the winning map is loaded. Position and size are % of the screen and are
-- edited in the Settings tab.
voteMapNotifTiles = {}
voteMapIconIds = voteMapIconIds or {}
voteMapNotifOpen = false
voteMapNotifHideToken = 0
-- Optimistic vote counters. The game's own "Votes: N" label lags by a second or
-- more (worst right after a death/respawn), so the panel adds the casts the dupe
-- made but the server has not echoed yet. Each bump is PENDING for a short
-- while: if the pad never counts it (rejected / lag spike), the pending value
-- expires and the panel drops back to the game's own number, so it can never
-- display a vote that does not exist.
voteMapNotifLocal = {}
voteMapNotifPendingTTL = 1.6

-- Monochrome palette by request: near-black card, white text, two text greys.
-- "Accent" is plain white now (it used to be mint green).
-- The panel is monochrome by request: no mint accent, just white on black.
voteMapPanelAccent = Color3.fromRGB(255, 255, 255)
voteMapPanelText = Color3.fromRGB(238, 240, 244)
voteMapPanelMuted = Color3.fromRGB(146, 150, 158)
voteMapPanelBg = Color3.fromRGB(0, 0, 0)
voteMapPanelTileBg = Color3.fromRGB(23, 25, 29)

-- Displayed count for a pad: the pad's own "Votes" number plus the casts that
-- are still waiting to be counted. Pending casts are consumed as the pad's
-- number catches up and expire on their own, so a rejected vote never sticks.
function voteMapNotifVotesFor(index, padVotes, name)
	padVotes = padVotes or 0
	local st = voteMapNotifLocal[index]
	if not st then return padVotes end
	if name and st.name ~= "" and voteMapNorm(st.name) ~= voteMapNorm(name) then
		return padVotes
	end
	local now = os.clock()
	if (st.pending or 0) > 0 and now > (st.due or 0) then
		st.pending = 0
	end
	local last = st.lastPad or 0
	if padVotes > last then
		-- The server caught up: those casts are no longer pending.
		st.pending = math.max(0, (st.pending or 0) - (padVotes - last))
		st.lastPad = padVotes
	elseif padVotes < last then
		-- Counter went backwards (new set of maps): follow the game.
		st.lastPad = padVotes
		st.pending = 0
	end
	return (st.lastPad or padVotes) + (st.pending or 0)
end

-- Called right after the dupe lands on the pad: one more vote is on its way to
-- the server. It is shown immediately and marked pending for
-- voteMapNotifPendingTTL, so it disappears again if the server never counts it.
function voteMapNotifBump(index, name)
	if not index then return end
	local st = voteMapNotifLocal[index]
	if not st or (name and voteMapNorm(st.name) ~= voteMapNorm(name)) then
		local base, padName = 0, name
		for _, m in ipairs(voteMapSnapshot()) do
			if m.index == index then base, padName = m.votes, m.name end
		end
		st = { name = padName or name or "", lastPad = base, pending = 0, due = 0 }
		voteMapNotifLocal[index] = st
	end
	st.pending = (st.pending or 0) + 1
	st.due = os.clock() + (voteMapNotifPendingTTL or 1.6)
	if voteMapNotifGui and voteMapNotifGui.Parent and voteMapNotifOpen and not voteMapNotifPreviewing then
		voteMapNotifRefresh()
	end
end

-- Panel position/size from the Settings values. The chrome (header, tiles, pill
-- and label sizes) scales with the panel so the same defaults stay readable on
-- a laptop screen and on 4K.
function voteMapNotifApplyLayout()
	local f = voteMapNotifFrame
	if not f then return end
	f.Position = UDim2.new(voteNotifPosXScale or 0.5, 0, voteNotifPosYScale or 0.2, 0)
	f.Size = UDim2.new(voteNotifSizeXScale or 0.3, 0, voteNotifSizeYScale or 0.2, 0)
	f.BackgroundTransparency = voteNotifBgTransparency or 0
	local cam = workspace.CurrentCamera
	local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local pxH = vs.Y * (voteNotifSizeYScale or 0.2)
	local pxW = vs.X * (voteNotifSizeXScale or 0.3)
	local pad = math.clamp(math.floor(pxH * 0.05), 5, 14)
	local headerH = math.clamp(math.floor(pxH * 0.18), 22, 44)
	voteMapNotifPadPx = pad

	if voteMapNotifHeader then
		voteMapNotifHeader.Size = UDim2.new(1, 0, 0, headerH)
	end
	if voteMapNotifDot then
		local d = math.clamp(math.floor(headerH * 0.24), 4, 8)
		voteMapNotifDot.Size = UDim2.new(0, d, 0, d)
		voteMapNotifDot.Position = UDim2.new(0, pad, 0.5, -math.floor(d / 2))
	end
	if voteMapNotifTitle then
		voteMapNotifTitle.Position = UDim2.new(0, pad + 12, 0, 0)
		voteMapNotifTitle.Size = UDim2.new(0.42, -pad - 16, 1, 0)
		voteMapNotifTitle.TextSize = math.clamp(math.floor(headerH * 0.46), 9, 17)
	end
	if voteMapNotifClose then
		local btn = math.clamp(math.floor(headerH * 0.60), 14, 26)
		voteMapNotifClose.Size = UDim2.new(0, btn, 0, btn)
		voteMapNotifClose.Position = UDim2.new(1, -(btn + math.max(4, math.floor(pad * 0.5))), 0.5, -math.floor(btn / 2))
		voteMapNotifClose.TextSize = math.clamp(math.floor(btn * 0.66), 9, 18)
	end
	if voteMapNotifStatus then
		voteMapNotifStatus.Position = UDim2.new(0.42, 0, 0, 0)
		voteMapNotifStatus.Size = UDim2.new(0.58, -(math.clamp(math.floor(headerH * 0.60), 14, 26) + pad * 2), 1, 0)
		voteMapNotifStatus.TextSize = math.clamp(math.floor(headerH * 0.34), 8, 13)
	end
	if voteMapNotifBody then
		voteMapNotifBody.Position = UDim2.new(0, pad, 0, headerH + math.floor(pad * 0.4))
		voteMapNotifBody.Size = UDim2.new(1, -(pad * 2), 1, -(headerH + math.floor(pad * 0.4) + pad))
	end

	-- Tile typography follows the tile size, not the panel height, so it reads
	-- well in both the 3-across default and a tall/narrow panel.
	local tileW = (pxW - pad * 2 - 12) / 3
	local tileH = pxH - (headerH + pad + math.floor(pad * 0.4))
	local nameSize = math.clamp(math.floor(math.min(tileH * 0.17, tileW * 0.16)), 10, 22)
	local pillSize = math.clamp(math.floor(nameSize * 0.92), 9, 20)
	for i = 1, 3 do
		local tile = voteMapNotifTiles[i]
		if tile then
			-- Full-bleed art in PIXELS: the tile's own size is known here, so the
			-- picture is sized from it (not from the panel height) with a fixed
			-- 1.35x overscan and centered. Both axes follow the panel, so the art
			-- shrinks with the card instead of hanging over its edges.
			local artScale = 1.35
			local artW = math.max(8, math.ceil(tileW * artScale))
			local artH = math.max(8, math.ceil(tileH * artScale))
			tile.img.Size = UDim2.fromOffset(artW, artH)
			tile.img.Position = UDim2.new(0.5, 0, 0.5, 0)
			-- The clip is scale-sized, so it follows the card on its own; it is
			-- kept in this entry because instances cannot hold custom fields.
			if tile.clip then
				tile.clip.Size = UDim2.new(1, 0, 1, 0)
			end
			tile.name.TextSize = nameSize
			tile.name.Size = UDim2.new(0, 0, 0, math.ceil(nameSize * 1.30))
			tile.name.Position = UDim2.new(0, 7, 1, -math.max(4, math.floor(nameSize * 0.40)))
			tile.name.UIPadding.PaddingLeft = UDim.new(0, math.max(4, math.floor(nameSize * 0.38)))
			tile.name.UIPadding.PaddingRight = UDim.new(0, math.max(4, math.floor(nameSize * 0.38)))
			tile.votes.TextSize = pillSize
			tile.votes.UIPadding.PaddingLeft = UDim.new(0, math.max(4, math.floor(pillSize * 0.55)))
			tile.votes.UIPadding.PaddingRight = UDim.new(0, math.max(4, math.floor(pillSize * 0.55)))
			tile.votes.UIPadding.PaddingTop = UDim.new(0, math.max(1, math.floor(pillSize * 0.20)))
			tile.votes.UIPadding.PaddingBottom = UDim.new(0, math.max(1, math.floor(pillSize * 0.20)))
			tile.dot.Size = UDim2.new(0, math.max(4, math.floor(nameSize * 0.42)), 0, math.max(4, math.floor(nameSize * 0.42)))
			tile.mono.TextSize = math.clamp(math.floor(tileH * 0.30), 14, 96)
		end
	end
end


-- exactly as the server names the model ("Mil Base" on the pad = "MilBase").
ESP_MAP_NAMES = {
	"MilBase", "Factory", "House2", "Workplace", "BioLab", "ResearchFacility",
	"Mansion2", "Hospital3", "Bank2", "PoliceStation", "Office3", "Hotel"
}

-- Every "which maps count as a map" table in the script (AutoGrab, Gun Aura,
-- Auto Remove Coins, Auto Delete Corpses) is built from this one list, so a new
-- or removed map only has to be edited in one place.
function mapNameSet(names)
	local t = {}
	for _, n in ipairs(names or ESP_MAP_NAMES) do
		t[n] = true
	end
	return t
end

function espGetRoleColor(plr)
	if not plr then return ESP_DEFAULT_COLOR end
	if not espRoles then return ESP_DEFAULT_COLOR end
	if not espIsAlive(plr) then return ESP_DEAD_COLOR end
	local data = espRoles[plr.Name]
	if not data then return ESP_DEFAULT_COLOR end
	if data.Role == "Murderer" then return ESP_MURDERER_COLOR
	elseif data.Role == "Sheriff" then return ESP_SHERIFF_COLOR
	elseif espIsHero(plr) then return ESP_HERO_COLOR
	else return ESP_DEFAULT_COLOR end
end

function espIsHero(plr)
	if not plr then return false end
	if not espRoles then return false end
	local data = espRoles[plr.Name]
	if not data then return false end
	if data.Role == "Murderer" then return false end
	if data.Role == "Sheriff" then return false end
	local sheriffName = nil
	for name, v in pairs(espRoles) do
		if v.Role == "Sheriff" then sheriffName = name; break end
	end
	if sheriffName then
		local sheriffPlr = Players:FindFirstChild(sheriffName)
		if sheriffPlr and espIsAlive(sheriffPlr) then return false end
	end
	if plr.Name == espCurrentHero then return true end
	if data.HasGun then return true end
	local char = plr.Character
	if char then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower():find("gun") then
				return true
			end
		end
		local backpack = plr:FindFirstChild("Backpack")
		if backpack then
			for _, tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") and tool.Name:lower():find("gun") then
					return true
				end
			end
		end
	end
	return false
end

function espGetRoleName(plr)
	if not espRoles then return "" end
	local data = espRoles[plr.Name]
	if not data then return "" end
	if data.Role == "Murderer" then return " [MURDERER]"
	elseif data.Role == "Sheriff" then return " [SHERIFF]"
	elseif espIsHero(plr) then return " [HERO]"
	else return "" end
end

function espGetRoleClass(plr)
	if not espIsAlive(plr) then return "dead" end
	if not espRoles then return "innocent" end
	local data = espRoles[plr.Name]
	if not data then return "innocent" end
	if data.Role == "Murderer" then return "murderer" end
	if data.Role == "Sheriff" or espIsHero(plr) then return "sheriff" end
	return "innocent"
end

-- Skeleton ESP (ScreenGui frames, NOT the Drawing API): per-player lines
-- between body-part centers, updated every render frame, colored by role.
-- Drawing overlay coordinates drift on mobile executors (the whole skeleton
-- was drawn beside the character on phones); a full-screen ScreenGui with
-- IgnoreGuiInset = true and no safe-area insets uses the exact same pixel
-- space as WorldToViewportPoint, so the frames line up on every device.
ESP_SKEL_R15 = {
	{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
ESP_SKEL_R6 = {
	{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
	{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}
ESP_SKEL_THICKNESS = 1.5
ESP_SKEL_OPACITY = 0.8
espSkelDrawings = {}
espSkeletonGui = nil
-- Lazily (re)creates the overlay used by the frame-based skeleton.
function espSkeletonEnsureGui()
	if espSkeletonGui and espSkeletonGui.Parent then return espSkeletonGui end
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if not pg then return nil end
	local gui = pg:FindFirstChild("AdrenalinSkeletonGui")
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = "AdrenalinSkeletonGui"
		gui.ResetOnSpawn = false
		-- Under the script's own windows (mainGui = 999999), above the game HUD.
		gui.DisplayOrder = 999
		-- Full-viewport GUI: WorldToViewportPoint is in viewport pixels and a
		-- ScreenGui with IgnoreGuiInset = true / no safe-area insets starts at
		-- the same (0, 0) origin, so the projected points land on the bones on
		-- PC and phones alike. (With CoreUISafeInsets the origin was shifted
		-- and the safe-area margins compressed the points, which made the
		-- skeleton drift sideways the farther the player was from us.)
		gui.IgnoreGuiInset = true
		pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
		gui.Parent = pg
	end
	-- Re-assert on every call: an overlay left over from a previous execution
	-- of the script may still be using the old inset/safe-area layout.
	gui.IgnoreGuiInset = true
	pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
	-- Size probe: the AbsoluteSize of a full-screen frame tells us how many GUI
	-- pixels one viewport pixel maps to. If the GUI is laid out in a different
	-- pixel space (high-DPI phones / executor quirk) the projected points are
	-- scaled by this ratio, so the skeleton can never drift with the resolution.
	if not gui:FindFirstChild("SizeProbe") then
		local probe = Instance.new("Frame")
		probe.Name = "SizeProbe"
		probe.Size = UDim2.fromScale(1, 1)
		probe.BackgroundTransparency = 1
		probe.BorderSizePixel = 0
		probe.Parent = gui
	end
	espSkeletonGui = gui
	return gui
end

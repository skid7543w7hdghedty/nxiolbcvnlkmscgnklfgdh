function createCategoryButton(shortName, layoutOrder)
	-- Map short names to full names
	fullNames = {
		["Mvmt"] = "Player",
		["Cmbt"] = "Combat",
		["Sher"] = "Sheriff",
		["Murd"] = "Murderer",
		["Trl"] = "Trolling",
		["Tele"] = "Teleports",
		["Util"] = "Utilities",
		["Team"] = "Teamers",
		["Scam"] = "Scammers",
		["Farm"] = "Autofarm",
		["Emts"] = "Emotes",
		["Sel"] = "Selections",
		["Bind"] = "Binds",
		["Expl"] = "Exploiters",
		["Main"] = "Main",
		["Btn"] = "Extractable",
		["Set"] = "Settings"
	}
	local fullName = fullNames[shortName] or shortName
	
	local btn = Instance.new("TextButton")
	btn.Name = fullName .. "CatBtn"
	btn.Size = UDim2.new(1, sideTabWidth or 0, 0, sideTabHeight or 36)
	btn.BackgroundColor3 = tabBgColor
	btn.BackgroundTransparency = tabBgTransparency or 0
	btn.TextColor3 = tabTextColor
	btn.Text = tabDisplayName(fullName)
	btn.Font = Enum.Font.SourceSansBold
	-- Keep long tab names inside the button (like the mobile version): scaled text capped
	-- at the normal size can only shrink, so it never spills out of the tab frame.
	btn.TextScaled = true
	btn.ClipsDescendants = true
	local catBtnTSC = Instance.new("UITextSizeConstraint")
	catBtnTSC.MaxTextSize = tabTextSize
	catBtnTSC.MinTextSize = 9
	catBtnTSC.Parent = btn
	table.insert(_tabSizeConstraints, catBtnTSC)
	btn.AutoButtonColor = false
	if layoutOrder then btn.LayoutOrder = layoutOrder end
	btn.Parent = leftSidebar

	local tabIcon = nil
	-- Every tab gets an icon slot; the image comes from Icons/<TabName>/ (Settings tab).
	if true then
		tabIcon = Instance.new("ImageLabel")
		tabIcon.Name = fullName .. "TabIcon"
		tabIcon.Size = UDim2.new(0, 24, 0, 24)
		tabIcon.Position = UDim2.new(0, 4, 0.5, -12)
		tabIcon.BackgroundTransparency = 1
		tabIcon.BorderSizePixel = 0
		tabIcon.Visible = false
		tabIcon.Parent = btn
	end
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = (shapeCornerMap and tabShapeMode and shapeCornerMap[tabShapeMode]) or UDim.new(1, 0)
	btnCorner.Parent = btn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = tabStrokeColor or Color3.fromRGB(255, 255, 255)
	btnStroke.Thickness = tabStrokeThickness or 1
	btnStroke.Transparency = tabStrokeTransparency or 0
	btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	btnStroke.Enabled = tabStrokesEnabled
	btnStroke.Parent = btn
	
	categories[fullName] = { button = btn, icon = tabIcon, isActive = (fullName == "Main") }
	
	if fullName == "Main" then
		btn.BackgroundColor3 = tabActiveBgColor
		btn.TextColor3 = tabActiveTextColor
	end
	
	addBtnPressAnim(btn)
	
	btn.MouseButton1Click:Connect(function()
		-- Deactivate all categories
		for catName, catData in pairs(categories) do
			catData.button.BackgroundColor3 = tabBgColor
			catData.button.TextColor3 = tabTextColor
			catData.isActive = false
		end
		
		-- Activate this category
		currentCategory = fullName
		btn.BackgroundColor3 = tabActiveBgColor
		btn.TextColor3 = tabActiveTextColor
		categories[fullName].isActive = true
		refreshTabIcons()
		
		-- Update content visibility with animation
		for catName, catFrame in pairs(categoryFrames) do
			if catName == fullName then
				catFrame.Visible = true
				catFrame.BackgroundTransparency = 1
				TweenService:Create(catFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundTransparency = 1
				}):Play()
			else
				catFrame.Visible = false
			end
		end
		refreshTabStrokeColors()
		pcall(applyCombatSubTabsForCategory, fullName)
		pcall(applyEmotesSubTabsForCategory, fullName)
		pcall(applySidebarSubTabsForCategory, fullName)
		pcall(applyFunctionSearch)
		if fullName == "Settings" then
			-- Re-entering Settings always restores the canonical row order.
			pcall(restoreSettingsLayout)
			applySettingsGroupsCollapse()
		end
	end)
	
	return btn
end

function applyTabTextSize()
	tabTextSize = math.clamp(tabTextSize or 12, 8, 20)
	for _, tsc in ipairs(_tabSizeConstraints) do
		if tsc and tsc.Parent then
			tsc.MaxTextSize = tabTextSize
		end
	end
end


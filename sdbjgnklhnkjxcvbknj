	local function updateStatus()
		if state.selectedName then
			statusLabel.Text = "Skybox: " .. state.selectedName
			statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			statusLabel.Text = "Select a saved skybox"
			statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	local function refresh()
		for _, child in ipairs(scrollFrame:GetChildren()) do
			if not child:IsA("UICorner") then child:Destroy() end
		end
		-- Built-in ready presets first, then user-saved presets
		local rows = {}
		for _, p in ipairs(SKYBOX_PRESETS) do
			table.insert(rows, { name = p.name, preset = p, builtIn = true })
		end
		local names = {}
		for name in pairs(savedSkyboxes) do table.insert(names, name) end
		table.sort(names, function(a, b) return a:lower() < b:lower() end)
		for _, name in ipairs(names) do
			table.insert(rows, { name = name, preset = savedSkyboxes[name], builtIn = false })
		end
		local y = 0
		for _, row in ipairs(rows) do
			local name = row.name
			local isSel = state.selectedName == name
			local entry = Instance.new("Frame")
			entry.Size = UDim2.new(1, -8, 0, 30)
			entry.Position = UDim2.new(0, 4, 0, y)
			entry.BackgroundColor3 = isSel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
			entry.BorderSizePixel = 0
			entry.Parent = scrollFrame
			local ec = Instance.new("UICorner"); ec.CornerRadius = UDim.new(0, 6); ec.Parent = entry

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(1, -100, 1, 0)
			nameLabel.Position = UDim2.new(0, 8, 0, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = row.builtIn and (name .. "   [ready]") or name
			nameLabel.TextColor3 = isSel and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
			nameLabel.TextSize = 16
			nameLabel.Font = Enum.Font.SourceSansBold
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nameLabel.Parent = entry

			if not row.builtIn then
				-- Rename button (saved presets only): opens the same input modal
				-- style as the confirm dialogs.
				local renBtn = Instance.new("TextButton")
				renBtn.Size = UDim2.new(0, 28, 0, 24)
				renBtn.Position = UDim2.new(1, -64, 0.5, -12)
				renBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				renBtn.Text = "R"
				renBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				renBtn.Font = Enum.Font.SourceSansBold
				renBtn.TextSize = 14
				renBtn.Parent = entry
				local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0, 6); rc.Parent = renBtn
				renBtn.MouseButton1Click:Connect(function()
					local thisName = name
					promptTextInput("Rename skybox", "New name for '" .. thisName .. "':", thisName, function(newName)
						newName = newName and newName:match("^%s*(.-)%s*$") or nil
						if not newName or newName == "" then
							notify("Skybox", "Enter a valid name", 2)
							return
						end
						if newName ~= thisName then
							if savedSkyboxes[newName] then
								notify("Skybox", "Name already saved", 2)
								return
							end
							savedSkyboxes[newName] = savedSkyboxes[thisName]
							savedSkyboxes[thisName] = nil
							if state.selectedName == thisName then
								state.selectedName = newName
								state.selectedFaces = savedSkyboxes[newName]
							end
							if skyboxLastPresetName == thisName then
								skyboxLastPresetName = newName
							end
							skyboxSaveConfig()
							notify("Skybox", "Renamed to '" .. newName .. "'", 2)
						end
						refresh()
					end)
				end)

				local delBtn = Instance.new("TextButton")
				delBtn.Size = UDim2.new(0, 28, 0, 24)
				delBtn.Position = UDim2.new(1, -32, 0.5, -12)
				delBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				delBtn.Text = "X"
				delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				delBtn.Font = Enum.Font.SourceSansBold
				delBtn.TextSize = 14
				delBtn.Parent = entry
				local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(0, 6); dc.Parent = delBtn
				delBtn.MouseButton1Click:Connect(function()
					local thisName = name
					confirmAction("Delete skybox?", '"' .. thisName .. '" will be removed.', function()
						savedSkyboxes[thisName] = nil
						if state.selectedName == thisName then
							state.selectedName = nil
							state.selectedFaces = nil
							state.selectedBuiltin = nil
						end
						skyboxSaveConfig()
						refresh()
						notify("Skybox", "Deleted: " .. thisName, 2)
					end)
				end)
			end

			local clickArea = Instance.new("TextButton")
			clickArea.Size = UDim2.new(1, -36, 1, 0)
			clickArea.BackgroundTransparency = 1
			clickArea.Text = ""
			clickArea.Parent = entry
			clickArea.MouseButton1Click:Connect(function()
				if state.selectedName == name then
					state.selectedName = nil
					state.selectedFaces = nil
					state.selectedBuiltin = nil
				else
					state.selectedName = name
					state.selectedFaces = row.preset
					state.selectedBuiltin = row.builtIn
				end
				refresh()
			end)

			y = y + 36
		end
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, y)
		updateStatus()
	end
	state.refresh = refresh
	state.getSelectedFaces = function()
		if state.selectedName then return state.selectedFaces, state.selectedBuiltin end
		return nil, nil
	end
	task.defer(refresh)
	return state
end

-- Save current face inputs as a named preset
do
	local saveBtn, nameBox = createSkyboxRow("SkyboxSave", "Save Skybox", "Preset name", "", 410)
	skyboxNameInput = nameBox
	saveBtn.MouseButton1Click:Connect(function()
		local nm = nameBox.Text
		if nm == nil or nm:gsub("%s", "") == "" then
			notify("Skybox", "Enter a preset name first", 2)
			return
		end
		-- Collect all face IDs from inputs
		local preset = {}
		local count = 0
		for _, face in ipairs(skyboxFaces) do
			local box = skyboxFaceInputs[face]
			if box and box.Text and box.Text ~= "" then
				local digits = tostring(box.Text):match("%d+")
				if digits then
					preset[face] = digits
					count = count + 1
				end
			end
		end
		if count == 0 then
			notify("Skybox", "Fill at least one face ID", 2)
			return
		end
		savedSkyboxes[nm] = preset
		skyboxSaveConfig()
		notify("Skybox", "Saved: " .. nm .. " (" .. count .. " faces)", 2)
		if skyboxPickerState and skyboxPickerState.refresh then
			skyboxPickerState.refresh()
		end
	end)
end


-- [configfix] Fix for "activated script -> quit instantly -> rejoined -> config
-- reset": during startup many task.spawn/defer blocks fired saveConfig while
-- most settings were still at their DEFAULTS, so config.json got overwritten
-- with near-default data if the game was closed mid-load. From now on ALL
-- saves are blocked (counter-based, see applyLoadedConfigSafely) until the
-- startup restore finishes; only then is the restored state written back once.
_configRestoreDepth = 0
isApplyingConfig = true

-- Nesting-safe push/pop around config restores. isApplyingConfig must become
-- exactly false (never a number) because all save paths check its truthiness.
function configRestorePush()
	_configRestoreDepth += 1
	isApplyingConfig = true
end
function configRestorePop()
	_configRestoreDepth -= 1
	if _configRestoreDepth <= 0 then
		_configRestoreDepth = 0
		isApplyingConfig = false
	end
end

-- Safe wrapper: blocks saves for the whole restore, then - if the restore ran
-- without errors - persists the fully restored state with a single save.
function applyLoadedConfigSafely()
	configRestorePush()
	local ok, err = pcall(restoreFullConfig)
	configRestorePop()
	if err then
		pcall(function() notify("Config", "Config restore error: " .. tostring(err), 3) end)
	end
	if ok then
		pcall(saveConfig)
	end
	return ok, err
end

-- Safety watchdog: if the restore never ran (script error before it is
-- deferred), unblock saves instead of locking them for the whole session.
task.delay(30, function()
	if isApplyingConfig then
		_configRestoreDepth = 0
		isApplyingConfig = false
		pcall(saveConfig)
	end
end)


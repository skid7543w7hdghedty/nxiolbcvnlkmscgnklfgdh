-- Scammer player list logic
scammerCheckboxes = {}
selectedScammerTargets = {}

function updateScammerStatus()
	if not scammerStatusLabel then return end
	local count = 0
	for _ in pairs(selectedScammerTargets) do count += 1 end
	scammerStatusLabel.Text = count == 0 and "Select players to mark as scammers" or (count .. " player(s) selected")
	scammerStatusLabel.TextColor3 = count == 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 50, 50)
end

scammerListRefreshPending = false
function requestScammerListRefresh()
	if scammerListRefreshPending then return end
	scammerListRefreshPending = true
	task.delay(0.5, function()
		scammerListRefreshPending = false
		refreshScammerList()
	end)
end
function refreshScammerList()
	if not scammerScrollFrame then return end
	if refreshSavedScammers then refreshSavedScammers() end
	if refreshOnlineScammers then refreshOnlineScammers() end
	for _, child in ipairs(scammerScrollFrame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	scammerCheckboxes = {}

	local playerList = Players:GetPlayers()
	table.sort(playerList, function(a, b)
		local aMarked = markedScammers[a.Name] == true
		local bMarked = markedScammers[b.Name] == true
		if aMarked ~= bMarked then return aMarked end
		return a.Name:lower() < b.Name:lower()
	end)

	local yPosition = 0
	for _, plr in ipairs(playerList) do
		if plr ~= player then
			local isMarked = markedScammers[plr.Name] == true

			local rowData
			rowData = createAvatarSelectorRow(scammerScrollFrame, plr, {
				nameSuffix = "ScammerEntry",
				selected = selectedScammerTargets[plr.Name] ~= nil,
				prefix = isMarked and "[!] " or "",
				accent = Color3.fromRGB(180, 50, 50),
				baseBg = isMarked and Color3.fromRGB(50, 0, 15) or Color3.fromRGB(0, 0, 0),
				selectedBg = Color3.fromRGB(92, 12, 34),
				baseTextColor = isMarked and Color3.fromRGB(180, 60, 60) or Color3.fromRGB(255, 255, 255),
				onClick = function()
					if selectedScammerTargets[plr.Name] then
						selectedScammerTargets[plr.Name] = nil
						rowData.SetSelected(false)
					else
						selectedScammerTargets[plr.Name] = plr
						rowData.SetSelected(true)
					end
					updateScammerStatus()
				end,
			})
			rowData.Entry.Position = UDim2.new(0, 0, 0, yPosition)

			scammerCheckboxes[plr.Name] = {
				Entry = rowData.Entry,
				Checkmark = rowData.Checkmark,
				NameLabel = rowData.NameLabel,
				SetSelected = rowData.SetSelected,
			}

			yPosition += 65
		end
	end

	scammerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPosition)
	updateScammerStatus()
	if scammerSearchBox then
		local searchText = string.lower(scammerSearchBox.Text)
		for _, data in pairs(scammerCheckboxes) do
			if data.Entry and data.NameLabel then
				local playerName = data.NameLabel.Text:gsub("^%[!%] ", "")
				data.Entry.Visible = searchText == "" or string.find(string.lower(playerName), searchText, 1, true) ~= nil
			end
		end
	end
end

function toggleAllScammerPlayers(selectAll)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local checkboxData = scammerCheckboxes[plr.Name]
			if checkboxData then
				if selectAll then
					selectedScammerTargets[plr.Name] = plr
					if checkboxData.SetSelected then checkboxData.SetSelected(true) else checkboxData.Checkmark.Visible = true end
				else
					selectedScammerTargets[plr.Name] = nil
					if checkboxData.SetSelected then checkboxData.SetSelected(false) else checkboxData.Checkmark.Visible = false end
				end
			end
		end
	end
	updateScammerStatus()
end

-- Mark button: mark selected players as scammers
scammerMarkButton.MouseButton1Click:Connect(function()
	local count = 0
	for name, plr in pairs(selectedScammerTargets) do
		markedScammers[name] = true
		count += 1
	end
	if count > 0 then
		saveScammers()
		selectedScammerTargets = {}
		refreshScammerList()
		notify("Scammers", count .. " player(s) marked", 2)

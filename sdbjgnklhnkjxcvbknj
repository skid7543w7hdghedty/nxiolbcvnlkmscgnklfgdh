-- Moves the tab sidebar around the menu (Left/Right/Top/Bottom),
-- resizing the content area to fit. Accounts for top bar, paddings
-- and the side tab height setting.
function applySidebarPosition()
	if not (leftSidebar and contentArea and mainFrame) then return end
	local valid = { Left = true, Right = true, Top = true, Bottom = true }
	if not valid[sidebarPosition] then sidebarPosition = "Left" end
	local pos = sidebarPosition
	local btnH = sideTabHeight or 36
	if pos == "Left" or pos == "Right" then
		sidebarLayout.FillDirection = Enum.FillDirection.Vertical
		leftSidebar.AutomaticCanvasSize = Enum.AutomaticSize.Y
		leftSidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
		leftSidebar.ScrollBarThickness = 2
		applySidebarButtonSizes()
		if pos == "Left" then
			leftSidebar.Position = UDim2.new(0, 0, 0, 34)
			leftSidebar.Size = UDim2.new(0, 140, 1, -34)
			contentArea.Position = UDim2.new(0, 148, 0, 42)
			contentArea.Size = UDim2.new(1, -156, 1, -50)
		else
			leftSidebar.Position = UDim2.new(1, -140, 0, 34)
			leftSidebar.Size = UDim2.new(0, 140, 1, -34)
			contentArea.Position = UDim2.new(0, 8, 0, 42)
			contentArea.Size = UDim2.new(1, -156, 1, -50)
		end
	else
		local stripH = btnH + 13
		sidebarLayout.FillDirection = Enum.FillDirection.Horizontal
		leftSidebar.AutomaticCanvasSize = Enum.AutomaticSize.X
		leftSidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
		leftSidebar.ScrollBarThickness = 2
		applySidebarButtonSizes()
		if pos == "Top" then
			leftSidebar.Position = UDim2.new(0, 0, 0, 34)
			leftSidebar.Size = UDim2.new(1, 0, 0, stripH)
			contentArea.Position = UDim2.new(0, 8, 0, 42 + stripH)
			contentArea.Size = UDim2.new(1, -16, 1, -(50 + stripH))
		else
			leftSidebar.Position = UDim2.new(0, 0, 1, -stripH)
			leftSidebar.Size = UDim2.new(1, 0, 0, stripH)
			contentArea.Position = UDim2.new(0, 8, 0, 42)
			contentArea.Size = UDim2.new(1, -16, 1, -(50 + stripH))
		end
	end
end

function cycleSidebarPosition()
	local idx = 1
	for i, name in ipairs(sidebarPositions) do
		if name == sidebarPosition then idx = i break end
	end
	sidebarPosition = sidebarPositions[idx % #sidebarPositions + 1]
	applySidebarPosition()
	if sidebarPosBtn then sidebarPosBtn.Text = "Sidebar Position: " .. sidebarPosition end
	pcall(saveConfig)
end


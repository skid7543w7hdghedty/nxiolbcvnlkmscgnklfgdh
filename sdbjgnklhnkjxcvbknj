-- ============================================
-- Coin Aura — magnetically attract coins within radius
-- Works independently or alongside the autofarm
-- ============================================
coinAuraEnabled = false
coinAuraRadius = 5
coinAuraConnections = {}
coinAuraContainer = nil
coinAuraPartCache = {}
coinAuraPurgeFrame = 0

function coinAuraGetRoot()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

function coinAuraGetCoinPart(coin)
	if coin:IsA("BasePart") then return coin end
	local p = coin:FindFirstChild("Coin")
	if p and p:IsA("BasePart") then return p end
	return coin:FindFirstChildWhichIsA("BasePart")
end

function coinAuraTouchCoin(root, coin, coinPart)
	if not (root and coinPart and coinPart.Parent) then return end
	-- Snap the invisible hitbox onto the player and fire the touch in BOTH
	-- directions (listeners are sometimes attached to only one side).
	if coin and coin:IsA("Model") then
		pcall(function() coin:PivotTo(root.CFrame) end)
	end
	pcall(function()
		coinPart.CFrame = root.CFrame
		coinPart.CanCollide = false
	end)
	safeFireTouch(coinPart, root)
	safeFireTouch(root, coinPart)
end

function enableCoinAura()
	coinAuraEnabled = true
	for _, conn in ipairs(coinAuraConnections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then conn:Disconnect() end
	end
	coinAuraConnections = {}
	coinAuraContainer = nil
	coinAuraPartCache = {}
	coinAuraTickFrame = 0
	coinAuraPurgeFrame = 0

	-- Catch a freshly spawned CoinContainer immediately (new round / new map)
	-- instead of waiting for the next recursive workspace search.
	table.insert(coinAuraConnections, Workspace.DescendantAdded:Connect(function(inst)
		if not coinAuraEnabled then return end
		if inst.Name == "CoinContainer" then
			coinAuraContainer = inst
			coinAuraPartCache = {}
		end
	end))

	-- Dropping the cache on respawn forces a fresh container lookup.
	table.insert(coinAuraConnections, player.CharacterAdded:Connect(function()
		coinAuraContainer = nil
		coinAuraPartCache = {}
	end))

	-- Main loop: every Heartbeat frame, full rate. CoinContainer is cached (the
	-- expensive recursive search only runs when the cached one is gone); coin
	-- hitboxes are memoized; dead cache entries are purged every ~5 seconds.
	table.insert(coinAuraConnections, RunService.Heartbeat:Connect(function()
		if not coinAuraEnabled then return end
		local root = coinAuraGetRoot()
		if not root then return end
		local playerPos = root.Position
		local cc = coinAuraContainer
		if not (cc and cc.Parent) then
			-- [perf] The recursive search below walks the whole Workspace. It used
			-- to run EVERY Heartbeat frame while no CoinContainer existed (which
			-- is most of the time between rounds) - 60 full map searches per
			-- second, the single biggest cost of Coin Aura. Throttled to once a
			-- second: the aura just idles until a container appears.
			local now = os.clock()
			if (now - (coinAuraFindAt or 0)) < 1 then return end
			coinAuraFindAt = now
			cc = Workspace:FindFirstChild("CoinContainer", true)
			coinAuraContainer = cc
			coinAuraPartCache = {}
			if not cc then return end
		end
		coinAuraPurgeFrame += 1
		if coinAuraPurgeFrame % 300 == 0 then
			for coin, part in pairs(coinAuraPartCache) do
				if not (coin and coin.Parent and part and part.Parent) then
					coinAuraPartCache[coin] = nil
				end
			end
		end
		local radius = coinAuraRadius or 5
		local r2 = radius * radius
		for _, coin in ipairs(cc:GetChildren()) do
			if coin.Parent then
				local coinPart = coinAuraPartCache[coin]
				if not (coinPart and coinPart.Parent) then
					coinPart = coinAuraGetCoinPart(coin)
					coinAuraPartCache[coin] = coinPart
				end
				if coinPart then
					-- Squared-distance test = the aura is a perfect invisible
					-- circle (no needless square root every frame).
					local d = coinPart.Position - playerPos
					if d:Dot(d) <= r2 then
						coinAuraTouchCoin(root, coin, coinPart)
					end
				end
			end
		end
	end))
end

function disableCoinAura()
	coinAuraEnabled = false
	for _, conn in ipairs(coinAuraConnections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then conn:Disconnect() end
	end
	coinAuraConnections = {}
end

function toggleCoinAura()
	if coinAuraEnabled then
		disableCoinAura()
	else
		enableCoinAura()
	end
end

btn.coinAura, ui.coinAuraRadiusInput = createDualRow("CoinAuraButton", "Coin Aura: OFF", "Radius", coinAuraRadius, 209)
btn.coinAura.MouseButton1Click:Connect(function()
	toggleCoinAura()
	setToggleState(btn.coinAura, coinAuraEnabled, "Coin Aura: ON", "Coin Aura: OFF")
	setExtractedBtnState("Coin Aura", coinAuraEnabled)
end)


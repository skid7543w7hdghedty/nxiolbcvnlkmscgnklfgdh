-- Avatar thumbnail cache: GetUserThumbnailAsync is a yielding web call. Without a
-- cache every list rebuild re-fetches avatars for ALL marked players online, so the
-- network stalls and image-streaming hitches grow with the marked list.
-- NOTE: globals on purpose (file is near the 200 local registers limit).
thumbCache = thumbCache or {}
function getCachedThumb(userId)
	if thumbCache[userId] then return thumbCache[userId] end
	local ok, thumb = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
	end)
	if ok and thumb and thumb ~= "" then thumbCache[userId] = thumb return thumb end
	return ""
end
function refreshOnlineExploiters()
	if not onlineExploitersList then return end

	local markedOnline = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and markedExploiters[plr.Name] == true then
			table.insert(markedOnline, plr)
		end
	end
	table.sort(markedOnline, function(a, b) return a.Name:lower() < b.Name:lower() end)
	-- Skip redundant rebuilds: same marked-online membership -> same UI.
	-- (checked BEFORE destroying children so a skip keeps the current list intact)
	local onlineExploiterSigParts = {}
	for _, plr in ipairs(markedOnline) do onlineExploiterSigParts[#onlineExploiterSigParts + 1] = plr.Name end
	local onlineExploiterSig = table.concat(onlineExploiterSigParts, ",")
	if onlineExploiterSig == onlineExploitersLastSig then return end
	onlineExploitersLastSig = onlineExploiterSig

	for _, child in ipairs(onlineExploitersList:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	local count = #markedOnline
	local entryHeight = 60
	local maxContainerHeight = 190
	local containerH = count > 0 and math.min(count * (entryHeight + 5) + 10, maxContainerHeight) or 0
	onlineExploitersContainer.Size = UDim2.new(1, 0, 0, containerH)

	if count == 0 then
		local emptyLabel = Instance.new("TextLabel")
		emptyLabel.Size = UDim2.new(1, 0, 0, 30)
		emptyLabel.BackgroundTransparency = 1
		emptyLabel.Text = "No marked exploiters online"
		emptyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		emptyLabel.Font = Enum.Font.SourceSansBold
		emptyLabel.TextSize = 13
		emptyLabel.Parent = onlineExploitersList
		return
	end

	for _, plr in ipairs(markedOnline) do
		local button = Instance.new("TextButton")
		button.Name = plr.Name
		button.Size = UDim2.new(1, 0, 0, entryHeight)
		button.BackgroundColor3 = exploiterRowBgColor or Color3.fromRGB(25, 25, 25)
		button.BackgroundTransparency = exploiterRowBgTransparency or 0
		button.BorderSizePixel = 0
		button.Text = ""
		button.AutoButtonColor = false
		button.Parent = onlineExploitersList

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = button

		local avatar = Instance.new("ImageLabel")
		avatar.Name = "Avatar"
		avatar.Size = UDim2.new(0, 40, 0, 40)
		avatar.Position = UDim2.new(0, 5, 0, 10)
		avatar.BackgroundColor3 = exploiterAvatarBgColor or Color3.fromRGB(0, 0, 0)
		avatar.BackgroundTransparency = exploiterAvatarBgTransparency or 0
		avatar.ImageTransparency = exploiterAvatarBgTransparency or 0
		avatar.BorderSizePixel = 0
		avatar.Parent = button

		local avatarCorner = Instance.new("UICorner")
		avatarCorner.CornerRadius = UDim.new(0, 6)
		avatarCorner.Parent = avatar

		coroutine.wrap(function()
			local thumb = getCachedThumb(plr.UserId)
			if avatar.Parent then avatar.Image = thumb end
		end)()

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -60, 0, 20)
		nameLabel.Position = UDim2.new(0, 55, 0, 20)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = plr.DisplayName .. " (" .. plr.Name .. ")"
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 14
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = button

		button.MouseEnter:Connect(function()
			button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
		end)
		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = exploiterRowBgColor or Color3.fromRGB(25, 25, 25)
		end)

		button.MouseButton1Click:Connect(function()
			showPlayerInfoPopup(plr)
		end)
	end
end


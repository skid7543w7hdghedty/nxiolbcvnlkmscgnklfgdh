	local val = tonumber(autoInvisDeactivateBox.Text)
	if val and val > 0 then
		autoInvisDeactivateDist = val
	else
		autoInvisDeactivateBox.Text = tostring(autoInvisDeactivateDist)
	end
	saveConfig()
end)

-- AutoGrab Gun (Ultra Speed)
autoGrabGunEnabled = false
autoGrabGunConnections = {}
autoGrabGunProcessed = {}
autoGrabGunConnectedModels = {}
autoGrabGunMagnets = {}

autoGrabGunTargets = mapNameSet()

-- Grab modes: "Only Innocent" never grabs while you are the murderer or dead;
-- "Full" grabs even as the murderer but still never while dead.
autoGrabModes = {"Only Innocent", "Full"}
autoGrabModeIndex = 1
autoGrabMurdererCheckAt = 0
autoGrabMurdererCached = false
-- Latches on Humanoid.Died so even the frame between death and Health==0 (or a
-- re-parented corpse) can never claim a drop. Cleared on CharacterAdded.
autoGrabDeathLatch = false
-- Time latch on top of the boolean: even if the Alive attribute / role cache
-- flickers back to "alive" on a corpse for a frame, grabbing stays disabled for
-- this window after any death signal.
autoGrabDeathLatchUntil = 0
-- os.clock() of the current character spawn. Used to ignore the previous life's
-- role flags for a moment right after respawn (they would otherwise delay the
-- first grab by up to ~1.5 s).
autoGrabCharSpawnClock = 0
-- Every GunDrop instance we have ever seen, so the fast poll can re-check them
-- without a recursive Workspace search every tick.
autoGrabKnownDrops = {}

function autoGrabHandleDeath()
	autoGrabDeathLatch = true
	autoGrabDeathLatchUntil = os.clock() + 3
	-- Release every live magnet and forget processed drops immediately: a dead
	-- body must never keep a GunDrop glued to it or re-fire touches.
	for drop, conn in pairs(autoGrabGunMagnets) do
		pcall(function() if conn and conn.Disconnect then conn:Disconnect() end end)
		autoGrabGunMagnets[drop] = nil
	end
	autoGrabGunProcessed = {}
end

function autoGrabHookChar(char)
	if not char then return end
	autoGrabDeathLatch = false
	autoGrabDeathLatchUntil = 0
	-- Already dead the moment the feature is enabled (toggled on while dead):
	-- latch immediately instead of waiting for a Died event that already fired.
	if char:GetAttribute("Alive") == false then autoGrabHandleDeath() end
	-- One hook set per character, even if the feature is toggled repeatedly.
	if char:GetAttribute("_WsAutoGrabDeadHooked") then return end
	autoGrabCharSpawnClock = os.clock()
	char:SetAttribute("_WsAutoGrabDeadHooked", true)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(autoGrabHandleDeath)
		-- Some death paths (round reset / server kill) set Health to 0 before
		-- Died runs. Latch on the health drop itself for the earliest signal.
		hum.HealthChanged:Connect(function(h)
			if h <= 0 then autoGrabHandleDeath() end
		end)
	else
		task.spawn(function()
			local h = char:WaitForChild("Humanoid", 10)
			if h then
				h.Died:Connect(autoGrabHandleDeath)
				h.HealthChanged:Connect(function(hp)
					if hp <= 0 then autoGrabHandleDeath() end
				end)
			end
		end)
	end
	-- Humanoid.Died is not always fired for every death path (round reset /
	-- server-side kill): mirror the game's own Alive attribute as well. When it
	-- flips back to true the latch clears, so grabbing resumes on respawn.
	pcall(function()
		char:GetAttributeChangedSignal("Alive"):Connect(function()
			if char ~= player.Character then return end
			if char:GetAttribute("Alive") == false then
				autoGrabHandleDeath()
			elseif char:GetAttribute("Alive") == true then
				autoGrabDeathLatch = false
				autoGrabDeathLatchUntil = 0
				-- Respawned: re-check every known drop immediately instead of
				-- waiting for the next poll tick.
				if autoGrabKickClaims then pcall(autoGrabKickClaims) end
			end
		end)
	end)
end

function autoGrabIsDead()
	local char = player.Character
	if not char or not char.Parent then return true end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return true end
	if hum.Health <= 0 then return true end
	if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
	-- The game marks dead players on the character itself. This fires BEFORE
	-- Humanoid.Health replicates to 0 in some respawn paths, so it is the
	-- earliest reliable death signal we have.
	if char:GetAttribute("Alive") == false then return true end
	-- Server-side role snapshot: Killed/Dead are authoritative even while the
	-- local corpse still reports a positive health (ragdoll / death animation).
	-- Only trust it while FRESH (<=2 s) so a stale "Dead" from the previous round
	-- can never block grabbing after respawn.
	local data = _roleDataCache
	if type(data) == "table" and (os.clock() - (_roleDataCacheAt or 0)) <= 2 then
		local me = data[player.Name]
		if me and (me.Killed == true or me.Dead == true) then return true end
	end
	-- A character without a root part cannot legally claim a drop.
	if not char:FindFirstChild("HumanoidRootPart") then return true end
	return false
end

function autoGrabHasKnife()
	local char = player.Character
	if char and char:FindFirstChild("Knife") then return true end
	local backpack = player:FindFirstChild("Backpack")
	if backpack and backpack:FindFirstChild("Knife") then return true end
	return false
end

function autoGrabIsMurdererNow()
	local now = tick()
	if now - autoGrabMurdererCheckAt >= 0.15 then
		autoGrabMurdererCheckAt = now
		autoGrabMurdererCached = autoGrabHasKnife()
		if not autoGrabMurdererCached then
			local ok, res = pcall(isPlayerMurderer)
			autoGrabMurdererCached = (ok and res == true) or cachedIsMurderer == true
		end
	end
	return autoGrabMurdererCached
end

-- ROLE GATE (the real fix). The game's own player-data snapshot tells us which
-- role the SERVER currently has for us. After death the role is no longer
-- Innocent/Sheriff/Hero (the same reason the knife disappears), so a corpse can
-- never pass this gate even if the replicated Humanoid still reports HP > 0 for
-- a couple of frames, or a cheater restores the corpse's health locally.
function autoGrabSelfInfo()
	local data = _roleDataCache
	if type(data) ~= "table" then return nil end
	-- 1.5 s: the snapshot is refreshed every 0.5 s while AutoGrab is on. Older
	-- data is ignored so a stale "Dead" from last round can't block respawn.
	if (os.clock() - (_roleDataCacheAt or 0)) > 1.5 then return nil end
	return data[player.Name]
end

-- true = yes, false = no, nil = unknown (fall back to health checks)
function autoGrabRoleAllows(me)
	if type(me) ~= "table" then return nil end
	-- Just respawned: the snapshot still carries the previous life's flags for a
	-- moment. Health / Alive / humanoid-state checks are authoritative for the
	-- new body, so don't let last round's Dead/Killed delay the first grab.
	if (os.clock() - (autoGrabCharSpawnClock or 0)) < 1.5 then return nil end
	if me.Dead == true or me.Killed == true then return false end
	if me.InRound == false then return false end
	local role = me.Role
	if role == "Dead" or role == "Spectator" then return false end
	if role == "Innocent" or role == "Sheriff" or role == "Hero" then return true end
	if role == "Murderer" then return autoGrabModeIndex == 2 end
	-- Role is present but not a living role: treat as not allowed. This is what
	-- catches the death transition when Dead/Killed flags have not flipped yet.
	if role ~= nil then return false end
	return nil
end

function autoGrabShouldGrab()
	if autoGrabDeathLatch or (autoGrabDeathLatchUntil > 0 and os.clock() < autoGrabDeathLatchUntil) then return false end
	if autoGrabIsDead() then return false end
	if autoGrabRoleAllows(autoGrabSelfInfo()) == false then return false end
	if autoGrabModeIndex ~= 2 and autoGrabIsMurdererNow() then return false end
	return true
end

function autoGrabGetRoot()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

function autoGrabStartMagnet(drop)
	if autoGrabGunMagnets[drop] then return end
	local isModel = drop:IsA("Model")
	local isPart = drop:IsA("BasePart")
	-- PreSimulation fires earliest in frame -- faster than Heartbeat for stealing
	local conn
	conn = RunService.PreSimulation:Connect(function()
		if not drop or not drop.Parent then
			if conn then conn:Disconnect() end
			autoGrabGunMagnets[drop] = nil
			return
		end
		if not autoGrabShouldGrab() then
			-- Dead (or murderer-gated in Only Innocent): release immediately so
			-- a corpse can never keep the drop glued to it. The 0.06 s poll
			-- re-claims automatically once the player is alive/eligible again.
			if conn then conn:Disconnect() end
			autoGrabGunMagnets[drop] = nil
			return
		end
		local char2 = player.Character
		local root = char2 and char2:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local cf = root.CFrame
		if isPart then
			drop.CFrame = cf
		elseif isModel then
			pcall(function() drop:PivotTo(cf) end)
		else
			local part = drop:FindFirstChildWhichIsA("BasePart", true)
			if part then part.CFrame = cf end
		end
	end)
	autoGrabGunMagnets[drop] = conn
end

function autoGrabStopMagnet(drop)
	if autoGrabGunMagnets[drop] then
		autoGrabGunMagnets[drop]:Disconnect()
		autoGrabGunMagnets[drop] = nil
	end
end

-- Re-check all known drops right now (respawn / feature re-enable). Cheap: the
-- set usually holds 0-2 entries.
function autoGrabKickClaims()
	if not autoGrabGunEnabled then return end
	for drop in pairs(autoGrabKnownDrops) do
		if not drop.Parent then
			autoGrabKnownDrops[drop] = nil
			autoGrabGunProcessed[drop] = nil
		else
			autoGrabClaimDrop(drop)
		end
	end
end

function autoGrabClaimDrop(drop)
	if not autoGrabGunEnabled then return end
	if not drop or not drop.Parent then return end
	-- Remember every drop we ever see; the fast poll walks this set instead of
	-- recursively searching the whole Workspace on every tick.
	autoGrabKnownDrops[drop] = true
	if autoGrabGunProcessed[drop] then return end
	if not autoGrabShouldGrab() then return end
	autoGrabGunProcessed[drop] = true

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		autoGrabGunProcessed[drop] = nil
		return
	end

	local parts = {}
	if drop:IsA("BasePart") then
		parts[1] = drop
	elseif drop:IsA("Model") then
		local i = 0
		for _, v in ipairs(drop:GetDescendants()) do
			if v:IsA("BasePart") then i = i + 1; parts[i] = v end
		end
	else
		local p = drop:FindFirstChildWhichIsA("BasePart", true)
		if p then parts[1] = p end
	end

	if #parts == 0 then
		autoGrabGunProcessed[drop] = nil
		return
	end

	local cf = root.CFrame
	local zero = Vector3.zero

	-- ULTRA FAST: triple teleport + triple touch in same frame (no yield) -- beats competitors by 1 frame
	for _ = 1, 3 do
		for i = 1, #parts do
			local part = parts[i]
			part.CanCollide = false
			part.AssemblyLinearVelocity = zero
			part.AssemblyAngularVelocity = zero
			part.CFrame = cf
		end
		if drop:IsA("Model") then pcall(function() drop:PivotTo(cf) end) end
		for i = 1, #parts do safeFireTouch(root, parts[i]) safeFireTouch(parts[i], root) end
	end

	-- PreSimulation burst (earliest possible -- before physics)
	local preConn
	preConn = RunService.PreSimulation:Connect(function()
		preConn:Disconnect()
		if not drop or not drop.Parent then return end
		if not autoGrabShouldGrab() then return end
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not r then return end
		for i = 1, #parts do parts[i].CFrame = r.CFrame; safeFireTouch(r, parts[i]) end
	end)
	-- RenderStepped burst (before render)
	local renderConn
	renderConn = RunService.RenderStepped:Connect(function()
		renderConn:Disconnect()
		if not drop or not drop.Parent then return end
		if not autoGrabShouldGrab() then return end
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not r then return end
		for i = 1, #parts do parts[i].CFrame = r.CFrame; safeFireTouch(r, parts[i]) end
	end)
	-- task.defer burst
	task.defer(function()
		if not drop or not drop.Parent then return end
		if not autoGrabShouldGrab() then return end
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not r then return end
		for i = 1, #parts do parts[i].CFrame = r.CFrame; safeFireTouch(r, parts[i]) end
	end)
	-- Heartbeat bursts x2
	for _ = 1, 2 do
		local hbOnce
		hbOnce = RunService.Heartbeat:Connect(function()
			hbOnce:Disconnect()
			if not drop or not drop.Parent then return end
			if not autoGrabShouldGrab() then return end
			local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not r then return end
			for i = 1, #parts do parts[i].CFrame = r.CFrame; safeFireTouch(r, parts[i]) end
		end)
	end

	-- Start magnet (keeps drop glued every PreSimulation)
	autoGrabStartMagnet(drop)

	-- Continuous ultra-fast touch: PreSimulation + Heartbeat every frame until grabbed
	local touchConns = {}
	local function stopTouch()
		for _, c in ipairs(touchConns) do pcall(function() c:Disconnect() end) end
		touchConns = {}
	end
	table.insert(touchConns, RunService.PreSimulation:Connect(function()
		if not drop or not drop.Parent then stopTouch(); return end
		if not autoGrabGunEnabled then stopTouch(); return end
		if not autoGrabShouldGrab() then autoGrabGunProcessed[drop] = nil; autoGrabStopMagnet(drop); stopTouch(); return end
		local fr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not fr then return end
		local fc = fr.CFrame
		for i = 1, #parts do local p = parts[i]; p.CFrame = fc; p.AssemblyLinearVelocity = zero; safeFireTouch(fr, p) end
	end))
	table.insert(touchConns, RunService.Heartbeat:Connect(function()
		if not drop or not drop.Parent then stopTouch(); return end
		if not autoGrabGunEnabled then stopTouch(); return end
		if not autoGrabShouldGrab() then autoGrabGunProcessed[drop] = nil; autoGrabStopMagnet(drop); stopTouch(); return end
		local fr = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not fr then return end
		local fc = fr.CFrame
		for i = 1, #parts do local p = parts[i]; p.CFrame = fc; p.AssemblyLinearVelocity = zero; safeFireTouch(fr, p) end
	end))

	drop.AncestryChanged:Connect(function()
		if not drop.Parent or drop.Parent == Workspace then
			autoGrabStopMagnet(drop)
			stopTouch()
			autoGrabGunProcessed[drop] = nil
			if not drop.Parent then autoGrabKnownDrops[drop] = nil end
		end
	end)
	-- Fast retry: if the touch did not register (e.g. we died mid-claim), allow
	-- the next poll to re-claim after 0.6 s instead of the old 1.5 s.
	task.delay(0.6, function() if drop and drop.Parent then autoGrabGunProcessed[drop] = nil end end)
end

function autoGrabConnectModel(model)
	if autoGrabGunConnectedModels[model] then return end
	autoGrabGunConnectedModels[model] = true

	-- Instant check of existing
	for _, child in ipairs(model:GetDescendants()) do
		if child.Name == "GunDrop" then
			autoGrabClaimDrop(child)
		end
	end

	-- DescendantAdded - direct call without delay (faster than task.defer)
	local conn = model.DescendantAdded:Connect(function(descendant)
		if not autoGrabGunEnabled then return end
		if descendant.Name == "GunDrop" then
			autoGrabClaimDrop(descendant)
		end
	end)
	autoGrabGunConnections[model] = conn

	-- ChildAdded - duplicate catch
	local conn2 = model.ChildAdded:Connect(function(child)
		if not autoGrabGunEnabled then return end
		if child.Name == "GunDrop" then
			autoGrabClaimDrop(child)
		end
		if child:IsA("Model") or child:IsA("Folder") then
			for _, desc in ipairs(child:GetDescendants()) do
				if desc.Name == "GunDrop" then
					autoGrabClaimDrop(desc)
				end
			end
		end
	end)
	table.insert(autoGrabGunConnections, conn2)

	model.AncestryChanged:Connect(function()
		if not model.Parent then
			if autoGrabGunConnections[model] then
				autoGrabGunConnections[model]:Disconnect()
				autoGrabGunConnections[model] = nil
				autoGrabGunConnectedModels[model] = nil
			end
		end
	end)
end

function autoGrabScanWorkspace()
	-- [perf] Chunked walk (300 nodes per frame) instead of a single
	-- Workspace:GetDescendants() call. The old version rebuilt the whole map's
	-- descendant table in ONE frame on every rescan (5 s while Auto Grab is on
	-- and on every respawn), which was a visible periodic hitch. Only
	-- containers (Models/Folders) are descended into, so loose parts are never
	-- visited.
	task.spawn(function()
		local stack = { Workspace }
		local budget = 0
		while autoGrabGunEnabled and #stack > 0 do
			local obj = table.remove(stack)
			if obj:IsA("Model") and autoGrabGunTargets[obj.Name] then
				autoGrabConnectModel(obj)
			end
			-- Also catch GunDrop directly
			if obj.Name == "GunDrop" then
				autoGrabClaimDrop(obj)
			end
			if obj == Workspace or obj:IsA("Model") or obj:IsA("Folder") then
				local kids = obj:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
			end
			budget = budget + 1
			if budget >= 300 then
				budget = 0
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

function enableAutoGrabGun()
	autoGrabGunEnabled = true
	autoGrabGunProcessed = {}
	autoGrabGunConnectedModels = {}
	autoGrabKnownDrops = {}
	autoGrabHookChar(player.Character)
	for drop, conn in pairs(autoGrabGunMagnets) do
		conn:Disconnect()
	end
	autoGrabGunMagnets = {}
	for model, conn in pairs(autoGrabGunConnections) do
		if conn then conn:Disconnect() end
	end
	autoGrabGunConnections = {}

	autoGrabScanWorkspace()

	-- Workspace.DescendantAdded - direct call, no delay
	table.insert(autoGrabGunConnections, Workspace.DescendantAdded:Connect(function(obj)
		if not autoGrabGunEnabled then return end
		if obj.Name == "GunDrop" then
			-- GunDrop first priority - most important
			autoGrabClaimDrop(obj)
		elseif obj:IsA("Model") and autoGrabGunTargets[obj.Name] then
			autoGrabConnectModel(obj)
		end
	end))

	-- Workspace.ChildAdded - additional top-level catch
	table.insert(autoGrabGunConnections, Workspace.ChildAdded:Connect(function(obj)
		if not autoGrabGunEnabled then return end
		if obj.Name == "GunDrop" then
			autoGrabClaimDrop(obj)
		end
		if obj:IsA("Model") and autoGrabGunTargets[obj.Name] then
			autoGrabConnectModel(obj)
		end
	end))

	table.insert(autoGrabGunConnections, player.CharacterAdded:Connect(function(char)
		if not autoGrabGunEnabled then return end
		autoGrabHookChar(char)
		for drop, conn in pairs(autoGrabGunMagnets) do
			conn:Disconnect()
		end
		autoGrabGunMagnets = {}
		autoGrabGunProcessed = {}
		autoGrabGunConnectedModels = {}
		char:WaitForChild("HumanoidRootPart")
		autoGrabScanWorkspace()
	end))

	-- Periodic scan - every 5 sec (DescendantAdded catches instantly)
	task.spawn(function()
		-- [perf] DescendantAdded already catches every new drop instantly, so the
		-- full-Workspace rescan is only a safety net. 1s full scans were freezing
		-- mobile; 5s is more than enough for a fallback.
		while autoGrabGunEnabled do
			task.wait(5)
			if autoGrabGunEnabled then
				autoGrabScanWorkspace()
			end
		end
	end)
	-- Fast GunDrop poll. DescendantAdded/ChildAdded already fire the instant a
	-- drop replicates; this poll is a cheap safety net that walks the KNOWN drop
	-- set (0-2 entries) every 0.03 s instead of recursively scanning the whole
	-- Workspace (the old FindFirstChild(..., true) call was the main cost).
	task.spawn(function()
		while autoGrabGunEnabled do
			task.wait(0.03)
			if autoGrabGunEnabled then
				for drop in pairs(autoGrabKnownDrops) do
					if not drop.Parent then
						autoGrabKnownDrops[drop] = nil
						autoGrabGunProcessed[drop] = nil
					else
						autoGrabClaimDrop(drop)
					end
				end
			end
		end
	end)
	-- Keep the server-side role snapshot fresh while AutoGrab is on: its
	-- Dead/Killed flag is the earliest authoritative death signal (the corpse
	-- can still report positive health for a frame or two). Shares the 0.35 s
	-- cache with every other poller, so this costs at most ~2 invokes/sec.
	-- Also latch death the moment the ROLE itself says we are dead/out of round
	-- (after death we are no longer Innocent/Sheriff/Hero).
	task.spawn(function()
		while autoGrabGunEnabled do
			pcall(invokePlayerData)
			local me = _roleDataCache and _roleDataCache[player.Name]
			if type(me) == "table" and (os.clock() - (_roleDataCacheAt or 0)) <= 1.5
				and (os.clock() - (autoGrabCharSpawnClock or 0)) >= 1.5 then
				if me.Dead == true or me.Killed == true or me.Role == "Dead" or me.InRound == false then
					autoGrabHandleDeath()
				end
			end
			task.wait(0.5)
		end
	end)
end

function disableAutoGrabGun()
	autoGrabGunEnabled = false
	for model, conn in pairs(autoGrabGunConnections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then
			conn:Disconnect()
		end
	end
	autoGrabGunConnections = {}
	for drop, conn in pairs(autoGrabGunMagnets) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	autoGrabGunMagnets = {}
	autoGrabGunProcessed = {}
	autoGrabGunConnectedModels = {}
	autoGrabKnownDrops = {}
end

function toggleAutoGrabGun()
	if autoGrabGunEnabled then
		disableAutoGrabGun()
	else
		enableAutoGrabGun()
	end
end


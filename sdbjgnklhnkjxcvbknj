-- ============================================================
-- Target Arrows: as murderer points at the nearest alive player (a VISIBLE
-- target always wins over behind-wall ones), as innocent/sheriff/hero points
-- at the murderer. Fixed screen-HUD (like Show Round Timer): the arrow sits at
-- its anchor point (screen middle + offsets) and only ROTATES in place to
-- indicate the direction — it never attaches to the target. Drawn with Drawing
-- lines as a real arrow (shaft + two backward barbs), plus a ScreenGui caption
-- with name, distance and visibility state.
-- Green = line of sight, red = behind wall.
-- Role data refreshes ~1/sec via invokePlayerData (cached, may yield);
-- per-frame work is pure math + drawing, no yields. Toggle + colors live in
-- the Visuals tab (Esp Colors section), position in Settings/Others,
-- size in Settings/Size.
-- Globals (not locals) on purpose: the chunk is at the local-registers limit.
-- ============================================================
arrowEnabled = false
arrowVisibleColor = Color3.fromRGB(0, 255, 0)
arrowHiddenColor = Color3.fromRGB(255, 0, 0)
arrowOffsetX = 0
arrowOffsetY = 0
arrowSize = 26
-- Caption (name • distance • visibility) settings: its own TextSize and its
-- own X/Y offset from the fixed arrow pivot, all settable in Settings
arrowTextSize = 14
arrowLabelOffsetX = 0
arrowLabelOffsetY = 18
arrowRoleData = nil
arrowRoleTick = 0
arrowLines = {}
arrowLabelGui = nil
arrowLabelText = nil
arrowLastAng = nil     -- last stable direction angle (jitter guard when the target projects onto the pivot)

-- Dead-latch: once a player shows ANY dead signal (health 0, Alive=false,
-- role Killed/Dead), remember it for a short window. A cheater who resets and
-- re-attaches / restores their character right after dying (health forced >0,
-- attributes stripped) is still excluded during the latch — the target never
-- flickers back to a corpse.
ARROW_DEAD_LATCH = 3     -- seconds the dead state sticks after being detected
arrowDeadLatch = {}      -- [Player] = os.clock() of the last dead detection

function arrowIsAlivePlr(plr, roleData)
	local char = plr and plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		arrowDeadLatch[plr] = os.clock()
		return false
	end
	local dead = false
	pcall(function()
		if char:GetAttribute("Alive") == false then dead = true end
	end)
	if dead then
		arrowDeadLatch[plr] = os.clock()
		return false
	end
	local info = roleData and roleData[plr.Name]
	if info then
		if info.Killed or info.Dead then
			arrowDeadLatch[plr] = os.clock()
			return false
		end
		-- Server truth: the round flag. If the round data is available it is the
		-- most authoritative signal (commands a respawned cheater bypassing local
		-- checks can't fake), so a live-but-out-of-round player is not a target.
		if info.InRound == false then return false end
	end
	-- Recently-dead latch per player
	local latchedAt = arrowDeadLatch[plr]
	if latchedAt and (os.clock() - latchedAt) < ARROW_DEAD_LATCH then return false end
	if latchedAt then arrowDeadLatch[plr] = nil end
	return true
end

function arrowEnsureDrawings()
	if espDrawingOK and #arrowLines < 3 then
		for _ = 1, 3 do
			local ok, line = pcall(function()
				local l = Drawing.new("Line")
				l.Thickness = 2
				l.Visible = false
				return l
			end)
			if ok and line then arrowLines[#arrowLines + 1] = line end
		end
	end
	if not (arrowLabelGui and arrowLabelGui.Parent) then
		pcall(function()
			local gui = Instance.new("ScreenGui")
			gui.Name = "ArrowTargetGui"
			gui.ResetOnSpawn = false
			gui.DisplayOrder = 999999
			gui.IgnoreGuiInset = true
			gui.Parent = playerGui
			local lbl = Instance.new("TextLabel")
			lbl.Name = "ArrowText"
			lbl.Size = UDim2.new(0, 340, 0, 20)
			lbl.BackgroundTransparency = 1
			lbl.Text = ""
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 14
			lbl.TextXAlignment = Enum.TextXAlignment.Center
			lbl.TextStrokeTransparency = 0.5
			lbl.Visible = false
			lbl.Parent = gui
			arrowLabelGui = gui
			arrowLabelText = lbl
		end)
	end
end

function arrowHide()
	for _, line in ipairs(arrowLines) do
		pcall(function() line.Visible = false end)
	end
	if arrowLabelText then
		pcall(function() arrowLabelText.Visible = false end)
	end
end

function arrowPickTarget()
	local myChar = player.Character
	if not myChar then return nil end
	local data = arrowRoleData
	local myRole = data and data[player.Name] and data[player.Name].Role
	if myRole == "Murderer" then
		local myRoot = myChar:FindFirstChild("HumanoidRootPart")
		if not myRoot then return nil end
		-- Priority per spec: nearest VISIBLE (line-of-sight) alive player wins;
		-- if everyone is behind walls, fall back to the nearest alive player.
		-- Raycasts only run for candidates closer than the best visible found so
		-- far, so the per-frame cost stays low.
		local bestVis, bestVisD = nil, math.huge
		local bestAny, bestAnyD = nil, math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local r = plr.Character:FindFirstChild("HumanoidRootPart")
				if r and arrowIsAlivePlr(plr, data) then
					local d = (myRoot.Position - r.Position).Magnitude
					if d < bestAnyD then bestAnyD = d; bestAny = plr end
					if d < bestVisD then
						local vis = false
						pcall(function() vis = aimHasLineOfSight(plr) end)
						if vis then bestVisD = d; bestVis = plr end
					end
				end
			end
		end
		return bestVis or bestAny
	else
		if data then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character then
					local info = data[plr.Name]
					if info and info.Role == "Murderer" and arrowIsAlivePlr(plr, data) then
						return plr
					end
				end
			end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character and arrowIsAlivePlr(plr, data) then
				local bp = plr:FindFirstChild("Backpack")
				if bp and bp:FindFirstChild("Knife") then
					return plr
				end
			end
		end
		return nil
	end
end

function arrowTick()
	if not arrowEnabled then arrowHide() return end
	local cam = workspace.CurrentCamera
	if not cam then arrowHide() return end
	arrowRoleTick = arrowRoleTick + 1
	if arrowRoleTick >= 60 or not arrowRoleData then
		arrowRoleTick = 0
		pcall(function() arrowRoleData = invokePlayerData() end)
	end
	local target = arrowPickTarget()
	local char = target and target.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then arrowHide() return end
	-- Fixed-screen HUD (like Show Round Timer): the arrow LIVES at its anchor
	-- point (screen middle + user offsets) and NEVER slides toward the target —
	-- it only rotates in place, compass-style, to indicate the direction.
	local vs = cam.ViewportSize
	local cx = vs.X / 2 + (arrowOffsetX or 0)
	local cy = vs.Y / 2 + (arrowOffsetY or 0)
	local sp = cam:WorldToViewportPoint(hrp.Position)
	-- sp.Z < 0 means the point is BEHIND the camera: its projection mirrors both
	-- axes, so the direction must be flipped back. Targets that are merely
	-- off-frame but IN FRONT of the camera keep the raw direction (the old code
	-- flipped those too, which pointed the arrow AWAY from them).
	local behind = sp.Z < 0
	local ang = math.atan2(sp.Y - cy, sp.X - cx)
	if behind then ang = ang + math.pi end
	-- Jitter guard: if the target projects exactly onto the pivot, keep the last
	-- stable angle instead of flickering every frame.
	local mag2 = (sp.X - cx) * (sp.X - cx) + (sp.Y - cy) * (sp.Y - cy)
	if mag2 >= 4 then arrowLastAng = ang end
	ang = arrowLastAng or 0
	local dx, dy = math.cos(ang), math.sin(ang)
	-- Up/down swap (user preference): when FACING a player the raw screen
	-- direction pointed DOWN (their torso sits below the camera line), and when
	-- the player was BEHIND the camera the mirrored projection pointed UP.
	-- Negating the screen-Y component swaps those two cases while keeping
	-- left/right directions intact.
	dy = -dy
	local size = math.clamp(arrowSize or 26, 8, 80)
	-- Real arrow shape: one shaft from the pivot to the head plus two barbs
	-- angled BACK at 30° off the shaft. The old closed triangle read as
	-- "pointing in three directions at once" — this one is unmistakable.
	local backX, backY = -dx, -dy
	local cos30, sin30 = 0.866, 0.5
	local b1x = backX * cos30 - backY * sin30
	local b1y = backX * sin30 + backY * cos30
	local b2x = backX * cos30 + backY * sin30
	local b2y = -backX * sin30 + backY * cos30
	local headLen = size * 0.45
	local vis = false
	pcall(function() vis = aimHasLineOfSight(target) end)
	local col = vis and (arrowVisibleColor or Color3.fromRGB(0, 255, 0)) or (arrowHiddenColor or Color3.fromRGB(255, 0, 0))
	arrowEnsureDrawings()
	if espDrawingOK and #arrowLines == 3 then
		local tx2, ty2 = cx + dx * size, cy + dy * size
		local c1x, c1y = tx2 + b1x * headLen, ty2 + b1y * headLen
		local c2x, c2y = tx2 + b2x * headLen, ty2 + b2y * headLen
		local pts = {{cx, cy, tx2, ty2}, {tx2, ty2, c1x, c1y}, {tx2, ty2, c2x, c2y}}
		for i, line in ipairs(arrowLines) do
			local p = pts[i]
			pcall(function()
				line.From = Vector2.new(p[1], p[2])
				line.To = Vector2.new(p[3], p[4])
				line.Color = col
				line.Thickness = 2
				line.Visible = true
			end)
		end
	end
	if arrowLabelText then
		local dist = 0
		pcall(function() dist = espGetDist(char) or 0 end)
		pcall(function()
			-- Caption sits under the FIXED pivot — it follows the anchor point,
			-- not the rotating tip. Its own offset and TextSize are configurable
			-- in Settings (Arrow Text Position / Arrow Text Size); -170 = half
			-- of the 340px label width so the text stays centered on the pivot.
			arrowLabelText.TextSize = math.clamp(arrowTextSize or 14, 8, 40)
			arrowLabelText.Position = UDim2.new(0, cx + (arrowLabelOffsetX or 0) - 170, 0, cy + (arrowLabelOffsetY or 18))
			arrowLabelText.Text = target.Name .. " • " .. tostring(dist) .. "m • " .. (vis and "VISIBLE" or "BEHIND WALL")
			arrowLabelText.TextColor3 = col
			arrowLabelText.Visible = true
		end)
	end
end
RunService.RenderStepped:Connect(function() pcall(arrowTick) end)

-- ============================================================
-- Clumsy modes: Default (seat + ghost desync) and Freeze (time-stop:
-- everyone else is anchored in place on YOUR screen, their animations
-- halted; disabling releases them back to real server positions).
-- ============================================================
clumsyModes = {"Default", "Freeze"}
clumsyModeIndex = 1
clumsyFreezeConns = {}
clumsyFreezeLoop = nil
clumsyFrozenChars = {}
clumsyFreezeResync = 0

function clumsyCurrentMode()
	local m = clumsyModes[clumsyModeIndex]
	if m ~= "Default" and m ~= "Freeze" then return "Default" end
	return m
end

function clumsyFreezeChar(ch)
	if not ch then return end
	for _, part in ipairs(ch:GetDescendants()) do
		if part:IsA("BasePart") then
			pcall(function() part.Anchored = true end)
		end
	end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum then
		for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
			pcall(function() tr:Stop() end)
		end
	end
end

function clumsyUnfreezeOthers()
	-- [perf] Nothing is frozen (feature off / freeze never used): the cleanup
	-- below would unanchor every part of every player for nothing. This runs on
	-- EVERY death, so on a full server it was a real per-death cost - and the
	-- vote dupe dies several times per press.
	if not clumsy_on and clumsyFreezeLoop == nil
		and (clumsyFreezeConns == nil or #clumsyFreezeConns == 0)
		and (clumsyFrozenChars == nil or next(clumsyFrozenChars) == nil) then
		return
	end
	if clumsyFreezeConns then
		for _, cn in ipairs(clumsyFreezeConns) do pcall(function() cn:Disconnect() end) end
	end
	clumsyFreezeConns = {}
	if clumsyFreezeLoop then pcall(function() clumsyFreezeLoop:Disconnect() end) end
	clumsyFreezeLoop = nil
	clumsyFrozenChars = {}
	clumsyFreezeResync = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local ch = plr.Character
			if ch then
				for _, part in ipairs(ch:GetDescendants()) do
					if part:IsA("BasePart") then
						pcall(function() part.Anchored = false end)
					end
				end
			end
		end
	end
end

function clumsyFreezeOthers()
	clumsyUnfreezeOthers()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			clumsyFreezeChar(plr.Character)
			local c = plr.CharacterAdded:Connect(function(ch)
				if clumsy_on and clumsyCurrentMode() == "Freeze" then
					clumsyFreezeChar(ch)
				end
			end)
			table.insert(clumsyFreezeConns, c)
		end
	end
	table.insert(clumsyFreezeConns, Players.PlayerAdded:Connect(function(plr)
		table.insert(clumsyFreezeConns, plr.CharacterAdded:Connect(function(ch)
			if clumsy_on and clumsyCurrentMode() == "Freeze" then
				clumsyFreezeChar(ch)
				clumsyFrozenChars[ch] = true
			end
		end))
	end))
	clumsyFreezeLoop = RunService.Heartbeat:Connect(function()
		if not (clumsy_on and clumsyCurrentMode() == "Freeze") then return end
		-- [perf] joins/respawns freeze via CharacterAdded; live chars are
		-- frozen once and only re-asserted every ~5s (was: every frame).
		clumsyFreezeResync += 1
		if clumsyFreezeResync % 300 == 0 then
			clumsyFrozenChars = {}
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local ch = plr.Character
				if ch and not clumsyFrozenChars[ch] then
					clumsyFreezeChar(ch)
					clumsyFrozenChars[ch] = true
				end
			end
		end
	end)
end

function clumsyApplyMode()
	local chair = workspace:FindFirstChild("clumsychair")
	if chair then chair:Destroy() end
	removeClumsyGhost()
	clumsyUnfreezeOthers()
	if not clumsy_on then return end
	if clumsyCurrentMode() == "Freeze" then
		clumsyFreezeOthers()
	else
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local savedpos = hrp.CFrame
		task.wait()
		pcall(function() char:MoveTo(savedpos.Position) end)
		task.wait(0.15)
		local Seat = Instance.new("Seat")
		Seat.Anchored = false
		Seat.CanCollide = false
		Seat.Name = "clumsychair"
		Seat.Transparency = 1
		Seat.CFrame = savedpos
		Seat.Parent = workspace
		local Weld = Instance.new("Weld")
		Weld.Part0 = Seat
		Weld.Part1 = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		Weld.Parent = Seat
		task.wait()
		Seat.CFrame = savedpos
		createClumsyGhost(savedpos.Position)
	end
end

function toggleClumsy()
	clumsy_on = not clumsy_on
	clumsyApplyMode()
	setToggleState(clumsyButton, clumsy_on, "Clumsy: ON", "Clumsy: OFF")
	setExtractedBtnState("Clumsy", clumsy_on)
end


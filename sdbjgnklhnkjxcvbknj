-- Custom Loop Jump Power: continuously forces the Humanoid JumpPower to a value you
-- choose (decimals like 56.4 allowed).
function setupCustomJumpPower()
	if customJumpPowerConn then customJumpPowerConn:Disconnect(); customJumpPowerConn = nil end
	if not customJumpPowerEnabled then
		-- Reverting: restore JumpPower to 50.5 when the feature is turned off.
		local c = player.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h then
			pcall(function() h.UseJumpPower = true end)
			h.JumpPower = 50.5
		end
		return
	end
	local function apply()
		local c = player.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h and h.Health > 0 then
			if h.UseJumpPower ~= true then pcall(function() h.UseJumpPower = true end) end
			if h.JumpPower ~= customJumpPowerValue then h.JumpPower = customJumpPowerValue end
		end
	end
	customJumpPowerConn = RunService.Heartbeat:Connect(apply)
	apply()
end

function toggleCustomJumpPower()
	customJumpPowerEnabled = not customJumpPowerEnabled
	setupCustomJumpPower()
end


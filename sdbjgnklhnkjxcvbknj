            -- own just-applied avatar items (tagged ChangerItem)
            local tagged = false
            pcall(function() tagged = d:GetAttribute("ChangerItem") == true end)
            if (not skipTagged) or (not tagged) then
                pcall(function() d:Destroy() end)
                n = n + 1
            end
        end
    end
    return n
end


-- ============================================================
-- Reliability fix: on some maps (e.g. Office3) the Workspace.DescendantAdded
-- event can occasionally not fire for a freshly dropped "GunDrop", and the gun
-- ESP was previously limited to a hardcoded ESP_MAP_NAMES list. This periodic,
-- map-agnostic fallback guarantees every GunDrop gets ESP-hooked and that the
-- "sheriff/hero died" (Gun Dropped) notification always fires exactly once.
-- ============================================================
gunDropAnnounced = {}

function fireGunDroppedNotif()
	if not gameNotifEnabled then return end
	local droppedByName = lastSheriffHeroName
	local droppedByUserId = lastSheriffHeroUserId
	if not droppedByName then
		local ok, roles = pcall(function()
			return invokePlayerData()
		end)
		if ok and roles and gameNotifPrevRoles then
			for name, data in pairs(gameNotifPrevRoles) do
				if data.HasGun or data.Role == "Sheriff" then
					local currentData = roles[name]
					if not currentData or (not currentData.HasGun and currentData.Role ~= "Sheriff") then
						droppedByName = name
						local p = Players:FindFirstChild(name)
						if p then droppedByUserId = p.UserId end
						break
					end
				end
			end
		end
	end
	if droppedByName then
		local droppedByPlayer = nil
		if droppedByUserId then
			for _, p in ipairs(Players:GetPlayers()) do
				if p.UserId == droppedByUserId then droppedByPlayer = p break end
			end
		end
		if not droppedByPlayer then
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name == droppedByName then droppedByPlayer = p break end
			end
		end
		if droppedByPlayer then
			gameNotifSend("Gun Dropped", droppedByName .. " died and dropped the gun!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255), droppedByPlayer)
		elseif droppedByUserId then
			gameNotifSendWithUserId("Gun Dropped", droppedByName .. " died and dropped the gun!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255), droppedByUserId)
		else
			gameNotifSend("Gun Dropped", droppedByName .. " died and dropped the gun!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255))
		end
	else
		gameNotifSend("Gun Dropped", "A gun has appeared on the map!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255))
	end
	playSoundFile(sheriffDieSoundPath)
end

-- [perf] GunDrop fallback tracker. The old version called
-- Workspace:GetDescendants() EVERY second - a full scan of the whole map (tens
-- of thousands of instances) that allocated a huge table on every pass and was
-- one of the biggest constant hitching sources. New drops are now caught by the
-- Workspace.DescendantAdded hook below (zero scanning); this loop only runs a
-- CHUNKED safety sweep every few seconds, a few hundred nodes per frame, and it
-- only descends into containers (Models/Folders) so it never touches the
-- millions of loose parts. Nothing is ever built in one frame.
task.spawn(function()
	local function gunDropHandle(obj)
		if espEnabled and espTrackedGuns and not espTrackedGuns[obj] then
			task.spawn(espHookGunDrop, obj)
		end
		if not gunDropAnnounced[obj] and not gameNotifGunDrops[obj] then
			gunDropAnnounced[obj] = true
			gameNotifGunDrops[obj] = true
			gameNotifHookGunDrop(obj)
			fireGunDroppedNotif()
		end
	end
	Workspace.DescendantAdded:Connect(function(obj)
		if obj.Name ~= "GunDrop" then return end
		gunDropHandle(obj)
	end)
	local sweepRunning = false
	local function gunDropSweep()
		local stack = { Workspace }
		local budget = 0
		while #stack > 0 do
			local obj = table.remove(stack)
			if obj.Name == "GunDrop" then gunDropHandle(obj) end
			if obj == Workspace or obj:IsA("Model") or obj:IsA("Folder") then
				local kids = obj:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
			end
			budget = budget + 1
			if budget >= 300 then
				budget = 0
				RunService.Heartbeat:Wait()
			end
		end
	end
	task.wait(3)
	while true do
		if (espEnabled or gameNotifEnabled) and not sweepRunning then
			sweepRunning = true
			task.spawn(function()
				pcall(gunDropSweep)
				sweepRunning = false
			end)
		end
		for g in pairs(gunDropAnnounced) do
			if not g.Parent then gunDropAnnounced[g] = nil end
		end
		task.wait(4)
	end
end)


		subLabel.TextColor3 = tabTextColor
		subLabel.TextXAlignment = Enum.TextXAlignment.Left
		subLabel.Font = Enum.Font.SourceSansBold
		subLabel.TextSize = 14
		subLabel.TextTruncate = Enum.TextTruncate.AtEnd
		subLabel.Parent = subBtn

		table.insert(group.tabs, {
			name = def.name,
			iconTab = def.iconTab,
			button = subBtn,
			icon = subIcon,
			label = subLabel,
			stroke = subStroke,
		})

		subBtn.MouseButton1Click:Connect(function()
			setSub(def.name)
		end)
		pcall(addBtnPressAnim, subBtn)
		pcall(hookClickSound, subBtn)
	end

	setSub(group.current)
	-- Feed the Settings -> Tab Positions sub-tab list.
	registerSubTabButtons(ownerName, group.tabs)
end

function applySidebarSubTabsForCategory(fullName)
	if not sidebarSubTabGroups then return end
	for _, group in pairs(sidebarSubTabGroups) do
		if group.bar then
			group.bar.Visible = (fullName == group.owner)
			if fullName == group.owner then
				group.setSub(group.current)
			else
				group.applyVisibility()
				if group.refreshIcons then group.refreshIcons() end
			end
		end
	end
end


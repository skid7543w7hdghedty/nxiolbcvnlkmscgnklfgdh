-- [perf + accuracy] Round timer: renders instantly the moment it is toggled on
-- and polls every ~0.1s to stay in lock-step with the real countdown. The label
-- is only rewritten when the displayed second actually changes (no GUI churn /
-- no lag). math.ceil matches the game's countdown so the value no longer trails
-- the real timer by one second. Position/Size are re-applied only when the
-- configured scales change.
local rtCachedLbl = nil
local rtLastText = nil
local rtLastPosX, rtLastPosY, rtLastSizeX, rtLastSizeY = nil, nil, nil, nil

function refreshRoundTimerLabel()
	if not showRoundTimerEnabled then
		if rtCachedLbl and rtCachedLbl.Parent then rtCachedLbl.Visible = false end
		rtCachedLbl = nil
		rtLastText = nil
		return
	end
	if not rtCachedLbl or not rtCachedLbl.Parent then
		rtCachedLbl = ensureRoundTimerLabel()
		rtLastText = nil
		rtLastPosX, rtLastPosY, rtLastSizeX, rtLastSizeY = nil, nil, nil, nil
	end
	local lbl = rtCachedLbl
	if not lbl then return end
	if roundTimerPosXScale ~= rtLastPosX or roundTimerPosYScale ~= rtLastPosY then
		lbl.Position = UDim2.new(roundTimerPosXScale, 0, roundTimerPosYScale, 0)
		rtLastPosX, rtLastPosY = roundTimerPosXScale, roundTimerPosYScale
	end
	if roundTimerSizeXScale ~= rtLastSizeX or roundTimerSizeYScale ~= rtLastSizeY then
		lbl.Size = UDim2.new(roundTimerSizeXScale, 0, roundTimerSizeYScale, 0)
		rtLastSizeX, rtLastSizeY = roundTimerSizeXScale, roundTimerSizeYScale
	end
	local secs = getRoundTimerSeconds()
	if secs and secs > 0 then
		local whole = math.ceil(secs)
		local m = math.floor(whole / 60)
		local r = whole % 60
		local txt = string.format("%dm %02ds", m, r)
		if txt ~= rtLastText then
			lbl.Text = txt
			rtLastText = txt
		end
		if not lbl.Visible then lbl.Visible = true end
	else
		if lbl.Visible then lbl.Visible = false end
	end
end

task.spawn(function()
	while true do
		refreshRoundTimerLabel()
		task.wait(0.1)
	end
end)


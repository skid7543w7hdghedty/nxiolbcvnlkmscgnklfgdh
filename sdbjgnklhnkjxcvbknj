-- Outlines around function rows/buttons inside tab content (categoryFrames).
-- Auto-attaches to new rows via DescendantAdded; one shared look for all.
function ensureFuncStroke(obj)
	if not (obj and obj:IsA("GuiObject")) then return end
	if obj.Name == "FuncStroke" then return end
	local parentFrame = obj.Parent
	if not parentFrame then return end
	local isDirect = false
	pcall(function()
		for _catName, catFrame in pairs(categoryFrames) do
			if parentFrame == catFrame then isDirect = true end
		end
	end)
	if not isDirect then return end
	if not (obj:IsA("TextButton") or obj:IsA("Frame")) then return end
	if obj:FindFirstChild("FuncStroke") then return end
	local st = Instance.new("UIStroke")
	st.Name = "FuncStroke"
	st.Color = funcStrokeColor or Color3.fromRGB(255, 255, 255)
	st.Thickness = 1
	st.Transparency = funcStrokeTransparency or 0
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Enabled = funcStrokesEnabled
	st.Parent = obj
end
function ensureFuncCorner(obj)
	if not (obj and obj:IsA("GuiObject")) then return end
	local cf = UDim.new(0, funcCornerRadius or 6)
	for _, ch in ipairs(obj:GetChildren()) do
		if ch:IsA("UICorner") then ch.CornerRadius = cf return end
	end
	local c = Instance.new("UICorner")
	c.CornerRadius = cf
	c.Parent = obj
end
function refreshFuncStrokes()
	for _, catFrame in pairs(categoryFrames) do
		for _, child in ipairs(catFrame:GetChildren()) do
			if child:IsA("TextButton") or child:IsA("Frame") then
				ensureFuncCorner(child)
				ensureFuncStroke(child)
				if funcButtonColor and child:IsA("TextButton") then
					child.BackgroundColor3 = funcButtonColor
				end
				local st = child:FindFirstChild("FuncStroke")
				if st then
					st.Enabled = funcStrokesEnabled
					st.Color = funcStrokeColor or Color3.fromRGB(255, 255, 255)
					st.Transparency = funcStrokeTransparency or 0
					st.Thickness = funcStrokeThickness or 1
				end
			end
		end
		catFrame.DescendantAdded:Connect(function(d)
			if d:IsA("TextButton") or d:IsA("Frame") then
				ensureFuncCorner(d)
				if funcButtonColor and d:IsA("TextButton") then
					d.BackgroundColor3 = funcButtonColor
				end
				if funcStrokesEnabled then ensureFuncStroke(d) end
			end
		end)
	end
end

local function updateTabColors()
	for catName, catData in pairs(categories) do
		if catData.isActive then
			catData.button.BackgroundColor3 = tabActiveBgColor
			catData.button.TextColor3 = tabActiveTextColor
		else
			catData.button.BackgroundColor3 = tabBgColor
			catData.button.TextColor3 = tabTextColor
		end
		catData.button.BackgroundTransparency = tabBgTransparency or 0
	end
	refreshTabStrokeColors()
end


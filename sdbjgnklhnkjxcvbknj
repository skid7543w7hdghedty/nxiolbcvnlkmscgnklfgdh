function refreshSavedExploiters()
	if not savedExploitersScroll then return end
	local _sigNames = {}
	for _n in pairs(markedExploiters) do _sigNames[#_sigNames+1] = _n end
	table.sort(_sigNames)
	local _sig = table.concat(_sigNames, ",")
	if _sig == _savedExploitersLastSig then return end
	_savedExploitersLastSig = _sig
	for _, child in ipairs(savedExploitersScroll:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	local names = {}
	for name, _ in pairs(markedExploiters) do
		table.insert(names, name)
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)

	if #names == 0 then
		local emptyLabel = Instance.new("TextLabel")
		emptyLabel.Size = UDim2.new(1, 0, 0, 30)

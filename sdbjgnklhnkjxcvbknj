-- Helper: waits until Animate LocalScript has built its folder structure after respawn
-- Fixes "idle is not a valid member of LocalScript Workspace.XXX.Animate" race after death
local function ensureAnimateReady(animate, timeout)
    timeout = timeout or 5
    local ok, idle = pcall(animate.WaitForChild, animate, "idle", timeout)
    if not ok or not idle then return false end
    -- wait for main folders
    local walk = animate:WaitForChild("walk", timeout)
    local run = animate:WaitForChild("run", timeout)
    local jump = animate:WaitForChild("jump", timeout)
    local climb = animate:WaitForChild("climb", timeout)
    local fall = animate:WaitForChild("fall", timeout)
    if not (walk and run and jump and climb and fall) then return false end
    -- ensure inner Animation objects exist (created asynchronously by Roblox Animate script)
    pcall(function() idle:WaitForChild("Animation1", 2) end)
    pcall(function() idle:WaitForChild("Animation2", 2) end)
    pcall(function() walk:WaitForChild("WalkAnim", 2) end)
    pcall(function() run:WaitForChild("RunAnim", 2) end)
    return true
end

-- ============================================
-- Animation restore helpers
-- ============================================
-- Every preset below used to only stop re-applying on toggle OFF, so the
-- override stayed on the current character until death. These helpers snapshot
-- the original AnimationIds before a preset writes to the Animate script and
-- put them back (plus restart the Animate script) the moment it is disabled.
animOriginals = setmetatable({}, {__mode = "k"})
animSlotPaths = {
	{"idle", "Animation1"}, {"idle", "Animation2"}, {"idle", "Animation3"},
	{"walk", "WalkAnim"}, {"run", "RunAnim"}, {"jump", "JumpAnim"},
	{"climb", "ClimbAnim"}, {"fall", "FallAnim"}, {"swim", "Swim"},
	{"swimidle", "SwimIdle"}
}
animDefaultIds = {
	["idle.Animation1"] = "rbxassetid://507766666",
	["idle.Animation2"] = "rbxassetid://507766951",
	["idle.Animation3"] = "rbxassetid://507766388",
	["walk.WalkAnim"] = "rbxassetid://507777826",
	["run.RunAnim"] = "rbxassetid://507767714",
	["jump.JumpAnim"] = "rbxassetid://507765000",
	["climb.ClimbAnim"] = "rbxassetid://507765644",
	["fall.FallAnim"] = "rbxassetid://507767968",
	["swim.Swim"] = "rbxassetid://507784897",
	["swimidle.SwimIdle"] = "rbxassetid://507785072"
}

function captureAnimOriginals(char)
	if not char then return nil end
	local cached = animOriginals[char]
	if cached then return cached end
	local animate = char:FindFirstChild("Animate")
	if not animate then return nil end
	local originals = {}
	for _, path in ipairs(animSlotPaths) do
		local holder = animate:FindFirstChild(path[1])
		local slot = holder and holder:FindFirstChild(path[2])
		if slot and slot:IsA("Animation") then
			originals[path[1] .. "." .. path[2]] = slot.AnimationId
		end
	end
	animOriginals[char] = originals
	return originals
end

function restoreCharacterAnimations(char)
	if not char then return end
	local originals = animOriginals[char]
	if not originals then return end
	animOriginals[char] = nil
	local animate = char:FindFirstChild("Animate")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not (animate and humanoid) then return end
	local animator = humanoid:FindFirstChild("Animator") or humanoid:WaitForChild("Animator", 5)
	if animator then
		pcall(function()
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop() end
		end)
	end
	-- Presets may have created a pose slot that did not exist before; remove it.
	if originals and originals["idle.Animation3"] == nil then
		local idleHolder = animate:FindFirstChild("idle")
		local createdPose = idleHolder and idleHolder:FindFirstChild("Animation3")
		if createdPose and createdPose:IsA("Animation") then
			pcall(function() createdPose:Destroy() end)
		end
	end
	for _, path in ipairs(animSlotPaths) do
		local holder = animate:FindFirstChild(path[1])
		local slot = holder and holder:FindFirstChild(path[2])
		if slot and slot:IsA("Animation") then
			local key = path[1] .. "." .. path[2]
			local id = (originals and originals[key]) or animDefaultIds[key]
			if id and id ~= "" then
				pcall(function() slot.AnimationId = id end)
			end
		end
	end
	-- Restart the Animate script so it reloads the restored IDs right away.
	pcall(function() animate.Disabled = true end)
	task.defer(function()
		if animate and animate.Parent then animate.Disabled = false end
	end)
	pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
end


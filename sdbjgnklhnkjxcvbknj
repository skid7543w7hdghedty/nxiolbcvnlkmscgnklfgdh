function rebuildCustomAnims()
	for _, data in pairs(customAnimUi) do
		local row = (data and data.Row) or data
		if row then pcall(function() row:Destroy() end) end
	end
	customAnimUi = {}
	local order = slotOrder
	for _, e in ipairs(customAnims) do
		local row = Instance.new("Frame")
		row.Name = "CustomAnim_" .. tostring(e.name)
		row.Size = UDim2.new(1, 0, 0, 42)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order
		order = order + 1
		row.Parent = categoryFrames["Animations"]

		local isOn = (activeCustomAnimName == e.name)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -152, 1, 0)
		btn.BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
		btn.TextColor3 = isOn and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
		btn.Text = e.name .. (isOn and "  [ON]" or "")
		btn.Font = Enum.Font.SourceSansBold

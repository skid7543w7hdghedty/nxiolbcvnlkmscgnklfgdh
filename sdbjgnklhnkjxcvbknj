-- ============================================================
-- Auto Manuals: picks the peek side from where the murderer is relative
-- to YOU (camera-relative). Murderer on your right → back to the right
-- (face Left); murderer on your left → back to the left (face Right).
-- Dead-ahead/behind holds the current side (no flicker). Runs ONLY while
-- manuals master is ON together with Anti-Aim or Fake Duck.
-- ============================================================
autoManualsEnabled = false

function toggleAutoManuals()
	autoManualsEnabled = not autoManualsEnabled
	setToggleState(autoManualsBtn, autoManualsEnabled, "Auto Manuals: ON", "Auto Manuals: OFF")
	setExtractedBtnState("Auto Manuals", autoManualsEnabled)
	saveConfig()
end

task.spawn(function()
	while true do
		RunService.Heartbeat:Wait()
		pcall(function()
			if not autoManualsEnabled then return end
			if not manualsEnabled then return end
			if not (antiAimIsActive() or fakeDuckEnabled) then return end
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local cam = workspace.CurrentCamera
			if not (hrp and cam) then return end
			local murderer = aimFindMurderer()
			if not (murderer and murderer ~= player) then return end
			local tChar = murderer.Character
			local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
			local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
			if not (tRoot and tHum and tHum.Health > 0) then return end
			-- Lateral position of the murderer on YOUR screen: positive means
			-- he is on your right → turn your back to the left (face Right),
			-- and vice versa. Zero deadzone: flips exactly at center crossing.
			local relX, relZ = tRoot.Position.X - hrp.Position.X, tRoot.Position.Z - hrp.Position.Z
			local rv = cam.CFrame.RightVector
			local rx, rz = rv.X, rv.Z
			if (rx * rx + rz * rz) < 0.0001 then return end
			local rlen = math.sqrt(rx * rx + rz * rz)
			local lateral = (relX * rx + relZ * rz) / rlen
			local want = nil
			if lateral > 0 then
				want = "Right"
			elseif lateral < 0 then
				want = "Left"
			end
			if want ~= nil and want ~= manualsSide then
				manualsSetSide(want)
			end
		end)
	end
end)


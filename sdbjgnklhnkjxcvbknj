	popupClose.TextSize = 16
	popupClose.Parent = popupTitle

	local popupCloseCorner = Instance.new("UICorner")
	popupCloseCorner.CornerRadius = UDim.new(0, 4)
	popupCloseCorner.Parent = popupClose

	popupClose.MouseButton1Click:Connect(function()
		-- Full close (not just hide): otherwise the 0.15s live-stats loop and the
		-- popup connections keep running forever and stack up -> periodic freezes.
		exploiterPopupCache[plr.Name] = nil
		popupGui:Destroy()
	end)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -10, 0, 330)
	scroll.Position = UDim2.new(0, 5, 0, 45)
	scroll.BackgroundTransparency = 1

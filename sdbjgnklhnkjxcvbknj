-- Uses the ON file when the tab is active, OFF otherwise (both from Icons/<TabName>/).
-- Each state falls back to the other state's file when its own is empty.
function refreshTabIcons()
	if not categories then return end
	pcall(function()
		if refreshCombatSubTabIcons then refreshCombatSubTabIcons() end
		if emotesRefreshIcons then emotesRefreshIcons() end
		if sidebarSubTabGroups then
			for _, group in pairs(sidebarSubTabGroups) do
				if group.refreshIcons then group.refreshIcons() end
			end
		end
	end)
	-- Master tab-icons switch (Settings): hide everything, keep text labels.
	if tabIconsEnabled == false then
		for _, catData in pairs(categories) do
			if catData.icon then catData.icon.Visible = false end
		end
		return
	end
	for fullName, catData in pairs(categories) do
		local icon = catData.icon
		if icon then
			local offAsset, onAsset = nil, nil
			pcall(function()
				if tabIconAsset then offAsset = tabIconAsset(fullName) end
				if tabIconActiveAsset then onAsset = tabIconActiveAsset(fullName) end
			end)
			local asset = nil
			if catData.isActive then
				asset = onAsset
				if (not asset or asset == "") then asset = offAsset end
			else
				asset = offAsset
				if (not asset or asset == "") then asset = onAsset end
			end
			if asset and asset ~= "" then
				icon.Image = asset
				icon.Visible = true
			else
				icon.Visible = false
			end
		end
	end
end


-- Vote Start detection now lives in the Vote Map watcher
-- ============================================
-- The old block here polled GetPlayerData every second and fired 13 s after
-- the roles were cleared. GetPlayerData returns an empty table on this game,
-- so it never detected anything (and fired at the wrong time when it did).
-- Vote Map watches the vote pads themselves instead, and the panel it opens is
-- the vote UI, so there is nothing left to poll here.

-- В–РѕР»СЉРµРєС‚РёСЂРѕСЂР°РЅРѕР№ РїРѕР»РЅРµРµ РїРѕРґР±РѕСЂР° GunDrop (instant, event-driven)
-- ============================================================
-- INSTANT PICKUP DETECTION
-- ============================================================
-- Root cause of "No one picked up" on instant-kill: the old code only detected a
-- pickup inside the 0.5s polling loop (then task.wait(0.3) + retries), so by the
-- time it scanned, the picker — who was auto-killed a frame after grabbing the
-- gun — was already dead. The fix: hook each GunDrop's AncestryChanged and run the
-- detection synchronously the SAME FRAME it disappears (grab moment), while the
-- picker is still alive and actually holding the "Gun" tool. The nearest-alive
-- snapshot is also taken in that same frame, so even a picker who dies a frame
-- later is still registered. gameNotifPickupHandled stops double-firing between
-- the event hook and the (now back-up) polling loop.
gameNotifPickupHandled = {}
gameNotifPickupBusy = {}

local function gameNotifSnapshotNearest(lastPos)
	if not lastPos then return nil end
	local bestName, bestDist = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		local pChar = p.Character
		local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
		local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
		if pChar and pHum and pHum.Health > 0 and pRoot then
			local d = (pRoot.Position - lastPos).Magnitude
			if d < bestDist then
				bestDist = d
				bestName = p.Name
			end
		end
	end
	return bestName
end

local function gameNotifEmitPickup(pickedByName, pickedByUserId)
	local pickedByPlayer = nil
	if pickedByUserId then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.UserId == pickedByUserId then pickedByPlayer = p break end
		end
	end
	if not pickedByPlayer then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name == pickedByName then pickedByPlayer = p break end
		end
	end
	local pickedChar = pickedByPlayer and pickedByPlayer.Character
	local pickedHum = pickedChar and pickedChar:FindFirstChildOfClass("Humanoid")
	if pickedByPlayer and pickedChar and pickedHum and pickedHum.Health > 0 then
		lastSheriffHeroName = pickedByName
		lastSheriffHeroUserId = pickedByUserId
	end
	if pickedByPlayer then
		gameNotifSend("Gun Picked Up", pickedByName .. " picked up the gun!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255), pickedByPlayer)
	elseif pickedByUserId then
		gameNotifSendWithUserId("Gun Picked Up", pickedByName .. " picked up the gun!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255), pickedByUserId)
	else
		gameNotifSend("Gun Picked Up", pickedByName .. " picked up the gun!", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255))
	end
end

-- Detect who grabbed this gun. Called from the instant AncestryChanged hook with
-- the frame-accurate lastPos of the disappearing gun, and from the polling loop
-- as a back-up for guns that vanished before we could hook them.
local function gameNotifDetectPickup(gun, lastPos)
	if gameNotifPickupBusy[gun] then return end
	gameNotifPickupBusy[gun] = true
	-- Synchronous-alive snapshot: the nearest ALIVE player to the gun in the very
	-- frame it vanished is the picker — captured now, before any instant death.
	local snapName = gameNotifSnapshotNearest(lastPos)
	local pickedByName = nil
	local pickedByUserId = nil
	if gameNotifEnabled then
		-- Tool scan (authoritative): an alive player holding the "Gun" tool now.
		-- Fast, few retries: at grab-moment the holder is alive, so usually found
		-- in one pass.
		local attempts = 0
		while attempts < 6 do
			attempts = attempts + 1
			local foundHolderPlayer = nil
			for _, p in ipairs(Players:GetPlayers()) do
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if char and hum and hum.Health > 0 then
					local hasTool = false
					for _, tool in ipairs(char:GetChildren()) do
						if tool:IsA("Tool") and tool.Name:lower():find("gun") then hasTool = true; break end
					end
					if not hasTool then
						local backpack = p:FindFirstChild("Backpack")
						if backpack then
							for _, tool in ipairs(backpack:GetChildren()) do
								if tool:IsA("Tool") and tool.Name:lower():find("gun") then hasTool = true; break end
							end
						end
					end
					if hasTool then foundHolderPlayer = p; break end
				end
			end
			if foundHolderPlayer then
				pickedByName = foundHolderPlayer.Name
				pickedByUserId = foundHolderPlayer.UserId
				break
			end
			if attempts % 3 == 0 then
				local okRoles, rolesNow = pcall(function()
					return invokePlayerData()
				end)
				if okRoles and rolesNow then
					for _, p in ipairs(Players:GetPlayers()) do
						local d = rolesNow[p.Name]
						if d and d.HasGun and d.Role ~= "Murderer" then
							local char = p.Character
							local hum = char and char:FindFirstChildOfClass("Humanoid")
							if char and hum and hum.Health > 0 then
								pickedByName = p.Name
								pickedByUserId = p.UserId
								foundHolderPlayer = p
								break
							end
						end
					end
				end
			end
			if pickedByName then break end
			task.wait(0.08)
		end
	end
	-- No alive holder found: maybe the picker was instantly killed. The snapName
	-- (nearest alive player at grab-moment) is the picker — but only if a round
	-- is actually running; otherwise the gun just vanished (round ended / reset).
	if not pickedByName then
		local roundActive = false
		pcall(function()
			local r = getPlayerDataRemote()
			if r then
				local res = invokePlayerData()
				if res then
					for _, d in pairs(res) do
						if d.Role == "Murderer" or d.Role == "Sheriff" then roundActive = true; break end
					end
				end
			end
		end)
		if roundActive and snapName then
			pickedByName = snapName
		end
	end
	if pickedByName then
		gameNotifEmitPickup(pickedByName, pickedByUserId)
	elseif gameNotifEnabled then
		gameNotifSend("Gun Picked Up", "No one picked up the gun — it disappeared.", Color3.fromRGB(170, 0, 255), Color3.fromRGB(255, 255, 255))
	end
	gameNotifPickupBusy[gun] = nil
end

-- Hook each GunDrop so detection fires INSTANTLY at the grab moment, not on the
-- next 0.5s poll tick.
local function gameNotifHookGunDrop(gun)
	if gameNotifPickupHandled[gun] or not gun then return end
	if gun:GetAttribute("NotifHooked") then return end
	local conn
	conn = gun.AncestryChanged:Connect(function(_, parent)
		if parent ~= nil then return end
		conn:Disconnect()
		if gameNotifPickupHandled[gun] then return end
		gameNotifPickupHandled[gun] = true
		-- Prefer the position we already tracked; if the poll never got to it,
		-- read the pivot directly (still valid for a frame after reparenting).
		local lastPos = gameNotifGunDropPos[gun]
		if not lastPos then
			local ok, pos = pcall(function()
				local cf = gun:GetPivot()
				return cf and cf.Position or nil
			end)
			if ok and pos then lastPos = pos end
		end
		gameNotifGunDropPos[gun] = nil
		task.spawn(gameNotifDetectPickup, gun, lastPos)
	end)
	gun:SetAttribute("NotifHooked", true)
end

-- РћС‚СЃР»РµР¶РёРІР°РЅРёРµ РїРѕРґР±РѕСЂР° GunDrop
-- [perf] This tracker used to call Workspace:GetDescendants() every 0.5 seconds —
-- a full scan of the entire map that allocated a huge table each pass and was one
-- of the biggest freeze sources on mobile. New GunDrops are now registered by the
-- Workspace.DescendantAdded hook below (event-based, zero scanning); this loop only
-- checks the handful of already-known guns for removal.
task.spawn(function()
	-- one-time initial scan for guns that already existed before the script
	-- loaded. [perf] Chunked walk instead of one Workspace:GetDescendants()
	-- call: that single call built the whole map's descendant table in ONE
	-- frame, which was the biggest part of the config-restore hitch. Only
	-- containers (Models/Folders) are descended into, so the millions of loose
	-- parts are never visited.
	task.spawn(function()
		local stack = { Workspace }
		local budget = 0
		while #stack > 0 do
			local obj = table.remove(stack)
			if obj.Name == "GunDrop" then
				gameNotifGunDrops[obj] = true
				gameNotifHookGunDrop(obj)
			end
			if obj == Workspace or obj:IsA("Model") or obj:IsA("Folder") then
				local kids = obj:GetChildren()
				for i = 1, #kids do stack[#stack + 1] = kids[i] end
			end
			budget = budget + 1
			if budget >= 300 then
				budget = 0
				RunService.Heartbeat:Wait()
			end
		end
	end)
		while true do
			task.wait(0.5)
			-- Record each tracked GunDrop's current position while it still exists,
			-- so a pick-up later (when the drop is gone) can be attributed to the
			-- player standing nearest to where it last was.
			for gun in pairs(gameNotifGunDrops) do
				if gun.Parent then
					local ok, pos = pcall(function()
						local cf = gun:GetPivot()
						return cf and cf.Position or nil
					end)
					if ok and pos then
						gameNotifGunDropPos[gun] = pos
					end
				else
					gameNotifGunDropPos[gun] = nil
				end
			end
			if not gameNotifEnabled then
				-- keep the set clean while notifications are off so re-enabling
				-- doesn't fire stale "picked up" notifications
				for gun in pairs(gameNotifGunDrops) do
					if not gun.Parent then gameNotifGunDrops[gun] = nil end
				end
				continue
			end

			for gun in pairs(gameNotifGunDrops) do
				if not gun.Parent then
					local lastPos = gameNotifGunDropPos[gun]
					gameNotifGunDrops[gun] = nil
					gameNotifGunDropPos[gun] = nil
					-- Back-up path only: guns that vanished before the AncestryChanged
					-- hook above could run (e.g. they already existed when the script
					-- loaded). The instant event hook handles the common case.
					if not gameNotifPickupHandled[gun] then
						gameNotifPickupHandled[gun] = true
						task.spawn(gameNotifDetectPickup, gun, lastPos)
					end
				end
			end
		end
end)

